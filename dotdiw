            print("    %s" % rel)
        print('\n    git add %s && git commit -m "Declare where work starts"' % " ".join(yours))


def show_actor(response: Response) -> None:
    """Who the tracker acts as, where it checked; a name anyone could give is not said."""
    actor = response.get("actor") or {}
    if actor.get("verified"):
        print("  Acting as %s." % actor["name"])


def show_adopt(request: Request, response: Response) -> None:
    if request.get("quiet"):
        return  # whoever asked quietly says what it has to say
    reason = response.get("reason")
    if reason == "not-a-repository":
        sys.stderr.write(
            "%s init needs a git repository: formulas are found with "
            "git. Run git init first.\n" % PROG
        )
    elif reason == "key-not-written":
        sys.stderr.write("%s %s\n" % (PROG, response["summary"]))
    elif reason == "workspace-not-made":
        sys.stderr.write("%s: %s\n" % (response["workspace"], response["summary"]))
    elif response["status"] != "completed":
        sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))
    elif not response["created"]:
        sys.stderr.write(
            "%s: this repository is adopted; its tracker is %s\n" % (PROG, response["workspace"])
        )
    else:
        print(
            "\u2713 Adopted. The tracker is %s, under %s"
            % (response["tracker"], response["workspace"])
        )
        show_actor(response)


def show_name(request: Request, response: Response) -> None:
    if response.get("reason") == "not-installed":
        sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))
    elif response.get("reason") in ("tracker-unknown", "adapter-failed", "no-workspace"):
        sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))
    elif response["status"] != "completed":
        sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))
    elif response.get("workRef"):
        item = response.get("item") or {}
        if request.get("json"):
            print(json.dumps(item, indent=2, ensure_ascii=False))
            return
        print(
            "\u2713 Created issue: %s \u2014 %s"
            % (response["workRef"], item.get("title") or request.get("title"))
        )
        print("  Priority: P%s" % (2 if item.get("priority") is None else item["priority"]))
        print("  Status: %s" % (item.get("status") or "open"))


def show_pour(request: Request, response: Response) -> None:
    if request.get("json") and response.get("moleculeRef"):
        # The record, whole or as far as the pour went: a pour that stopped
        # part of the way still names the root and the steps it made.
        answer = {"rootId": response["moleculeRef"], "stepIds": response.get("stepRefs") or []}
        if response.get("verifyUsing"):
            answer["verifyUsing"] = response["verifyUsing"]
        if response.get("claims"):
            answer["claims"] = response["claims"]
        print(json.dumps(answer, indent=2, ensure_ascii=False))
        if response["status"] != "completed":
            sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))
        return
    if response.get("reason") == "not-installed":
        sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))
    elif response["status"] != "completed":
        sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))
    elif response.get("moleculeRef"):
        print("\u2713 Poured mol: created %d issues" % (len(response.get("stepRefs") or []) + 1))
        print("  Root issue: %s" % response["moleculeRef"])
    means = response.get("verifyUsing") or []
    if means and response["status"] == "completed" and not request.get("json"):
        print("Verify using:")
        for value in means:
            print("  %s" % value)
    for c in response.get("claims") or [] if not request.get("json") else []:
        print(
            "%s has a claim. When it is done, record it: %s claim %s %s"
            % (c["item"], PROG, c["item"], " ".join("'%s: <value>'" % s for s in c["slots"]))
        )


def show_claim(request: Request, response: Response) -> None:
    """dotdiw claim: the run, its claims filled from their values and its
    means filled from them, or what refused; --json prints the run as data."""
    run = response.get("run")
    if response["status"] != "completed" or not run:
        sys.stderr.write("%s: claim: %s\n" % (PROG, response["summary"]))
        return
    if request.get("json"):
        print(json.dumps(run, indent=2, ensure_ascii=False))
        return
    print("Run %s (%s)" % (run["root"], run.get("formula") or ""))
    if not run["steps"]:
        print("\nNo step of this run has a claim.")
    for s in run["steps"]:
        print("\n%s (%s, %s)" % (s["step"], s["item"], s.get("status") or ""))
        held = {v["label"]: v["text"] for v in s["values"]}
        for label in s["slots"]:
            print("  %s: %s" % (label, held.get(label, "")))
        print("claim:\n%s" % s["claim"])
    if run["verifyUsing"]:
        print("\nverify-using:")
        for m in run["verifyUsing"]:
            print(m)
    if run["open"]:
        print("\nopen: %s" % ", ".join(run["open"]))


def show_forward(request: Request, response: Response) -> None:
    """The pass-through showed itself; a command answered in records is
    shown here, in the shape the tracker underneath used to print."""
    if response.get("reason") == "not-installed":
        sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))
        return
    if response.get("reason") in ("unsupported-command", "tracker-unknown", "adapter-failed"):
        sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))
        return
    if response.get("printed"):
        # What dotdiw did after the tracker's own command, kept off its stdout.
        for answer in response.get("answers") or []:
            sys.stderr.write("%s: %s\n" % (PROG, answer["summary"]))
        return
    if not response.get("operation"):
        if response["status"] != "completed":
            sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))
        else:
            sys.stdout.write(response.get("output") or "")
        return
    glyphs = {"open": "\u25cb", "in_progress": "\u25d0", "blocked": "\u25cf", "closed": "\u2713"}
    as_json = "--json" in (request.get("arguments") or [])

    def line(item: dict[str, Any]) -> str:
        return "%s %s P%s %s" % (
            glyphs.get(item.get("status") or "", "?"),
            item["id"],
            item.get("priority", 2),
            item.get("title", ""),
        )

    def draw(item: dict[str, Any], kids: dict[str, Any], seen: set[str], lead: str) -> None:
        """An item's children under it, to any depth, each item once."""
        seen.add(item["id"])
        below = [k for k in kids.get(item["id"], []) if k["id"] not in seen]
        for n, child in enumerate(below):
            last = n == len(below) - 1
            print(
                "%s%s %s"
                % (lead, "\u2514\u2500\u2500" if last else "\u251c\u2500\u2500", line(child))
            )
            draw(child, kids, seen, lead + ("    " if last else "\u2502   "))

    written: list[dict[str, Any]] = []
    for answer in response.get("answers") or []:
        if answer["status"] != "completed":
            if answer.get("reason") == "blocked":
                sys.stderr.write(
                    "cannot close blocked issue: %s is blocked by [%s]\n"
                    % (answer["summary"].split(" ", 1)[0], ", ".join(answer.get("blockedBy") or []))
                )
            else:
                sys.stderr.write("%s: %s\n" % (PROG, answer["summary"]))
            continue
        operation = response["operation"]
        if operation in ("operation.list-items", "operation.ready-items"):
            items = answer.get("items") or []
            if as_json:
                print(json.dumps(items, indent=2, ensure_ascii=False))
                continue
            byid = {i["id"]: i for i in items}
            kids: dict[str, list[dict[str, Any]]] = {}
            for i in items:
                if i.get("parent") in byid:
                    kids.setdefault(i["parent"], []).append(i)
            seen: set[str] = set()
            for i in items:
                if i.get("parent") not in byid:
                    print(line(i))
                    draw(i, kids, seen, "")
            for i in items:  # a loop of parents has no root: each is still printed
                if i["id"] not in seen:
                    print(line(i))
                    draw(i, kids, seen, "")
            if operation == "operation.ready-items":
                print(
                    "\nReady: %d issue%s with no active blockers"
                    % (len(items), "" if len(items) == 1 else "s")
                )
            else:
                open_, active = (
                    sum(1 for i in items if i.get("status") != "closed"),
                    sum(1 for i in items if i.get("status") == "in_progress"),
                )
                print(
                    "\nTotal: %d issue%s (%d open, %d in progress)"
                    % (len(items), "" if len(items) == 1 else "s", open_, active)
                )
        elif operation == "operation.show-item":
            item = answer["item"]
            if as_json:
                print(
                    json.dumps(
                        dict(item, children=answer.get("children") or []),
                        indent=2,
                        ensure_ascii=False,
                    )
                )
                continue
            print(
                "%s %s \u00b7 %s   [P%s \u00b7 %s]"
                % (
                    glyphs.get(item["status"], "?"),
                    item["id"],
                    item["title"],
                    item.get("priority", 2),
                    item["status"].upper(),
                )
            )
            print("Type: %s" % (item.get("kind") or "task"))
            print(
                "Created: %s \u00b7 Updated: %s"
                % ((item.get("createdAt") or "")[:10], (item.get("updatedAt") or "")[:10])
            )
            if item.get("assignee"):
                print("Assignee: %s" % item["assignee"])
            if item.get("reason"):
                print("Close reason: %s" % item["reason"])
            if item.get("parent"):
                print("\nPARENT\n  \u2191 %s" % item["parent"])
            if item.get("needs"):
                print("\nDEPENDS ON")
                for n in item["needs"]:
                    print("  \u2192 %s" % n)
            if answer.get("children"):
                print("\nCHILDREN")
                for child in answer["children"]:
                    print("  \u21b3 %s" % line(child))
        elif operation == "operation.close-item":
            item = answer.get("item") or {}
            if as_json:
                written.append(item)
                continue
            for ident in answer.get("closedIds") or []:
                title = item.get("title", "") if ident == item.get("id") else ""
                reason = item.get("reason") if ident == item.get("id") else "every step closed"
                print(
                    "\u2713 Closed %s%s%s"
                    % (ident, " \u2014 " + title if title else "", ": " + reason if reason else "")
                )
            if not answer.get("closedIds"):
                print("%s was closed already" % item.get("id"))
        elif operation == "operation.update-item":
            item = answer["item"]
            if as_json:
                written.append(item)
                continue
            print("\u2713 Updated issue: %s \u2014 %s" % (item["id"], item["title"]))
        elif operation == "operation.add-need":
            edge = answer["edge"]
            if as_json:
                print(json.dumps(edge, indent=2, ensure_ascii=False))
                continue
            print("\u2713 Added dependency: %s depends on %s" % (edge["id"], edge["needs"]))
    if written:
        print(json.dumps(written, indent=2, ensure_ascii=False))


