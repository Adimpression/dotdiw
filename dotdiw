PRESENTER: Callable[[str, Request, Response], None] | None = None


class DoorError(TypeError):
    """A request or a response outside its type, or an operation that is not one."""


def invoke(operation: str, request: Request) -> Response:
    """Run one operation: the request held to its type, the body, the response
    held to its type, the witness appended, a lock the body took for a write
    released once that is written, the response shown and returned. An
    operation asked from outside the door begins a request of its own, which
    reads the formulas afresh and holds what it holds apart from any other
    request running in the process at the same time; it waits while one
    runs alone (Gate)."""
    spec = DOOR.get(operation)
    if spec is None:
        raise DoorError("%s is not an operation of %s" % (operation, PROG))
    for key in request:
        if key not in spec["request"]:
            raise DoorError('%s: "%s" is not a field of its request' % (operation, key))
    for key in spec["requestRequired"]:
        if request.get(key) is None:
            raise DoorError('%s: "%s" is required in its request and missing' % (operation, key))
    with a_request() as scope:
        held = len(scope.held)
        try:
            scope.depth += 1
            try:
                response: Response = globals()[spec["body"]](request)
            finally:
                scope.depth -= 1
            for key in response:
                if key not in spec["response"]:
                    raise DoorError('%s: "%s" is not a field of its response' % (operation, key))
            for key in spec["responseRequired"]:
                if response.get(key) is None:
                    raise DoorError(
                        '%s: "%s" is required in its response and missing' % (operation, key)
                    )
            if response["status"] not in STATUSES:
                raise DoorError(
                    '%s: status "%s" is not one of %s'
                    % (operation, response["status"], ", ".join(STATUSES))
                )
            witness_from(operation, request, response)
        finally:
            release_held(scope, held)
        if PRESENTER is not None:
            PRESENTER(operation, request, response)
    return response


def witness_from(operation: str, request: Request, response: Response) -> None:
    """The six observed labels, each from the typed response of the operation
    the IDL binds it to; nothing when this checkout keeps no log.

    A pour that names no work is placed by the log: the create that surfaced
    the formula, failing that the most recent named work. A pour the log
    cannot place is exactly what the contract is there to say. A close is
    placed the same way: through the pours the log holds.
    """
    root = request.get("root")
    ws = workspace(root) if root else None
    if not witness_on(ws):
        return
    if operation == "operation.name-the-work":
        if response.get("exitCode") == 0 and response.get("workRef"):
            witness(
                ws,
                "dotdiwInvocations",
                "work_named",
                workId=response["workRef"],
                title=request.get("title"),
                startedAt=request_started(),
                tracker=response.get("tracker"),
            )
    elif operation == "operation.match-formulas":
        if request.get("surface", True) and request.get("workRef"):
            surfaced = response.get("surfaced") or []
            for f in surfaced:
                witness(
                    ws,
                    "dotdiwInvocations",
                    "formula_surfaced",
                    workId=request["workRef"],
                    formulaId=f.get("formulaRef"),
                    path=f.get("path"),
                )
            if not surfaced:
                witness(
                    ws,
                    "dotdiwInvocations",
                    "nothing_surfaced",
                    workId=request["workRef"],
                    title=request.get("title"),
                )
    elif operation == "operation.pour-procedure":
        if (
            response.get("exitCode") == 0
            and response.get("formulaRef")
            and response.get("moleculeRef")
        ):
            work = request.get("workRef")
            if not work:
                log = witnessed(ws)
                for e in reversed(log):
                    if (
                        e.get("label") == "formula_surfaced"
                        and e.get("formulaId") == response["formulaRef"]
                    ):
                        work = e.get("workId")
                        break
                else:
                    for e in reversed(log):
                        if e.get("label") == "work_named":
                            work = e.get("workId")
                            break
            witness(
                ws,
                "dotdiwInvocations",
                "procedure_poured",
                workId=work,
                formulaId=response["formulaRef"],
                moleculeId=response["moleculeRef"],
                stepIds=response.get("stepRefs") or [],
                tracker=response.get("tracker"),
            )
    elif operation == "operation.forward-to-the-tracker":
        # Read back from the tracker, so each id here is closed whatever the
        # command's exit: a close it did make is a close.
        closed = response.get("closedRefs") or []
        if closed:
            poured = {}
            for e in witnessed(ws):
                if e.get("label") == "procedure_poured" and e.get("moleculeId"):
                    poured[e["moleculeId"]] = e
            for ident in closed:
                if ident in poured:
                    # Whether the log shows every step poured in it closed by now:
                    # a close it cannot vouch for is the contract's to class apart.
                    shut = {
                        e.get("stepId")
                        for e in witnessed(ws)
                        if e.get("label") == "step_closed" and e.get("moleculeId") == ident
                    }
                    witness(
                        ws,
                        "beadsIssues",
                        "molecule_closed",
                        workId=poured[ident].get("workId"),
                        moleculeId=ident,
                        everyStepClosed=set(poured[ident].get("stepIds") or []) <= shut,
                        tracker=response.get("tracker"),
                    )
                    continue
                for mol, e in poured.items():
                    if ident in (e.get("stepIds") or []):
                        witness(
                            ws,
                            "beadsIssues",
                            "step_closed",
                            workId=e.get("workId"),
                            moleculeId=mol,
                            stepId=ident,
                            tracker=response.get("tracker"),
                        )


