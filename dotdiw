def tracker_command_at_sight(argv: list[str]) -> str:
    """What dotdiw does with a pass-through's command from its first word
    alone, where that is enough: as-it-is, refused:<word>, or read, for one
    that must be read whole -- a close, an update, an edge, a command whose
    subcommands differ, and any command that begins with an option."""
    if not argv:
        return "as-it-is"
    word = argv[0]
    if word.startswith("-"):
        return "read"
    name = TRACKER_ALIASES.get(word, word)
    if name in TRACKER_AS_IT_IS:
        return "as-it-is"
    if name in TRACKER_REFUSED:
        return "refused:%s" % word
    return "read"


def what_the_command_asks(
    reading: Response,
) -> tuple[str, list[str] | None, list[tuple[str, str, str]], list[str]]:
    """What a command asks, from the pass-through's reading of it as the
    tracker will read it: as-it-is, refused:<command>, or checked; with the
    words naming what it closes, None where it closes nothing, and each
    edge it would write as the pair it makes -- the first waiting on the
    second once written -- with what to say of it; and the ids an update
    writes, each to be read before it runs."""
    path = reading.get("command")
    if path is None:
        return "as-it-is", None, [], []  # a word the tracker knows by no command
    path = [str(p) for p in path]
    options: Mapping[str, Any] = reading.get("options") or {}
    words = [str(w) for w in reading.get("words") or []]
    said = " ".join(path) or "it"
    if options.get("help") is True:
        return "as-it-is", None, [], []  # help, and nothing run
    elsewhere = [o for o in TRACKER_ELSEWHERE if o in options]
    if elsewhere:
        return "refused:%s --%s" % (said, elsewhere[0]), None, [], []
    name, sub = (path[0] if path else ""), (path[1] if len(path) > 1 else "")
    closing = [o for o in TRACKER_CLOSING_OPTIONS.get(name, ()) if options.get(o)]
    if closing:
        return "refused:%s --%s" % (said, closing[0]), None, [], []
    if name in TRACKER_AS_IT_IS:
        return "as-it-is", None, [], []
    if name in TRACKER_SUBCOMMANDS_AS_IT_IS and sub in TRACKER_SUBCOMMANDS_AS_IT_IS[name]:
        return "as-it-is", None, [], []
    if path == ["close"]:
        if not words:
            return "refused:%s with no id" % said, None, [], []
        return "checked", words, [], []
    if path == ["update"]:
        if not words:
            return "refused:%s with no id" % said, None, [], []
        kept = [o for o in TRACKER_KEPT_OPTIONS if o in options]
        if kept:
            return "refused:%s --%s" % (said, kept[0]), None, [], []
        status = options.get("status")
        if isinstance(status, str) and status not in TRACKER_OPEN_STATUSES + ("closed",):
            return "refused:%s --status %s" % (said, status), None, [], []
        parent = options.get("parent")
        edges = [
            (str(parent), w, "%s cannot stand under %s" % (w, parent))
            for w in words
            if isinstance(parent, str) and parent
        ]
        return "checked", words if status == "closed" else None, edges, words
    if path == ["dep", "add"]:
        if "file" in options:
            return "refused:%s --file" % said, None, [], []
        needs = {
            str(n)
            for n in words[1:2] + [options.get("blocked-by"), options.get("depends-on")]
            if isinstance(n, str)
        }
        if len(needs) > 1:
            return "refused:%s naming more than one need" % said, None, [], []
        if not words or not needs:
            return "as-it-is", None, [], []  # the tracker's to refuse, with nothing written
        return "checked", None, edge_pairs(words[0], needs.pop(), options.get("type")), []
    if path == ["dep"]:
        blocks = options.get("blocks")
        if isinstance(blocks, str) and words:
            return "checked", None, edge_pairs(blocks, words[0], None), []
        return "as-it-is", None, [], []
    if path == ["link"]:
        if len(words) < 2:
            return "as-it-is", None, [], []
        return "checked", None, edge_pairs(words[0], words[1], options.get("type")), []
    return "refused:%s" % said, None, [], []


def edge_pairs(first: str, second: str, kind: Any) -> list[tuple[str, str, str]]:
    """The pair an edge of the given type makes: a need's item waits on what
    it needs, a parent-child edge puts its first under its second, and the
    types that make nothing wait make no pair."""
    if kind == "parent-child":
        return [(second, first, "%s cannot stand under %s" % (first, second))]
    if kind in TRACKER_EDGES_WITHOUT_A_WAIT:
        return []
    return [(first, second, "%s cannot need %s" % (first, second))]


@contextlib.contextmanager
def held_for_writing(root: str | None) -> Iterator[bool]:
    """The workspace's lock, held while a command that closes an item or
    makes one wait is checked and written, so that two dotdiw commands at
    once on this machine cannot each pass the check before the other
    writes. True once held, False where another held it too long; with no
    workspace there is no tracker to write, and nothing to hold."""
    ws = workspace(root) if root else None
    if not ws or not os.path.isdir(ws):
        yield True
        return
    with open(os.path.join(ws, TRACKER_LOCK), "a", encoding="utf-8") as fh:
        deadline = time.monotonic() + TRACKER_LOCK_SECONDS
        held = False
        while not held:
            try:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                held = True
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    break
                time.sleep(0.05)
        try:
            yield held
        finally:
            scope = SCOPE.get()
            if held and scope is not None and scope.depth:
                # Released by the door once the log of the command is written,
                # so that two commands' lines come in the order of their writes;
                # held by this request, which no other request lets go of.
                scope.held.append(os.dup(fh.fileno()))
            elif held:
                fcntl.flock(fh, fcntl.LOCK_UN)


def command_words(argv: list[str]) -> tuple[list[str], dict[str, str | bool]]:
    """One of dotdiw's own commands, under an adapter without a pass-through:
    its words after its verb, and its options; a value is never taken for a
    word."""
    flags: dict[str, str | bool] = {}
    words: list[str] = []
    i = 1
    while i < len(argv):
        a = argv[i]
        if a.startswith("--") and "=" in a:
            k, v = a.split("=", 1)
            flags[k] = v
        elif a in COMMAND_VALUE_FLAGS and i + 1 < len(argv):
            flags[a] = argv[i + 1]
            i += 1
        elif a.startswith("-"):
            flags[a] = True
        else:
            words.append(a)
        i += 1
    return words, flags


# The options of dotdiw's own commands whose next word is their value.
COMMAND_VALUE_FLAGS = (
    "--reason",
    "-r",
    "--title",
    "-s",
    "--status",
    "-p",
    "--priority",
    "--parent",
    "-a",
    "--assignee",
)


def held_at_the_command_line(
    common: Request,
    closing_words: list[str] | None,
    edges: list[tuple[str, str, str]],
    every: dict[str, TrackerItem] | None,
    asked: Iterable[str] = (),
) -> tuple[list[Response], list[str]]:
    """What dotdiw refuses at the command line, whichever tracker answers,
    as answers the presenter shows: under a pass-through, which runs the
    tracker's own close, a close of an item while what it waits on stands
    open -- an open need, an open child, an open item poured in its run --
    as close-item refuses it, given every item as the tracker listed them
    before the command (every), the words it closes in the order named
    (closing_words); and a close of an item the tracker shows by id while
    that listing leaves it out, since then the listing is not every item
    and nothing it says of what stands open can be held; under any, an edge
    (edges, each the pair it makes, the first waiting on the second once
    written) where the second already waits on the first, or is it, which
    would leave neither able to close. Asked of the tracker interface, so
    that every adapter is held alike, and every id as the tracker reads it,
    so that a short one is held as the full one is -- save a whole id the
    tracker holds nothing of, which it reads as another item's
    (shown_for_a_word): a command naming one runs nothing, since the
    tracker would write that other item, and so does one that writes an
    item it names otherwise (asked, the ids an update writes). A tracker
    the interface cannot reach is left to answer the command itself; one
    that fails otherwise refuses it. With the refusals come the ids a close
    names, as the tracker reads them, each once, in the order first named,
    whether they stand open or closed."""
    out: list[Response] = []
    closing: list[str] = []
    read: dict[str, str | None] = {}

    def named(word: str) -> str | None:
        """The id a word names, as the tracker reads it; None where it names
        nothing, or the tracker cannot say."""
        if every is not None and word in every:
            return word
        if word in read:
            return read[word]
        asked_of = invoke_tracker("operation.show-item", dict(common, id=word))
        shown = shown_for_a_word(word, asked_of)
        read[word] = None
        if shown is not asked_of:
            out.append(dict(shown, summary="Nothing ran: %s" % shown["summary"]))
            return None
        if shown["status"] == "completed":
            read[word] = str((shown.get("item") or {}).get("id") or word)
            return read[word]
        if shown.get("reason") not in ("item-not-found",) + TRACKER_CANNOT_ANSWER:
            failed = dict(shown)
            failed["summary"] = "Nothing ran: the tracker could not say what %s names. %s" % (
                word,
                shown["summary"],
            )
            out.append(failed)
        return None

    for word in asked:
        named(word)
    if out:
        return out, closing
    if closing_words is not None and every is not None:
        before = {i: o for i, o in every.items() if o.get("status") != "closed"}
        earlier: set[str] = set()
        for word in closing_words:
            ident = named(word)
            if ident is None:
                continue
            if ident not in every:
                out.append(
                    {
                        "status": "failed",
                        "reason": "adapter-failed",
                        "exitCode": 1,
                        "summary": "Nothing ran: the tracker shows %s, and its list of every "
                        "item leaves it out, so what a close of it waits on could not be read."
                        % ident,
                    }
                )
                continue
            if ident in before:
                standing = what_stands_open(ident, before[ident], before, earlier)
                if standing:
                    out.append(
                        {
                            "status": "blocked",
                            "reason": "blocked",
                            "blockedBy": standing,
                            "exitCode": 1,
                            "summary": "%s is blocked by %s." % (ident, ", ".join(standing)),
                        }
                    )
                earlier.add(ident)
            if ident not in closing:
                closing.append(ident)
        if out:
            return out, closing

    def waited_on(start: str) -> set[str] | None:
        """Every item the one named waits on before it can close, to any
        depth: its needs, its children and the items poured in its run;
        None where the tracker cannot say."""
        listed = invoke_tracker("operation.list-items", dict(common, scope="all"))
        if listed["status"] != "completed":
            if listed.get("reason") not in TRACKER_CANNOT_ANSWER:
                failed = dict(listed)
                failed["summary"] = (
                    "Nothing ran: what waits on what could not be read. %s" % (listed["summary"])
                )
                out.append(failed)
            return None
        under: dict[str, list[str]] = {}
        for i in listed.get("items") or []:
            for above in (i.get("parent"), i.get("run")):
                if above:
                    under.setdefault(above, []).append(i["id"])
        seen: set[str] = set()
        todo = [start]
        while todo:
            at = todo.pop()
            shown = shown_by_its_id(at, invoke_tracker("operation.show-item", dict(common, id=at)))
            if shown["status"] != "completed" and shown.get("reason") != "item-not-found":
                if shown.get("reason") not in TRACKER_CANNOT_ANSWER:
                    failed = dict(shown)
                    failed["summary"] = "Nothing ran: what %s waits on could not be read. %s" % (
                        at,
                        shown["summary"],
                    )
                    out.append(failed)
                return None
            item = shown.get("item") or {} if shown["status"] == "completed" else {}
            for nxt in list(item.get("needs") or []) + under.get(at, []):
                if nxt not in seen:
                    seen.add(nxt)
                    todo.append(nxt)
        return seen

    for waiter_word, item_word, said in edges:
        waiter, item = named(waiter_word), named(item_word)
        if out:
            return out, closing
        if waiter is None or item is None:
            continue  # the tracker names it no item, and says so
        waits = waited_on(item)
        if out:
            return out, closing
        if waiter == item or (waits is not None and waiter in waits):
            out.append(
                {
                    "status": "failed",
                    "reason": "cycle",
                    "exitCode": 1,
                    "summary": "%s, which waits on it to close, so neither could close." % said
                    if waiter != item
                    else "%s: an item cannot wait on itself." % said,
                }
            )
    return out, closing


def closes_that_follow(
    common: Request,
    closed: list[str],
    records: Mapping[str, Mapping[str, Any]],
    standing: dict[str, Any] | None,
) -> list[Response]:
    """The closes an item's close leaves due: its poured root, and the root
    of the run it was poured in, wherever it stands, each closed once
    nothing of it is open -- the answers of those closes, one level up, as
    a close inside the local adapter makes them. Where the adapter closed
    the root itself it is among those closed and is left. With standing,
    what stands open now, no root still waiting on an item is asked; the
    adapter refuses the rest itself."""
    answers: list[Response] = []
    done = set(closed)
    for ident in list(closed):
        item = records.get(ident) or {}
        above: list[tuple[str, bool]] = []
        if item.get("parent"):
            above.append((str(item["parent"]), True))
        if item.get("run") and item.get("run") != item.get("parent"):
            above.append((str(item["run"]), False))
        for up, must_be_root in above:
            if up in done:
                continue
            record: Mapping[str, Any] | None
            if standing is not None:
                record = standing.get(up)
                if record is None or what_stands_open(up, record, standing, done):
                    continue
            else:
                shown = shown_by_its_id(
                    up, invoke_tracker("operation.show-item", dict(common, id=up))
                )
                if shown["status"] != "completed":
                    if shown.get("reason") != "item-not-found":
                        answers.append(
                            dict(
                                shown,
                                summary="%s, which the close of %s may have left with nothing "
                                "open, could not be read: %s" % (up, ident, shown["summary"]),
                            )
                        )
                    continue
                record = shown.get("item")
                if record is None or record.get("status") == "closed":
                    continue
            if must_be_root and record.get("kind") != "root":
                continue
            shut = invoke_tracker(
                "operation.close-item", dict(common, id=up, closeReason="every step closed")
            )
            if shut["status"] == "blocked" or (
                shut["status"] == "completed" and not shut.get("closedIds")
            ):
                continue
            if shut["status"] != "completed":
                shut = dict(
                    shut,
                    summary="The close of %s, left with nothing open, failed: %s"
                    % (up, shut["summary"]),
                )
            answers.append(shut)
            for c in shut.get("closedIds") or []:
                done.add(c)
                if standing is not None:
                    standing.pop(c, None)
    return answers


def what_the_close_closed(
    common: Request,
    named: list[str],
    every: dict[str, TrackerItem],
    marked: Any,
    errored: bool,
) -> tuple[list[str], list[Response]]:
    """What a close the pass-through ran closed, read back from the tracker
    after it ran, and the run rule held of the tracker as it then stands
    (held_to_the_run), given every item as listed before the close, each id
    the close named among them.

    The listing after is every item only where it holds each one listed
    before that the tracker still holds. One it leaves out is asked of the
    tracker by id (shown_by_its_id): where the tracker holds that one no
    more -- another having deleted it as the close ran -- it is no gap;
    otherwise the listing is not every item, nothing can be held to it, and
    the command fails naming each id it named.

    What carries the mark the close ran under is what it closed -- each id it
    named, in the order named, then a root the tracker closed of its own
    accord as that close ran -- and nothing else, whoever else is writing.
    What stood closed before the command is no close of its, whatever
    session the tracker now keeps on it: an update to the closed status
    writes its own over the first close's.

    Where the marks cannot be read back, nothing is known to be this
    close's: the rule is held all the same, nothing is logged or followed,
    and the command fails naming each id it named. An id it named that
    stood open before and that the tracker holds no more is not read back
    either: nothing of it is logged, and the command fails naming it, the
    other closes standing. And where the tracker's command ended without an
    error (errored says whether it did), an id it named that stood open
    before and stands open after was not closed by it, and the command
    fails saying so. Then the roots its closes left with nothing open
    are closed, after them. The ids closed, and the answers to show after
    the tracker's own output."""

    def unread(ident: str, why: str) -> Response:
        return {
            "status": "failed",
            "reason": "adapter-failed",
            "exitCode": 1,
            "summary": "%s could not be read back after the close, so whether this command "
            "closed it, and after what it waits on, is not known; nothing of it is logged: %s"
            % (ident, why),
        }

    listed = invoke_tracker("operation.list-items", dict(common, scope="all"))
    if listed["status"] != "completed":
        return [], [unread(ident, listed["summary"]) for ident in named]
    now: dict[str, Any] = {i["id"]: i for i in listed.get("items") or []}
    for absent in [i for i in every if i not in now]:
        shown = shown_by_its_id(
            absent, invoke_tracker("operation.show-item", dict(common, id=absent))
        )
        if shown.get("reason") != "item-not-found":
            why = "the tracker's list of every item leaves out %s, which it listed before." % absent
            return [], [unread(ident, why) for ident in named]
    before = {i: o for i, o in every.items() if o.get("status") != "closed"}
    shut: list[str] = []
    if isinstance(marked, list):
        shut = [i for i in named if i in marked and i in now and i in before]
        shut += [i for i in marked if i not in named and i in now and i in before]

    def reopen(ident: str, status: str) -> str | None:
        back = invoke_tracker("operation.update-item", dict(common, id=ident, status=status))
        return None if back["status"] == "completed" else str(back["summary"])

    shut, notes, standing = held_to_the_run(named, shut, before, now, reopen)
    if not isinstance(marked, list):
        why = "the tracker did not say which closes were this command's."
        return [], notes + [unread(ident, why) for ident in named]
    notes += [
        unread(ident, "the tracker holds it no more.")
        for ident in named
        if ident in before and ident not in now
    ]
    if not errored:
        notes += [
            {
                "status": "failed",
                "reason": "adapter-failed",
                "exitCode": 1,
                "summary": "The tracker answered the close without an error, and %s stands open."
                % ident,
            }
            for ident in named
            if ident in before and ident in now and now[ident].get("status") != "closed"
        ]
    follows = closes_that_follow(common, shut, {**before, **now}, standing)
    closed = list(shut)
    for answer in follows:
        if answer["status"] == "completed":
            closed += [c for c in answer.get("closedIds") or [] if c not in closed]
            answer = dict(
                answer,
                summary="Closed %s: every step of it closed."
                % ", ".join(answer.get("closedIds") or []),
            )
        notes.append(answer)
    return closed, notes


def RunATrackerCommand(request: RunATrackerCommandRequest) -> RunATrackerCommandResponse:
    """journey.run-a-tracker-command: forward, with what rides along on cook, doctor, lint
    and remember."""
    root, argv = request["root"], list(request.get("arguments") or [])
    # `cook <id>` means that formula's file, wherever in the tree it sits.
    if argv and argv[0] == "cook" and len(argv) > 1 and not argv[1].startswith("-"):
        r = invoke("operation.resolve-formula", {"root": root, "ident": argv[1]})
        if r["status"] == "completed" and not os.path.exists(argv[1]):
            argv = ["cook", os.path.join(root, r["path"])] + argv[2:]
    fwd = invoke(
        "operation.forward-to-the-tracker",
        {"root": root, "arguments": argv, "tracker": request.get("tracker")},
    )
    # The conventions, checked where someone actually looks. Nobody in the
    # trial ran `check` or `learn`; they ran these two.
    if argv and argv[0] in ("doctor", "lint"):
        invoke(
            "operation.describe-and-check",
            {"root": root, "mode": "doctor", "tracker": request.get("tracker")},
        )
    if argv and argv[0] == "remember" and fwd["exitCode"] == 0:
        invoke("operation.nudge-towards-a-formula", {"root": root, "text": " ".join(argv[1:])})
    return {"status": fwd["status"], "summary": fwd["summary"], "exitCode": fwd["exitCode"]}


# --------------------------------- duty.surface-procedures-when-work-starts


def NameTheWork(request: NameTheWorkRequest) -> NameTheWorkResponse:
    """step.name-the-work: the work item, created under the title given.

    Through the tracker door, with the fields dotdiw's own flags filled: the
    title, the description, the priority and the parent. The id comes back
    in the record.
    """
    root = request["root"]
    made = invoke_tracker(
        "operation.create-item",
        {
            "root": root,
            "tracker": request.get("tracker"),
            "title": request["title"],
            "description": request.get("description"),
            "priority": request.get("priority"),
            "parent": request.get("parent"),
        },
    )
    code = made.get("exitCode", 0 if made["status"] == "completed" else 1)
    work = (made.get("item") or {}).get("id") if code == 0 else None
    return {
        "status": made["status"],
        "summary": "Named %s." % (work or "the work") if code == 0 else made["summary"],
        "workRef": work,
        "item": made.get("item") if code == 0 else None,
        "reason": made.get("reason"),
        "tracker": made.get("tracker"),
        "exitCode": code,
    }


def PourProcedure(request: PourProcedureRequest) -> PourProcedureResponse:
    """step.pour-procedure: a surfaced formula becomes tracked, ordered steps.

    The formula is read from where it actually lives, every time, and its
    steps handed to the tracker with their needs: the file is the formula,
    so a formula edited in place pours as it reads now, not as a copy the
    tracker happened to hold. Every adapter pours the steps it is given.
    """
    root = request["root"]
    r = invoke("operation.resolve-formula", {"root": root, "ident": request.get("ident")})
    found = r["status"] == "completed"
    # An id refused here never reaches the tracker: one that two formulas
    # share, or one with a provider's suffix that the provider does not serve,
    # whose copy the tracker may still hold.
    if not found and r.get("reason") in (
        "ambiguous",
        "provider-formula-unserved",
        "provider-failed",
    ):
        return {
            "status": r["status"],
            "summary": r["summary"],
            "formulaRef": None,
            "reason": r["reason"],
            "exitCode": 1,
        }
    # The formula poured is the one the lookup selected, as its reading parsed
    # it: its id, its title, its description, its means to prove and its
    # steps, one version whatever is written to its file meanwhile. Nothing
    # reads the file again, and nothing is written for it.
    body = r.get("formula") if found else None
    formula = (
        {
            "id": r["formulaRef"],
            "desc": body["description"],
            "steps": body["steps"],
            "verifyUsing": body["verifyUsing"],
        }
        if body
        else {}
    )
    ident = request.get("ident") or ""
    ref = formula.get("id")
    shared = shared_step_id(formula.get("steps") or [])
    if shared is not None:
        return {
            "status": "failed",
            "summary": "Two steps of %s share the id %s, so nothing was poured." % (ref, shared),
            "formulaRef": ref,
            "reason": "duplicate-step",
            "exitCode": 1,
        }
    poured = invoke_tracker(
        "operation.pour-steps",
        {
            "root": root,
            "tracker": request.get("tracker"),
            "formulaRef": ref or ident,
            "title": ref or ident,
            "steps": [tracker_step(s) for s in formula.get("steps") or []],
            "description": formula.get("desc") or None,
            "verifyUsing": list(formula.get("verifyUsing") or []),
        },
    )
    code = poured.get("exitCode", 0 if poured["status"] == "completed" else 1)
    # Each claimed step the pour made, so that whoever does it knows what to
    # record: its statement and slots, every placeholder still open.
    claims: list[ClaimedStep] = []
    # A pour cut short answers fewer ids than there are steps.
    made = dict(
        zip(
            [s["id"] for s in formula.get("steps") or []],
            poured.get("stepIds") or [],
            strict=False,
        )
    )
    for s in formula.get("steps") or [] if code == 0 else []:
        claim = s.get("claim")
        if claim and made.get(s["id"]):
            statement, left = filled(claim["statement"], CLAIM_PLACEHOLDER, lambda _: None)
            claims.append(
                {
                    "item": made[s["id"]],
                    "step": s["id"],
                    "status": "open",
                    "statement": statement,
                    "slots": list(claim["slots"]),
                    "values": [],
                    "claim": statement,
                    "open": left,
                }
            )
    return {
        "status": poured["status"],
        "summary": poured["summary"],
        "formulaRef": ref if found else None,
        "moleculeRef": poured.get("rootId") if found else None,
        "stepRefs": list(poured.get("stepIds") or []) if found else [],
        "claims": claims,
        "verifyUsing": list(formula.get("verifyUsing") or []) if found and code == 0 else None,
        "reason": poured.get("reason"),
        "tracker": poured.get("tracker"),
        "exitCode": code,
    }


def StartNamedWork(request: StartNamedWorkRequest) -> StartNamedWorkResponse:
    """journey.start-named-work: name it, read what applies, and -- when asked -- pour."""
    root = request["root"]
    named = invoke(
        "operation.name-the-work",
        {
            "root": root,
            "title": request.get("title"),
            "description": request.get("description"),
            "tracker": request.get("tracker"),
            "priority": request.get("priority"),
            "parent": request.get("parent"),
            "json": request.get("json"),
        },
    )
    if named["exitCode"] != 0:
        return {
            "status": named["status"],
            "summary": named["summary"],
            "workRef": named.get("workRef"),
            "exitCode": named["exitCode"],
        }
    if request.get("quiet"):
        return {
            "status": "completed",
            "summary": named["summary"],
            "workRef": named["workRef"],
            "surfaced": [],
            "exitCode": 0,
        }

    invoke("operation.declare-conventions", {"root": root, "announce": "create"})
    built = invoke("operation.index-the-project", {"root": root, "background": True})
    if built["status"] != "completed":
        return {
            "status": "failed",
            "summary": built["summary"],
            "workRef": named["workRef"],
            "exitCode": built["exitCode"],
        }
    matched = invoke(
        "operation.match-formulas",
        {
            "root": root,
            "title": request.get("title"),
            "description": request.get("description"),
            "workRef": named["workRef"],
        },
    )
    invoke(
        "operation.describe-and-check",
        {"root": root, "mode": "quiet", "tracker": request.get("tracker")},
    )
    if request.get("formulaRef"):
        invoke(
            "operation.pour-procedure",
            {
                "root": root,
                "ident": request["formulaRef"],
                "workRef": named["workRef"],
                "tracker": request.get("tracker"),
            },
        )
    return {
        "status": "completed",
        "summary": named["summary"],
        "workRef": named["workRef"],
        "surfaced": matched["surfaced"],
        "exitCode": 0,
    }


