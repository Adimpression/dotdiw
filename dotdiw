# Words that make a remembered note read like a procedure rather than a fact.
# Two or more: one "then" is a sentence, two is a sequence.
PROCEDURAL = ("every time", "each time", "always", "first", "then", "after",
              "before", "step", "run ", "finally", "once you")


def clip(text, n):
    """Cut to a word, not to a letter: this goes in a command to be copied."""
    t = " ".join(text.split())
    return t if len(t) <= n else t[:t.rfind(" ", 0, n + 1)]


def reads_procedural(text):
    t = " " + " ".join(text.lower().split()) + " "
    return sum(1 for w in PROCEDURAL if w in t) >= 2


