def tracker_command_at_sight(argv: list[str]) -> str:
    """What dotdiw does with a pass-through's command from its first word
    alone, where that is enough: as-it-is, refused:<word>, or read, for one
    that must be read whole -- a close, an update, an edge, a command whose
    subcommands differ, and any command that begins with an option."""
    if not argv:
        return "as-it-is"
    word = argv[0]
    if word.startswith("-"):
        return "read"
    name = TRACKER_ALIASES.get(word, word)
    if name in TRACKER_AS_IT_IS:
        return "as-it-is"
    if name in TRACKER_REFUSED:
        return "refused:%s" % word
    return "read"


def what_the_command_asks(
    reading: Response,
) -> tuple[str, list[str] | None, list[tuple[str, str, str]], list[str]]:
    """What a command asks, from the pass-through's reading of it as the
    tracker will read it: as-it-is, refused:<command>, or checked; with the
    words naming what it closes, None where it closes nothing, and each
    edge it would write as the pair it makes -- the first waiting on the
    second once written -- with what to say of it; and the ids an update
    writes, each to be read before it runs."""
    path = reading.get("command")
    if path is None:
        return "as-it-is", None, [], []  # a word the tracker knows by no command
    path = [str(p) for p in path]
    options: Mapping[str, Any] = reading.get("options") or {}
    words = [str(w) for w in reading.get("words") or []]
    said = " ".join(path) or "it"
    if options.get("help") is True:
        return "as-it-is", None, [], []  # help, and nothing run
    elsewhere = [o for o in TRACKER_ELSEWHERE if o in options]
    if elsewhere:
        return "refused:%s --%s" % (said, elsewhere[0]), None, [], []
    name, sub = (path[0] if path else ""), (path[1] if len(path) > 1 else "")
    closing = [o for o in TRACKER_CLOSING_OPTIONS.get(name, ()) if options.get(o)]
    if closing:
        return "refused:%s --%s" % (said, closing[0]), None, [], []
    if name in TRACKER_AS_IT_IS:
        return "as-it-is", None, [], []
    if name in TRACKER_SUBCOMMANDS_AS_IT_IS and sub in TRACKER_SUBCOMMANDS_AS_IT_IS[name]:
        return "as-it-is", None, [], []
    if path == ["close"]:
        if not words:
            return "refused:%s with no id" % said, None, [], []
        return "checked", words, [], []
    if path == ["update"]:
        if not words:
            return "refused:%s with no id" % said, None, [], []
        kept = [o for o in TRACKER_KEPT_OPTIONS if o in options]
        if kept:
            return "refused:%s --%s" % (said, kept[0]), None, [], []
        status = options.get("status")
        if isinstance(status, str) and status not in TRACKER_OPEN_STATUSES + ("closed",):
            return "refused:%s --status %s" % (said, status), None, [], []
        parent = options.get("parent")
        edges = [
            (str(parent), w, "%s cannot stand under %s" % (w, parent))
            for w in words
            if isinstance(parent, str) and parent
        ]
        return "checked", words if status == "closed" else None, edges, words
    if path == ["dep", "add"]:
        if "file" in options:
            return "refused:%s --file" % said, None, [], []
        needs = {
            str(n)
            for n in words[1:2] + [options.get("blocked-by"), options.get("depends-on")]
            if isinstance(n, str)
        }
        if len(needs) > 1:
            return "refused:%s naming more than one need" % said, None, [], []
        if not words or not needs:
            return "as-it-is", None, [], []  # the tracker's to refuse, with nothing written
        return "checked", None, edge_pairs(words[0], needs.pop(), options.get("type")), []
    if path == ["dep"]:
        blocks = options.get("blocks")
        if isinstance(blocks, str) and words:
            return "checked", None, edge_pairs(blocks, words[0], None), []
        return "as-it-is", None, [], []
    if path == ["link"]:
        if len(words) < 2:
            return "as-it-is", None, [], []
        return "checked", None, edge_pairs(words[0], words[1], options.get("type")), []
    return "refused:%s" % said, None, [], []


def edge_pairs(first: str, second: str, kind: Any) -> list[tuple[str, str, str]]:
    """The pair an edge of the given type makes: a need's item waits on what
    it needs, a parent-child edge puts its first under its second, and the
    types that make nothing wait make no pair."""
    if kind == "parent-child":
        return [(second, first, "%s cannot stand under %s" % (first, second))]
    if kind in TRACKER_EDGES_WITHOUT_A_WAIT:
        return []
    return [(first, second, "%s cannot need %s" % (first, second))]


@contextlib.contextmanager
def held_for_writing(
    root: str | None, tracker: str | None, until_logged: bool = True
) -> Iterator[bool]:
    """The lock of the store a write goes to, held while a write of an
    item's record is checked and written, so that two dotdiw writes at once
    cannot each pass the check before the other writes.

    The store is the one the adapter answering the request writes to. An
    adapter dotdiw ships keeps it in the checkout's workspace, so the lock is
    the workspace's. One loaded from a file may keep it where other checkouts
    reach it too -- a hosted tracker's project is reached by every checkout
    adopted on it -- and dotdiw cannot tell where, so the lock is the one
    every checkout under this dotdiw home shares for that tracker, the home
    being where the tracker's name means that adapter: two homes, like two
    machines, share none. True once held, False where another held it too
    long; with no workspace there is no tracker to write, and nothing to
    hold. Held until the door has logged the command, unless asked to be let
    go of on leaving, as a move's read of its source is before it writes."""
    ws = workspace(root) if root else None
    if not ws or not os.path.isdir(ws):
        yield True
        return
    name, adapter = resolve_tracker({"root": root, "tracker": tracker})
    path = os.path.join(ws, TRACKER_LOCK)
    if adapter is not None and is_loaded(adapter):
        shared = os.path.join(os.path.expanduser(DOTDIW_HOME), TRACKER_LOCKS)
        os.makedirs(shared, exist_ok=True)
        path = os.path.join(shared, "%s.lock" % re.sub(r"[^A-Za-z0-9_-]", "_", name))
    with held_at(path, until_logged) as held:
        yield held


def adoption_lock(root: str) -> str:
    """What one adoption of this checkout locks while it runs, and a move
    while it opens its target: the git directory git names for the
    checkout, which its worktrees share and which holds the config its key
    and its choice are written to. Named by git, it is the same directory
    whether git was told it through GIT_DIR, as a hook's environment tells
    it, or found it; where git names none, the checkout's own directory. A
    directory is locked as it stands (held_at), so the lock leaves nothing
    behind, in the checkout or under the home, and every adoption of the
    checkout holds it, under whichever home."""
    common = git(["rev-parse", "--git-common-dir"], root).strip()
    directory = os.path.join(root, common) if common else root
    return os.path.realpath(directory if os.path.isdir(directory) else root)


@contextlib.contextmanager
def held_at(path: str, until_logged: bool = True) -> Iterator[bool]:
    """The lock of the file at path, for this request: True once held, False
    where another held it for TRACKER_LOCK_SECONDS. Once held, the door lets
    go of it when the log of the command is written, so that two commands'
    lines come in the order of their writes; or, not until_logged, it is let
    go of on leaving, so that the request can take it again. A file is made
    where there is none; a directory is locked as it stands."""
    if os.path.isdir(path):
        fh = os.open(path, os.O_RDONLY)
    else:
        fh = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o666)
    try:
        deadline = time.monotonic() + TRACKER_LOCK_SECONDS
        held = False
        while not held:
            try:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                held = True
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    break
                time.sleep(0.05)
        try:
            yield held
        finally:
            scope = SCOPE.get()
            if held and until_logged and scope is not None and scope.depth:
                # Released by the door once the log of the command is written,
                # so that two commands' lines come in the order of their writes;
                # held by this request, which no other request lets go of.
                scope.held.append(os.dup(fh))
            elif held:
                fcntl.flock(fh, fcntl.LOCK_UN)
    finally:
        os.close(fh)


def command_words(argv: list[str]) -> tuple[list[str], dict[str, str | bool]]:
    """One of dotdiw's own commands, under an adapter without a pass-through:
    its words after its verb, and its options; a value is never taken for a
    word."""
    flags: dict[str, str | bool] = {}
    words: list[str] = []
    i = 1
    while i < len(argv):
        a = argv[i]
        if a.startswith("--") and "=" in a:
            k, v = a.split("=", 1)
            flags[k] = v
        elif a in COMMAND_VALUE_FLAGS and i + 1 < len(argv):
            flags[a] = argv[i + 1]
            i += 1
        elif a.startswith("-"):
            flags[a] = True
        else:
            words.append(a)
        i += 1
    return words, flags


# The options of dotdiw's own commands whose next word is their value.
COMMAND_VALUE_FLAGS = (
    "--reason",
    "-r",
    "--title",
    "-s",
    "--status",
    "-p",
    "--priority",
    "--parent",
    "-a",
    "--assignee",
)


def read_in_records(argv: list[str]) -> bool:
    """Whether a command is one of dotdiw's own reads as dotdiw spells them --
    list with --all or --parent, ready, show with one id, each perhaps with
    --json -- which a request with no terminal has answered as records under
    every adapter, a pass-through's too, each item with its ETag."""
    plain, flags = command_words(argv)
    verb = argv[0] if argv else ""
    takes = {"list": ("--all", "--parent", "--json"), "ready": ("--json",), "show": ("--json",)}
    if verb not in takes or any(f not in takes[verb] for f in flags):
        return False
    return len(plain) == 1 if verb == "show" else not plain


def made_by_a_stopped_move(
    common: Request, kept: Callable[[], str | None]
) -> dict[str, tuple[str, str, str]]:
    """Each item a move into the request's tracker made and has not
    finished -- a run of it stopped before it wrote all of the item's needs,
    its status and its close -- by its id there, with the move's source and
    target and where to run it again, as the moves' records beside the
    stores hold them. A store dotdiw ships is the checkout's, so the records
    read are its workspace's; one loaded from a file may be reached by every
    checkout under this dotdiw home, as its lock is (held_for_writing), so
    the records are every workspace's under the home -- save those of a
    move into another store, by where the tracker keeps this checkout's
    items, as the body asks it (kept: describe-tracker's storeId), asked
    only where a record says where its move wrote. Read under that lock,
    which a move holds through its last save, they are as the moves last
    left them."""
    root = common.get("root") or repo_root()
    ws = workspace(root) if root else None
    if not ws:
        return {}
    name, adapter = resolve_tracker(dict(common, root=root))
    where = (
        os.path.join(os.path.expanduser(DOTDIW_HOME), "*")
        if adapter is not None and is_loaded(adapter)
        else ws
    )
    unsettled: list[tuple[dict[str, Any], list[str], str]] = []
    for path in sorted(glob.glob(os.path.join(where, "migration-*.json"))):
        try:
            with open(path, encoding="utf-8") as fh:
                record = json.load(fh)
        except (OSError, ValueError):
            continue
        if not isinstance(record, dict):
            continue
        # One that names no pair, as an earlier dotdiw's, is of the pair
        # its name gives, as the move reads it.
        named = os.path.basename(path)[len("migration-") : -len(".json")]
        if (
            record.get("to") is None
            and record.get("from") is None
            and named.endswith("-to-" + name)
        ):
            record = dict(record, to=name, **{"from": named[: -len("-to-" + name)]})
        if record.get("to") != name:
            continue
        # A field not as a move keeps it holds what it can: ids not as kept
        # name nothing to hold; settled not as kept settles nothing.
        ids = record.get("ids")
        if not isinstance(ids, dict):
            continue
        listed = record.get("settled")
        settled = {s for s in listed if isinstance(s, str)} if isinstance(listed, list) else set()
        made = [str(m) for s, m in ids.items() if s not in settled]
        if made:
            unsettled.append((record, made, path))
    here = kept() if any(isinstance(r.get("store"), str) for r, _, _ in unsettled) else None
    out: dict[str, tuple[str, str, str]] = {}
    for record, made, path in unsettled:
        if here and isinstance(record.get("store"), str) and record["store"] != here:
            continue  # a move into another store, under the same name
        # Where to run it again: the checkout it ran in, where that is still
        # the checkout of the record's workspace; else where the record is,
        # and how to let go of what it holds once that checkout is gone.
        checkout = record.get("checkout")
        if (
            isinstance(checkout, str)
            and checkout
            and os.path.isdir(checkout)
            and workspace(checkout) == os.path.dirname(path)
        ):
            again = " in %s" % checkout
        else:
            again = MOVE_RECORD_ASIDE % (
                path,
                "names as %s, now none of it" % checkout
                if isinstance(checkout, str) and checkout
                else "names none",
            )
        for ident in made:
            out[ident] = (str(record.get("from")), name, again)
    return out


def stopped_here(common: Request) -> dict[str, tuple[str, str, str]]:
    """What a stopped move into the request's tracker made and has not
    finished (made_by_a_stopped_move), the tracker asked where it keeps the
    checkout's items where a record says where its move wrote."""

    def kept() -> str | None:
        described = invoke_tracker("operation.describe-tracker", dict(common))
        return described.get("storeId") if described["status"] == "completed" else None

    return made_by_a_stopped_move(common, kept)


def held_at_the_command_line(
    common: Request,
    closing_words: list[str] | None,
    edges: list[tuple[str, str, str]],
    every: dict[str, TrackerItem] | None,
    asked: Iterable[str] = (),
    holds: list[str] | None = None,
    dropped: Iterable[tuple[str, str]] = (),
) -> tuple[list[Response], list[str]]:
    """What dotdiw refuses at the command line, whichever tracker answers,
    as answers the presenter shows: under a pass-through, which runs the
    tracker's own close, a close of an item while what it waits on stands
    open -- an open need, an open child, an open item poured in its run --
    as close-item refuses it, given every item as the tracker listed them
    before the command (every), the words it closes in the order named
    (closing_words); and a close of an item the tracker shows by id while
    that listing leaves it out, since then the listing is not every item
    and nothing it says of what stands open can be held; under any, a close
    of an item a move into the tracker made and stopped before finishing,
    until a run of the move finishes it, since until then the item need not
    wait on all it needs (made_by_a_stopped_move); under any, an edge
    (edges, each the pair it makes, the first waiting on the second once
    written) where the second already waits on the first, or is it, which
    would leave neither able to close. Asked of the tracker interface, so
    that every adapter is held alike, and every id as the tracker reads it,
    so that a short one is held as the full one is -- save a whole id the
    tracker holds nothing of, which it reads as another item's
    (shown_for_a_word): a command naming one runs nothing, since the
    tracker would write that other item, and so does one that writes an
    item it names otherwise (asked, the ids an update writes). A tracker
    the interface cannot reach is left to answer the command itself; one
    that fails otherwise refuses it. With the refusals come the ids a close
    names, as the tracker reads them, each once, in the order first named,
    whether they stand open or closed.

    And under any: a write of a pour's guard -- an item the command writes
    (asked) that is one, or a need taken off (dropped, each the pair of the
    item that waits and its need) that names one -- since only the pour
    writes it (GUARD_HELD); and a need taken off a calling step on an item
    poured within it, which no write takes off (CALL_NEED_HELD)."""
    out: list[Response] = []
    closing: list[str] = []
    read: dict[str, str | None] = {}
    records: dict[str, Mapping[str, Any]] = dict(every or {})

    def named(word: str) -> str | None:
        """The id a word names, as the tracker reads it; None where it names
        nothing, or the tracker cannot say."""
        if every is not None and word in every:
            return word
        if word in read:
            return read[word]
        asked_of = invoke_tracker("operation.show-item", dict(common, id=word))
        shown = shown_for_a_word(word, asked_of)
        read[word] = None
        if shown is not asked_of:
            out.append(dict(shown, summary="Nothing ran: %s" % shown["summary"]))
            return None
        if shown["status"] == "completed":
            read[word] = str((shown.get("item") or {}).get("id") or word)
            records[read[word] or word] = shown.get("item") or {}
            return read[word]
        if shown.get("reason") not in ("item-not-found",) + TRACKER_CANNOT_ANSWER:
            failed = dict(shown)
            failed["summary"] = "Nothing ran: the tracker could not say what %s names. %s" % (
                word,
                shown["summary"],
            )
            out.append(failed)
        return None

    # The pours not known to be whole, of every item listed: their guards
    # are written by nothing but the pour, and what each holds from closing
    # waits on its guard, whatever that reads as (pours_held). Each guard is
    # read once.
    reads: dict[str, Response] = {}

    def show(ident: str) -> Response:
        if ident not in reads:
            reads[ident] = invoke_tracker("operation.show-item", dict(common, id=ident))
        return reads[ident]

    pours: dict[str, dict[str, Any]] = pours_held(every, show) if every is not None else {}

    def a_guard(ident: str) -> bool:
        """A pour's guard: an item that reads as one, or the guard of a pour
        not known to be whole, whatever it reads as."""
        return (records.get(ident) or {}).get("kind") == "guard" or ident in pours

    for word in asked:
        ident = named(word)
        if ident is not None and a_guard(ident):
            out.append(
                {
                    "status": "blocked",
                    "reason": "blocked",
                    "exitCode": 1,
                    "summary": GUARD_HELD % ident,
                }
            )
    for waiter_word, need_word in dropped:
        waiter, need = named(waiter_word), named(need_word)
        if waiter is None or need is None:
            continue  # the tracker names it no item, and says so
        for ident in (waiter, need):
            if a_guard(ident):
                out.append(
                    {
                        "status": "blocked",
                        "reason": "blocked",
                        "exitCode": 1,
                        "summary": GUARD_HELD % ident,
                    }
                )
        if (records.get(need) or {}).get("within") == waiter:
            out.append(
                {
                    "status": "blocked",
                    "reason": "blocked",
                    "exitCode": 1,
                    "summary": CALL_NEED_HELD % (waiter, need),
                }
            )
    if out:
        return out, closing
    if closing_words is not None and every is not None:
        before = {i: o for i, o in every.items() if o.get("status") != "closed"}
        held = closes_held(pours)
        earlier: set[str] = set()
        for word in closing_words:
            ident = named(word)
            if ident is None:
                continue
            if ident not in every:
                out.append(
                    {
                        "status": "failed",
                        "reason": "adapter-failed",
                        "exitCode": 1,
                        "summary": "Nothing ran: the tracker shows %s, and its list of every "
                        "item leaves it out, so what a close of it waits on could not be read."
                        % ident,
                    }
                )
                continue
            # A guard closes only where it stands open and its pour is known
            # to be whole: the pour's own last write again, the way out of a
            # pour cut short at its guard's close.
            if a_guard(ident) and (
                every[ident].get("status") == "closed" or not known_whole(ident, every)
            ):
                out.append(
                    {
                        "status": "blocked",
                        "reason": "blocked",
                        "exitCode": 1,
                        "summary": GUARD_HELD % ident
                        + (
                            ""
                            if every[ident].get("status") == "closed"
                            else " Its pour is not known to be whole: to finish with it, remove "
                            "its root, its steps and %s outside dotdiw." % ident
                        ),
                    }
                )
                continue
            pour = pours.get(held.get(ident) or "") or {}
            if pour.get("unread") and ident in before:
                out.append(
                    {
                        "status": "failed",
                        "reason": "adapter-failed",
                        "exitCode": 1,
                        "summary": "Nothing ran: %s is held on %s, the guard of a pour not known "
                        "to be whole, which could not be read: %s"
                        % (ident, pour["guard"], pour["unread"]),
                    }
                )
                continue
            if ident in before:
                standing = what_stands_open(ident, before[ident], before, earlier, held)
                if standing:
                    out.append(
                        {
                            "status": "blocked",
                            "reason": "blocked",
                            "blockedBy": standing,
                            "exitCode": 1,
                            "summary": "%s is blocked by %s." % (ident, ", ".join(standing)),
                        }
                    )
                    guard = held.get(ident) or ""
                    if guard in standing:
                        # The way out, said: its guard's close, or the
                        # pour's removal.
                        out.append(
                            {
                                "status": "blocked",
                                "exitCode": 1,
                                "summary": POUR_HELD_WHOLE % (ident, guard, PROG, guard)
                                if known_whole(guard, every)
                                else POUR_HELD % (ident, guard, guard),
                            }
                        )
                earlier.add(ident)
            if ident not in closing:
                closing.append(ident)
        if out:
            return out, closing
    stopped = stopped_here(common) if closing_words else {}
    if holds is not None:
        # What a stopped move holds, for the close to leave open in its wake.
        holds.extend(sorted(stopped))
    if stopped:
        for word in closing_words or []:
            ident = named(word)
            if ident in stopped:
                source, target, again = stopped[ident]
                out.append(
                    {
                        "status": "blocked",
                        "reason": "blocked",
                        "exitCode": 1,
                        "summary": MOVE_UNFINISHED
                        % (ident, source, target, PROG, source, target, again),
                    }
                )
        if out:
            return out, closing

    # Every item, listed once for the edges: what waits on what, and which
    # ids are a pour's guards, which no edge is written to or from.
    listing: list[Any] | None = None
    if edges:
        listed = invoke_tracker("operation.list-items", dict(common, scope="all"))
        if listed["status"] == "completed":
            listing = list(listed.get("items") or [])
            if every is None:
                pours.update(pours_held({i["id"]: i for i in listing}, show))
        elif listed.get("reason") not in TRACKER_CANNOT_ANSWER:
            failed = dict(listed)
            failed["summary"] = (
                "Nothing ran: what waits on what could not be read. %s" % (listed["summary"])
            )
            return [failed], closing

    def waited_on(start: str) -> set[str] | None:
        """Every item the one named waits on before it can close, to any
        depth: its needs, its children, the items poured in its run and
        within it, and its guard; None where the tracker cannot say."""
        if listing is None:
            return None
        under: dict[str, list[str]] = {}
        for i in listing:
            for above in stands_under(i):
                if above:
                    under.setdefault(above, []).append(i["id"])
        seen: set[str] = set()
        todo = [start]
        while todo:
            at = todo.pop()
            shown = shown_by_its_id(at, invoke_tracker("operation.show-item", dict(common, id=at)))
            if shown["status"] != "completed" and shown.get("reason") != "item-not-found":
                if shown.get("reason") not in TRACKER_CANNOT_ANSWER:
                    failed = dict(shown)
                    failed["summary"] = "Nothing ran: what %s waits on could not be read. %s" % (
                        at,
                        shown["summary"],
                    )
                    out.append(failed)
                return None
            item = shown.get("item") or {} if shown["status"] == "completed" else {}
            held = [item["guard"]] if item.get("guard") else []
            for nxt in list(item.get("needs") or []) + under.get(at, []) + held:
                if nxt not in seen:
                    seen.add(nxt)
                    todo.append(nxt)
        return seen

    for waiter_word, item_word, said in edges:
        waiter, item = named(waiter_word), named(item_word)
        if out:
            return out, closing
        if waiter is None or item is None:
            continue  # the tracker names it no item, and says so
        guarded = [i for i in (waiter, item) if a_guard(i)]
        if guarded:
            out.append(
                {
                    "status": "blocked",
                    "reason": "blocked",
                    "exitCode": 1,
                    "summary": GUARD_HELD % guarded[0],
                }
            )
            return out, closing
        waits = waited_on(item)
        if out:
            return out, closing
        if waiter == item or (waits is not None and waiter in waits):
            out.append(
                {
                    "status": "failed",
                    "reason": "cycle",
                    "exitCode": 1,
                    "summary": "%s, which waits on it to close, so neither could close." % said
                    if waiter != item
                    else "%s: an item cannot wait on itself." % said,
                }
            )
    return out, closing


def closes_that_follow(
    common: Request,
    closed: list[str],
    records: Mapping[str, Mapping[str, Any]],
    standing: dict[str, Any] | None,
    keep: Iterable[str] = (),
    held: Mapping[str, str] | None = None,
) -> list[Response]:
    """The closes an item's close leaves due: its poured root, the root of
    the run it was poured in, wherever it stands, and the calling step it
    was poured within, each closed once nothing of it is open, and so on up
    from each of those -- the answers of those closes, as a close inside the
    local adapter makes them. Where the adapter closed one itself it is
    among those closed and is left. With standing, what stands open now, no
    root or calling step still waiting on an item is asked; the adapter
    refuses the rest itself. A root to keep open (keep) -- one a move into
    the tracker made and has not finished, which nothing but the move
    closes -- is left as it is. And so is one a pour not known to be whole
    holds from closing (held, by item: closes_held), while its guard has
    not closed in the same command."""
    answers: list[Response] = []
    done = set(closed)
    known: dict[str, Mapping[str, Any]] = dict(records)
    todo = list(closed)
    while todo:
        ident = todo.pop(0)
        item = known.get(ident)
        if item is None:
            # One the adapter closed in the wake of a close asked here, read
            # for what stands above it.
            shown = shown_by_its_id(
                ident, invoke_tracker("operation.show-item", dict(common, id=ident))
            )
            item = shown.get("item") or {} if shown["status"] == "completed" else {}
        # Above it: its parent, where that is a poured root; the root of its
        # run; the calling step it was poured within; and, of what is read
        # standing, each calling step that needs it, whose last need it may
        # have been. Each once, and taken for a calling step or a run's root
        # where it is one of those as well as the parent.
        reached: dict[str, bool] = {}
        for up, must_be_root in zip(stands_under(item), (True, False, False), strict=True):
            if up:
                reached[str(up)] = reached.get(str(up), True) and must_be_root
        for i, o in (standing or {}).items():
            if o.get("calls") and ident in (o.get("needs") or []):
                reached[i] = False
        above = list(reached.items())
        for up, must_be_root in above:
            if up in done or up in keep:
                continue
            record: Mapping[str, Any] | None
            if standing is not None:
                record = standing.get(up)
                if record is None or what_stands_open(up, record, standing, done, held):
                    continue
            else:
                shown = shown_by_its_id(
                    up, invoke_tracker("operation.show-item", dict(common, id=up))
                )
                if shown["status"] != "completed":
                    if shown.get("reason") != "item-not-found":
                        answers.append(
                            dict(
                                shown,
                                summary="%s, which the close of %s may have left with nothing "
                                "open, could not be read: %s" % (up, ident, shown["summary"]),
                            )
                        )
                    continue
                record = shown.get("item")
                if record is None or record.get("status") == "closed":
                    continue
            if must_be_root and record.get("kind") != "root":
                continue
            if record.get("kind") == "guard":
                continue
            known[up] = record
            shut = invoke_tracker(
                "operation.close-item", dict(common, id=up, closeReason="every step closed")
            )
            if shut["status"] == "blocked" or (
                shut["status"] == "completed" and not shut.get("closedIds")
            ):
                continue
            if shut["status"] != "completed":
                shut = dict(
                    shut,
                    summary="The close of %s, left with nothing open, failed: %s"
                    % (up, shut["summary"]),
                )
            answers.append(shut)
            for c in shut.get("closedIds") or []:
                if standing is not None and c in standing:
                    known.setdefault(c, standing[c])
                if c not in done:
                    done.add(c)
                    todo.append(c)
                if standing is not None:
                    standing.pop(c, None)
    return answers


def what_the_close_closed(
    common: Request,
    named: list[str],
    every: dict[str, TrackerItem],
    marked: Any,
    errored: bool,
    keep: Iterable[str] = (),
) -> tuple[list[str], list[Response]]:
    """What a close the pass-through ran closed, read back from the tracker
    after it ran, and the run rule held of the tracker as it then stands
    (held_to_the_run), given every item as listed before the close, each id
    the close named among them.

    The listing after is every item only where it holds each one listed
    before that the tracker still holds. One it leaves out is asked of the
    tracker by id (shown_by_its_id): where the tracker holds that one no
    more -- another having deleted it as the close ran -- it is no gap;
    otherwise the listing is not every item, nothing can be held to it, and
    the command fails naming each id it named.

    What carries the mark the close ran under is what it closed -- each id it
    named, in the order named, then a root the tracker closed of its own
    accord as that close ran -- and nothing else, whoever else is writing.
    What stood closed before the command is no close of its, whatever
    session the tracker now keeps on it: an update to the closed status
    writes its own over the first close's.

    Where the marks cannot be read back, nothing is known to be this
    close's: the rule is held all the same, nothing is logged or followed,
    and the command fails naming each id it named. An id it named that
    stood open before and that the tracker holds no more is not read back
    either: nothing of it is logged, and the command fails naming it, the
    other closes standing. And where the tracker's command ended without an
    error (errored says whether it did), an id it named that stood open
    before and stands open after was not closed by it, and the command
    fails saying so. Then the roots its closes left with nothing open
    are closed, after them. The ids closed, and the answers to show after
    the tracker's own output."""

    def unread(ident: str, why: str) -> Response:
        return {
            "status": "failed",
            "reason": "adapter-failed",
            "exitCode": 1,
            "summary": "%s could not be read back after the close, so whether this command "
            "closed it, and after what it waits on, is not known; nothing of it is logged: %s"
            % (ident, why),
        }

    listed = invoke_tracker("operation.list-items", dict(common, scope="all"))
    if listed["status"] != "completed":
        return [], [unread(ident, listed["summary"]) for ident in named]
    now: dict[str, Any] = {i["id"]: i for i in listed.get("items") or []}
    for absent in [i for i in every if i not in now]:
        shown = shown_by_its_id(
            absent, invoke_tracker("operation.show-item", dict(common, id=absent))
        )
        if shown.get("reason") != "item-not-found":
            why = "the tracker's list of every item leaves out %s, which it listed before." % absent
            return [], [unread(ident, why) for ident in named]
    before = {i: o for i, o in every.items() if o.get("status") != "closed"}
    shut: list[str] = []
    if isinstance(marked, list):
        shut = [i for i in named if i in marked and i in now and i in before]
        shut += [i for i in marked if i not in named and i in now and i in before]

    def reopen(ident: str, status: str) -> str | None:
        back = invoke_tracker("operation.update-item", dict(common, id=ident, status=status))
        return None if back["status"] == "completed" else str(back["summary"])

    # The pours not known to be whole, as the items stand after the close.
    pours = pours_held(now, lambda g: invoke_tracker("operation.show-item", dict(common, id=g)))
    held = closes_held(pours)
    shut, notes, standing = held_to_the_run(named, shut, before, now, reopen, keep, held)
    if not isinstance(marked, list):
        why = "the tracker did not say which closes were this command's."
        return [], notes + [unread(ident, why) for ident in named]
    notes += [
        unread(ident, "the tracker holds it no more.")
        for ident in named
        if ident in before and ident not in now
    ]
    if not errored:
        notes += [
            {
                "status": "failed",
                "reason": "adapter-failed",
                "exitCode": 1,
                "summary": "The tracker answered the close without an error, and %s stands open."
                % ident,
            }
            for ident in named
            if ident in before and ident in now and now[ident].get("status") != "closed"
        ]
    follows = closes_that_follow(common, shut, {**before, **now}, standing, keep, held)
    closed = list(shut)
    for answer in follows:
        if answer["status"] == "completed":
            closed += [c for c in answer.get("closedIds") or [] if c not in closed]
            answer = dict(
                answer,
                summary="Closed %s: every step of it closed."
                % ", ".join(answer.get("closedIds") or []),
            )
        notes.append(answer)
    return closed, notes


def RunATrackerCommand(request: RunATrackerCommandRequest) -> RunATrackerCommandResponse:
    """journey.run-a-tracker-command: forward, with what rides along on cook, doctor, lint
    and remember. What the command answered comes back for a caller that
    reads it rather than a terminal: the records, each with its ETag, the
    ids closed, the tracker's own output where no terminal saw it, and why
    nothing was done, a write's ETags that no longer match among it."""
    root, argv = request["root"], list(request.get("arguments") or [])
    # `cook <id>` means that formula's file, wherever in the tree it sits.
    if argv and argv[0] == "cook" and len(argv) > 1 and not argv[1].startswith("-"):
        r = invoke("operation.resolve-formula", {"root": root, "ident": argv[1]})
        if r["status"] == "completed" and not os.path.exists(argv[1]):
            argv = ["cook", os.path.join(root, r["path"])] + argv[2:]
    fwd = invoke(
        "operation.forward-to-the-tracker",
        {
            "root": root,
            "arguments": argv,
            "tracker": request.get("tracker"),
            "etags": request.get("etags"),
            "terminal": request.get("terminal"),
        },
    )
    # The conventions, checked where someone actually looks. Nobody in the
    # trial ran `check` or `learn`; they ran these two.
    if argv and argv[0] in ("doctor", "lint"):
        invoke(
            "operation.describe-and-check",
            {"root": root, "mode": "doctor", "tracker": request.get("tracker")},
        )
    if argv and argv[0] == "remember" and fwd["exitCode"] == 0:
        invoke("operation.nudge-towards-a-formula", {"root": root, "text": " ".join(argv[1:])})
    out: RunATrackerCommandResponse = {
        "status": fwd["status"],
        "summary": fwd["summary"],
        "exitCode": fwd["exitCode"],
        "items": list(fwd.get("items") or []),
        "closedRefs": list(fwd.get("closedRefs") or []),
        "output": "" if fwd.get("printed") else fwd.get("output") or "",
    }
    if fwd.get("reason"):
        out["reason"] = fwd["reason"]
    return out


