            "\n%s turned the tracker's anonymous usage metrics off, for every\n"
            "    repository on this machine: %s, metrics.disabled: true.\n"
            "    It does this on every run. What would have been sent: %s metrics example\n\n"
            % (PROG, response.get("path"), PROG)
        )


def show_undo(request: Request, response: Response) -> None:
    if response["status"] in ("blocked", "failed"):
        sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))
        return
    done, made = response["undone"], response.get("adopted")
    if not (done or made):
        return
    out = sys.stderr
    out.write("\n%s put right what an earlier version of it left here:\n" % PROG)
    for line in done:
        out.write("    %s\n" % line)
    if made:
        out.write(
            "    the tracker now lives at %s, under your home, keyed to\n"
            "    this checkout; earlier tasks are not carried over. The .beads in\n"
            "    the tree is unused -- remove it when convenient:\n"
            "        %s\n" % (made, response.get("command"))
        )
    if response.get("hooksReplaced"):
        out.write(
            "\n    Nothing was deleted and no history was rewritten. Hooks\n"
            "    that existed when this repository was adopted went on\n"
            "    running. Any hook added after that was skipped until now,\n"
            "    so commits made in between did not see it.\n\n"
        )
    else:
        out.write("\n    Nothing was deleted and no history was rewritten.\n\n")


def show_declare(request: Request, response: Response) -> None:
    renamed, declared = response["renamed"], response["declared"]
    if request.get("announce") == "init":
        if renamed:
            n = len(renamed)
            print(
                "\n✓ %d agent instruction file%s now name%s %s:"
                % (n, "" if n == 1 else "s", "s" if n == 1 else "", PROG)
            )
            for rel in renamed:
                print("    %s" % rel)
        if declared:
            print("\n✓ Declared where work starts, in %s." % " and ".join(declared))
            print("    Whoever shows up reads it there, human or agent.")
    elif request.get("announce") == "create" and renamed:
        n = len(renamed)
        print(
            "\n(%d agent instruction file%s the tracker rewrote now name%s %s)"
            % (n, "" if n == 1 else "s", "s" if n == 1 else "", PROG),
            file=sys.stderr,
        )


def show_report(request: Request, response: Response) -> None:
    yours = response["yours"]
    if yours:
        print(
            "\n\u26a0 %s wrote the project's declaration of where work starts into"
            " these files.\n  They are yours to commit, so that every clone reads it:" % PROG
        )
        for rel in yours:
