def present(operation: str, request: Request, response: Response) -> None:
    """What the worker sees of a response, as its operation returns."""
    shown = SHOW.get(operation)
    if shown is not None:
        shown(request, response)


# The flags of dotdiw's own commands: what each takes a value for, by the
# field of the request it fills, and what each takes alone.
CREATE_VALUES = {
    "-p": "priority",
    "--priority": "priority",
    "--parent": "parent",
    "-d": "description",
    "--description": "description",
}
CREATE_SWITCHES = {"--json": "json", "-q": "quiet", "--quiet": "quiet", "--silent": "quiet"}
CREATE_USAGE = "%s create <title> [-p <0-4>] [--parent <id>] [-d <description>] [--json] [-q]"
POUR_USAGE = "%s formula pour <formula> [--json]"
CLAIM_USAGE = "%s claim <id> [label: value ...] [--json]"
INIT_USAGE = "%s init [--tracker <name>] [--prefix <prefix>]"
# What --help says of each command dotdiw parses itself: its usage and what it
# does. Every other command is the tracker's, and the tracker's help answers.
HELP = {
    "create": (CREATE_USAGE, "Create an item, and see the procedures that may apply to it."),
    "claim": (
        CLAIM_USAGE,
        "Record what a claimed step found, as label: value lines from the arguments or "
        "standard input, and read the run back with its claims and means filled in.",
    ),
    "formula pour": (
        POUR_USAGE,
        "Pour a formula as tracked, ordered steps; each claimed step says how to record it.",
    ),
    "mol pour": (
        POUR_USAGE,
        "Pour a formula as tracked, ordered steps; each claimed step says how to record it.",
    ),
    "init": (INIT_USAGE, "Adopt this repository, or put right what an earlier version left."),
    "check": ("%s check", "Check that every formula here can be found and the conventions held."),
}


def own_flags(
    args: list[str], values: dict[str, str], switches: dict[str, str], positionals: int
) -> tuple[dict[str, Any], list[str], str | None]:
    """The fields a command's own flags fill, its positional words, and what
    it refused, said as a clause, if anything: a flag outside its own, a flag
    with no value after it -- another flag where its value belongs counts as
    none, and --name=value gives a value that starts with a dash -- or a word
    beyond the positionals it takes."""
    fields: dict[str, Any] = {}
    words: list[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        flag, eq, value = a.partition("=") if a.startswith("--") else (a, "", "")
        if flag in values:
            if not eq:
                if i + 1 >= len(args) or args[i + 1].startswith("-") and args[i + 1] != "-":
                    return fields, words, "%s needs a value" % a
                i += 1
                value = args[i]
            fields[values[flag]] = value
        elif a in switches:
            fields[switches[a]] = True
        elif a.startswith("-") and a != "-":
            return fields, words, "%s is not one of its flags" % a
        elif len(words) >= positionals:
            return fields, words, "%s is one word too many; quote words that go together" % a
        else:
            words.append(a)
        i += 1
    return fields, words, None


def extract_tracker(argv: list[str]) -> tuple[str | None, list[str], bool]:
    """The adapter the worker named: --tracker <name> or --tracker=<name>
    anywhere, taken out of the arguments, else DOTDIW_TRACKER, else None --
    the workspace's choice and the default are the door's to apply; and
    whether --tracker was given with no name, which nothing may run on."""
    name, rest, i, missing = None, [], 0, False
    while i < len(argv):
        a = argv[i]
        if a == "--tracker":
            given = argv[i + 1] if i + 1 < len(argv) else ""
            if not given or given.startswith("-"):
                missing = True
                i += 1
                continue
            name = given
            i += 2
            continue
        if a.startswith("--tracker="):
            name = a[len("--tracker=") :]
            missing = missing or not name
        else:
            rest.append(a)
        i += 1
    return name or os.environ.get("DOTDIW_TRACKER") or None, rest, missing


def main() -> int:
    global PRESENTER
    PRESENTER = present
    tracker, argv, missing = extract_tracker(sys.argv[1:])
    if missing:
        sys.stderr.write("%s: --tracker needs a value, as --tracker <name>.\n" % PROG)
        return 2
    root = repo_root()

    # Before any tracker command, --version included: while the tracker's
    # metrics are on, it queues an event for every command it runs.
    invoke("operation.turn-metrics-off", {"root": root, "tracker": tracker})

    if not argv or argv[0] == "learn":
        return int(invoke("operation.learn-the-conventions", {})["exitCode"])
    helped = HELP.get(" ".join(argv[:2])) or HELP.get(argv[0])
    if helped and ("--help" in argv[1:] or "-h" in argv[1:]):
        print(helped[0] % PROG)
        print("\n%s" % helped[1])
        return 0
    if argv[0] in ("--version", "-V", "version") and len(argv) == 1:
        print("%s %s" % (PROG, VERSION))
        described = invoke_tracker("operation.describe-tracker", {"root": root, "tracker": tracker})
        info = described.get("info") or {}
        if described["status"] == "completed" and info.get("version"):
            print("  tracker %s %s" % (info.get("name"), info["version"]))
        return 0
    # What an earlier version left -- a hook override, a tracker in the tree,
    # a workspace with no tracker chosen -- is init's to put right. Every
    # other command asks first and is refused, in one line, while it is left.
    if argv[0] != "init":
        left = invoke("operation.undo-earlier-adoption", {"root": root, "tracker": tracker})
        if left["exitCode"] != 0:
            return int(left["exitCode"])

    # The workspace this checkout is keyed to, when a tracker was opened in it.
    ws = workspace(root) if checkout_adopted(root) else None

    # The command line's binding of record-what-a-step-found: lines from the
    # arguments, or from standard input when there are none.
    if argv[0] == "claim":
        as_json = "--json" in argv[1:]
        words = [a for a in argv[1:] if a != "--json"]
        if not words or words[0].startswith("-"):
            sys.stderr.write("%s: claim: name a step. %s\n" % (PROG, CLAIM_USAGE % PROG))
            return 2
        lines = words[1:]
        if not lines and not sys.stdin.isatty():
            lines = sys.stdin.read().splitlines()
        # Each line splits at its first colon, the value trimmed; any other
        # line refuses the whole input.
        values: list[ClaimValue] = []
        bad: list[str] = []
        for line in lines:
            label, colon, text = line.partition(":")
            if colon and CLAIM_LABEL.match(label.strip()):
                values.append({"label": label.strip(), "text": text.strip()})
            elif line.strip():
                bad.append(line)
        if bad:
            sys.stderr.write(
                "%s: claim: not a label: value line, so nothing was recorded: %s\n"
                % (PROG, "; ".join(repr(b) for b in bad))
            )
            return 2
        return int(
            invoke(
                "operation.record-what-a-step-found",
                {
                    "root": root,
                    "tracker": tracker,
                    "id": words[0],
                    "values": values,
                    "json": as_json,
                },
            )["exitCode"]
        )

    if argv[0] == "check":
        return int(
            invoke(
                "operation.describe-and-check", {"root": root, "mode": "check", "tracker": tracker}
            )["exitCode"]
        )

    if argv[0] == "init":
        fields, _, refused = own_flags(argv[1:], {"-p": "prefix", "--prefix": "prefix"}, {}, 0)
        if refused is not None:
            sys.stderr.write("%s: init: %s. %s\n" % (PROG, refused, INIT_USAGE % PROG))
            return 2
        return int(
            invoke(
                "operation.adopt-a-repository",
                {"root": root, "prefix": fields.get("prefix"), "tracker": tracker},
            )["exitCode"]
        )

    # The tracker chosen, in the open: which adapters there are, which this
    # checkout uses, whether one keeps to the interface, and the move.
    if argv[0] == "tracker":
        action = argv[1] if len(argv) > 1 else ""
        names = [a for a in argv[2:] if not a.startswith("-")]
        if action == "new":
            rest, at, name, i = argv[2:], None, None, 0
            while i < len(rest):
                a = rest[i]
                if a.startswith("--at="):
                    at = a[5:]
                elif a == "--at":
                    i += 1
                    at = rest[i] if i < len(rest) else ""
                elif not a.startswith("-") and name is None:
                    name = a
                i += 1
            if name and at != "":
                return int(
                    invoke("operation.ship-a-tracker", {"name": name, "directory": at})["exitCode"]
                )
        if action == "migrate" and len(names) == 2:
            return int(
                invoke(
                    "operation.move-a-workspace",
                    {"root": root, "fromTracker": names[0], "toTracker": names[1]},
                )["exitCode"]
            )
        if (
            action == "check"
            and len(names) == 1
            and (os.sep in names[0] or names[0].endswith(".py"))
        ):
            return int(
                invoke(
                    "operation.choose-a-tracker",
                    {
                        "root": root,
                        "action": action,
                        "name": os.path.splitext(os.path.basename(names[0]))[0],
                        "path": os.path.abspath(names[0]),
                    },
                )["exitCode"]
            )
        if action == "list" or (action in ("use", "check") and len(names) == 1):
            return int(
                invoke(
                    "operation.choose-a-tracker",
                    {"root": root, "action": action, "name": names[0] if names else None},
                )["exitCode"]
            )
        sys.stderr.write(
            "%s tracker list | use <name> | check <name or path> | new <name> | "
            "migrate <from> <to>\n" % PROG
        )
        return 2

    # These questions are about the project. bd answers them about its own
    # two search paths, and in a project whose formulas sit next to what they
    # are about its answer is "No formulas found". They need no tracker.
    if argv[0] == "formula" and len(argv) > 1 and argv[1] == "new":
        rest, at, frm, title, i = argv[2:], None, None, "", 0
        while i < len(rest):
            a = rest[i]
            if a.startswith("--at="):
                at = a[5:]
            elif a.startswith("--from="):
                frm = a[7:]
            elif a in ("--at", "--from"):
                i += 1
                value = rest[i] if i < len(rest) else ""
                at, frm = (value, frm) if a == "--at" else (at, value)
            elif not a.startswith("-") and not title:
                title = a
            i += 1
        if at == "" or frm == "":
            title = ""  # says how it is used, as no title does
        return int(
            invoke(
                "operation.write-formula",
                {"root": root, "title": title, "directory": at, "fromRef": frm, "tracker": tracker},
            )["exitCode"]
        )

    if argv[:2] == ["formula", "provider"]:
        given = argv[3:]
        at = None
        if "--at" in given:
            k = given.index("--at")
            at = given[k + 1] if k + 1 < len(given) else ""
            given = given[:k] + given[k + 2 :]
        action = argv[2] if len(argv) > 2 else ""
        if action == "register" and len(given) == 2:
            asked = {"action": "register", "name": given[0], "module": given[1], "location": at}
        elif action == "list" and not given and at is None:
            asked = {"action": "list"}
        elif action == "remove" and len(given) == 1 and at is None:
            asked = {"action": "remove", "name": given[0]}
        else:
            sys.stderr.write(
                "usage: %s formula provider register <name> <module> [--at <location>] "
                "| list | remove <name>\n" % PROG
            )
            return 2
        answered = invoke("operation.answer-through-a-formula-provider", {"root": root, **asked})
        return int(answered["exitCode"])

    if argv[0] == "formula" and len(argv) > 1:
        plain = [a for a in argv[2:] if not a.startswith("-")]
        flags = [a for a in argv[2:] if a.startswith("-")]
        if argv[1] == "list" and not [g for g in flags if g != "--json"]:
            listed = invoke("operation.list-formulas", {"root": root, "json": "--json" in flags})
            return int(listed["exitCode"])
        if argv[1] == "show" and len(plain) == 1 and not flags:
            shown = invoke("operation.show-formula", {"root": root, "ident": plain[0]})
            # Only an id that names no formula at all is the tracker's to answer.
            if shown["status"] != "blocked" or shown.get("reason") != "formula-not-found":
                return int(shown["exitCode"])

    if ws is None:
        # The tracker's own error would name a store that is not supposed to
        # exist; one sentence is better.
        sys.stderr.write(
            "%s: this repository is not adopted. Run %s init once; it is "
            "local and commits nothing.\n" % (PROG, PROG)
        )
        return 1

    # Pour from where the formula lives, instead of requiring it be moved there.
    # formula pour is what dotdiw teaches; mol pour is the older spelling of it.
    if argv[:2] == ["formula", "pour"] and (len(argv) < 3 or argv[2].startswith("-")):
        sys.stderr.write("%s formula pour <formula>\n" % PROG)
        return 2

    if len(argv) > 2 and argv[1] == "pour" and argv[0] in ("formula", "mol"):
        fields, _, refused = own_flags(argv[3:], {}, {"--json": "json"}, 0)
        if refused is not None:
            sys.stderr.write("%s: formula pour: %s. %s\n" % (PROG, refused, POUR_USAGE % PROG))
            return 2
        return int(
            invoke(
                "operation.pour-procedure",
                {
                    "root": root,
                    "ident": argv[2],
                    "json": bool(fields.get("json")),
                    "tracker": tracker,
                },
            )["exitCode"]
        )

    if argv[0] != "create":
        return int(
            invoke(
                "operation.run-a-tracker-command",
                {"root": root, "arguments": argv, "tracker": tracker},
            )["exitCode"]
        )

    fields, words, refused = own_flags(argv[1:], CREATE_VALUES, CREATE_SWITCHES, 1)
    number = re.fullmatch(r"[Pp]?([0-4])", str(fields.get("priority", "2")))
    if refused is not None or not words or not number:
        said = refused or (
            "a title is needed" if not words else "the priority is 0 to 4, as 2 or P2"
        )
        sys.stderr.write("%s: create: %s. %s\n" % (PROG, said, CREATE_USAGE % PROG))
        return 2
    if "priority" in fields:
        fields["priority"] = int(number.group(1))
    json_out, quiet = bool(fields.pop("json", False)), bool(fields.pop("quiet", False))
    return int(
        invoke(
            "operation.start-named-work",
            dict(
                fields,
                root=root,
                title=words[0],
                json=json_out,
                quiet=quiet or json_out or bool(os.environ.get("DOTDIW_NO_HINTS")),
                tracker=tracker,
            ),
        )["exitCode"]
    )


if __name__ == "__main__":
    sys.exit(main() or 0)
