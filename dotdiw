def beads_update(request: UpdateItemRequest) -> UpdateItemResponse:
    """operation.update-item: bd update; a close is close-item's, not this."""
    if not beads_find():
        return failed_as(UpdateItemResponse, *BEADS_NOT_INSTALLED)
    if request.get("status") == "closed":
        return {
            "status": "failed",
            "reason": "close-through-update",
            "exitCode": 1,
            "summary": "Closing is close-item's, with a reason.",
        }
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(UpdateItemResponse, *BEADS_NO_WORKSPACE)
    argv = ["update", request["id"], "--json"]
    given: Mapping[str, Any] = request
    flags: list[str] = []
    for key, flag in (
        ("title", "--title"),
        ("status", "-s"),
        ("priority", "-p"),
        ("parent", "--parent"),
        ("assignee", "-a"),
    ):
        if given.get(key) is not None:
            flags += [flag, str(given[key])]
    argv += beads_typed(flags, root)[0]
    code, out, err = beads_quiet(argv, root)
    rows = beads_json(out) if code == 0 else []
    if not rows:
        return beads_failed(
            UpdateItemResponse,
            out,
            err,
            [("item-not-found", BEADS_NOT_FOUND), ("bad-status", ("invalid status",))],
        )
    return {
        "status": "completed",
        "summary": "Updated %s." % request["id"],
        "item": beads_record(rows[0]),
        "exitCode": 0,
    }


