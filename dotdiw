SCAFFOLD = """# Fill in the description and the steps, then: %(p)s check
# The description is the mechanism and not a label on one -- it is all that
# stands between what someone calls their work and this procedure. Name the
# situation and say when to reach for it, in the words people use for the work.
formula = "mol-%(slug)s"
description = "TODO -- %(title)s. Replace this with a sentence naming the \
situation this covers and when someone should use it."
examples = [
%(examples)s]
version = 1
type = "workflow"

%(steps)s"""

STEP = '''[[steps]]
id = "%(id)s"
title = "%(title)s"
'''

PLACEHOLDER_STEPS = '''[[steps]]
id = "first"
title = "TODO -- the first thing you do"

[[steps]]
id = "second"
title = "TODO -- the next thing, and so on"
needs = ["first"]
'''


def slug(title, limit=4):
    words = [w for w in re.findall(r"[a-z0-9]+", title.lower())
             if len(w) >= 2 and w not in STOP]
    return "-".join(words[:limit]) or "procedure"


def steps_from(ident, limit=300):
    """An issue's children as steps, with its blocks edges as `needs`.

    The highest-fidelity capture there is: the procedure as it was actually
    carried out, rather than as someone remembers it afterwards.
    """
    code, out = bd_quiet(["list", "--all", "--json", "--brief",
                          "-n", str(limit)])
    if code != 0:
        return None
    try:
        rows = json.loads(out)
    except (ValueError, TypeError):
        return None
    byid = {r.get("id"): r for r in rows if isinstance(r, dict)}
    hit = [i for i in byid if i == ident or str(i).endswith("-" + ident)]
    if len(hit) != 1:
        return None
    parent = hit[0]
    kids = [r for r in rows if r.get("parent") == parent]
    if not kids:
        return None
    ids, used = {}, set()
    for r in kids:
        sid, k = slug(str(r.get("title") or ""), 3), 1
        while sid in used:
            k += 1
            sid = "%s-%d" % (slug(str(r.get("title") or ""), 3), k)
        used.add(sid)
        ids[r.get("id")] = sid
    needs = {}
    for r in kids:
        needs[ids[r["id"]]] = [ids[d.get("depends_on_id")]
                               for d in (r.get("dependencies") or [])
                               if d.get("type") == "blocks"
                               and d.get("depends_on_id") in ids]
    # In the order the work was done, not the order the tracker lists it: a
    # formula is read top to bottom by whoever has to follow it.
    order, left = [], [ids[r["id"]] for r in kids]
    while left:
        ready = [x for x in left if all(d in order for d in needs[x])]
        if not ready:                       # a cycle; keep what is left as-is
            order.extend(left)
            break
        order.extend(ready)
        left = [x for x in left if x not in ready]
    titles = {ids[r["id"]]: str(r.get("title") or "").replace('"', "'")
              for r in kids}
    out = []
    for sid in order:
        block = STEP % {"id": sid, "title": titles[sid]}
        if needs[sid]:
            block += "needs = [%s]\n" % ", ".join('"%s"' % x for x in needs[sid])
        out.append(block)
    return "\n".join(out)


def cmd_formula_new(root, title, at=None, frm=None):
    """Write a formula for work the project keeps doing.

    The expensive part of declaring a procedure was never the thinking, it was
    the TOML: fifteen agents in the trial wrote the procedure down as prose
    instead, where nothing can match it against a title or pour it into steps.
    This writes the file, seeds the examples from the titles the work has
    actually been given here, and leaves the thinking marked TODO.
    """
    if not title:
        sys.stderr.write("%s formula new \"<what the procedure is for>\"\n"
                         % PROG)
        return 2
    forms = load_formulas(root)
    idx = Index(forms, background(root))
    cases = [title]
    for _, t in Titles(past_titles(root), idx).echoes(title):
        if t not in cases:
            cases.append(t)
    steps = (frm and steps_from(frm)) or PLACEHOLDER_STEPS
    name = slug(title)
    path = os.path.join(at or os.getcwd(), name + ".formula.toml")
    if os.path.exists(path):
        sys.stderr.write("%s already exists\n" % os.path.relpath(path, root))
        return 1
    body = SCAFFOLD % {
        "p": PROG, "slug": name, "title": title.replace('"', "'"),
        "examples": "".join('  "%s",\n' % c.replace('"', "'") for c in cases),
        "steps": steps,
    }
    try:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(body)
    except OSError as e:
        sys.stderr.write("%s: %s\n" % (path, e))
        return 1
    rel = os.path.relpath(path, root)
    print("\u2713 Wrote %s" % rel)
    if len(cases) > 1:
        print("  Seeded %d example titles from work already named here."
              % len(cases))
    done = frm and steps is not PLACEHOLDER_STEPS
    if done:
        print("  Steps taken from %s, in the order the work was done." % frm)
    if done:
        print("\n  One thing left, and it is discoverable:")
        print("    the description   the situation, and when to reach for it")
    else:
        print("\n  Two things left, and it is discoverable:")
        print("    the description   the situation, and when to reach for it")
        print("    the steps         what you do, and which step needs which")
    print("\n  Then:  git add %s && git commit" % rel)
    print("         %s check" % PROG)
    return 0


def cmd_formula_show(root, f):
    """The formula as it is written, from where it is written."""
    try:
        with open(os.path.join(root, f["rel"]), encoding="utf-8") as fh:
            sys.stdout.write(fh.read())
    except OSError as e:
        sys.stderr.write("%s: %s\n" % (f["rel"], e))
        return 1
    return 0


def ensure_cooked(root, f):
    """Cook a formula from where it actually lives, every time.

    bd pours only what it has cooked, and cooks only from its own directories.
    Cooking by path closes that gap, so a formula never has to be moved or
    linked out of the place it belongs.

    Unconditionally, and with --force, because the file is the formula. Cooking
    only when bd had never heard of the id meant that a formula edited in place
    poured the version bd happened to hold -- found by editing this project's
    own commit formula and watching `mol pour` instantiate the step that edit
    had just removed. A procedure that gets edited in place is the convention;
    silently pouring its previous version defeats it.
    """
    path = os.path.join(root, f["rel"])
    code, _ = bd_quiet(["cook", path, "--persist", "--force"])
    if code == 0:
        return True
    # Older bd without --force on cook: the stale proto is better than none.
    code, _ = bd_quiet(["cook", path, "--persist"])
    return code == 0 or bd_knows(f["id"])


# ------------------------------------------------------- the create moment

# bd create flags that consume the next argument, so it is never the title.
VALUE_FLAGS = {
    "-d", "--description", "-p", "--priority", "-t", "--type", "-a", "--assignee",
    "-l", "--label", "--labels", "--design", "--acceptance", "--notes", "--parent",
    "--estimate", "--status", "--due", "--repo", "--db", "--actor", "--external-id",
}


def extract_query(argv):
    """Title plus -d description, from a `create ...` argument list."""
    title, desc, skip = "", "", False
    for i, a in enumerate(argv):
        if skip:
            skip = False
            continue
        if a == "create":
            continue
        if a.startswith("--") and "=" in a:
            k, v = a.split("=", 1)
            if k in ("-d", "--description"):
                desc = v
            continue
        if a.startswith("-"):
            if a in VALUE_FLAGS:
                skip = True
                if a in ("-d", "--description") and i + 1 < len(argv):
                    desc = argv[i + 1]
            continue
        if not title:
            title = a
    return title, desc


def suggest(argv, root, idx):
    """The procedures that apply. Returns whether any did."""
    title, desc = extract_query(argv)
    if not title:
        return False
    ranked = idx.search(title + " " + desc)
    if not ranked:
        return False
    seen, top = set(), []
    for score, f in ranked:
        if f["name"] in seen:
            continue
        seen.add(f["name"])
        top.append((score, f))
        if len(top) == TOP_N:
            break
    w = max(len(f["name"]) for _, f in top)
    print("\n\U0001f4dc Formulas that may apply:", file=sys.stderr)
    for _, f in top:
        d = " ".join(f["desc"].split())
        if len(d) > 74 - w:
            d = d[:73 - w] + "…"
        print("  %-*s  %s" % (w, f["name"], d), file=sys.stderr)
        print("  %-*s  %s" % (w, "", f["rel"]), file=sys.stderr)
    f = top[0][1]
    # One command. It used to print `cook --persist && mol wisp create`, whose
    # wisp is ephemeral and never synced via git -- which is management and
    # sharing both given up. `mol pour` is the durable one, and it now cooks
    # from the formula's own path first.
    print("  Run it: %s mol pour %s" % (PROG, f["id"]), file=sys.stderr)
    return True


def handmade(root, limit=300):
    """Procedures this project carried out but never declared.

    Pouring a formula leaves a molecule behind. A parent that is not a molecule,
    with several ordered children, is that same shape built by hand: the
    procedure exists, in the tracker, where nothing can match it against a
    title or pour it a second time. Unlike a guess at what two titles have in
    common, this cannot misfire -- the DAG is either there or it is not.
    """
    code, out = bd_quiet(["list", "--all", "--json", "--brief",
                          "-n", str(limit)])
    if code != 0:
        return []
    try:
        rows = json.loads(out)
    except (ValueError, TypeError):
        return []
    byid, kids = {}, {}
    for r in rows:
        if not isinstance(r, dict):
            continue
        byid[r.get("id")] = r
        if r.get("parent"):
            kids.setdefault(r["parent"], []).append(r)
    found = []
    for pid, ks in sorted(kids.items(), key=lambda kv: -len(kv[1])):
        p = byid.get(pid) or {}
        if p.get("issue_type") in ("molecule", "epic"):
            continue
        if len(ks) < HANDMADE_STEPS:
            continue
        if not any(d.get("type") == "blocks"
                   for k in ks for d in (k.get("dependencies") or [])):
            continue
        found.append((pid, " ".join(str(p.get("title") or "").split()), len(ks)))
    return found


def note_handmade(root, idx):
    """Name the procedures the project has run by hand and not written down.

    Suppressed once a formula reaches the title, which is what writing it down
    means -- so this stops the moment it is acted on, and `--from` turns the
    work that was actually done into the steps.
    """
    found = [t for t in handmade(root) if not idx.search(t[1])]
    if not found:
        return
    sys.stdout.flush()
    print("\n\U0001f4dc %d procedure%s carried out here, never declared:"
          % (len(found), "" if len(found) == 1 else "s"), file=sys.stderr)
    for pid, title, k in found[:TOP_N]:
        print("    %s  (%d ordered steps, built by hand)" % (title or pid, k),
              file=sys.stderr)
        print("      %s formula new \"%s\" --from %s" % (PROG, title, pid),
              file=sys.stderr)
    if len(found) > TOP_N:
        print("    ... and %d more" % (len(found) - TOP_N), file=sys.stderr)


# ------------------------------------------------------------- enforcement

def problems(root, forms, idx):
    """The two conventions, checked rather than hoped for."""
    out = []

    # Only once the project has adopted any of this: a plain repo is not in
    # breach of a convention it has never declared.
    if os.path.isdir(os.path.join(root, ".beads")):
        for rel in undeclared(root):
            out.append((rel, "does not say where work starts -- run `%s init`"
                        % PROG))

    extra = []
    for rel in untracked_formulas(root):
        out.append((rel, "not committed, so nobody else can see it"))
        f = load_formula(root, rel)
        if f:
            extra.append(f)

    home = os.path.expanduser("~/.beads/formulas")
    for p in sorted(glob.glob(os.path.join(home, "*.toml"))
                    + glob.glob(os.path.join(home, "*.json"))):
        out.append((p, "outside the repo: bd finds it, nobody else does"))

    for f in forms + extra:
        n = len(f["desc"].split())
        if n < MIN_DESC_WORDS:
            out.append((f["rel"], "description is %d word%s -- write a sentence "
                                  "naming the situation, and when to use it"
                        % (n, "" if n == 1 else "s")))
        try:
            with open(os.path.join(root, f["rel"]), encoding="utf-8") as fh:
                if "TODO" in fh.read():
                    out.append((f["rel"], "still has TODO in it -- a scaffold "
                                          "is not yet a procedure"))
        except OSError:
            pass
        if len(f["examples"]) < MIN_EXAMPLES:
            out.append((f["rel"], "has %d example title%s, needs %d"
                        % (len(f["examples"]),
                           "" if len(f["examples"]) == 1 else "s", MIN_EXAMPLES)))

    for i, f in enumerate(forms):
        for j, ex in enumerate(f["examples"]):
            ranked = idx.search_without_example(i, j, ex)
            top = [g["name"] for _, g in ranked[:TOP_N]]
            if f["name"] not in top:
                out.append((f["rel"], 'example "%s" does not retrieve it' % ex))

    return out


def print_problems(probs, limit=None):
    shown = probs if limit is None else probs[:limit]
    w = max(len(p[0]) for p in shown)
    for where, what in shown:
        print("  %-*s  %s" % (w, where, what), file=sys.stderr)
    extra = len(probs) - len(shown)
    if extra > 0:
        print("  ... and %d more. See them all: %s check" % (extra, PROG),
              file=sys.stderr)


def cmd_check():
    root = repo_root()
    forms = load_formulas(root)
    idx = Index(forms, background(root))
    probs = problems(root, forms, idx)
    if not forms and not probs:
        print("No formulas yet. %s learn says how to write one." % PROG)
        note_handmade(root, idx)
        return 0
    if not probs:
        print("✓ %d formula%s, all discoverable."
              % (len(forms), "" if len(forms) == 1 else "s"))
        note_handmade(root, idx)
        return 0
    print("%d problem%s:" % (len(probs), "" if len(probs) == 1 else "s"),
          file=sys.stderr)
    print_problems(probs)
    note_handmade(root, idx)
    return 1


