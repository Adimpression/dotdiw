# any checkout, answering list and show -- the reference for writing others.
def directory_store(location: str | None) -> str:
    """The directory a store is; raised when it is not there, so that a store
    that is gone leaves the provider out in one line instead of answering
    nothing."""
    if not location or not os.path.isdir(location):
        raise RuntimeError(
            "its store is unavailable: no directory at %s" % (location or "no location")
        )
    return location


def directory_describe(request: dict[str, Any]) -> dict[str, Any]:
    """The directory provider answers list and show, for a directory that is
    there, recorded by its absolute path so that it names one store from every
    directory dotdiw runs in."""
    location = request.get("location")
    absolute = os.path.abspath(os.path.expanduser(location)) if location else None
    return {"answers": ["list", "show"], "location": directory_store(absolute)}


def directory_list(request: dict[str, Any]) -> dict[str, Any]:
    """Every formula in the directory: its id, description and examples."""
    store = directory_store(request.get("location"))
    formulas: list[dict[str, Any]] = []
    found: dict[str, str] = {}
    for path in formula_files(store):
        f = load_formula(os.path.dirname(path), os.path.basename(path))
        if f:
            formulas.append({"id": f["id"], "description": f["desc"], "examples": f["examples"]})
            found.setdefault(f["id"], path)
    DIRECTORY_FOUND[store] = found
    return {"formulas": formulas}


def directory_show(request: dict[str, Any]) -> dict[str, Any]:
    """One formula by its id, as data, from its file in the directory: the
    file the last listing found it in, or, when there was none, the first that
    holds it."""
    store = directory_store(request.get("location"))
    known = (DIRECTORY_FOUND.get(store) or {}).get(request.get("id") or "")
    for path in [known] if known and os.path.isfile(known) else formula_files(store):
        f = load_formula(os.path.dirname(path), os.path.basename(path))
        if f and f["id"] == request.get("id"):
            return {
                "formula": {
                    "description": f["desc"],
                    "verifyUsing": list(f["verifyUsing"]),
                    "steps": list(f["steps"]),
                }
            }
    return {}


