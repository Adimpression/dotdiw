# ============================================================ infrastructure
#
# Shared by any body below, and deciding nothing about the product: how to run
# git, tokenising, the FTS storage, file parsing, and appending to the witness
# log. Everything after this section is one operation's body.


def git(args: list[str], cwd: str | None = None) -> str:
    try:
        p = subprocess.run(["git"] + args, capture_output=True, text=True, timeout=10, cwd=cwd)
        if p.returncode == 0:
            return p.stdout
    except (OSError, subprocess.SubprocessError):
        pass
    return ""


def repo_root() -> str:
    return git(["rev-parse", "--show-toplevel"]).strip() or os.getcwd()


# root -> its workspace, read once per process. A checkout's key does not
# change during one run, except when init writes it, which forgets it below.
WORKSPACES: dict[str, str | None] = {}


def workspace(root: str) -> str | None:
    """~/.dotdiw/<id> for this checkout, or None when it has no key.

    Read with --local on purpose: a worktree then sees the checkout's key and
    a value set globally by mistake is never taken for one.
    """
    if root in WORKSPACES:
        return WORKSPACES[root]
    key = git(["config", "--local", "--get", WORKSPACE_KEY], root).strip()
    ws = os.path.join(os.path.expanduser(DOTDIW_HOME), key) if key else None
    WORKSPACES[root] = ws
    return ws


def forget_workspace(root: str) -> None:
    """After the key or the choice is written: the next read sees it."""
    WORKSPACES.pop(root, None)
    CHOICES.pop(root, None)


def adopted(ws: str | None) -> bool:
    """Whether the workspace holds a tracker's store, not only a key pointing
    at it. Which adapter's store is the adapter's business; the witness log
    beside it is not one."""
    try:
        return bool(ws) and any(n != WITNESS_FILE for n in os.listdir(ws))
    except OSError:
        return False


def checkout_adopted(root: str) -> bool:
    """Whether this checkout has a tracker: a store under its workspace, or a
    written choice of a module. A module may keep nothing under the workspace, so
    the choice is all there is to go on, and it is written only once the store
    has opened."""
    ws = workspace(root)
    if not ws:
        return False
    name = tracker_name(root)
    return adopted(ws) or (bool(name) and (name not in TRACKERS or is_loaded(TRACKERS[name])))


def toks(s: str) -> list[str]:
    """The words of a query. FTS5's porter tokenizer does the stemming."""
    return list(
        dict.fromkeys(
            w for w in re.findall(r"[a-z0-9]+", s.lower()) if len(w) >= 2 and w not in STOP
        )
    )


def load_formula(root: str, rel: str) -> dict[str, Any] | None:
    path = os.path.join(root, rel)
    try:
        with open(path, "rb") as fh:
            if path.endswith(".toml"):
                data = tomllib.load(fh)
            else:
                data = json.load(fh)
    except Exception:
        return None

    name = os.path.basename(path).split(".")[0]
    desc = str(data.get("description", ""))
    ex = data.get("examples") or data.get("keywords") or []
    if isinstance(ex, str):
        ex = [ex]
    ex = [str(e) for e in ex]
    # The directory is matchable text too: services/billing/ says "billing"
    # without the description having to repeat it.
    where = " ".join(re.split(r"[/\\._-]+", os.path.dirname(rel)))
    # The means to prove a run: read, never matched, never run.
    declared = data.get("verify-using")
    values = [] if declared is None else declared if isinstance(declared, list) else [declared]
    means: list[str] = []
    unread: list[str] = []
    for value in values:
        why = verify_unread(value)
        if why:
            unread.append(why)
        else:
            means.append(value)
    steps = []
    # A step's claim: read with it, and named for check where it cannot be.
    claims_unread: list[str] = []
    for s in data.get("steps") or []:
        if isinstance(s, dict) and s.get("id"):
            step: dict[str, Any] = {
                "id": str(s["id"]),
                "title": str(s.get("title") or s["id"]),
                "needs": [str(n) for n in (s.get("needs") or [])],
            }
            if "claim" in s:
                claim, why = read_claim(step["id"], s["claim"])
                if claim is not None:
                    step["claim"] = claim
                else:
                    claims_unread.append(str(why))
            steps.append(step)
    claimed = {s["id"]: s["claim"]["slots"] for s in steps if s.get("claim")}
    for value in means:
        for inner in CLAIM_PLACEHOLDER.findall(value):
            step_id, _, label = inner.rpartition(".")
            if label not in claimed.get(step_id, []):
                claims_unread.append(
                    'verify-using value "%s" has the placeholder "{{ %s }}", which names no '
                    "slot of a claimed step" % (value, inner)
                )
    return {
        "name": name,
        "rel": rel,
        "id": str(data.get("formula") or name),
        "desc": desc,
        "examples": ex,
        "words": name.replace("-", " "),
        "where": where,
        "steps": steps,
        "verifyUsing": means,
        "verifyUnread": unread,
        "claimUnread": claims_unread,
    }


def shared_step_id(steps: list[Any]) -> str | None:
    """The first step id two steps share, or None: a pour answers one id per
    step, so a formula that gives two steps one id pours nothing."""
    seen: set[str] = set()
    for s in steps:
        if s["id"] in seen:
            return str(s["id"])
        seen.add(s["id"])
    return None


def tracker_step(step: FormulaStep) -> TrackerStep:
    """A formula's step as the tracker is handed it: its id, its title, the
    steps it needs, and its claim when it declares one."""
    out: TrackerStep = {
        "id": step["id"],
        "title": step["title"],
        "needs": list(step.get("needs") or []),
    }
    if step.get("claim"):
        out["claim"] = step["claim"]
    return out


def merged_values(held: list[ClaimValue], given: list[ClaimValue]) -> list[ClaimValue]:
    """A claim's values after record-values: each label given gets its value,
    replacing any earlier one where it stood; a label given empty is removed;
    every other label stays, in the order it was first recorded."""
    out: list[ClaimValue] = [{"label": v["label"], "text": v["text"]} for v in held]
    for v in given:
        at = next((i for i, h in enumerate(out) if h["label"] == v["label"]), None)
        if not v["text"]:
            if at is not None:
                out.pop(at)
        elif at is None:
            out.append({"label": v["label"], "text": v["text"]})
        else:
            out[at] = {"label": v["label"], "text": v["text"]}
    return out


def steps_in_order(steps: list[Any]) -> list[Any]:
    """The steps a tracker makes one at a time, each after those it needs and
    otherwise as declared: declaration order is no part of a formula. A need
    naming no step raises LookupError, and a cycle ValueError."""
    known = {s["id"] for s in steps}
    for s in steps:
        for need in s.get("needs") or []:
            if need not in known:
                raise LookupError("%s needs %s, which is not a step." % (s["id"], need))
    order: list[Any] = []
    placed: set[str] = set()
    left = list(steps)
    while left:
        ready = [s for s in left if all(n in placed for n in s.get("needs") or [])]
        if not ready:
            raise ValueError("A cycle among the steps: %s." % ", ".join(s["id"] for s in left))
        order.extend(ready)
        placed.update(s["id"] for s in ready)
        left = [s for s in left if s["id"] not in placed]
    return order


def what_stands_open(
    ident: str,
    item: Mapping[str, Any],
    standing: Mapping[str, Mapping[str, Any]],
    earlier: set[str],
) -> list[str]:
    """What keeps an item from closing, of what stands open: its needs, then
    its children, then the items poured in its run, wherever they stand;
    none closed earlier in the same command."""
    needs = [n for n in item.get("needs") or [] if n in standing and n not in earlier]
    under = [
        i
        for i, o in standing.items()
        if i != ident and i not in earlier and ident in (o.get("parent"), o.get("run"))
    ]
    return needs + [i for i in under if i not in needs]


def shown_by_its_id(ident: str, shown: Response) -> Response:
    """show-item's answer for an id held whole -- one the tracker itself gave,
    in a listing, or on an item as its parent, its run or a need -- which
    must be of that very item. A tracker reads an id as it will: bd reads one
    it holds nothing of as that of the one item whose id begins with it, a
    deleted item's as its only child's, and shows that one. An item of
    another id is not the one asked for, so the answer then is that the item
    is not found. A word a person gave is read as the tracker reads it, and
    is not held to this."""
    other = (shown.get("item") or {}).get("id")
    if shown["status"] != "completed" or other == ident:
        return shown
    return {
        "status": "failed",
        "reason": "item-not-found",
        "exitCode": 1,
        "summary": "The tracker holds no item %s: asked for it, it shows %s." % (ident, other),
    }


def shown_for_a_word(word: str, shown: Response) -> Response:
    """show-item's answer for a word a person gave, read as the tracker reads
    it -- a short id as the full one -- save where the tracker shows an item
    whose id runs on past the word: begins with it, or holds it after a dash,
    and is neither it nor ends with it. Then the word is a whole id the
    tracker holds nothing of, read as another item's -- bd reads a deleted
    root's id, in full or short, as its only step's -- and the item is not
    found, so that nothing is read or written on the other item's record. An
    id that is the word, or ends with it after a dash, is the word read
    whole, in full or short; one that holds it nowhere is the tracker's own
    reading of it, as Jira's of an issue moved to another project."""
    other = str((shown.get("item") or {}).get("id") or "")
    if (
        shown["status"] != "completed"
        or other == word
        or other.endswith("-" + word)
        or not (other.startswith(word) or "-" + word in other)
    ):
        return shown
    return {
        "status": "failed",
        "reason": "item-not-found",
        "exitCode": 1,
        "summary": "The tracker holds no item %s: asked for it, it shows %s, whose id runs on "
        "past it." % (word, other),
    }


def held_to_the_run(
    named: list[str],
    shut: list[str],
    before: Mapping[str, Mapping[str, Any]],
    now: Mapping[str, Mapping[str, Any]],
    reopen: Callable[[str, str], str | None],
) -> tuple[list[str], list[Response], dict[str, Any]]:
    """The run rule, held of a tracker as it stands after a close that ran in
    a tracker knowing no run -- one rule, whichever way the close was asked.

    It is given the ids the close named; those it closed, an item before what
    stands above it; the items that stood open before it, by id; every item
    as listed after it, by id; and the way to open one again to a status,
    which answers None, or why it could not.

    One the close closed while what it waits on stands open -- another writer
    having opened or moved it meanwhile, or the tracker having closed a root
    of its own accord -- is opened again to the status it had. And whoever
    closed what: a root that stands closed while an item poured in its run
    stands open is opened again, where the close named it, or an item the
    close named stands under it or was poured in it as the items stand now,
    or it stood open before the close. So no state read before the close
    says which root to hold, and a close run again sets right what an
    earlier one left.

    The ids the close closed that still stand closed; an answer for each one
    opened again or left closed against the rule, blocked where the close
    named it or it would not open, and completed otherwise; and what stands
    open after."""
    standing: dict[str, Any] = {i: o for i, o in now.items() if o.get("status") != "closed"}
    left = list(shut)
    notes: list[Response] = []
    tried: set[str] = set()

    def opened(ident: str, status: str, waiting: list[str], how: str) -> None:
        why = reopen(ident, status)
        tried.add(ident)
        if why is None:
            if ident in left:
                left.remove(ident)
            # As listed, which keeps its parent and run, not as the tracker
            # answers an update, which may leave them out.
            standing[ident] = dict(now[ident], status=status)
            said = "so it is %s again" % status
        else:
            said = "and it could not be opened again: %s" % why
        # A close the command named fails it; one the tracker made of its own
        # accord, opened again, leaves the command's own close standing.
        own = ident in named or why is not None
        notes.append(
            {
                "status": "blocked" if own else "completed",
                "reason": "blocked",
                "blockedBy": waiting,
                "exitCode": 1 if own else 0,
                "summary": "%s %s while %s stood open, %s."
                % (ident, how, ", ".join(waiting), said),
            }
        )

    # In order, so that one opened again is open for those after it.
    for ident in shut:
        waiting = what_stands_open(ident, now[ident], standing, set())
        if waiting:
            how = "closed" if ident in named else "closed of the tracker's own accord"
            opened(ident, before[ident]["status"], waiting, how)
    touched: list[str] = []
    for ident in named:
        item = now.get(ident) or {}
        for up in (ident, item.get("parent"), item.get("run")):
            if up and str(up) not in touched:
                touched.append(str(up))
    touched += [i for i in before if i not in touched]
    for up in touched:
        record = now.get(up)
        if record is None or record.get("kind") != "root" or up in standing or up in tried:
            continue
        waiting = sorted(i for i, o in standing.items() if o.get("run") == up)
        if waiting:
            opened(up, before[up]["status"] if up in before else "open", waiting, "stood closed")
    return left, notes, standing


def held_formula(f: dict[str, Any]) -> HeldFormula:
    """A formula as a response carries it: the IDL's HeldFormula record."""
    held: HeldFormula = {
        "formulaRef": f["id"],
        "name": f["name"],
        "description": f["desc"],
        "path": f["rel"],
        "examples": list(f["examples"]),
    }
    if f.get("verifyUsing"):
        held["verifyUsing"] = list(f["verifyUsing"])
    if f.get("provider"):
        held["provider"] = f["provider"]
    return held


# The means to prove a run, as a formula names them under verify-using: one
# line each, its form read from its prefix alone -- a command after run:, a
# file of a repository as a git+https:// or git+ssh:// URL with its path after
# #, or any other scheme:// link.
VERIFY_FILES = ("git+https://", "git+ssh://")
VERIFY_HEADING = "Verify using:"


def verify_unread(value: Any) -> str | None:
    """What keeps one value of verify-using from being read, or None."""
    if not isinstance(value, str) or not value.strip():
        return "verify-using holds a value that is not text"
    if "\n" in value or "\r" in value:
        return (
            'verify-using value "%s" is longer than one line -- write one means to a line'
            % (value.strip().splitlines()[0])
        )
    if value.startswith("run:"):
        return None if value[4:].strip() else 'verify-using value "run:" names no command'
    if value.startswith(VERIFY_FILES):
        if value.partition("#")[2].strip("/ "):
            return None
        return (
            'verify-using value "%s" names a repository and no file -- '
            "put the file's path after #" % value
        )
    if re.match(r"[A-Za-z][A-Za-z0-9+.-]*://", value):
        return None
    return (
        'verify-using value "%s" is in none of the forms -- start it with run:, '
        "git+https:// or git+ssh://, or a link's scheme" % value
    )


CLAIM_LABEL = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*\Z")
CLAIM_PLACEHOLDER = re.compile(r"\{\{\s*(.*?)\s*\}\}")


def read_claim(step: str, said: Any) -> tuple[StepClaim | None, str | None]:
    """A step's claim as its formula declares it -- the statement, and the
    slots' labels in the formula's order -- or None and why it cannot be
    read. A slot is a label in lowercase kebab-case followed by a colon,
    holding an empty table, and every placeholder names a slot of its own."""
    if not isinstance(said, dict):
        return None, "the claim of step %s is not a table" % step
    statement = said.get("statement")
    if not isinstance(statement, str) or not statement.strip():
        return None, "the claim of step %s has no statement" % step
    slots: list[str] = []
    for key, value in said.items():
        if key == "statement":
            continue
        label = str(key)[:-1] if str(key).endswith(":") else None
        if label is None or not CLAIM_LABEL.match(label):
            return None, (
                'the claim of step %s holds "%s", which is neither its statement nor a slot -- '
                "a slot is a label in lowercase kebab-case followed by a colon" % (step, key)
            )
        if value != {}:
            return None, (
                'the claim of step %s gives its slot "%s" a value -- a slot holds an empty table'
                % (step, key)
            )
        slots.append(label)
    for name in CLAIM_PLACEHOLDER.findall(statement):
        if name not in slots:
            return None, (
                'the claim of step %s has the placeholder "{{ %s }}", which names none of its slots'
                % (step, name)
            )
    claim: StepClaim = {"statement": statement, "slots": slots}
    return claim, None


def held_claim(step: str, said: Any) -> StepClaim:
    """A provider's claim on a step held to its shape -- a statement, and its
    slots' labels in lowercase kebab-case, each once, every placeholder naming
    one -- or ValueError naming what is outside it."""
    if not isinstance(said, dict) or set(said) - {"statement", "slots"}:
        raise ValueError("the claim of step %s is not a statement and its slots" % step)
    statement, slots = said.get("statement"), said.get("slots")
    if not isinstance(statement, str) or not statement.strip():
        raise ValueError("the claim of step %s has no statement" % step)
    if not isinstance(slots, list) or not all(
        isinstance(s, str) and CLAIM_LABEL.match(s) for s in slots
    ):
        raise ValueError(
            "the slots of step %s's claim are not labels in lowercase kebab-case" % step
        )
    if len(set(slots)) != len(slots):
        raise ValueError("the claim of step %s names a slot twice" % step)
    for name in CLAIM_PLACEHOLDER.findall(statement):
        if name not in slots:
            raise ValueError(
                'the claim of step %s has the placeholder "{{ %s }}", which names none of its slots'
                % (step, name)
            )
    claim: StepClaim = {"statement": statement, "slots": list(slots)}
    return claim


def keep_verify_using(description: str | None, means: list[str]) -> str | None:
    """A description with the means to prove a run kept as its last section,
    one to a line: how a tracker that has a description and nothing more for
    them keeps them. With no means, the description as given; one that would
    read back as holding a section of its own gets an empty section after it,
    so that read_verify_using gives every description back as it was."""
    if means:
        block = "\n".join([VERIFY_HEADING] + ["- " + m for m in means])
        return description + "\n\n" + block if description else block
    if not description or read_verify_using(description) == (description, []):
        return description
    return description + "\n\n" + VERIFY_HEADING


def read_verify_using(text: str | None) -> tuple[str | None, list[str]]:
    """The description as it was given, and the means keep_verify_using kept
    in it: the last section headed Verify using:, at the start of the text or
    after a blank line, whose lines to the end are each a means. A text with
    no such section is all description."""
    if not text:
        return text, []
    at = text.rfind("\n\n" + VERIFY_HEADING)
    if at < 0 and not text.startswith(VERIFY_HEADING):
        return text, []
    start, description = (at + 2, text[:at]) if at >= 0 else (0, None)
    rest = text[start + len(VERIFY_HEADING) :]
    if not rest:
        return description, []
    lines = rest.split("\n")
    if lines[0] or not all(line.startswith("- ") and len(line) > 2 for line in lines[1:]):
        return text, []
    return description, [line[2:] for line in lines[1:]]


def repository_of(url: str) -> str:
    """Host and path of a git URL in any of its forms, so that two naming one
    repository compare equal: https://host/a/b.git, ssh://git@host:22/a/b and
    git@host:a/b all read host/a/b."""
    m = re.match(r"[A-Za-z][A-Za-z0-9+.-]*://(?:[^@/]*@)?([^/:]+)(?::\d+)?/(.*)", url)
    if not m:
        m = re.match(r"(?:[^@/]*@)?([^:/]+):(.*)", url)
    if not m:
        return url.lower()
    path = m.group(2).strip("/")
    path = path[:-4] if path.endswith(".git") else path
    return ("%s/%s" % (m.group(1), path)).lower()


def checkout_remotes(root: str) -> set[str]:
    """The repositories this checkout's remotes name, read as repository_of reads them."""
    return {
        repository_of(line.split()[1])
        for line in git(["remote", "-v"], root).splitlines()
        if len(line.split()) >= 2
    }


def no_fts5() -> None:
    """Retrieval is FTS5, and some SQLite builds are compiled without it."""
    sys.stderr.write(
        "%s needs SQLite built with FTS5, and this interpreter's is not.\n"
        "  brew install %s installs its own interpreter; this one came from "
        "elsewhere.\n" % (PROG, PROG)
    )
    sys.exit(4)


class Index:
    """BM25 storage over the formulas, with the project's prose for word weight.

    SQLite's FTS5 does the retrieval: its porter stemmer reaches "failing"
    from "fail", and bm25() ranks on how distinctive a word is instead of on
    how many words happened to overlap. What counts as a match -- the
    coverage floor, how many to show -- is MatchFormulas' decision, not this
    class's; this only stores, weighs and ranks.
    """

    COLUMNS = ("fname", "place", "body", "cases")

    def __init__(self, forms: list[dict[str, Any]], bg: list[str]) -> None:
        self.forms = forms
        self.nbg = len(bg)
        self._spread_cache: dict[str, tuple[frozenset[int], int]] = {}
        self.db = sqlite3.connect(":memory:")
        try:
            self.db.execute(
                "CREATE VIRTUAL TABLE f USING fts5(%s, "
                "tokenize='porter unicode61')" % ", ".join(self.COLUMNS)
            )
        except sqlite3.Error:
            no_fts5()
        rows = [(f["words"], f["where"], f["desc"], " ".join(f["examples"])) for f in forms]
        # Formulas take rowid 1..N, so everything after them is background.
        rows += [("", "", text, "") for text in bg]
        self.db.executemany("INSERT INTO f VALUES (?, ?, ?, ?)", rows)
        self.sql = (
            "SELECT rowid, -bm25(f, %s) AS s FROM f "
            "WHERE f MATCH ? AND rowid <= ?" % ", ".join("%g" % w for w in WEIGHTS)
        )

    def spread(self, word: str) -> tuple[frozenset[int], int]:
        """Which formulas hold this word, and how many background documents do.

        One query per word, so a title costs a handful however many formulas
        the project has.
        """
        if word not in self._spread_cache:
            n = len(self.forms)
            rows = [
                r[0]
                for r in self.db.execute("SELECT rowid FROM f WHERE f MATCH ?", ('"%s"' % word,))
            ]
            self._spread_cache[word] = (
                frozenset(r for r in rows if r <= n),
                sum(1 for r in rows if r > n),
            )
        return self._spread_cache[word]

    def weight(self, word: str) -> float:
        """How distinctive a word is in this project.

        Smoothed so it stays positive. bm25's own idf is zero for a word in
        half the corpus, and in a project with one formula and one README that
        is every word there is.
        """
        held = self.spread(word)[1]
        return math.log((self.nbg - held + 0.5) / (held + 0.5) + 1.0)

    def rows(self, words: list[str]) -> list[Any]:
        """(rowid, bm25 score) for every formula holding any of the words."""
        if not words or not self.forms:
            return []
        match = " OR ".join('"%s"' % w for w in words)
        try:
            return self.db.execute(self.sql, (match, len(self.forms))).fetchall()
        except sqlite3.Error:
            return []

    @contextlib.contextmanager
    def without_example(self, i: int, j: int) -> Iterator[None]:
        """The index as if formula i had never listed example j.

        A self-test that leaves the example in place proves nothing: the
        title is in the index, so of course it finds itself.
        """
        ex = self.forms[i]["examples"]
        before = " ".join(ex)
        kept = " ".join(e for k, e in enumerate(ex) if k != j)
        self.db.execute("UPDATE f SET cases = ? WHERE rowid = ?", (kept, i + 1))
        self._spread_cache.clear()
        try:
            yield
        finally:
            self.db.execute("UPDATE f SET cases = ? WHERE rowid = ?", (before, i + 1))
            self._spread_cache.clear()


class Scope:
    """What one request asked of the door holds while it runs: its own, and
    no other request's, though others run in the same process, each in a
    thread of its own. How deep in the door it is; the locks its bodies took
    for a write, held until the door has logged what was written; for each
    checkout, the formulas and the index IndexTheProject built, which its
    steps share and the next request reads again -- they are not fields of
    any response, so this is where a body finds them -- and the formula
    files that index could not parse."""

    def __init__(self) -> None:
        self.depth = 0
        self.held: list[int] = []
        self.indexes: dict[str, tuple[list[dict[str, Any]], Index | None]] = {}
        self.unparsed: dict[str, list[str]] = {}


# The request running here, set by the door when an operation is asked of it
# from outside, and gone once that operation is answered.
SCOPE: contextvars.ContextVar[Scope | None] = contextvars.ContextVar("scope", default=None)


class Gate:
    """The requests running in this process: any number at once, or one
    alone -- one that changes for its length what the whole process shares,
    as a check of a tracker changes its working directory, its environment
    and the adapters registered in it."""

    def __init__(self) -> None:
        self.changed = threading.Condition()
        self.running = 0
        self.alone = False

    def enter(self) -> None:
        with self.changed:
            while self.alone:
                self.changed.wait()
            self.running += 1

    def leave(self) -> None:
        with self.changed:
            self.running -= 1
            self.changed.notify_all()

    @contextlib.contextmanager
    def by_itself(self) -> Iterator[None]:
        """Run alone: the request asking gives up its own place, waits for
        every other to end, and keeps new ones out until it is done."""
        holding = SCOPE.get() is not None
        with self.changed:
            self.running -= holding
            while self.alone or self.running:
                self.changed.wait()
            self.alone = True
        # Asked outside any request, it is one for its length, so that what
        # it asks of a door itself is asked within it, and does not wait.
        begun = None if holding else SCOPE.set(Scope())
        try:
            yield
        finally:
            if begun is not None:
                SCOPE.reset(begun)
            with self.changed:
                self.alone = False
                self.running += holding
                self.changed.notify_all()


GATE = Gate()


@contextlib.contextmanager
def a_request() -> Iterator[Scope]:
    """The request a door is asked in. Asked within one, it is that one.
    Asked from outside -- of the door, the tracker door, an adapter's extra
    or an adapter's own callable -- it begins one: it waits while a request
    runs alone (Gate), so that nothing asked meanwhile reads the working
    directory, the environment or the adapters that one changed for its
    length, and it is gone once answered."""
    scope = SCOPE.get()
    if scope is not None:
        yield scope
        return
    GATE.enter()
    scope = Scope()
    begun = SCOPE.set(scope)
    try:
        yield scope
    finally:
        SCOPE.reset(begun)
        GATE.leave()


# Each registered provider's list, asked for once in a run; a registration
# forgets them all, so that a name registered again is listed from where it
# points now.
LISTED: dict[str, Any] = {}


def hold_index(root: str, forms: list[dict[str, Any]], idx: Index | None) -> None:
    scope = SCOPE.get()
    if scope is None:
        raise DoorError("%s was indexed outside any request" % root)
    scope.indexes[root] = (forms, idx)


def held_index(root: str) -> tuple[list[dict[str, Any]], Index | None]:
    """The formulas and the index IndexTheProject built for this checkout in
    this request; asking before it ran is the project's mistake, and raises."""
    scope = SCOPE.get()
    if scope is None or root not in scope.indexes:
        raise DoorError("%s was asked for its index before it was indexed" % root)
    return scope.indexes[root]


def witness_on(ws: str | None) -> bool:
    """Whether this checkout's tracker is keeping the witness log."""
    if not ws:
        return False
    return bool(os.environ.get("DOTDIW_WITNESS")) or os.path.exists(os.path.join(ws, WITNESS_FILE))


def release_held(scope: Scope, mark: int) -> None:
    """Release the locks the request took since the mark, the last first."""
    while len(scope.held) > mark:
        fd = scope.held.pop()
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)


def witness(ws: str | None, source: str, label: str, **fields: Any) -> None:
    """Append one observed event. Which events exist is each body's decision."""
    now = datetime.datetime.now(datetime.UTC)
    stamp = now.strftime("%Y-%m-%dT%H:%M:%S.%fZ")
    event = {
        "observedEventId": "%s-%s-%d" % (label, now.strftime("%Y%m%d%H%M%S%f"), os.getpid()),
        "label": label,
    }
    event.update((k, v) for k, v in fields.items() if v is not None)
    event.update({"occurredAt": stamp, "observedAt": stamp, "source": source})
    if not ws or not os.path.isdir(ws):
        return
    path = os.path.join(ws, WITNESS_FILE)
    try:
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(event, ensure_ascii=False) + "\n")
    except OSError:
        pass


def witnessed(ws: str | None) -> list[dict[str, Any]]:
    """The events this checkout's log holds, oldest first."""
    out: list[dict[str, Any]] = []
    if not ws:
        return out
    try:
        with open(os.path.join(ws, WITNESS_FILE), encoding="utf-8") as fh:
            for line in fh:
                try:
                    out.append(json.loads(line))
                except ValueError:
                    continue
    except OSError:
        pass
    return out


# ================================================================ operations
#
# One function per operation in operation-idl.json, in the order the duties
# hold them. Each takes a request dict and returns a dict carrying `status`
# (completed, blocked or failed), `summary`, `exitCode`, and whatever else the
# IDL's response type names. An operation calls another only through the
# door, `invoke`, by the operation's id. A body prints nothing: what the
# worker sees of a response is the command line's to show, in present(),
# as the operation returns. The one exception is the tracker's own stream,
# which the beads adapter passes through with the worker's terminal when a
# request says the terminal is there; no body touches it.

# --------------------------------------------- duty.teach-without-a-project


def TeachTheConventions(request: TeachTheConventionsRequest) -> TeachTheConventionsResponse:
    """step.teach-the-conventions: the four things and the two conventions."""
    return {
        "status": "completed",
        "summary": "How work gets done here.",
        "text": LEARN,
        "exitCode": 0,
    }


def LearnTheConventions(request: LearnTheConventionsRequest) -> LearnTheConventionsResponse:
    """journey.learn-the-conventions."""
    # Another operation's response, answered as this one's: the door holds it
    # to this operation's type on the way out.
    return cast(LearnTheConventionsResponse, invoke("operation.teach-the-conventions", {}))


# ------------------------------------------- duty.keep-procedures-findable


def IndexTheProject(request: IndexTheProjectRequest) -> IndexTheProjectResponse:
    """step.index-the-project: the formulas in local storage, indexed with the project's own text.

    These documents are indexed and never returned. Their only job is to tell
    bm25 that "write", "test" and "version" are everyday words in this
    project, which a corpus of four formulas cannot work out on its own. On
    four documents of prose "version" was distinctive enough to pull up the
    release formula for a Go toolchain bump; on twenty-two it is not.
    """
    root = request["root"]
    scope = SCOPE.get()
    if scope is None:
        raise DoorError("%s was indexed outside any request" % root)
    held = scope.indexes.get(root)
    if held is not None and (held[1] is not None or not request.get("background", True)):
        forms, idx = held
        return {
            "status": "completed",
            "summary": "%d formula%s." % (len(forms), "" if len(forms) == 1 else "s"),
            "formulaCount": len(forms),
            "unparsed": list(scope.unparsed.get(root, [])),
            "exitCode": 0,
        }
    # Local storage is the file system: every formula file in the checkout,
    # committed or not, and git plays no part in finding it. A directory whose
    # name starts with a dot is skipped, and no symbolic link is followed.
    rels = [os.path.relpath(p, root) for p in formula_files(root)]
    forms = []
    unparsed = []
    for rel in rels:
        f = load_formula(root, rel)
        if f:
            forms.append(f)
        else:
            unparsed.append(rel)
    scope.unparsed[root] = unparsed
    # Every registered provider's formulas, from its list alone, each under its
    # suffixed id; a formula's text is asked for only when it is shown or
    # poured. A provider that fails, or answers outside its shape, is left out
    # of this run whole, in one line.
    left_out: list[str] = []
    for name in sorted(read_providers()):
        if name not in LISTED:
            LISTED[name] = invoke("operation.list-provider-formulas", {"name": name})
        listed = LISTED[name]
        if listed["status"] != "completed":
            left_out.append(listed["summary"])
            continue
        for held in listed.get("formulas") or []:
            ref = held["formulaRef"]
            forms.append(
                {
                    "name": ref,
                    "rel": "",
                    "id": ref,
                    "desc": held["description"],
                    "examples": list(held["examples"]),
                    "words": ref.replace("-", " "),
                    "where": "",
                    "steps": [],
                    "verifyUsing": [],
                    "verifyUnread": [],
                    "provider": name,
                    "ident": ref[: -len(name) - 1],
                }
            )

    idx = None
    if request.get("background", True):
        bg = []
        for rel in git(["ls-files", "-z"], root).split("\0"):
            if not rel or rel.endswith(".formula.toml") or rel.endswith(".formula.json"):
                continue
            if os.path.splitext(rel)[1].lower() not in CORPUS_EXTS:
                continue
            p = os.path.join(root, rel)
            try:
                if os.path.getsize(p) > CORPUS_BYTES:
                    continue
                with open(p, errors="ignore") as fh:
                    bg.append(fh.read())
            except OSError:
                continue
            if len(bg) >= CORPUS_FILES:
                break
        idx = Index(forms, bg)
    hold_index(root, forms, idx)
    return {
        "status": "completed",
        "summary": "%d formula%s." % (len(forms), "" if len(forms) == 1 else "s"),
        "fileCount": len(rels),
        "formulaCount": len(forms),
        "providersLeftOut": left_out,
        "unparsed": unparsed,
        "exitCode": 0,
    }


def ResolveFormula(request: ResolveFormulaRequest) -> ResolveFormulaResponse:
    """step.resolve-formula: a formula by its id, its file name, or its path."""
    root = request["root"]
    built = invoke("operation.index-the-project", {"root": root, "background": False})
    if built["status"] != "completed":
        return {"status": "failed", "summary": built["summary"], "exitCode": built["exitCode"]}
    forms = held_index(root)[0]
    ident = (request.get("ident") or "").strip()
    # An id first. An ident with a provider's suffix is that provider's alone:
    # it names one of its formulas or nothing, never a local file by an alias.
    # Then a path exactly as given, and only then a file's name. Two formulas
    # at one tier are refused.
    registry = read_registry()
    owner = suffix_owner(ident, registry)
    given = os.path.realpath(ident) if os.path.isabs(ident) else os.path.join(root, ident)
    rel = os.path.normpath(os.path.relpath(given, root)) if ident else ""
    base = os.path.basename(ident).split(".")[0]
    tiers: list[Callable[[dict[str, Any]], bool]] = [
        lambda f: f["id"] == ident and (not owner or f.get("provider") == owner)
    ]
    if not owner:
        tiers += [
            lambda f: not f.get("provider") and f["rel"] == rel,
            lambda f: not f.get("provider") and ident == f["name"],
            lambda f: not f.get("provider") and base in (f["id"], f["name"]),
        ]
    matches: list[dict[str, Any]] = []
    for tier in tiers if ident else []:
        matches = [f for f in forms if tier(f)]
        if matches:
            break
    if len(matches) > 1:
        return {
            "status": "blocked",
            "summary": "%s names more than one formula: %s."
            % (
                ident,
                ", ".join(
                    f["rel"] or "%s from the %s provider" % (f["id"], f["provider"])
                    for f in matches
                ),
            ),
            "reason": "ambiguous",
            "formulaRef": None,
            "path": None,
            "exitCode": 1,
        }
    if not matches:
        # Handed to the tracker, a provider's id would find whatever copy the
        # tracker kept.
        if owner:
            return {
                "status": "blocked",
                "summary": (
                    "%s names no formula the %s provider serves."
                    if owner in registry["providers"]
                    else "%s names no formula: the %s provider is removed."
                )
                % (ident, owner),
                "reason": "provider-formula-unserved",
                "formulaRef": None,
                "path": None,
                "exitCode": 1,
            }
        return {
            "status": "blocked",
            "summary": "%s names no formula." % (ident or "nothing"),
            "reason": "formula-not-found",
            "formulaRef": None,
            "path": None,
            "exitCode": 0,
        }
    found = matches[0]
    if found.get("provider") and not found["rel"]:
        shown = invoke(
            "operation.show-provider-formula",
            {"root": root, "name": found["provider"], "ident": found["ident"]},
        )
        if shown["status"] != "completed" or not shown.get("formula"):
            return {
                "status": "failed",
                "summary": shown["summary"],
                "reason": "provider-failed",
                "formulaRef": None,
                "path": None,
                "exitCode": 1,
            }
        return {
            "status": "completed",
            "summary": "Resolved %s to %s, from the %s provider."
            % (ident, found["id"], found["provider"]),
            "formulaRef": found["id"],
            "path": None,
            "formula": shown["formula"],
            "exitCode": 0,
        }
    # The formula as this reading parsed it, so that a pour pours the formula
    # this id selected, whatever is written to its file meanwhile.
    return {
        "status": "completed",
        "summary": "Resolved %s to %s." % (ident, found["rel"]),
        "formulaRef": found["id"],
        "path": found["rel"],
        "formula": {
            "description": found["desc"],
            "verifyUsing": list(found["verifyUsing"]),
            "steps": list(found["steps"]),
        },
        "exitCode": 0,
    }


def ListFormulas(request: ListFormulasRequest) -> ListFormulasResponse:
    """step.list-formulas: what this project holds.

    bd answers this question about its own search paths, so in a project whose
    formulas sit next to what they are about it says "No formulas found" --
    which is true of `.beads/formulas` and false of the project. Every agent in
    the trial believed it and moved the formulas. This answers about the
    project, which is what was asked.
    """
    root = request["root"]
    built = invoke("operation.index-the-project", {"root": root, "background": False})
    if built["status"] != "completed":
        return {"status": "failed", "summary": built["summary"], "exitCode": built["exitCode"]}
    forms = held_index(root)[0]
    return {
        "status": "completed",
        "summary": "%d formulas listed." % len(forms),
        "formulas": [held_formula(f) for f in forms],
        "formulaCount": len(forms),
        "exitCode": 0,
    }


def ShowFormula(request: ShowFormulaRequest) -> ShowFormulaResponse:
    """step.show-formula: the formula as it is written, from where it is written."""
    root = request["root"]
    r = invoke("operation.resolve-formula", {"root": root, "ident": request.get("ident")})
    if r["status"] != "completed":
        return {
            "status": r["status"],
            "summary": r["summary"],
            "reason": r.get("reason"),
            "exitCode": r["exitCode"],
        }
    body = r.get("formula")
    if body and not r.get("path"):
        # A provider's formula has no file; it is shown in the form a
        # .formula.json file takes. A file in the tree is shown as written.
        steps: list[dict[str, Any]] = []
        for s in body["steps"]:
            step: dict[str, Any] = {"id": s["id"], "title": s["title"], "needs": s.get("needs")}
            if s.get("claim"):
                claim: dict[str, Any] = {"statement": s["claim"]["statement"]}
                claim.update({"%s:" % label: {} for label in s["claim"]["slots"]})
                step["claim"] = claim
            steps.append(step)
        shown = {
            "formula": r["formulaRef"],
            "description": body["description"],
            "verify-using": body["verifyUsing"],
            "steps": steps,
        }
        return {
            "status": "completed",
            "summary": "Showed %s." % r["formulaRef"],
            "path": None,
            "text": json.dumps(shown, indent=2, ensure_ascii=False) + "\n",
            "exitCode": 0,
        }
    try:
        with open(os.path.join(root, r["path"]), encoding="utf-8") as fh:
            text = fh.read()
    except OSError as e:
        return {"status": "failed", "summary": str(e), "path": r["path"], "exitCode": 1}
    return {
        "status": "completed",
        "summary": "Showed %s." % r["path"],
        "path": r["path"],
        "text": text,
        "exitCode": 0,
    }


def FindAHeldProcedure(request: FindAHeldProcedureRequest) -> FindAHeldProcedureResponse:
    """journey.find-a-held-procedure: list, show or resolve, by what is asked."""
    root = request["root"]
    built = invoke("operation.index-the-project", {"root": root, "background": False})
    if built["status"] != "completed":
        return {"status": "failed", "summary": built["summary"], "exitCode": built["exitCode"]}
    # The step's response is answered as this journey's: the door holds it to
    # this operation's type on the way out.
    ask = request.get("ask")
    if ask == "list":
        listed = invoke("operation.list-formulas", {"root": root, "json": request.get("json")})
        return cast(FindAHeldProcedureResponse, listed)
    if ask == "show":
        shown = invoke("operation.show-formula", {"root": root, "ident": request.get("ident")})
        return cast(FindAHeldProcedureResponse, shown)
    found = invoke("operation.resolve-formula", {"root": root, "ident": request.get("ident")})
    return cast(FindAHeldProcedureResponse, found)


def DescribeProvider(request: DescribeProviderRequest) -> DescribeProviderResponse:
    """step.describe-provider: which of list, show and create a provider answers,
    a registered one by its name or a module before it is registered."""
    name = request.get("name") or ""
    if name:
        entry = read_providers().get(name)
        if entry is None:
            return {
                "status": "blocked",
                "summary": "No formula management provider is registered as %s." % name,
                "reason": "provider-unknown",
                "exitCode": 1,
            }
        module, location = str(entry["module"]), entry.get("location")
    else:
        module, location = request.get("module") or "", request.get("location")
    table, why = load_provider(module)
    if table is None and why == "module-not-found":
        return {
            "status": "blocked",
            "summary": "No formula management provider module named %s is installed." % module,
            "reason": "module-not-found",
            "exitCode": 1,
        }
    if table is None:
        return {
            "status": "blocked",
            "summary": "%s is not a formula management provider of interface %d: it "
            "raised on load, its PROVIDER table lacks describe, list or show, or its info "
            "names another interface." % (module, PROVIDER_INTERFACE),
            "reason": "not-a-provider",
            "exitCode": 1,
        }
    try:
        said = table["operations"]["describe"]({"location": location})
        declared = said.get("answers") if isinstance(said, dict) else None
        answers: list[Any] = [a for a in ("list", "show", "create") if a in (declared or [])]
        # A provider may answer its location as it means it -- a directory by
        # its absolute path -- so that it names one store from everywhere.
        if isinstance(said, dict) and isinstance(said.get("location"), str) and said["location"]:
            location = said["location"]
    except Exception as e:
        return {
            "status": "failed",
            "summary": "The %s provider failed to describe itself: %s"
            % (module, " ".join(str(e).split()) or type(e).__name__),
            "reason": "provider-failed",
            "exitCode": 1,
        }
    provider: FormulaProvider = {
        "name": name,
        "module": module,
        "location": location,
        "version": str((table.get("info") or {}).get("version") or ""),
        "answers": answers,
    }
    return {
        "status": "completed",
        "summary": "%s answers %s." % (name or module, ", ".join(answers) or "nothing"),
        "answers": answers,
        "provider": provider,
        "exitCode": 0,
    }


def RegisterProvider(request: RegisterProviderRequest) -> RegisterProviderResponse:
    """step.register-provider: a provider under a name of letters and digits,
    lawful once no local formula of this checkout reads like one of its
    suffixed ids, and only for a module that answers list and show."""
    name, module, location = request["name"], request["module"], request.get("location")
    if not re.fullmatch(PROVIDER_NAME, name):
        return {
            "status": "blocked",
            "summary": "%s is not a provider name: use letters and digits alone." % name,
            "reason": "name-not-alphanumeric",
            "exitCode": 1,
        }

    def taken_in(names: Iterable[str]) -> str | None:
        """The registered name this one is, whatever the case of either."""
        return next((n for n in names if n.lower() == name.lower()), None)

    taken = taken_in(read_providers())
    if taken:
        return {
            "status": "blocked",
            "summary": "A formula management provider is already registered as %s." % taken,
            "reason": "name-taken",
            "exitCode": 1,
        }
    said = invoke("operation.describe-provider", {"module": module, "location": location})
    if said["status"] != "completed":
        why = said.get("reason")
        return {
            "status": said["status"],
            "summary": said["summary"],
            "reason": "module-not-found"
            if why == "module-not-found"
            else "not-a-provider"
            if why == "not-a-provider"
            else "provider-failed",
            "exitCode": 1,
        }
    answers = said.get("answers") or []
    if "list" not in answers or "show" not in answers:
        return {
            "status": "blocked",
            "summary": "%s answers %s; a formula management provider answers list and show."
            % (module, ", ".join(answers) or "nothing"),
            "reason": "lacks-list-or-show",
            "exitCode": 1,
        }
    root = request.get("root")
    clashing: list[str] = []
    if root:
        built = invoke("operation.index-the-project", {"root": root, "background": False})
        if built["status"] == "completed":
            clashing = sorted(
                f["rel"]
                for f in held_index(root)[0]
                if not f.get("provider") and f["id"].endswith("-" + name)
            )
    if clashing:
        return {
            "status": "blocked",
            "summary": "Rename these local formulas first; each id reads like a formula of "
            "a provider registered as %s:" % name,
            "reason": "clashing-local-formula",
            "clashing": clashing,
            "exitCode": 1,
        }
    provider: FormulaProvider = dict(said.get("provider") or {})  # type: ignore[assignment]
    provider["name"] = name
    with registry_lock():
        registry = read_registry()
        taken = taken_in(registry["providers"])
        if taken:
            return {
                "status": "blocked",
                "summary": "A formula management provider is already registered as %s." % taken,
                "reason": "name-taken",
                "exitCode": 1,
            }
        registry["providers"][name] = {"module": module, "location": provider.get("location")}
        registry["removed"] = [n for n in registry["removed"] if n != name]
        write_registry(registry)
    LISTED.clear()
    return {
        "status": "completed",
        "summary": "Registered %s, the %s provider; every formula of it carries -%s."
        % (name, module, name),
        "provider": provider,
        "exitCode": 0,
    }


def ListProviderFormulas(request: ListProviderFormulasRequest) -> ListProviderFormulasResponse:
    """step.list-provider-formulas: every formula a provider holds, each under
    its suffixed id."""
    name = request["name"]
    entry = read_providers().get(name)
    if entry is None:
        return {
            "status": "blocked",
            "summary": "No formula management provider is registered as %s." % name,
            "reason": "provider-unknown",
            "exitCode": 1,
        }
    table, _ = load_provider(str(entry["module"]))
    if table is None:
        return {
            "status": "failed",
            "summary": "The %s provider's module, %s, is not installed or not a provider."
            % (name, entry["module"]),
            "reason": "provider-failed",
            "exitCode": 1,
        }
    formulas: list[HeldFormula] = []
    try:
        said = table["operations"]["list"]({"location": entry.get("location")})
        listed = said.get("formulas") if isinstance(said, dict) else None
        if not isinstance(listed, list):
            raise ValueError("its list answered no list of formulas")
        seen: set[str] = set()
        for x in listed:
            ident = x.get("id") if isinstance(x, dict) else None
            if not isinstance(ident, str) or not re.fullmatch(PROVIDER_FORMULA_ID, ident):
                raise ValueError(
                    "it listed %s, which is not an id of letters, digits, dots, hyphens "
                    "and underscores" % repr(ident)[:80]
                )
            if ident in seen:
                raise ValueError("it listed %s twice" % ident)
            seen.add(ident)
            desc, examples = x.get("description") or "", x.get("examples") or []
            if not isinstance(desc, str):
                raise ValueError("the description of %s is not text" % ident)
            if not isinstance(examples, list) or not all(isinstance(e, str) for e in examples):
                raise ValueError("the examples of %s are not a list of text" % ident)
            formulas.append(
                {
                    "formulaRef": "%s-%s" % (ident, name),
                    "name": "%s-%s" % (ident, name),
                    "description": desc,
                    "path": "",
                    "examples": list(examples),
                    "provider": name,
                }
            )
    except Exception as e:
        return {
            "status": "failed",
            "summary": "The %s provider failed to list its formulas: %s"
            % (name, " ".join(str(e).split()) or type(e).__name__),
            "reason": "provider-failed",
            "exitCode": 1,
        }
    return {
        "status": "completed",
        "summary": "%d formula%s from %s."
        % (len(formulas), "" if len(formulas) == 1 else "s", name),
        "formulas": formulas,
        "exitCode": 0,
    }


def step_told(text: Any) -> dict[str, Any]:
    """What a step's description tells, as a provider with title and
    description fields keeps a step: its id on a Step ID: line, its needs on a
    Needs: line, comma separated, and its claim under a Claim: heading -- the
    statement, then a line for each slot, its label and a colon -- up to the
    next blank line. ValueError when the description is not text."""
    if text is None:
        return {}
    if not isinstance(text, str):
        raise ValueError("a step's description is not text")
    told: dict[str, Any] = {}
    lines = [line.strip() for line in text.split("\n")]
    i = 0
    while i < len(lines):
        line = lines[i]
        i += 1
        if line.startswith("Step ID:"):
            told["id"] = line[len("Step ID:") :].strip()
        elif line.startswith("Needs:"):
            told["needs"] = [n.strip() for n in line[len("Needs:") :].split(",") if n.strip()]
        elif line == "Claim:":
            while i < len(lines) and not lines[i]:
                i += 1
            block = []
            while i < len(lines) and lines[i]:
                block.append(lines[i])
                i += 1

            def slot(b: str) -> bool:
                return b.endswith(":") and bool(CLAIM_LABEL.match(b[:-1]))

            told["claim"] = {
                "statement": " ".join(b for b in block if not slot(b)),
                "slots": [b[:-1] for b in block if slot(b)],
            }
    return told


def formula_body(said: Any) -> FormulaBody:
    """ShowProviderFormula's: a provider's answer to show held to its shape --
    a formula with a description, its means to prove, and steps each with an
    id, a title and the step ids it needs -- or ValueError naming what is
    outside it."""
    body = said.get("formula") if isinstance(said, dict) else None
    if not isinstance(body, dict):
        raise ValueError("its show answered no formula")
    description = body.get("description")
    if not isinstance(description, str):
        raise ValueError("its description is not text")
    means = body.get("verifyUsing")
    if means is None:
        # A provider with title and description fields alone keeps the means
        # as a Verify using: section of the formula's description.
        kept, means = read_verify_using(description.rstrip("\n"))
        description = kept or ""
    if not isinstance(means, list):
        raise ValueError("its verifyUsing is not a list")
    for value in means:
        why = verify_unread(value)
        if why:
            raise ValueError(why)
    steps = body.get("steps")
    if not isinstance(steps, list):
        raise ValueError("its steps are not a list")
    held: list[FormulaStep] = []
    for s in steps:
        told = step_told(s.get("description")) if isinstance(s, dict) else {}
        ident = s.get("id", told.get("id")) if isinstance(s, dict) else None
        title = s.get("title") if isinstance(s, dict) else None
        needs = s.get("needs", told.get("needs", [])) if isinstance(s, dict) else None
        needs = [] if needs is None else needs
        if not isinstance(ident, str) or not ident or not isinstance(title, str) or not title:
            raise ValueError("a step has no id or no title")
        if not isinstance(needs, list) or not all(isinstance(n, str) for n in needs):
            raise ValueError("the needs of %s are not a list of step ids" % ident)
        if any(h["id"] == ident for h in held):
            raise ValueError("it has the step %s twice" % ident)
        step: FormulaStep = {"id": ident, "title": title, "needs": list(needs)}
        claim = s.get("claim", told.get("claim"))
        if claim is not None:
            step["claim"] = held_claim(ident, claim)
        held.append(step)
    answer: FormulaBody = {"description": description, "verifyUsing": list(means), "steps": held}
    return answer


def ShowProviderFormula(request: ShowProviderFormulaRequest) -> ShowProviderFormulaResponse:
    """step.show-provider-formula: a provider's formula, as data, under its
    suffixed id: its description, its means to prove and its steps, held to
    their shape. Nothing is written for it."""
    name, ident = request["name"], request["ident"]
    entry = read_providers().get(name)
    if entry is None:
        return {
            "status": "blocked",
            "summary": "No formula management provider is registered as %s." % name,
            "reason": "provider-unknown",
            "exitCode": 1,
        }
    table, _ = load_provider(str(entry["module"]))
    if table is None:
        return {
            "status": "failed",
            "summary": "The %s provider's module, %s, is not installed or not a provider."
            % (name, entry["module"]),
            "reason": "provider-failed",
            "exitCode": 1,
        }
    suffixed = "%s-%s" % (ident, name)
    try:
        said = table["operations"]["show"]({"location": entry.get("location"), "id": ident})
        body = formula_body(said) if said else None
    except Exception as e:
        return {
            "status": "failed",
            "summary": "The %s provider failed to show %s: %s"
            % (name, ident, " ".join(str(e).split()) or type(e).__name__),
            "reason": "provider-failed",
            "exitCode": 1,
        }
    if body is None:
        return {
            "status": "blocked",
            "summary": "The %s provider holds no formula %s." % (name, ident),
            "reason": "formula-not-found",
            "exitCode": 1,
        }
    return {
        "status": "completed",
        "summary": "%s, from the %s provider." % (suffixed, name),
        "formulaRef": suffixed,
        "formula": body,
        "exitCode": 0,
    }


def RemoveProvider(request: RemoveProviderRequest) -> RemoveProviderResponse:
    """step.remove-provider: the registration gone, the package left installed."""
    name = request["name"]
    with registry_lock():
        registry = read_registry()
        entry = registry["providers"].pop(name, None)
        if entry is None:
            return {
                "status": "blocked",
                "summary": "No formula management provider is registered as %s." % name,
                "reason": "provider-unknown",
                "exitCode": 1,
            }
        registry["removed"] = sorted(set(registry["removed"]) | {name})
        write_registry(registry)
    provider: FormulaProvider = {
        "name": name,
        "module": str(entry["module"]),
        "location": entry.get("location"),
    }
    return {
        "status": "completed",
        "summary": "Removed %s; its package stays installed." % name,
        "provider": provider,
        "exitCode": 0,
    }


def AnswerThroughAFormulaProvider(
    request: AnswerThroughAFormulaProviderRequest,
) -> AnswerThroughAFormulaProviderResponse:
    """journey.answer-through-a-formula-provider: register, list and remove the
    formula management providers every checkout reaches."""
    action = request["action"]
    if action == "register":
        done = invoke(
            "operation.register-provider",
            {
                "root": request.get("root"),
                "name": request.get("name") or "",
                "module": request.get("module") or "",
                "location": request.get("location"),
            },
        )
        return {
            "status": done["status"],
            "summary": done["summary"],
            "provider": done.get("provider"),
            "reason": done.get("reason"),
            "clashing": done.get("clashing"),
            "exitCode": done["exitCode"],
        }
    if action == "remove":
        gone = invoke("operation.remove-provider", {"name": request.get("name") or ""})
        return {
            "status": gone["status"],
            "summary": gone["summary"],
            "provider": gone.get("provider"),
            "reason": gone.get("reason"),
            "exitCode": gone["exitCode"],
        }
    providers: list[FormulaProvider] = []
    for name, entry in sorted(read_providers().items()):
        said = invoke("operation.describe-provider", {"name": name})
        if said.get("provider"):
            providers.append(said["provider"])
        else:
            providers.append(
                {
                    "name": name,
                    "module": str(entry["module"]),
                    "location": entry.get("location"),
                    "version": "",
                    "answers": [],
                    "unavailable": said["summary"],
                }
            )
    return {
        "status": "completed",
        "summary": "%d formula management provider%s registered."
        % (len(providers), "" if len(providers) == 1 else "s"),
        "providers": providers,
        "exitCode": 0,
    }


def RecordWhatAStepFound(
    request: RecordWhatAStepFoundRequest,
) -> RecordWhatAStepFoundResponse:
    """journey.record-what-a-step-found: the values given recorded on the
    step, when there are any, then the run read back."""
    asked = {"root": request.get("root"), "tracker": request.get("tracker"), "id": request["id"]}
    if request.get("values"):
        values = list(request.get("values") or [])
        recorded = invoke("operation.record-claim", dict(asked, values=values))
        if recorded["status"] != "completed":
            return {
                "status": recorded["status"],
                "summary": recorded["summary"],
                "reason": recorded.get("reason"),
                "exitCode": recorded.get("exitCode") or 1,
            }
    read = invoke("operation.read-run", asked)
    out: RecordWhatAStepFoundResponse = {
        "status": read["status"],
        "summary": read["summary"],
        "exitCode": read.get("exitCode") or 0,
    }
    if read.get("run"):
        out["run"] = read["run"]
    if read.get("reason"):
        out["reason"] = read["reason"]
    return out


def RecordClaim(request: RecordClaimRequest) -> RecordClaimResponse:
    """step.record-claim: the values recorded on an open claimed step through
    the tracker that holds it; a label that is not lowercase kebab-case, an
    item with no claim, or a closed one records nothing."""
    values = list(request["values"])
    bad = [v["label"] for v in values if not CLAIM_LABEL.match(v["label"])]
    if bad:
        return {
            "status": "failed",
            "reason": "bad-label",
            "exitCode": 2,
            "summary": '"%s" is not a label in lowercase kebab-case, so nothing was recorded.'
            % bad[0],
        }
    where = {"root": request.get("root"), "tracker": request.get("tracker")}
    # A short id is read as the tracker reads it, and the values go to the item
    # it names, by its whole id; a whole id read as another item's names none.
    shown = shown_for_a_word(
        request["id"], invoke_tracker("operation.show-item", dict(where, id=request["id"]))
    )
    if shown["status"] != "completed":
        return {
            "status": "failed",
            "reason": "item-not-found"
            if shown.get("reason") == "item-not-found"
            else "adapter-failed",
            "exitCode": 1,
            "summary": shown["summary"],
        }
    item = shown["item"]
    if not item.get("claim"):
        return {
            "status": "failed",
            "reason": "no-claim",
            "exitCode": 1,
            "summary": "%s has no claim, so nothing was recorded." % request["id"],
        }
    if item["status"] == "closed":
        return {
            "status": "failed",
            "reason": "step-closed",
            "exitCode": 1,
            "summary": "%s is closed, so nothing was recorded." % request["id"],
        }
    recorded = invoke_tracker(
        "operation.record-values", dict(where, id=str(item["id"]), values=values)
    )
    if recorded["status"] != "completed":
        return {
            "status": "failed",
            # The item deleted as its values were written is not found; a
            # tracker that records no claim's values says so.
            "reason": recorded["reason"]
            if recorded.get("reason") in ("item-not-found", "unsupported")
            else "adapter-failed",
            "exitCode": 1,
            "summary": recorded["summary"],
        }
    out: RecordClaimResponse = {
        "status": "completed",
        "summary": recorded["summary"],
        "exitCode": 0,
    }
    if recorded.get("item"):
        out["item"] = recorded["item"]
    return out


# In a root's verify-using, a placeholder names a step by its id and one of
# its slots after the last dot; a value fills it only when it is simple, so
# that no value can change what a means says beyond its slot.
CLAIM_SIMPLE = re.compile(r"[A-Za-z0-9._:/@+-]+\Z")


def filled(
    text: str, pattern: re.Pattern[str], look: Callable[..., str | None]
) -> tuple[str, list[str]]:
    """The text with each placeholder the pattern finds filled by look, and
    the placeholders left as written, each once, in the order they stand."""
    left: list[str] = []

    def one(m: re.Match[str]) -> str:
        value = look(*m.groups())
        if value is None:
            if m.group(0) not in left:
                left.append(m.group(0))
            return m.group(0)
        return value

    return pattern.sub(one, text), left


def ReadRun(request: ReadRunRequest) -> ReadRunResponse:
    """step.read-run: the run of the item named -- the root it names, when the
    item is a poured step, whatever parent it stands under now -- read from
    the steps poured in it and no other: each claim filled from its own
    values, the root's verify-using filled by step id from simple values,
    and every placeholder left open. A root the tracker holds no more is
    not found, whatever the tracker shows for its id (shown_by_its_id)."""
    where = {"root": request.get("root"), "tracker": request.get("tracker")}
    shown = invoke_tracker("operation.show-item", dict(where, id=request["id"]))
    if shown["status"] == "completed" and shown["item"].get("run"):
        its_run = str(shown["item"]["run"])
        shown = shown_by_its_id(
            its_run, invoke_tracker("operation.show-item", dict(where, id=its_run))
        )
    if shown["status"] != "completed":
        return {
            "status": "failed",
            "reason": "item-not-found"
            if shown.get("reason") == "item-not-found"
            else "adapter-failed",
            "exitCode": 1,
            "summary": shown["summary"],
        }
    top = shown["item"]
    # A step's parent can change; the run it was poured in cannot.
    listed = invoke_tracker("operation.list-items", dict(where, scope="all", run=top["id"]))
    if listed["status"] != "completed":
        return {
            "status": "failed",
            "reason": "adapter-failed",
            "exitCode": 1,
            "summary": listed["summary"],
        }
    steps: list[ClaimedStep] = []
    found: dict[str, dict[str, str]] = {}
    for kid in listed.get("items") or []:
        values = list(kid.get("values") or [])
        own = {v["label"]: v["text"] for v in values}
        if kid.get("step"):
            found[kid["step"]] = own
        claim = kid.get("claim")
        if not claim:
            continue
        text, left = filled(claim["statement"], CLAIM_PLACEHOLDER, own.get)
        steps.append(
            {
                "item": kid["id"],
                "step": kid.get("step") or "",
                "status": kid.get("status"),
                "statement": claim["statement"],
                "slots": list(claim["slots"]),
                "values": values,
                "claim": text,
                "open": left,
            }
        )

    def simple(inner: str) -> str | None:
        step, dot, label = inner.rpartition(".")
        value = found.get(step, {}).get(label) if dot and CLAIM_LABEL.match(label) else None
        return value if value is not None and CLAIM_SIMPLE.match(value) else None

    means, opened = [], []
    for m in top.get("verifyUsing") or []:
        text, left = filled(m, CLAIM_PLACEHOLDER, simple)
        means.append(text)
        opened += [x for x in left if x not in opened]
    run: ClaimRun = {
        "root": top["id"],
        "formula": top.get("title"),
        "steps": steps,
        "verifyUsing": means,
        "open": opened,
    }
    return {
        "status": "completed",
        "summary": "Read the run under %s." % top["id"],
        "run": run,
        "exitCode": 0,
    }


def MatchFormulas(request: MatchFormulasRequest) -> MatchFormulasResponse:
    """step.match-formulas: the procedures that apply to a title.

    The one place a title is ranked against the project's formulas. The
    conventions check reuses it with one example taken out of the index, and
    the handmade notice reuses it to see whether a formula already reaches a
    title -- both through this body, so the threshold lives here once, and
    both with `surface` false, so what they find is returned and not shown.
    """
    root = request["root"]
    built = invoke("operation.index-the-project", {"root": root, "background": True})
    if built["status"] != "completed":
        return {"status": "failed", "summary": built["summary"], "exitCode": built["exitCode"]}
    forms, idx = held_index(root)
    if idx is None:
        raise DoorError("operation.match-formulas needs the index with its background")
    text = "%s %s" % (request.get("title") or "", request.get("description") or "")
    words = toks(text)
    ranked = []
    taken_out: contextlib.AbstractContextManager[None] = contextlib.nullcontext()
    exclude = request.get("exclude")
    if exclude:
        # The example named, where the index holds it: the formula's position
        # and the example's within it.
        for i, f in enumerate(forms):
            if f["id"] == exclude.get("formulaRef") and exclude.get("example") in f["examples"]:
                taken_out = idx.without_example(i, f["examples"].index(exclude["example"]))
                break
    with taken_out:
        rows = idx.rows(words) if forms else []
        total = sum(idx.weight(w) for w in words) if rows else 0
        for rowid, score in rows:
            held = sum(idx.weight(w) for w in words if rowid in idx.spread(w)[0])
            if total and held / total >= COVERAGE:
                ranked.append((score, forms[rowid - 1]))
    ranked.sort(key=lambda r: (-r[0], r[1]["name"]))
    seen, top = set(), []
    for _score, f in ranked:
        if f["name"] in seen:
            continue
        seen.add(f["name"])
        top.append(f)
        if len(top) == TOP_N:
            break
    # The command printed to pour the first pours that very formula: its id,
    # unless the id answers to another -- a provider's suffix is the
    # provider's, and an id two formulas share is refused -- or would be read
    # as an option; then its path, from ./ when it would be read as one too.
    pour_ref = None
    if top:
        first = top[0]
        pour_ref = first["id"]
        if not first.get("provider") and (
            suffix_owner(first["id"], read_registry())
            or sum(1 for f in forms if f["id"] == first["id"]) > 1
            or first["id"].startswith("-")
        ):
            pour_ref = first["rel"]
            if pour_ref.startswith("-"):
                pour_ref = "./" + pour_ref
    return {
        "status": "completed",
        "summary": "%d formula%s apply." % (len(top), "" if len(top) == 1 else "s"),
        "surfaced": [held_formula(f) for f in top],
        "pourRef": pour_ref,
        "exitCode": 0,
    }


def NoticeHandmadeProcedures(
    request: NoticeHandmadeProceduresRequest,
) -> NoticeHandmadeProceduresResponse:
    """step.notice-handmade-procedures: procedures this project carried out but never declared.

    Pouring a formula leaves a root behind. A parent that is not a root, with
    several ordered children, is that same shape built by hand: the
    procedure exists, in the tracker, where nothing can match it against a
    title or pour it a second time. Unlike a guess at what two titles have in
    common, this cannot misfire -- the DAG is either there or it is not.
    Suppressed once a formula reaches the title, which is what writing it down
    means -- so this stops the moment it is acted on, and `--from` turns the
    work that was actually done into the steps.
    """
    root = request["root"]
    listed = invoke_tracker(
        "operation.list-items", {"root": root, "tracker": request.get("tracker"), "scope": "all"}
    )
    rows = listed.get("items") or [] if listed["status"] == "completed" else []
    byid: dict[str, Any] = {}
    kids: dict[str, list[Any]] = {}
    for r in rows:
        byid[r.get("id")] = r
        if r.get("parent"):
            kids.setdefault(r["parent"], []).append(r)
    found = []
    for pid, ks in sorted(kids.items(), key=lambda kv: -len(kv[1])):
        p = byid.get(pid) or {}
        if p.get("kind") == "root":
            continue
        if len(ks) < HANDMADE_STEPS:
            continue
        if not any(k.get("needs") for k in ks):
            continue
        title = " ".join(str(p.get("title") or "").split())
        if invoke("operation.match-formulas", {"root": root, "title": title, "surface": False})[
            "surfaced"
        ]:
            continue
        found.append((pid, title, len(ks)))
    return {
        "status": "completed",
        "summary": "%d undeclared procedure%s." % (len(found), "" if len(found) == 1 else "s"),
        "undeclared": [{"workRef": pid, "title": title, "stepCount": k} for pid, title, k in found],
        "exitCode": 0,
    }


def NudgeTowardsAFormula(request: NudgeTowardsAFormulaRequest) -> NudgeTowardsAFormulaResponse:
    """step.nudge-towards-a-formula: a memory that reads like a procedure.

    A procedure kept as a memory is one nothing can match or instantiate.
    Three agents in five reached for this instead of writing a formula.
    """
    text = request.get("text") or ""
    t = " " + " ".join(text.lower().split()) + " "
    procedural = sum(1 for w in PROCEDURAL if w in t) >= 2
    command = None
    if procedural:
        # Cut to a word, not to a letter: this goes in a command to be copied.
        short = " ".join(text.split())
        if len(short) > 60:
            short = short[: short.rfind(" ", 0, 61)]
        command = "%s formula new %s" % (PROG, shell_word(short))
    return {
        "status": "completed",
        "summary": "Reads like a procedure." if procedural else "Reads like a fact.",
        "nudged": procedural,
        "command": command,
        "exitCode": 0,
    }


# The rest of WriteFormula's body: the titles the project has already given
# its work, and an issue's children as steps. Used by nothing else.


class Titles:
    """The work this project has already named, matched the way formulas are.

    Word weights come from the formula index, whose background is the project's
    own prose -- so "menu" counts as distinctive here for the same reason it
    does there, and this table holds nothing but the titles.
    """

    def __init__(self, titles: list[str], idx: Index) -> None:
        self.titles = titles
        self.idx = idx
        self.db = sqlite3.connect(":memory:")
        try:
            self.db.execute("CREATE VIRTUAL TABLE t USING fts5(body, tokenize='porter unicode61')")
        except sqlite3.Error:
            no_fts5()
        self.db.executemany("INSERT INTO t VALUES (?)", [(t,) for t in titles])
        self._held: dict[str, frozenset[int]] = {}

    def holders(self, word: str) -> frozenset[int]:
        if word not in self._held:
            self._held[word] = frozenset(
                r[0]
                for r in self.db.execute("SELECT rowid FROM t WHERE t MATCH ?", ('"%s"' % word,))
            )
        return self._held[word]

    def echoes(self, text: str) -> list[tuple[float, str]]:
        """Earlier titles that look like this one, for seeding examples."""
        words = toks(text)
        if not words or not self.titles:
            return []
        total = sum(self.idx.weight(w) for w in words)
        if not total:
            return []
        out = []
        for i, t in enumerate(self.titles):
            held = sum(self.idx.weight(w) for w in words if (i + 1) in self.holders(w))
            if held / total >= SEED:
                out.append((held / total, t))
        out.sort(key=lambda r: (-r[0], r[1]))
        return out


def slug(title: str, limit: int = 4) -> str:
    words = [w for w in re.findall(r"[a-z0-9]+", title.lower()) if len(w) >= 2 and w not in STOP]
    return "-".join(words[:limit]) or "procedure"


def past_titles(root: str, tracker: str | None, drop: str | None = None) -> list[str]:
    """The top-level work this project has named before.

    Children of a poured root are left out: those titles came out of a
    formula, so counting them as evidence that a formula is wanted is
    circular. `drop` removes one copy of a title -- the one `create` just made.
    """
    listed = invoke_tracker(
        "operation.list-items", {"root": root, "tracker": tracker, "scope": "all"}
    )
    if listed["status"] != "completed":
        return []
    titles = []
    for r in listed.get("items") or []:
        if r.get("parent"):
            continue
        if r.get("kind") == "root":
            continue
        t = " ".join(str(r.get("title") or "").split())
        if t:
            titles.append(t)
    if drop:
        drop = " ".join(drop.split())
        if drop in titles:
            titles.remove(drop)
    return titles


def steps_from(root: str, tracker: str | None, ident: str) -> str | None:
    """An issue's children as steps, with its blocks edges as `needs`.

    The highest-fidelity capture there is: the procedure as it was actually
    carried out, rather than as someone remembers it afterwards.
    """
    listed = invoke_tracker(
        "operation.list-items", {"root": root, "tracker": tracker, "scope": "all"}
    )
    if listed["status"] != "completed":
        return None
    rows = listed.get("items") or []
    byid = {r.get("id"): r for r in rows}
    hit = [i for i in byid if i == ident or str(i).endswith("-" + ident)]
    if len(hit) != 1:
        return None
    parent = hit[0]
    kids = [r for r in rows if r.get("parent") == parent]
    if not kids:
        return None
    ids, used = {}, set()
    for r in kids:
        sid, k = slug(str(r.get("title") or ""), 3), 1
        while sid in used:
            k += 1
            sid = "%s-%d" % (slug(str(r.get("title") or ""), 3), k)
        used.add(sid)
        ids[r.get("id")] = sid
    needs = {}
    for r in kids:
        needs[ids[r["id"]]] = [ids[n] for n in (r.get("needs") or []) if n in ids]
    # In the order the work was done, not the order the tracker lists it: a
    # formula is read top to bottom by whoever has to follow it.
    order, left = [], [ids[r["id"]] for r in kids]
    while left:
        ready = [x for x in left if all(d in order for d in needs[x])]
        if not ready:  # a cycle; keep what is left as-is
            order.extend(left)
            break
        order.extend(ready)
        left = [x for x in left if x not in ready]
    titles = {ids[r["id"]]: str(r.get("title") or "").replace('"', "'") for r in kids}
    out = []
    for sid in order:
        block = STEP % {"id": sid, "title": titles[sid]}
        if needs[sid]:
            block += "needs = [%s]\n" % ", ".join('"%s"' % x for x in needs[sid])
        out.append(block)
    return "\n".join(out)


def WriteFormula(request: WriteFormulaRequest) -> WriteFormulaResponse:
    """step.write-formula: a formula for work the project keeps doing.

    The expensive part of declaring a procedure was never the thinking, it was
    the TOML: fifteen agents in the trial wrote the procedure down as prose
    instead, where nothing can match it against a title or pour it into steps.
    This writes the file, seeds the examples from the titles the work has
    actually been given here, and leaves the thinking marked TODO.
    """
    root, title = request["root"], request.get("title") or ""
    at, frm = request.get("directory"), request.get("fromRef")
    if not title:
        return {
            "status": "failed",
            "summary": "No title given.",
            "reason": "no-title",
            "exitCode": 2,
        }
    if frm:
        asked = {"root": root, "tracker": request.get("tracker"), "limit": 1}
        listed = invoke_tracker("operation.list-items", asked)
        if listed["status"] != "completed":
            reason = "not-installed" if listed.get("reason") == "not-installed" else None
            return failed_as(WriteFormulaResponse, reason, listed["summary"], listed["exitCode"])
    built = invoke("operation.index-the-project", {"root": root, "background": True})
    if built["status"] != "completed":
        return {"status": "failed", "summary": built["summary"], "exitCode": built["exitCode"]}
    idx = held_index(root)[1]
    if idx is None:
        raise DoorError("operation.write-formula needs the index with its background")
    cases = [title]
    for _, t in Titles(past_titles(root, request.get("tracker")), idx).echoes(title):
        if t not in cases:
            cases.append(t)
    steps = (frm and steps_from(root, request.get("tracker"), frm)) or PLACEHOLDER_STEPS
    name = slug(title)
    path = os.path.join(at or os.getcwd(), name + ".formula.toml")
    if os.path.exists(path):
        return {
            "status": "failed",
            "summary": "The file already exists.",
            "path": os.path.relpath(path, root),
            "reason": "exists",
            "exitCode": 1,
        }
    body = SCAFFOLD % {
        "p": PROG,
        "slug": name,
        "title": title.replace('"', "'"),
        "examples": "".join('  "%s",\n' % c.replace('"', "'") for c in cases),
        "steps": steps,
    }
    try:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(body)
    except OSError as e:
        return {
            "status": "failed",
            "summary": str(e),
            "path": os.path.relpath(path, root),
            "reason": "unwritable",
            "exitCode": 1,
        }
    rel = os.path.relpath(path, root)
    done = frm and steps is not PLACEHOLDER_STEPS
    return {
        "status": "completed",
        "summary": "Wrote %s." % rel,
        "path": rel,
        "seeded": len(cases),
        "stepsFrom": frm if done else None,
        "left": ["description"] if done else ["description", "steps"],
        "exitCode": 0,
    }


def DescribeAndCheck(request: DescribeAndCheckRequest) -> DescribeAndCheckResponse:
    """step.describe-and-check: the two conventions, checked rather than hoped for.

    Three places ask: `check` itself, in full; every `create`, quietly, with
    the first three problems; and `doctor` and `lint`, with the first five
    under the tracker's own report, because nobody in the trial ran `check`
    or `learn` and everybody ran those two. The request's `mode` names which,
    and the handmade notice rides along in the response for all three.
    """
    root, mode = request["root"], request.get("mode") or "check"
    built = invoke("operation.index-the-project", {"root": root, "background": True})
    if built["status"] != "completed":
        return {"status": "failed", "summary": built["summary"], "exitCode": built["exitCode"]}
    forms = held_index(root)[0]

    probs: list[tuple[Literal["convention", "formula"], str, str]] = []  # (kind, where, what)
    # Only once the project has adopted any of this: a plain repo is not in
    # breach of a convention it has never declared.
    if checkout_adopted(root):
        if git(["ls-files", "-z", "--", ".beads"], root):
            probs.append(
                (
                    "convention",
                    ".beads",
                    "tracked in git, left by an adoption before 0.4.0 -- "
                    "run: git rm -r -q .beads && git commit && rm -rf .beads",
                )
            )
        for rel in CONVENTION_FILES:
            try:
                with open(os.path.join(root, rel), encoding="utf-8") as fh:
                    if MARK_OPEN in fh.read():
                        continue
            except OSError:
                pass
            probs.append(
                ("convention", rel, "does not say where work starts -- run `%s init`" % PROG)
            )

    # What a fresh clone sees is what HEAD holds: a formula found here that
    # HEAD does not hold -- new, staged, or under an ignored directory -- is one
    # nobody else can see.
    unparsed = list(built.get("unparsed") or [])
    local = sorted({g["rel"] for g in forms if not g.get("provider")} | set(unparsed))
    at_head = (
        set(git(["ls-tree", "-z", "--name-only", "HEAD", "--", *local], root).split("\0"))
        if local
        else set()
    )
    for rel in local:
        if rel not in at_head:
            probs.append(("formula", rel, "not committed, so nobody else can see it"))
        if rel in unparsed:
            probs.append(("formula", rel, "does not parse, so nothing can find it"))

    home = os.path.expanduser("~/.beads/formulas")
    for p in sorted(
        glob.glob(os.path.join(home, "*.toml")) + glob.glob(os.path.join(home, "*.json"))
    ):
        probs.append(("formula", p, "outside the repo: the tracker finds it, nobody else does"))

    remotes: set[str] | None = None
    tracked: set[str] | None = None
    # A provider's formulas are the provider's to keep.
    for f in [g for g in forms if not g.get("provider")]:
        n = len(f["desc"].split())
        if n < MIN_DESC_WORDS:
            probs.append(
                (
                    "formula",
                    f["rel"],
                    "description is %d word%s -- write a sentence "
                    "naming the situation, and when to use it" % (n, "" if n == 1 else "s"),
                )
            )
        try:
            with open(os.path.join(root, f["rel"]), encoding="utf-8") as fh:
                if "TODO" in fh.read():
                    probs.append(
                        (
                            "formula",
                            f["rel"],
                            "still has TODO in it -- a scaffold is not yet a procedure",
                        )
                    )
        except OSError:
            pass
        if len(f["examples"]) < MIN_EXAMPLES:
            probs.append(
                (
                    "formula",
                    f["rel"],
                    "has %d example title%s, needs %d"
                    % (len(f["examples"]), "" if len(f["examples"]) == 1 else "s", MIN_EXAMPLES),
                )
            )
        for what in f.get("verifyUnread") or []:
            probs.append(("formula", f["rel"], what))
        for what in f.get("claimUnread") or []:
            probs.append(("formula", f["rel"], what))
        for value in f.get("verifyUsing") or []:
            if not value.startswith(VERIFY_FILES):
                continue
            url, _, path = value.partition("#")
            if CLAIM_PLACEHOLDER.search(path):
                continue  # a claimed slot names it, so it is known once the run records it
            if remotes is None:
                remotes = checkout_remotes(root)
            if repository_of(url[len("git+") :]) not in remotes:
                continue  # a file of another repository is shown as it is
            if tracked is None:
                tracked = {p for p in git(["ls-files", "-z"], root).split("\0") if p}
            path = path.strip("/")
            if path not in tracked and not any(p.startswith(path + "/") for p in tracked):
                probs.append(
                    (
                        "formula",
                        f["rel"],
                        "verify-using names %s, which git does not track here -- commit it, "
                        "or name the file that proves the run" % path,
                    )
                )

    registry = read_registry()
    reserved = sorted(set(registry["providers"]) | set(registry["removed"]))
    for f in forms:
        if f.get("provider"):
            continue
        for name in reserved:
            if f["id"].endswith("-" + name):
                probs.append(
                    (
                        "formula",
                        f["rel"],
                        (
                            "its id reads like a formula of the %s provider -- rename it"
                            if name in registry["providers"]
                            else "its id carries the suffix of the removed %s provider -- rename it"
                        )
                        % name,
                    )
                )

    for f in forms:
        for ex in f["examples"]:
            top = [
                s["name"]
                for s in invoke(
                    "operation.match-formulas",
                    {
                        "root": root,
                        "title": ex,
                        "surface": False,
                        "exclude": {"formulaRef": f["id"], "example": ex},
                    },
                )["surfaced"]
            ]
            if f["name"] not in top:
                probs.append(("formula", f["rel"], 'example "%s" does not retrieve it' % ex))

    noticed = invoke(
        "operation.notice-handmade-procedures", {"root": root, "tracker": request.get("tracker")}
    )
    return {
        "status": "completed" if not probs else "blocked",
        "summary": "%d problem%s." % (len(probs), "" if len(probs) == 1 else "s"),
        "problems": [{"kind": k, "where": w, "what": x} for k, w, x in probs],
        "undeclared": noticed["undeclared"],
        "formulaCount": len(forms),
        "exitCode": 1 if probs and mode == "check" else 0,
    }


def CommitFormula(request: CommitFormulaRequest) -> CommitFormulaResponse:
    """step.commit-formula: the one step dotdiw never performs.

    The commit is the worker's act, which the project asks for; a tool that
    made it would be deciding what goes into history on somebody's behalf.
    So this body refuses, and says exactly what to run instead.
    """
    path = request.get("path") or "<the formula file>"
    command = 'git add %s && git commit -m "Add the %s formula"' % (
        shlex.quote(path) if request.get("path") else path,
        os.path.basename(path).split(".")[0],
    )
    return {
        "status": "blocked",
        "summary": "The commit is the worker's: %s never commits, pushes or syncs." % PROG,
        "command": command,
        "exitCode": 0,
    }


def WriteAProcedureDown(request: WriteAProcedureDownRequest) -> WriteAProcedureDownResponse:
    """journey.write-a-procedure-down, as one executable: notice, nudge, write, check, and
    stop at the commit."""
    root = request["root"]
    built = invoke("operation.index-the-project", {"root": root, "background": True})
    if built["status"] != "completed":
        return {"status": "failed", "summary": built["summary"], "exitCode": built["exitCode"]}
    invoke(
        "operation.notice-handmade-procedures", {"root": root, "tracker": request.get("tracker")}
    )
    if request.get("text"):
        invoke("operation.nudge-towards-a-formula", {"root": root, "text": request["text"]})
    path = request.get("path")
    if request.get("title"):
        written = invoke(
            "operation.write-formula",
            {
                "root": root,
                "title": request["title"],
                "directory": request.get("directory"),
                "fromRef": request.get("fromRef"),
                "tracker": request.get("tracker"),
            },
        )
        if written["status"] != "completed":
            return {
                "status": written["status"],
                "summary": written["summary"],
                "path": written.get("path"),
                "exitCode": written["exitCode"],
            }
        path = written["path"]
    checked = invoke(
        "operation.describe-and-check",
        {"root": root, "mode": "check", "tracker": request.get("tracker")},
    )
    commit = invoke("operation.commit-formula", {"root": root, "path": path})
    return {
        "status": "blocked",
        "summary": commit["summary"],
        "command": commit["command"],
        "problems": checked["problems"],
        "path": path,
        "exitCode": checked["exitCode"],
    }


# ------------------------------------------- duty.put-all-four-under-one-name


def ForwardToTheTracker(request: ForwardToTheTrackerRequest) -> ForwardToTheTrackerResponse:
    """step.forward-to-the-tracker: the command as typed, through the chosen adapter.

    Under an adapter with a pass-through, an extra the beads adapter offers,
    the worker's command runs with the worker's terminal and the tracker's
    name rewritten in the stream, which is the whole of "one name for all
    four" and happens inside that adapter -- where dotdiw can hold what it
    would close and make wait to a run's rules before it runs. Under one
    without, the commands dotdiw owns -- list, ready, show, close, update,
    dep add -- are answered through the tracker interface, in records the
    presenter shows; help is the pass-through's to give, so --help, -h and
    help are answered with the conventions text, as bare dotdiw gives it;
    and any other command is unsupported.

    A command that closes an item or makes one wait is checked, written and
    logged under the workspace's lock, so that two dotdiw commands at once
    cannot each pass the check before the other writes, nor log out of the
    order they wrote in. Under every adapter, an
    item whose close leaves its poured root, or the root of the run it was
    poured in, with nothing open is followed by that root's close. The ids
    closed come back, in the order the command named them, the roots after;
    the door writes the steps and molecules among them to the witness log,
    and this body knows nothing of the log.
    """
    argv = list(request.get("arguments") or [])
    root, tracker = request.get("root"), request.get("tracker")
    common = {"root": root, "tracker": tracker}
    _, adapter = resolve_tracker(common)
    extras = adapter.get("extras") or {} if adapter is not None else {}
    if "forward" in extras and "read" not in extras:
        # A pass-through that reads no command for dotdiw: forwarded as given,
        # its closes and waits not dotdiw's to check.
        out = invoke_extra("forward", {"root": root, "tracker": tracker, "arguments": argv})
        return forwarded(argv, out, [], [])
    if "forward" in extras:
        return through_the_pass_through(common, argv)

    verb = argv[0] if argv else ""
    if verb in ("--help", "-h", "help"):
        taught = invoke("operation.teach-the-conventions", {})
        return {
            "status": "completed",
            "summary": "The conventions, in place of the tracker's help.",
            "exitCode": taught["exitCode"],
            "output": "",
            "closedRefs": [],
            "printed": True,
            "tracker": tracker,
        }
    plain, flags = command_words(argv)
    if verb == "list":
        parent = flags.get("--parent")
        answer = invoke_tracker(
            "operation.list-items",
            dict(
                common,
                scope="all" if "--all" in flags else "open",
                parent=parent if isinstance(parent, str) else None,
            ),
        )
        return answered(verb, "operation.list-items", [answer], [])
    if verb == "ready":
        answer = invoke_tracker("operation.ready-items", dict(common))
        return answered(verb, "operation.ready-items", [answer], [])
    if verb == "show" and len(plain) == 1:
        answer = invoke_tracker("operation.show-item", dict(common, id=plain[0]))
        return answered(verb, "operation.show-item", [answer], [])
    fields: dict[str, Any] = {}
    edges: list[tuple[str, str, str]] = []
    if verb == "close" and plain:
        operation = "operation.close-item"
    elif verb == "update" and len(plain) == 1:
        operation = "operation.update-item"
        for keys, field in (
            (("--title",), "title"),
            (("-s", "--status"), "status"),
            (("-p", "--priority"), "priority"),
            (("--parent",), "parent"),
            (("-a", "--assignee"), "assignee"),
        ):
            for k in keys:
                value = flags.get(k)
                if isinstance(value, str):
                    if field == "priority" and not value.isdigit():
                        return {
                            "status": "failed",
                            "exitCode": 1,
                            "summary": "A priority is a number, 0 the highest: %s." % value,
                            "output": "",
                            "closedRefs": [],
                            "printed": False,
                        }
                    fields[field] = int(value) if field == "priority" else value
        if fields.get("parent"):
            edges = [
                (
                    fields["parent"],
                    plain[0],
                    "%s cannot stand under %s" % (plain[0], fields["parent"]),
                )
            ]
    elif verb == "dep" and plain[:1] == ["add"] and len(plain) == 3:
        operation = "operation.add-need"
        edges = [(plain[1], plain[2], "%s cannot need %s" % (plain[1], plain[2]))]
    else:
        return {
            "status": "failed",
            "reason": "unsupported-command",
            "exitCode": 1,
            "summary": "%s is not a command of this tracker." % (verb or "nothing"),
            "output": "",
            "closedRefs": [],
            "printed": False,
        }
    with held_for_writing(root) as held:
        if not held:
            return refusal(operation, [TRACKER_BUSY])
        refused, _ = held_at_the_command_line(common, None, edges, None)
        if refused:
            return refusal(operation, refused)
        answers: list[Response] = []
        if operation == "operation.close-item":
            reason = (
                flags.get("--reason") if isinstance(flags.get("--reason"), str) else flags.get("-r")
            )
            for ident in plain:
                answers.append(
                    invoke_tracker(
                        "operation.close-item",
                        dict(
                            common,
                            id=ident,
                            closeReason=reason if isinstance(reason, str) else None,
                        ),
                    )
                )
            closed = [ident for a in answers for ident in (a.get("closedIds") or [])]
            records = {
                a["item"]["id"]: a["item"]
                for a in answers
                if a["status"] == "completed" and a.get("item")
            }
            answers += closes_that_follow(common, closed, records, None)
        elif operation == "operation.update-item":
            answers.append(
                invoke_tracker("operation.update-item", dict(common, id=plain[0], **fields))
            )
        else:
            answers.append(
                invoke_tracker("operation.add-need", dict(common, id=plain[1], needs=plain[2]))
            )
    closed = [ident for a in answers for ident in (a.get("closedIds") or [])]
    return answered(verb, operation, answers, closed)


def answered(
    verb: str, operation: str, answers: list[Response], closed: list[str]
) -> ForwardToTheTrackerResponse:
    """A command dotdiw answered through the tracker interface, as the
    presenter shows it: failed where any answer failed."""
    failed = [a for a in answers if a["status"] != "completed"]
    return {
        "status": "failed" if failed else "completed",
        "summary": failed[0]["summary"] if failed else "%s answered." % verb,
        "exitCode": 1 if failed else 0,
        "output": "",
        "closedRefs": closed,
        "operation": operation,
        "answers": answers,
        "printed": False,
        "tracker": answers[0].get("tracker") if answers else None,
        "reason": next(
            (
                a["reason"]
                for a in answers
                if a.get("reason") in ("tracker-unknown", "adapter-failed")
            ),
            None,
        ),
    }


def refusal(operation: str | None, refused: list[Response]) -> ForwardToTheTrackerResponse:
    """What dotdiw refused before the tracker ran anything, as the presenter
    shows it."""
    return {
        "status": "failed",
        "summary": refused[0]["summary"],
        "exitCode": 1,
        "output": "",
        "closedRefs": [],
        "reason": "unsupported-command"
        if refused[0].get("reason") == "unsupported-command"
        else None,
        "operation": operation,
        "answers": refused,
        "printed": False,
        "tracker": None,
    }


def through_the_pass_through(common: Request, argv: list[str]) -> ForwardToTheTrackerResponse:
    """A command under a pass-through: run only where dotdiw can hold what it
    would close and what it would make wait to a run's rules before it runs.
    One that closes nothing and makes nothing wait runs as it is; a close, an
    update, an edge run once checked, read as the tracker itself will read
    them -- every option by its own rules, so that no spelling of the command
    is checked as one thing and run as another; any other command of the
    tracker's is refused before it runs. A word the tracker knows by no
    command is the tracker's to refuse. A close is checked against a list of
    every item, and a list that leaves out an item the close names is not
    that: nothing runs on its word. A close runs with a mark the tracker
    keeps on what it closes, and what it named is read back after it ran,
    from a list held to every item listed before (what_the_close_closed):
    what carries the mark is what this command closed, and nothing else is
    taken for its close, whoever else is writing."""
    asks = tracker_command_at_sight(argv)
    closing_words: list[str] | None = None
    edges: list[tuple[str, str, str]] = []
    writes: list[str] = []
    if asks == "read":
        reading = invoke_extra("read", dict(common, arguments=argv))
        if reading["status"] == "completed":
            asks, closing_words, edges, writes = what_the_command_asks(reading)
        elif reading.get("reason") in TRACKER_CANNOT_ANSWER:
            asks = "as-it-is"  # the tracker cannot run it either, and says so
        else:
            asks = "refused:%s" % (argv[0] if argv else "it")
            unread = dict(reading, reason="unsupported-command")
            unread["summary"] = (
                "dotdiw does not run this: it cannot read the command as the tracker would, "
                "so it cannot check what it would close or make wait. %s" % reading["summary"]
            )
            return refusal(None, [unread])
    if asks.startswith("refused:"):
        return refusal(
            None,
            [
                {
                    "status": "failed",
                    "reason": "unsupported-command",
                    "exitCode": 1,
                    "summary": "dotdiw does not run %s: what it would close, or make wait, "
                    "cannot be checked against a run's steps before it runs."
                    % asks[len("refused:") :],
                }
            ],
        )
    if asks == "as-it-is":
        out = invoke_extra("forward", dict(common, arguments=argv))
        return forwarded(argv, out, [], [])
    operation = "operation.close-item" if closing_words is not None else "operation.add-need"
    with held_for_writing(common.get("root")) as held:
        if not held:
            return refusal(operation, [TRACKER_BUSY])
        every: dict[str, TrackerItem] | None = None
        if closing_words is not None:
            # Every item, of which those not closed stand open: a listing of
            # the open ones may leave out some that do, a pinned one in bd's.
            listed = invoke_tracker("operation.list-items", dict(common, scope="all"))
            if listed["status"] == "completed":
                every = {i["id"]: i for i in listed.get("items") or []}
            elif listed.get("reason") not in TRACKER_CANNOT_ANSWER:
                failed = dict(listed)
                failed["summary"] = (
                    "Nothing ran: what the tracker holds open could not be read, so no close "
                    "could be held to the steps it waits on. %s" % listed["summary"]
                )
                return refusal(operation, [failed])
        refused, closing = held_at_the_command_line(common, closing_words, edges, every, writes)
        if refused:
            return refusal(operation, refused)
        asked: Request = dict(common, arguments=argv)
        if closing and every is not None:
            # What the close may close: what it names, and any root that
            # stands open, since the tracker closes one of its own accord
            # when its last child closes -- whichever root an item it names
            # stands under by then, not the one it stood under when listed.
            asked["mark"] = os.urandom(8).hex()
            asked["marked"] = closing + [
                i
                for i, o in every.items()
                if o.get("kind") == "root" and o.get("status") != "closed" and i not in closing
            ]
        out = invoke_extra("forward", asked)
        closed: list[str] = []
        notes: list[Response] = []
        if closing and every is not None and out.get("reason") != "not-installed":
            closed, notes = what_the_close_closed(
                common, closing, every, out.get("markedIds"), out.get("exitCode", 1) != 0
            )
    return forwarded(argv, out, closed, notes)


def forwarded(
    argv: list[str], out: Response, closed: list[str], notes: list[Response]
) -> ForwardToTheTrackerResponse:
    """The tracker's own answer to a command it ran, with what dotdiw did
    after it: failed where that failed, though the tracker's command did not."""
    code = out.get("exitCode", 1)
    stopped = [n for n in notes if n["status"] != "completed"]
    return {
        "status": "completed" if code == 0 and not stopped else "failed",
        "summary": stopped[0]["summary"]
        if stopped
        else "%s %s exited %d." % ("tracker", argv[0] if argv else "", code)
        if out.get("printed")
        else out["summary"],
        "exitCode": 1 if stopped and code == 0 else code,
        "output": out.get("output") or "",
        "closedRefs": closed,
        "answers": notes,
        "reason": out.get("reason"),
        "printed": bool(out.get("printed")),
        "tracker": out.get("tracker"),
    }


