# ============================================================ infrastructure
#
# Shared by any body below, and deciding nothing about the product: how to run
# git and bd, the pty plumbing, tokenising, the FTS storage, file parsing, and
# appending to the witness log. Everything after this section is one
# operation's body.

def find_bd():
    return shutil.which("bd") or shutil.which("beads")


def git(args, cwd=None):
    try:
        p = subprocess.run(["git"] + args, capture_output=True, text=True,
                           timeout=10, cwd=cwd)
        if p.returncode == 0:
            return p.stdout
    except (OSError, subprocess.SubprocessError):
        pass
    return ""


def repo_root():
    return git(["rev-parse", "--show-toplevel"]).strip() or os.getcwd()


# root -> its workspace, read once per process. A checkout's key does not
# change during one run, except when init writes it, which forgets it below.
WORKSPACES = {}


def workspace(root):
    """~/.dotdiw/<id> for this checkout, or None when it has no key.

    Read with --local on purpose: a worktree then sees the checkout's key and
    a value set globally by mistake is never taken for one.
    """
    if root in WORKSPACES:
        return WORKSPACES[root]
    key = git(["config", "--local", "--get", WORKSPACE_KEY], root).strip()
    ws = os.path.join(os.path.expanduser(DOTDIW_HOME), key) if key else None
    WORKSPACES[root] = ws
    return ws


def forget_workspace(root):
    """After the key is written: the next read sees it."""
    WORKSPACES.pop(root, None)


def beads_dir(ws):
    return os.path.join(ws, ".beads")


def adopted(ws):
    """Whether the workspace has a tracker in it, not only a key pointing at it."""
    return bool(ws) and os.path.isdir(beads_dir(ws))


def bd_quiet(args):
    """Run bd for its output only, nothing printed."""
    bd = find_bd()
    if not bd:
        return 127, ""
    p = subprocess.run([bd] + list(args), capture_output=True, text=True)
    return p.returncode, p.stdout


def _hold_partial(buf):
    """Split off a short alphanumeric tail that may be half of a split token."""
    i, n = len(buf), 0
    while i > 0 and chr(buf[i - 1]).isalnum() and n < 3:
        i -= 1
        n += 1
    return buf[:i], buf[i:]


def run_bd(args, filter_text, filter_bytes):
    """Run bd with the worker's terminal, every byte of output through a filter.

    What the filter does is the caller's decision; this only knows how to keep
    interactive prompts working while the stream is filtered. Returns the exit
    code and the filtered text that went past, for the caller to read.
    """
    bd = find_bd()
    if not bd:
        sys.stderr.write("%s is not fully installed. Run: brew install adimpression/tap/dotdiw\n" % PROG)
        return 127, ""
    argv = [bd] + list(args)

    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        p = subprocess.run(argv, capture_output=True, text=True)
        out, err = filter_text(p.stdout), filter_text(p.stderr)
        sys.stdout.write(out)
        sys.stdout.flush()
        sys.stderr.write(err)
        sys.stderr.flush()
        return p.returncode, out + err

    # A pty, so interactive prompts still work while the stream is filtered.
    import pty
    carry = bytearray()
    seen = bytearray()

    def reader(fd):
        data = os.read(fd, 4096)
        if not data:
            out = filter_bytes(bytes(carry))
            del carry[:]
            seen.extend(out)
            return out
        carry.extend(data)
        head, tail = _hold_partial(bytes(carry))
        del carry[:]
        carry.extend(tail)
        out = filter_bytes(head)
        seen.extend(out)
        return out

    code = os.waitstatus_to_exitcode(pty.spawn(argv, reader))
    return code, bytes(seen).decode("utf-8", "replace")


def toks(s):
    """The words of a query. FTS5's porter tokenizer does the stemming."""
    return list(dict.fromkeys(
        w for w in re.findall(r"[a-z0-9]+", s.lower())
        if len(w) >= 2 and w not in STOP))


def load_formula(root, rel):
    path = os.path.join(root, rel)
    try:
        with open(path, "rb") as fh:
            if path.endswith(".toml"):
                if tomllib is None:
                    return None
                data = tomllib.load(fh)
            else:
                data = json.load(fh)
    except Exception:
        return None

    name = os.path.basename(path).split(".")[0]
    desc = str(data.get("description", ""))
    ex = data.get("examples") or data.get("keywords") or []
    if isinstance(ex, str):
        ex = [ex]
    ex = [str(e) for e in ex]
    # The directory is matchable text too: services/billing/ says "billing"
    # without the description having to repeat it.
    where = " ".join(re.split(r"[/\\._-]+", os.path.dirname(rel)))
    return {
        "name": name,
        "rel": rel,
        "id": str(data.get("formula") or name),
        "desc": desc,
        "examples": ex,
        "words": name.replace("-", " "),
        "where": where,
    }


def held_formula(f):
    """A formula as a response carries it: the IDL's HeldFormula record."""
    return {"formulaRef": f["id"], "name": f["name"], "description": f["desc"],
            "path": f["rel"], "examples": list(f["examples"])}


def no_fts5():
    """Retrieval is FTS5, and some SQLite builds are compiled without it."""
    sys.stderr.write(
        "%s needs SQLite built with FTS5, and this interpreter's is not.\n"
        "  brew install %s installs its own interpreter; this one came from "
        "elsewhere.\n" % (PROG, PROG))
    sys.exit(4)


class Index:
    """BM25 storage over the formulas, with the project's prose for word weight.

    SQLite's FTS5 does the retrieval: its porter stemmer reaches "failing"
    from "fail", and bm25() ranks on how distinctive a word is instead of on
    how many words happened to overlap. What counts as a match -- the
    coverage floor, how many to show -- is MatchFormulas' decision, not this
    class's; this only stores, weighs and ranks.
    """

    COLUMNS = ("fname", "place", "body", "cases")

    def __init__(self, forms, bg):
        self.forms = forms
        self.nbg = len(bg)
        self._spread_cache = {}
        self.db = sqlite3.connect(":memory:")
        try:
            self.db.execute(
                "CREATE VIRTUAL TABLE f USING fts5(%s, "
                "tokenize='porter unicode61')" % ", ".join(self.COLUMNS))
        except sqlite3.Error:
            no_fts5()
        rows = [(f["words"], f["where"], f["desc"], " ".join(f["examples"]))
                for f in forms]
        # Formulas take rowid 1..N, so everything after them is background.
        rows += [("", "", text, "") for text in bg]
        self.db.executemany(
            "INSERT INTO f VALUES (?, ?, ?, ?)", rows)
        self.sql = (
            "SELECT rowid, -bm25(f, %s) AS s FROM f "
            "WHERE f MATCH ? AND rowid <= ?"
            % ", ".join("%g" % w for w in WEIGHTS))

    def spread(self, word):
        """Which formulas hold this word, and how many background documents do.

        One query per word, so a title costs a handful however many formulas
        the project has.
        """
        if word not in self._spread_cache:
            n = len(self.forms)
            rows = [r[0] for r in self.db.execute(
                "SELECT rowid FROM f WHERE f MATCH ?", ('"%s"' % word,))]
            self._spread_cache[word] = (frozenset(r for r in rows if r <= n),
                                        sum(1 for r in rows if r > n))
        return self._spread_cache[word]

    def weight(self, word):
        """How distinctive a word is in this project.

        Smoothed so it stays positive. bm25's own idf is zero for a word in
        half the corpus, and in a project with one formula and one README that
        is every word there is.
        """
        held = self.spread(word)[1]
        return math.log((self.nbg - held + 0.5) / (held + 0.5) + 1.0)

    def rows(self, words):
        """(rowid, bm25 score) for every formula holding any of the words."""
        if not words or not self.forms:
            return []
        match = " OR ".join('"%s"' % w for w in words)
        try:
            return self.db.execute(self.sql, (match, len(self.forms))).fetchall()
        except sqlite3.Error:
            return []

    @contextlib.contextmanager
    def without_example(self, i, j):
        """The index as if formula i had never listed example j.

        A self-test that leaves the example in place proves nothing: the
        title is in the index, so of course it finds itself.
        """
        ex = self.forms[i]["examples"]
        before = " ".join(ex)
        kept = " ".join(e for k, e in enumerate(ex) if k != j)
        self.db.execute("UPDATE f SET cases = ? WHERE rowid = ?", (kept, i + 1))
        self._spread_cache.clear()
        try:
            yield
        finally:
            self.db.execute("UPDATE f SET cases = ? WHERE rowid = ?",
                            (before, i + 1))
            self._spread_cache.clear()


# root -> (formulas, index or None), held once per process: the tree does not
# change during one run. The objects are not fields of any response, so this
# is where a body that needs them finds what IndexTheProject built.
INDEXES = {}


def hold_index(root, forms, idx):
    INDEXES[root] = (forms, idx)


def held_index(root):
    """What IndexTheProject has built for this root in this process, or None."""
    return INDEXES.get(root)


def witness_on(ws):
    """Whether this checkout's tracker is keeping the witness log."""
    return bool(ws) and (bool(os.environ.get("DOTDIW_WITNESS"))
                         or os.path.exists(os.path.join(ws, WITNESS_FILE)))


def witness(ws, source, label, **fields):
    """Append one observed event. Which events exist is each body's decision."""
    now = datetime.datetime.now(datetime.timezone.utc)
    stamp = now.strftime("%Y-%m-%dT%H:%M:%S.%fZ")
    event = {"observedEventId": "%s-%s-%d" % (label, now.strftime("%Y%m%d%H%M%S%f"),
                                              os.getpid()),
             "label": label}
    event.update((k, v) for k, v in fields.items() if v is not None)
    event.update({"occurredAt": stamp, "observedAt": stamp, "source": source})
    if not ws or not os.path.isdir(ws):
        return
    path = os.path.join(ws, WITNESS_FILE)
    try:
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(event, ensure_ascii=False) + "\n")
    except OSError:
        pass


def witnessed(ws):
    """The events this checkout's log holds, oldest first."""
    out = []
    if not ws:
        return out
    try:
        with open(os.path.join(ws, WITNESS_FILE), encoding="utf-8") as fh:
            for line in fh:
                try:
                    out.append(json.loads(line))
                except ValueError:
                    continue
    except OSError:
        pass
    return out


# ================================================================ operations
#
# One function per operation in operation-idl.json, in the order the duties
# hold them. Each takes a request dict and returns a dict carrying `status`
# (completed, blocked or failed), `summary`, `exitCode`, and whatever else the
# IDL's response type names. An operation calls another only through the
# door, `invoke`, by the operation's id. A body prints nothing: what the
# worker sees of a response is the command line's to show, in present(),
# as the operation returns. The one exception is the tracker's own stream,
# which ForwardToTheTracker passes through with the worker's terminal.

# --------------------------------------------- duty.teach-without-a-project

