        ]
        poured = ask("pour-steps", formulaRef="mol-calls", title="mol-calls", steps=steps)
        expect(poured["status"] == "completed", "a pour of a call: %s" % poured.get("summary"))
        call, a, b, after = poured["stepIds"]
        root = poured["rootId"]
        shown = ask("show-item", id=call)["item"]
        expect(
            (shown.get("step"), shown.get("calls"), shown.get("run"), shown.get("verifyUsing"))
            == ("call", "mol-called", root, ["run:make called"])
            and shown.get("description") == "The formula called."
            and {a, b} <= set(shown.get("needs") or []),
            "a calling step keeps the formula it calls, its description and means, its run, "
            "and needs what is poured within it: %s" % shown,
        )
        inner = ask("show-item", id=b)["item"]
        expect(
            (inner.get("step"), inner.get("within"), inner.get("run"), inner.get("needs"))
            == ("b", call, root, [a]),
            "a step poured within a call keeps the calling step and its run: %s" % inner,
        )
        ready_now = [i["id"] for i in ask("ready-items").get("items") or []]
        expect(
            a in ready_now and call not in ready_now and after not in ready_now,
            "a calling step is not ready while what is within it is open",
        )
        refused = ask("close-item", id=call)
        expect(
            refused.get("status") == "blocked" and a in (refused.get("blockedBy") or []),
            "close-item refuses a calling step while what is within it is open: %s"
            % refused.get("summary"),
        )
        kept = ask("update-item", id=call, dropNeeds=[a])
        expect(
            kept.get("status") != "completed"
            and a in (ask("show-item", id=call)["item"].get("needs") or []),
            "update-item takes off no need of a calling step on what is within it: %s"
            % kept.get("summary"),
        )
        ask("close-item", id=a)
        last = ask("close-item", id=b)
        if call not in (last.get("closedIds") or []):
            closing = ask("close-item", id=call)
            expect(
                closing.get("status") == "completed",
                "a calling step closes once what is within it is: %s" % closing.get("summary"),
            )
        expect(
            ask("show-item", id=call)["item"]["status"] == "closed",
            "the calling step stands closed once what is within it is",
        )
        done = ask("close-item", id=after)
        if root not in (done.get("closedIds") or []):
            closing = ask("close-item", id=root)
            expect(
                closing.get("status") == "completed",
                "the root closes once every step of the job is: %s" % closing.get("summary"),
            )
        expect(
            ask("show-item", id=root)["item"]["status"] == "closed",
            "the root stands closed once every step of the job is",
        )
        caller = ask("create-item", title="Moved call", run=root, calls="mol-moved")
        moved = ask(
            "create-item", title="Moved within", run=root, within=caller["item"]["id"], step="m"
        )
        expect(
            moved["status"] == "completed"
            and ask("show-item", id=moved["item"]["id"])["item"].get("within")
            == caller["item"]["id"]
            and ask("show-item", id=caller["item"]["id"])["item"].get("calls") == "mol-moved"
            and moved["item"]["id"]
            in (ask("show-item", id=caller["item"]["id"])["item"].get("needs") or []),
            "create-item takes within and calls for a move, the calling step needing the item",
        )

    def pour_and_calls() -> None:
        pour()
        calls()

    for operation, body in (
        ("operation.open-tracker", open_tracker),
        ("operation.describe-tracker", describe),
        ("operation.create-item", create),
        ("operation.add-need", need),
        ("operation.show-item", show),
        ("operation.ready-items", ready),
        ("operation.close-item", close),
        ("operation.list-items", listing),
        ("operation.update-item", update),
        ("operation.pour-steps", pour_and_calls),
        ("operation.record-values", claims),
    ):
        check(operation, body)
    return results


@contextlib.contextmanager
def candidate_registered(name: str) -> Iterator[None]:
    """The length of a check by path: what the file registers under this stem lasts
    that long. After it the adapter of that name and its module are back, a file that
    did not load counts against nothing, and nothing the file imported has left
    bytecode beside it."""
    tables: list[tuple[dict[str, Any], str]] = [
        (TRACKERS, name),
        (sys.modules, "dotdiw_tracker_" + name),
        (LOAD_FAILED, name),
    ]
    held = [(table, key, table.get(key)) for table, key in tables]
    tried, writes = name in LOAD_TRIED, sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        yield
    finally:
        sys.dont_write_bytecode = writes
        (LOAD_TRIED.add if tried else LOAD_TRIED.discard)(name)
        for table, key, value in held:
            if value is None:
                table.pop(key, None)
            else:
                table[key] = value


def CheckTracker(request: CheckTrackerRequest) -> CheckTrackerResponse:
    """step.check-tracker: the conformance scenario against the adapter's
    declared check target, one result per operation; never against live
    work. The target is the prefix the scenario opens its store under --
    the project a hosted tracker lets the check fill -- and the workspace
    it runs in is a scratch one under ~/.dotdiw, made for the run and
    removed after it; the shipped adapters' stores go with it. A file given
    by path is checked without being installed, under its stem, as it stands
    now, and registered for the length of the check. The check runs alone in
    its process (Gate): it changes, for its length, the working directory,
    the environment and the adapter registered under the name, which every
    request running in the process shares."""
    name, path = request["name"], request.get("path")
    registered: contextlib.AbstractContextManager[None] = contextlib.nullcontext()
    if path:
        if not re.fullmatch(TRACKER_NAME, name):
            return failed_as(CheckTrackerResponse, "bad-name", BAD_TRACKER_NAME % name)
        if name in TRACKERS and not is_loaded(TRACKERS[name]):
            return failed_as(CheckTrackerResponse, "shipped-name", SHIPPED_TRACKER_NAME % name)
        if not os.path.isfile(path):
            return failed_as(CheckTrackerResponse, "no-such-file", "%s is not a file." % path)
        registered = candidate_registered(name)
    with GATE.by_itself(), registered:
        if not (load_tracker(name, path) if path else name in TRACKERS or load_tracker(name)):
            return tracker_unknown(CheckTrackerResponse, name)
        described = invoke_tracker(
            "operation.describe-tracker", {"root": request.get("root"), "tracker": name}
        )
        if described.get("reason") == "not-installed":
            return failed_as(
                CheckTrackerResponse, "not-installed", described["summary"], described["exitCode"]
            )
        target = TRACKERS[name]["info"].get("checkTarget")
        if not target:
            return {
                "status": "failed",
                "reason": "no-check-target",
                "exitCode": 1,
                "summary": "%s declares no check target; the scenario runs against nothing unasked."
                % name,
            }
        key = "check-" + os.urandom(6).hex()
        ws = os.path.join(os.path.expanduser(DOTDIW_HOME), key)
        scratch, here = "", ""
        # A hook in a linked worktree runs with GIT_DIR exported, which would turn every
        # git call below on that checkout, whatever directory the call runs in. A
        # tracker's own binary reads the directory it runs in, so that moves as well.
        hidden = {
            k: os.environ.pop(k)
            for k in git(["rev-parse", "--local-env-vars"]).split()
            if k in os.environ
        }
        try:
            here = os.getcwd()
            scratch = tempfile.mkdtemp(prefix="%s-check-" % PROG)
            git(["init", "-q"], scratch)
            git(["config", "--local", WORKSPACE_KEY, key], scratch)
            os.makedirs(ws, exist_ok=True)
            os.chdir(scratch)
            results = conformance_scenario(
                lambda operation, **req: invoke_tracker(
                    "operation." + operation, dict(req, root=scratch, tracker=name)
                ),
                prefix=target,
            )
        except OSError as e:
            return {
                "status": "failed",
                "summary": "The check has nowhere to run: %s" % e,
                "exitCode": 1,
            }
        finally:
            os.environ.update(hidden)
            if here:
                os.chdir(here)
            forget_workspace(scratch)
            if scratch:
                shutil.rmtree(scratch, ignore_errors=True)
            shutil.rmtree(ws, ignore_errors=True)
        failed = [r for r in results if r["status"] != "pass"]
        return {
            "status": "completed" if not failed else "failed",
            "summary": "%s passed %d of %d." % (name, len(results) - len(failed), len(results))
            if not failed
            else "%s failed at %s: %s" % (name, failed[0]["operation"], failed[0].get("detail")),
            "results": results,
            "passed": not failed,
            "exitCode": 0 if not failed else 1,
        }


def MigrateWorkspace(request: MigrateWorkspaceRequest) -> MigrateWorkspaceResponse:
    """step.migrate-workspace: everything the source holds, written into the
    target -- open items first, then closed ones with their reasons, then
    the needs -- each item read whole, its description and its means handed
    over as given, and the source left as it was. Ids are asked for and kept
    where the target honours them. The record beside the stores says which
    items are made and which have nothing left to write, and is saved as
    each item is made, so a second run makes only what the record does not
    hold and finishes the needs, statuses and closes of those it holds
    unfinished. A target that refuses any of it stops the move, failed, with
    what it refused named; what was written stays, and the next run continues.
    A move holds the workspace from its listing through the last save of its
    record, so that a second move at once makes nothing the first made; it
    reads the source whole -- the listing, and each item it makes, shown --
    under the lock a write of the source holds, and lets go of it before it
    writes, so that it reads no write half made, a run's steps without their
    needs, and records nothing settled as the source never held it; it
    opens the target under the lock an adoption of the checkout holds, so
    that the store one of the two makes is the one the other finds; and it
    writes the target under the target's lock, held from its first write
    there to its last, as a pour holds it, so that no write held to what was
    read lands between its compare and its write, nor between an item the
    move made and the needs, status and close it writes of it -- no step made
    is closed before it waits on what it needs. A run that stops leaves what
    it made unsettled in the record, and that, nothing but the move closes,
    nor gives as ready, until a run of the move finishes it
    (made_by_a_stopped_move): a step it made stays unclosed across the stop,
    though its needs be not yet written. So does an item the target made and
    could not finish or read back, a create failing that names it (madeId):
    the next run reads it back before it writes anything, and finishes it as
    made, makes it again where the target holds none and the run is told it
    was deleted there (deletedIds), or writes nothing more -- where the
    target holds none and the run is not told so, since a tracker answers so
    of an item its caller may not see, and where it holds not what only its
    make writes. The record says where the move reads and writes, the stores
    the source and the target name (storeId), and the checkout it ran in; a
    run whose source or target names another store than the record does
    writes nothing, the record's ids naming another item there, or none; and
    so does a run of a record that holds what it made and names no store
    where the tracker names one, as an earlier dotdiw's, until it is told the
    store is the record's (fromStore, toStore). A move whose source holds what a
    stopped move into it made writes nothing: it would read that half made,
    and settle it so."""
    root, src, dst = request["root"], request["fromTracker"], request["toTracker"]
    # A store given empty is none given, as a client that sends every field sends it.
    request = cast(
        MigrateWorkspaceRequest,
        dict(
            request,
            fromStore=request.get("fromStore") or None,
            toStore=request.get("toStore") or None,
        ),
    )
    if src == dst:
        return {
            "status": "failed",
            "reason": "same-tracker",
            "exitCode": 1,
            "summary": "%s is the source and the target both." % src,
        }
    for name in (src, dst):
        if not (name in TRACKERS or load_tracker(name)):
            return tracker_unknown(MigrateWorkspaceResponse, name)
    ws = workspace(root)
    if ws is None:
        return {
            "status": "failed",
            "summary": "This checkout has no workspace; init adopts it.",
            "exitCode": 1,
        }
    # One move of a workspace at a time, from its listing through the last
    # save of its record: a second move at once would read the record before
    # the first had saved what it made, and make it again.
    with held_at(os.path.join(ws, MIGRATION_LOCK)) as held:
        if not held:
            return {
                "status": "failed",
                "exitCode": 1,
                "summary": "Nothing was moved: another move of this workspace held it "
                "for a minute.",
            }
        path = os.path.join(ws, "migration-%s-to-%s.json" % (src, dst))
        try:
            with open(path, encoding="utf-8") as fh:
                record = json.load(fh)
        except (OSError, ValueError):
            record = {"from": src, "to": dst, "ids": {}}
        if not isinstance(record, dict):
            return {"status": "failed", "exitCode": 1, "summary": MOVE_NO_RECORD % path}

        def record_misshapen(record: Mapping[str, Any]) -> str | None:
            """The first field of a move's record that is not as a move keeps it,
            or None: a run trusts each field's shape, and one it cannot read stops
            it before anything is written."""

            def words(value: Any) -> bool:
                return isinstance(value, list) and all(isinstance(v, str) for v in value)

            def maybe_word(value: Any) -> bool:
                return value is None or isinstance(value, str)

            def remarks(value: Any) -> bool:
                return isinstance(value, dict) and all(
                    isinstance(held, dict) and all(words(r) for r in held.values())
                    for held in value.values()
                )

            shapes: dict[str, Callable[[Any], bool]] = {
                "ids": lambda v: (
                    isinstance(v, dict)
                    and all(isinstance(a, str) and isinstance(b, str) for a, b in v.items())
                ),
                "linked": lambda v: (
                    isinstance(v, list)
                    and all(isinstance(e, list) and len(e) == 2 and words(e) for e in v)
                ),
                "settled": words,
                "unparented": words,
                "unread": words,
                "gone": words,
                "relink": words,
                "said": lambda v: (
                    isinstance(v, dict)
                    and all(remarks(x) if k == "copies" else words(x) for k, x in v.items())
                ),
                "madeAs": lambda v: (
                    isinstance(v, dict) and all(isinstance(x, dict) for x in v.values())
                ),
                "labels": lambda v: isinstance(v, dict) and all(words(x) for x in v.values()),
                "store": maybe_word,
                "fromStore": maybe_word,
                "checkout": maybe_word,
            }
            for field, holds in shapes.items():
                if field in record and not holds(record[field]):
                    return field
            return None

        misshapen = record_misshapen(record)
        if misshapen is not None:
            return {
                "status": "failed",
                "exitCode": 1,
                "summary": MOVE_RECORD_MISSHAPEN % (path, misshapen),
            }
        if (record.get("from"), record.get("to")) not in ((src, dst), (None, None)):
            # Two names that join alike -- a to b-to-c, a-to-b to c -- share
            # the record's name: another move's record is none of this one's.
            return {
                "status": "failed",
                "exitCode": 1,
                "summary": MOVE_OTHERS_RECORD
                % (path, record.get("from"), record.get("to"), src, dst),
            }
        # One that names neither, as an earlier dotdiw's, is this move's from
        # now on, so that what it holds is held to this pair.
        record["from"], record["to"] = src, dst
        if any(
            not str(w)
            for w in [*(request.get("deletedIds") or []), *(request.get("sourceGoneIds") or [])]
        ):
            return {"status": "failed", "exitCode": 1, "summary": MOVE_TOLD_EMPTY}
        ids = record.setdefault("ids", {})  # source id -> target id: the item is made there
        linked = record.setdefault("linked", [])  # [source id, source need]: the edge is there
        settled = record.setdefault("settled", [])  # source ids with nothing left to write
        unparented = record.setdefault("unparented", [])  # made before their parent, set after it
        unread = record.setdefault("unread", [])  # made, the make failing after: read back first
        gone = record.setdefault("gone", [])  # made, unfinished, and the source holds it no more
        relink = record.setdefault("relink", [])  # finished, but for a need to write again
        # source id -> the labels of the values the move wrote on its copy, so
        # that one the source takes off is taken off the copy too, and only
        # one recorded there alone is kept
        labels_of: dict[str, list[str]] = record.setdefault("labels", {})
        deleted = set(request.get("deletedIds") or [])  # deleted in the target, the run is told
        source_gone = set(request.get("sourceGoneIds") or [])  # deleted there, as told
        # What the runs since the move last finished did that the one that
        # finishes it says: what each left out or kept as made, and what it
        # was told and acted on, kept across the runs a stop cuts it into.
        said: dict[str, Any] = dict(record.get("said") or {})
        # And of each copy a run brought in line, what of it the copy keeps
        # that the source does not show, by what it is -- its fields, its
        # parent, its values, its labels, its needs, its close reason -- each
        # said afresh by the run that last looks at it, so that what a later
        # run brings in line is said no more.
        of_copies: dict[str, dict[str, list[str]]] = {
            str(k): dict(v) for k, v in (said.get("copies") or {}).items() if isinstance(v, dict)
        }
        moved = 0

        def kept_said() -> None:
            """What is said, as this run has it, the record's to save: what
            it took back included."""
            if of_copies:
                said["copies"] = of_copies
            else:
                said.pop("copies", None)
            record["said"] = said

        def note(key: str, values: Iterable[str]) -> None:
            kept = said.setdefault(key, [])
            kept.extend(v for v in values if v not in kept)
            if not kept:
                del said[key]
            kept_said()

        looked_at: set[str] = set()  # the copies this run says anything of, afresh

        def aspect(copy: str, what: str, values: Iterable[str]) -> None:
            """What the copy keeps, by what it is, as this run finds it: none
            takes back what an earlier run said of it."""
            looked_at.add(copy)
            held = of_copies.setdefault(copy, {})
            held[what] = list(values)
            if not held[what]:
                del held[what]
            if not held:
                del of_copies[copy]
            kept_said()

        def forget(ident: str) -> None:
            """An item whose copy the move makes again, or forgets: what it
            kept of that copy, and what was said of it, go with it."""
            of_copies.pop(ids[ident], None)
            kept_said()
            labels_of.pop(ident, None)
            (record.get("madeAs") or {}).pop(ident, None)
            del ids[ident]

        def made_as(fields: Mapping[str, Any]) -> dict[str, str]:
            """What only a make writes, as a digest of each field: what a
            copy the move made and could not read back must still hold."""
            return {
                field: hashlib.sha256(
                    json.dumps(fields.get(field) or None, sort_keys=True).encode("utf-8")
                ).hexdigest()[:16]
                for field in MADE_ONLY_BY_A_MAKE
            }

        def kept_in(tracker: str) -> str | None:
            """Where the tracker keeps this checkout's items, as it names them."""
            described = invoke_tracker(
                "operation.describe-tracker", {"root": root, "tracker": tracker}
            )
            return described.get("storeId") if described["status"] == "completed" else None

        def told_and(
            more: Iterable[str] = (),
            more_gone: Iterable[str] = (),
            store: tuple[str, str] | None = None,
        ) -> str:
            """The options that tell a run all this one was told -- the
            stores, and what is gone -- and what is given besides: ids
            deleted in the target (more), ids gone from the source
            (more_gone), a store under its option (store). Each id and
            store is one word to a shell, so that the run the command
            starts is told no less than this one was."""
            stores = {
                "--from-store": request.get("fromStore"),
                "--to-store": request.get("toStore"),
            }
            if store is not None:
                stores[store[0]] = store[1]

            def given(flag: str, value: str) -> str:
                # A value that starts with a dash given after =, as the
                # command line reads one, and never as an option.
                joined = "=" if value.startswith("-") else " "
                return "%s%s%s" % (flag, joined, shlex.quote(value))

            return " ".join(
                [given(flag, value) for flag, value in stores.items() if value]
                + [given("--deleted", t) for t in sorted(deleted | set(more))]
                + [given("--source-gone", t) for t in sorted(source_gone | set(more_gone))]
            )

        def command(
            more: Iterable[str] = (),
            more_gone: Iterable[str] = (),
            store: tuple[str, str] | None = None,
        ) -> str:
            """The command that runs the move again, told all this run was
            and what is given besides (told_and)."""
            told = told_and(more, more_gone, store)
            return "%s tracker migrate %s %s%s" % (PROG, src, dst, " " + told if told else "")

        def some_of(named: list[str]) -> str:
            """The first three ids, and how many more."""
            out = ", ".join(named[:3])
            return out + (" and %d more" % (len(named) - 3) if len(named) > 3 else "")

        def held_to(side: str, now: str | None) -> MigrateWorkspaceResponse | None:
            """None where the record may be held to the store the tracker on
            the side given -- from, the source; to, the target -- keeps this
            checkout's items in now, as it names it (now): the record holds
            nothing made, or names that store there, or names none and the
            run is told it is the record's (fromStore, toStore), or names
            none and the tracker names none. Otherwise what the run answers,
            writing nothing: the ids the record holds are of another store,
            and name other items here, or none."""
            key, tracker, told = (
                ("fromStore", src, request.get("fromStore"))
                if side == "from"
                else ("store", dst, request.get("toStore"))
            )
            recorded = record.get(key) or told
            if not ids or recorded == now:
                return None
            unfinished = sorted(str(t) for s, t in ids.items() if s not in settled)
            where = now or STORE_UNNAMED
            if recorded is None:
                verb, flag = (
                    ("read from", "--from-store") if side == "from" else ("wrote to", "--to-store")
                )
                summary = MOVE_STORE_UNSAID % (
                    path,
                    src,
                    dst,
                    tracker,
                    verb,
                    tracker,
                    now,
                    PROG,
                    src,
                    dst,
                    told_and(store=(flag, now or "")),
                    tracker,
                    verb,
                )
            elif side == "from":
                summary = (
                    MOVE_FROM_ELSEWHERE_UNFINISHED
                    % (src, dst, recorded, some_of(unfinished), src, where, src, recorded)
                    if unfinished
                    else MOVE_FROM_ELSEWHERE_FINISHED
                    % (src, dst, recorded, src, where, path, recorded)
                )
            else:
                summary = (
                    MOVE_ELSEWHERE_UNFINISHED
                    % (src, dst, some_of(unfinished), recorded, dst, where, dst, recorded)
                    if unfinished
                    else MOVE_ELSEWHERE_FINISHED % (src, dst, recorded, dst, where, path, recorded)
                )
            return {
                "status": "failed",
                "exitCode": 1,
                "summary": summary,
                "moved": 0,
                "mapped": sum(1 for a, b in ids.items() if a != b),
                "mappingPath": path,
            }

        def save() -> None:
            record["at"] = datetime.datetime.now(datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
            temporary = path + ".tmp"
            with open(temporary, "w", encoding="utf-8") as fh:
                json.dump(record, fh, indent=2, sort_keys=True)
                fh.write("\n")
            os.replace(temporary, path)  # a run that dies leaves the last whole record

        # Where the move runs now, kept at once, so that a close held by what
        # it made names where to run it again, however early this run stops.
        if record.get("checkout") != root:
            record["checkout"] = root
            if ids:
                save()

        # The source read whole -- listed, and each item the run writes of
        # shown by its id -- under the lock a write of it holds, let go of
        # before anything is written. A
        # pour makes its steps and then their needs under that lock, and a
        # close its item and then its root: read between two of those writes, a
        # run would be settled half made, a step without its need, and the next
        # move would find nothing left to write.
        wholes: dict[str, Any] = {}
        with held_for_writing(root, src, until_logged=False) as reading:
            if not reading:
                return {"status": "failed", "exitCode": 1, "summary": MOVE_BUSY % src}
            listed = invoke_tracker(
                "operation.list-items", {"root": root, "tracker": src, "scope": "all"}
            )
            if listed["status"] != "completed":
                return {
                    "status": "failed",
                    "summary": listed["summary"],
                    "exitCode": 1,
                    "reason": listed.get("reason")
                    if listed.get("reason") in ("tracker-unknown", "adapter-failed")
                    else None,
                }
            items = listed.get("items") or []
            # A pour not known to be whole (pours_held) moves not: no move can
            # make it whole. One known to be whole moves, its guards left
            # behind, whatever became of them.
            listed_ids = {i["id"]: i for i in items}
            pours = pours_held(
                listed_ids,
                lambda g: invoke_tracker(
                    "operation.show-item", {"root": root, "tracker": src, "id": g}
                ),
            )
            for g, pour in sorted(pours.items()):
                if pour["unread"]:
                    return {
                        "status": "failed",
                        "exitCode": 1,
                        "summary": "Nothing was moved: whether a pour into %s finished could not "
                        "be told, since its guard %s could not be read: %s Try again."
                        % (src, g, pour["unread"]),
                    }
                return {
                    "status": "failed",
                    "exitCode": 1,
                    "summary": MOVE_POUR_UNFINISHED
                    % (src, g, ", ".join(pour["closes"]) or "what it made", src),
                }
            items = [i for i in items if i.get("kind") != "guard"]
            # Where the source keeps this checkout's items, as it names its
            # store: a record of what the move read from another is none of
            # this run's, its ids naming other items here, or none.
            source_store = kept_in(src)
            elsewhere = held_to("from", source_store)
            if elsewhere is not None:
                return elsewhere
            # What a stopped move into the source made, read now, is half made:
            # a move from it would settle it so, and the next run of this one
            # would find nothing left to write of it.
            stopped = made_by_a_stopped_move({"root": root, "tracker": src}, lambda: source_store)
            half = sorted(i["id"] for i in items if i["id"] in stopped)
            if half:
                source, _, again = stopped[half[0]]
                return {
                    "status": "failed",
                    "exitCode": 1,
                    "summary": MOVE_FROM_UNFINISHED
                    % (src, source, src, some_of(half), src, PROG, source, src, again),
                }
            # Each item the run has anything to write of -- not yet made, made
            # and not finished, or to be made again -- shown by its id, and
            # taken as shown: a listing need not carry a description or the
            # means, and may be without a write for a while after it, as
            # Jira's search is, where a read by id holds it at once.
            # Told what was deleted in the target, a run shows every item it
            # lists: what stood under the deleted or waited on it is written
            # again as the source shows it, not as a lagging listing does.
            for n, item in enumerate(items):
                if item["id"] in settled and not deleted:
                    continue
                shown = shown_by_its_id(
                    item["id"],
                    invoke_tracker(
                        "operation.show-item", {"root": root, "tracker": src, "id": item["id"]}
                    ),
                )
                if shown["status"] != "completed" or not shown.get("item"):
                    return {
                        "status": "failed",
                        "reason": shown.get("reason")
                        if shown.get("reason") in ("tracker-unknown", "adapter-failed")
                        else None,
                        "exitCode": 1,
                        "summary": "%s could not show %s: %s" % (src, item["id"], shown["summary"]),
                        "moved": 0,
                        "mapped": sum(1 for a, b in ids.items() if a != b),
                        "mappingPath": path if ids else None,
                    }
                wholes[item["id"]] = shown["item"]
                items[n] = cast(TrackerItem, dict(item, **shown["item"]))
            # What the listing leaves out that the move must know of, read by
            # its id: each item an earlier run made and has not finished, and
            # each need, parent and root of a run the move has made nothing
            # of, of what this run writes. A listing may lag the source's writes -- Jira's
            # search catches up with them -- so one the source shows is the
            # listing's omission, and nothing is written, what the move made
            # held as it was; one it shows none of is outside it, save one the
            # move made of, whose copy stays held until the source shows it.
            # One the run is told the source holds no more (sourceGoneIds) --
            # deleted there, or archived, which a source may show and never
            # list again -- is taken so unasked: a copy made of it is left as
            # it was made, and a need on it or a place under it written to
            # that copy, or, where the move made none, left out.
            # One the listing lacks whose copy the run is told was deleted in
            # the target, and that the run is told the source holds no more,
            # is gone from both: forgotten, and a need on it, a place under
            # it or in its run left out, as of any the source holds no more.
            in_listing = {i["id"] for i in items}
            dropped = sorted(
                i for i in ids if i not in in_listing and i in source_gone and ids[i] in deleted
            )
            missing = sorted(
                i
                for i in ids
                if i not in settled and i not in in_listing and i not in dropped and i not in relink
            )
            aside = sorted(
                i
                for i in ids
                if i in settled and i not in in_listing and ids[i] in deleted and i not in dropped
            )
            to_write = [i for i in items if i["id"] not in settled or ids.get(i["id"]) in deleted]
            unlisted = sorted(
                (
                    {n for i in to_write for n in i.get("needs") or []}
                    | {i["parent"] for i in to_write if i.get("parent")}
                    | {i["run"] for i in to_write if i.get("run")}
                    | {i["within"] for i in to_write if i.get("within")}
                )
                - in_listing
                - (set(ids) - set(dropped))
            )
            for ident in missing + aside + unlisted:
                if ident in source_gone:
                    continue  # gone from the source, as the run is told, whatever it shows
                shown = shown_by_its_id(
                    ident,
                    invoke_tracker(
                        "operation.show-item", {"root": root, "tracker": src, "id": ident}
                    ),
                )
                if shown["status"] == "completed" and shown.get("item"):
                    summary = MOVE_UNLISTED % (src, ident, command(), command((), [ident]))
                elif shown.get("reason") != "item-not-found":
                    summary = "%s could not show %s: %s" % (src, ident, shown["summary"])
                elif ident in ids and ids[ident] in deleted:
                    summary = MOVE_GONE_FROM_BOTH % (
                        src,
                        ident,
                        ids[ident],
                        dst,
                        src,
                        command(),
                        command((), [ident]),
                    )
                elif ident in missing:
                    summary = MOVE_SOURCE_GONE % (
                        src,
                        ident,
                        ids[ident],
                        src,
                        command(),
                        command((), [ident]),
                        ids[ident],
                    )
                else:
                    continue
                return {
                    "status": "failed",
                    "reason": shown.get("reason")
                    if shown.get("reason") in ("tracker-unknown", "adapter-failed")
                    else None,
                    "exitCode": 1,
                    "summary": summary,
                    "moved": 0,
                    "mapped": sum(1 for a, b in ids.items() if a != b),
                    "mappingPath": path if ids else None,
                }
            # One finished but for a need on an item made again, that the run
            # is told the source holds no more, has nothing left to write:
            # settled as it stands, left as made.
            for ident in [i for i in relink if i in source_gone and i not in in_listing]:
                relink.remove(ident)
                settled.append(ident)
                note("leftAsMade", [ids[ident]])
                note("goneHeard", [ident])
            # What the move made that the listing lacks -- archived, say --
            # and the run must have as the source shows it, shown by its id:
            # each finished but for a need to write again on an item made
            # again (relink), or to stand under one (unparented), and, told
            # what was deleted in the target, each the move made at all, as it
            # may wait on, stand under or be in the run of what is made again.
            # One the source shows none of stays as it stands there, and one
            # that was to stand under an item made again is left as made; one
            # finished but for its need is held, as an unfinished one is,
            # until the source shows it or the run is told it is gone.
            for ident in sorted(
                a
                for a in ids
                if a not in in_listing
                and a not in source_gone
                and a not in dropped
                and (a in relink or (a in settled and (deleted or a in unparented)))
            ):
                shown = shown_by_its_id(
                    ident,
                    invoke_tracker(
                        "operation.show-item", {"root": root, "tracker": src, "id": ident}
                    ),
                )
                if shown["status"] == "completed" and shown.get("item"):
                    wholes[ident] = shown["item"]
                    items.append(cast(TrackerItem, dict(shown["item"])))
                elif shown.get("reason") == "item-not-found":
                    if ident in relink:
                        # As of an unfinished item the source shows none of:
                        # held until it shows it, or the run is told it is gone.
                        return {
                            "status": "failed",
                            "exitCode": 1,
                            "summary": MOVE_SOURCE_GONE
                            % (
                                src,
                                ident,
                                ids[ident],
                                src,
                                command(),
                                command((), [ident]),
                                ids[ident],
                            ),
                            "moved": 0,
                            "mapped": sum(1 for a, b in ids.items() if a != b),
                            "mappingPath": path,
                        }
                    if ident in unparented:
                        unparented.remove(ident)
                        note("leftAsMade", [ids[ident]])
                else:
                    return {
                        "status": "failed",
                        "exitCode": 1,
                        "summary": "%s could not show %s: %s" % (src, ident, shown["summary"]),
                        "moved": 0,
                        "mapped": sum(1 for a, b in ids.items() if a != b),
                        "mappingPath": path,
                    }
        # The target opened under the lock an adoption of the checkout holds
        # while it opens its tracker: a move and an adoption opening one
        # tracker at once would each find it unopened and record a store of
        # their own -- a Jira project -- the later over the earlier, and the
        # work made under the earlier would leave the checkout's list.
        with held_at(adoption_lock(root), until_logged=False) as adopting:
            if not adopting:
                return {"status": "failed", "summary": ADOPTION_BUSY % "moved", "exitCode": 1}
            opened = invoke_tracker("operation.open-tracker", {"root": root, "tracker": dst})
        if opened["status"] != "completed":
            return {
                "status": "failed",
                "summary": opened["summary"],
                "exitCode": 1,
                "reason": opened.get("reason")
                if opened.get("reason") in ("tracker-unknown", "adapter-failed")
                else None,
            }
        # Where the move writes, as the target names its store, so that what it
        # leaves unfinished holds nothing in another store of that name; and
        # the checkout it runs in, where its record is, to run it again. A
        # record of what the move made in another store than the target now
        # names is none of this run's: its ids name nothing here, or another
        # item, so nothing is written. Nor is one that names no store, as an
        # earlier dotdiw's, where the target names one, until the run is told
        # it is the record's; the record names both stores from then on.
        here = kept_in(dst)
        elsewhere = held_to("to", here)
        if elsewhere is not None:
            return elsewhere
        # Items poured within a call move only into a tracker that keeps
        # calls, which the target says of itself.
        called = sorted(i["id"] for i in items if i.get("within") or i.get("calls"))
        if called:
            described = invoke_tracker("operation.describe-tracker", {"root": root, "tracker": dst})
            if not (
                (described.get("info") or {}) if described["status"] == "completed" else {}
            ).get("nests"):
                return {
                    "status": "failed",
                    "exitCode": 1,
                    "summary": MOVE_NO_CALLS % (src, some_of(called), dst),
                    "moved": 0,
                    "mapped": sum(1 for a, b in ids.items() if a != b),
                    "mappingPath": path,
                }
        # Kept though nothing is written: the stores it was told.
        told = bool(ids) and (record.get("fromStore"), record.get("store")) != (source_store, here)
        record["fromStore"], record["store"] = source_store, here

        # Each item once, after its parent and after the root of the run it was
        # poured in, so that both new ids are known when it is written. Where the
        # two wait on each other -- a root moved under a step of its own run --
        # the item goes first and its parent is set once both are made; a run is
        # never cut, so runs that wait on each other stop the move before any
        # item is written.
        byid = {i["id"]: i for i in items}
        order: list[Any] = []
        placed: set[str] = set()

        def waits(item: Any, on: str) -> bool:
            return item.get(on) in byid and item.get(on) not in placed

        while len(order) < len(items):
            progress = False
            for item in items:
                if (
                    item["id"] in placed
                    or waits(item, "parent")
                    or waits(item, "run")
                    or waits(item, "within")
                ):
                    continue
                order.append(item)
                placed.add(item["id"])
                progress = True
            if not progress:
                left = [i for i in items if i["id"] not in placed]
                cut = [i for i in left if not waits(i, "run") and not waits(i, "within")]
                if not cut:
                    stuck = sorted(i["id"] for i in left)
                    return {
                        "status": "failed",
                        "exitCode": 1,
                        "summary": "The runs of %s wait on each other, so no item was written."
                        % ", ".join(stuck),
                        "moved": 0,
                        "mapped": sum(1 for a, b in ids.items() if a != b),
                        "mappingPath": path,
                    }
                order.append(cut[0])
                placed.add(cut[0]["id"])
        # Every write to the target -- the makes, the parents set late, the
        # needs, the statuses and the closes -- under the lock a write of it
        # holds, from the first to the last, as a pour holds it from its root
        # to the last need of its steps: a write held to what it read lands
        # before the move or after it, never between an item the move made
        # and the needs, status and close it writes of it, so none closes a
        # step not yet waiting on what it needs. A write there waits on the
        # move, as long as TRACKER_LOCK_SECONDS.
        with held_for_writing(root, dst) as writing:
            if not writing:
                return {"status": "failed", "exitCode": 1, "summary": MOVE_BUSY % dst}
            if told:
                save()  # the stores it was told, kept though nothing is written

            def written(operation: str, fields: dict[str, Any]) -> Response:
                return invoke_tracker(operation, dict(fields, root=root, tracker=dst))

            def way_there(start: str, goal: str) -> list[str] | None:
                """What start waits on, in the target, to goal -- its needs
                and its children, as the target shows them -- each said, or
                None where none is read."""
                came: dict[str, tuple[str, str]] = {}
                todo, seen = [start], {start}
                while todo and len(seen) < 500:
                    at = todo.pop(0)
                    if at == goal:
                        said: list[str] = []
                        while at != start:
                            was, how = came[at]
                            said.append(how)
                            at = was
                        return list(reversed(said))
                    shown = shown_by_its_id(at, written("operation.show-item", {"id": at}))
                    if shown["status"] != "completed" or not shown.get("item"):
                        continue
                    onward = [
                        (n, "%s needs %s" % (at, n)) for n in shown["item"].get("needs") or []
                    ]
                    onward += [
                        (c["id"], "%s stands under %s" % (c["id"], at))
                        for c in shown.get("children") or []
                        if c.get("id")
                    ]
                    for nxt, how in onward:
                        if nxt not in seen:
                            seen.add(nxt)
                            came[nxt] = (at, how)
                            todo.append(nxt)
                return None

            def refused(
                what: str, answer: Response, cycle: tuple[str, str] | None = None
            ) -> MigrateWorkspaceResponse:
                save()
                summary = "%s refused %s: %s" % (dst, what, answer["summary"])
                if answer.get("reason") == "cycle":
                    # What closes the cycle, as the target holds it: of the
                    # way from the one to the other, what the source does not
                    # show -- kept by the move -- or, all of it as the source
                    # shows it, the whole way.
                    back = {made: source for source, made in ids.items()}

                    def source_shows(how: str) -> bool:
                        if " needs " in how:
                            waits, on = how.split(" needs ", 1)
                            needs = (byid.get(back.get(waits, "")) or {}).get("needs") or []
                            return back.get(on) in needs
                        under, above = how.split(" stands under ", 1)
                        return (byid.get(back.get(under, "")) or {}).get("parent") == back.get(
                            above
                        )

                    way = way_there(*cycle) if cycle is not None else None
                    kept = [how for how in way or [] if not source_shows(how)] or (way or [])
                    if not kept:
                        kept = [
                            r
                            for held in of_copies.values()
                            for w in ("needs", "parent")
                            for r in held.get(w) or []
                        ]
                    if kept:
                        summary += MOVE_KEPT_IN_THE_WAY % (dst, src, ", ".join(kept), command())
                return {
                    "status": "failed",
                    "reason": "item-refused",
                    "exitCode": 1,
                    "summary": summary,
                    "moved": moved,
                    "mapped": sum(1 for a, b in ids.items() if a != b),
                    "mappingPath": path,
                }

            def given(item: Any) -> dict[str, Any]:
                """What the make of an item gives the target."""
                whole = wholes[item["id"]]
                return {
                    "id": item["id"],
                    "title": item["title"],
                    "priority": item.get("priority"),
                    "parent": ids.get(item.get("parent")) if item.get("parent") else None,
                    "description": whole.get("description"),
                    "verifyUsing": list(whole.get("verifyUsing") or []) or None,
                    "step": whole.get("step"),
                    "claim": whole.get("claim"),
                    "run": ids.get(whole["run"]) if whole.get("run") else None,
                    "values": list(whole.get("values") or []) or None,
                    "within": ids.get(whole["within"]) if whole.get("within") else None,
                    "calls": whole.get("calls"),
                }

            # Gone from both, as the run is told: forgotten, its copy
            # deleted, and what stood on it left out -- each read back first:
            # one the target still holds was not deleted, and is left as made,
            # as of any item the source holds no more.
            if dropped:
                still_there = []
                for ident in dropped:
                    there = shown_by_its_id(
                        ids[ident], written("operation.show-item", {"id": ids[ident]})
                    )
                    if there["status"] == "completed" and there.get("item"):
                        still_there.append(ident)
                    elif there.get("reason") != "item-not-found":
                        return refused("the read of %s, made of %s" % (ids[ident], ident), there)
                for ident in still_there:
                    if ident not in settled:
                        gone.append(ident)
                        settled.append(ident)
                    for held in (unread, unparented, relink):
                        while ident in held:
                            held.remove(ident)
                    note("leftAsMade", [ids[ident]])
                note("goneHeard", still_there)
                dropped = [i for i in dropped if i not in still_there]
                note("deletedHeard", [ids[i] for i in dropped])
                for ident in dropped:
                    forget(ident)
                    for held in (settled, unread, unparented, relink, gone):
                        while ident in held:
                            held.remove(ident)
                linked[:] = [e for e in linked if e[0] not in dropped and e[1] not in dropped]
                note("dropped", dropped)
                note("goneHeard", dropped)
                save()

            def not_found(ident: str) -> MigrateWorkspaceResponse:
                """What the run answers where the target holds no item the
                move made of ident, as far as it says, and the run is not told
                it was deleted there."""
                made = ids[ident]
                return {
                    "status": "failed",
                    "reason": "item-refused",
                    "exitCode": 1,
                    "summary": MOVE_NOT_FOUND
                    % (dst, made, ident, made, command(), command([made])),
                    "moved": 0,
                    "mapped": sum(1 for a, b in ids.items() if a != b),
                    "mappingPath": path,
                }

            # Each item an earlier run made and has not finished, and each the
            # run is told was deleted in the target (deletedIds), read back
            # before anything else is written. Found, it is made, and one whose
            # make failed after it must hold what the move gave it, which only
            # a make writes, or the move writes nothing more. Not found, it
            # stays made and the move writes nothing more, since a tracker
            # answers so of an item its caller may not see -- unless the run is
            # told it was deleted there, when it is made again.
            # So is each the source holds no more, as the run is told, whose
            # copy is to be left as it was made: one the target holds none of
            # is not left so, and the run says how it goes on.
            lost: set[str] = set()
            copies: dict[str, Any] = {}  # source id -> its copy, as read back
            for ident in [
                i
                for i in ids
                if i in missing or i in byid and (i not in settled or ids[i] in deleted)
            ]:
                there = shown_by_its_id(
                    ids[ident], written("operation.show-item", {"id": ids[ident]})
                )
                if there.get("reason") == "item-not-found":
                    if ids[ident] not in deleted:
                        return not_found(ident)
                    lost.add(ident)
                    continue
                if there["status"] != "completed" or not there.get("item"):
                    return refused("the read of %s, made of %s" % (ids[ident], ident), there)
                copies[ident] = there["item"]
                if ident not in unread or ident not in byid:
                    continue
                # Read against what the move gave it, which the record keeps,
                # not what the source shows now: a change since is kept as
                # made, and said, as of any copy made whole. A record an
                # earlier dotdiw wrote keeps none, and the source is read.
                gave = (record.get("madeAs") or {}).get(ident)
                if isinstance(gave, dict):
                    holds = made_as(there["item"])
                    lacks = [
                        field for field in MADE_ONLY_BY_A_MAKE if holds[field] != gave.get(field)
                    ]
                else:
                    asked = given(byid[ident])
                    lacks = [
                        field
                        for field in MADE_ONLY_BY_A_MAKE
                        if (there["item"].get(field) or None) != (asked.get(field) or None)
                    ]
                if lacks:
                    return {
                        "status": "failed",
                        "reason": "item-refused",
                        "exitCode": 1,
                        "summary": MOVE_NOT_AS_MADE
                        % (
                            dst,
                            ids[ident],
                            ident,
                            ", ".join(lacks),
                            ids[ident],
                            dst,
                            command([ids[ident]]),
                        ),
                        "moved": 0,
                        "mapped": sum(1 for a, b in ids.items() if a != b),
                        "mappingPath": path,
                    }
                unread.remove(ident)
                (record.get("madeAs") or {}).pop(ident, None)
                save()
            # What else the move made that stands on an item to be made again:
            # in its run, which only a make writes, it must be made again too,
            # so the run writes nothing and names it; waiting on it, or under
            # it, it is written again to wait on the new item, or to stand
            # under it -- read back first, since it may have gone with it.
            if lost:
                # What the move made in its run, or within it where it is a
                # calling step: only a make writes either.
                in_run = sorted(
                    ids[i]
                    for i in ids
                    if i not in lost
                    and (
                        (byid.get(i) or {}).get("run") in lost
                        or (byid.get(i) or {}).get("within") in lost
                    )
                )
                if in_run:
                    return {
                        "status": "failed",
                        "reason": "item-refused",
                        "exitCode": 1,
                        "summary": MOVE_DELETED_HELD
                        % (
                            dst,
                            some_of(sorted(ids[i] for i in lost)),
                            some_of(in_run),
                            dst,
                            command(in_run),
                        ),
                        "moved": 0,
                        "mapped": sum(1 for a, b in ids.items() if a != b),
                        "mappingPath": path,
                    }
                # What waits on it, as the record has the move writing it, or
                # as the source shows it: a need the move found written on
                # the copy waits on the new item as much as one it wrote.
                waiting = sorted(
                    {a for a, b in linked if b in lost and a not in lost and a in byid}
                    | {
                        i
                        for i in ids
                        if i not in lost and lost & set((byid.get(i) or {}).get("needs") or [])
                    }
                )
                under = sorted(
                    i for i in ids if i not in lost and (byid.get(i) or {}).get("parent") in lost
                )
                for ident in sorted(set(waiting) | set(under)):
                    if ident not in settled:
                        continue  # read back above
                    there = shown_by_its_id(
                        ids[ident], written("operation.show-item", {"id": ids[ident]})
                    )
                    if there.get("reason") == "item-not-found":
                        return not_found(ident)
                    if there["status"] != "completed" or not there.get("item"):
                        return refused("the read of %s, made of %s" % (ids[ident], ident), there)
                note("deletedHeard", sorted(ids[i] for i in lost))
                for ident in lost:
                    forget(ident)
                    for held in (settled, unread, unparented, relink):
                        if ident in held:
                            held.remove(ident)
                linked[:] = [edge for edge in linked if edge[0] not in lost and edge[1] not in lost]
                for ident in waiting:
                    if ident in settled:
                        # Finished, and held again only until it waits on the
                        # new item: its status and its close are as they
                        # stand in the target, where it may have moved on.
                        settled.remove(ident)
                        relink.append(ident)
                for ident in under:
                    if ident not in unparented:
                        unparented.append(ident)
                save()
            # What an earlier run made and has not finished, that the source
            # neither lists nor shows and the run is told was deleted there,
            # has nothing left for the move to write: settled as it was made,
            # so that nothing holds it, for good.
            if missing:
                gone.extend(missing)
                settled.extend(missing)
                note("leftAsMade", [ids[i] for i in missing])
                note("goneHeard", missing)
                save()

            def none_there(*sources: str | None) -> MigrateWorkspaceResponse | None:
                """Where a write the target refused names a copy it holds no
                more, what the run answers of that copy: how it goes on."""
                for ident in sources:
                    if ident is None or ident not in ids:
                        continue
                    there = written("operation.show-item", {"id": ids[ident]})
                    if shown_by_its_id(ids[ident], there).get("reason") == "item-not-found":
                        return not_found(ident)
                return None

            def as_updated(ident: str, out: Response) -> Any:
                """The copy as an update left it: as it answered, or read back."""
                return out.get("item") or shown_by_its_id(
                    ids[ident], written("operation.show-item", {"id": ids[ident]})
                ).get("item")

            # Before anything is made or written, each item an earlier run
            # made and has not finished is taken off what the source no longer
            # shows it on: each need the move wrote of it (linked) that the
            # source no longer shows, and the parent it stands under where the
            # source shows it under none, or under one the move leaves out --
            # so that no parent or need written after makes a cycle with one
            # turned round while the move stood stopped. A need of the copy
            # the move never wrote -- written in the target -- is kept, and
            # said; and so is a parent the target will not take it from.
            for item in order:
                ident = item["id"]
                copy = copies.get(ident)
                if copy is None or ident in settled or ident in relink or ident in unread:
                    continue
                copy_id = ids[ident]
                wanted = {ids[n] for n in item.get("needs") or [] if n in ids}
                ours = {ids[b] for a, b in linked if a == ident and b in ids}
                has = set(copy.get("needs") or [])
                drop = sorted((has & ours) - wanted)
                aspect(
                    copy_id,
                    "needs",
                    ["%s needs %s" % (copy_id, n) for n in sorted(has - wanted - ours)],
                )
                if drop:
                    out = written("operation.update-item", {"id": copy_id, "dropNeeds": drop})
                    if out["status"] != "completed":
                        return refused("the update of %s, made of %s" % (copy_id, ident), out)
                    after = as_updated(ident, out)
                    kept_there = set(drop) if after is None else set(after.get("needs") or [])
                    kept_needs = sorted(set(drop) & kept_there)
                    if kept_needs:
                        save()
                        return {
                            "status": "failed",
                            "reason": "item-refused",
                            "exitCode": 1,
                            "summary": MOVE_NEED_KEPT
                            % (dst, copy_id, ", ".join(kept_needs), src, ident, dst, command()),
                            "moved": moved,
                            "mapped": sum(1 for a, b in ids.items() if a != b),
                            "mappingPath": path,
                        }
                    linked[:] = [e for e in linked if not (e[0] == ident and ids.get(e[1]) in drop)]
                    copies[ident] = copy = dict(copy, needs=sorted(has - set(drop)))
                    save()
                above = item.get("parent")
                if not copy.get("parent") or (above and (above in ids or above in byid)):
                    aspect(copy_id, "parent", [])  # under none, or as the source shows it
                else:
                    out = written("operation.update-item", {"id": copy_id, "dropParent": True})
                    after = as_updated(ident, out) if out["status"] == "completed" else None
                    if after is not None and not after.get("parent"):
                        copies[ident] = dict(copy, parent=None)
                        aspect(copy_id, "parent", [])
                        save()
                    elif out["status"] == "completed" or out.get("reason") == "unsupported":
                        aspect(copy_id, "parent", ["the parent of %s" % copy_id])  # it keeps one
                    else:
                        return refused("the update of %s, made of %s" % (copy_id, ident), out)
            for item in order:
                if item["id"] in ids:
                    continue
                early = item.get("parent") in byid and item.get("parent") not in ids
                asked = given(item)
                made = written("operation.create-item", asked)
                if made["status"] != "completed" or not made.get("item"):
                    if made.get("reason") in (
                        "item-not-found",
                        "parent-not-found",
                    ) and not made.get("madeId"):
                        gone_there = none_there(item.get("parent"), wholes[item["id"]].get("run"))
                        if gone_there is not None:
                            return gone_there
                    if made.get("madeId"):
                        # Made, and not read back whole: held as made, so that
                        # nothing closes it and no run makes it again; the next
                        # run reads it back first.
                        ids[item["id"]] = str(made["madeId"])
                        unread.append(item["id"])
                        record.setdefault("madeAs", {})[item["id"]] = made_as(asked)
                        labels_of[item["id"]] = [v["label"] for v in asked.get("values") or []]
                        if early:
                            unparented.append(item["id"])
                        moved += 1
                    return refused(item["id"], made)
                ids[item["id"]] = made["item"]["id"]
                labels_of[item["id"]] = [v["label"] for v in asked.get("values") or []]
                if early:
                    unparented.append(item["id"])
                moved += 1
                save()
            for ident in list(unparented):
                parent = (byid.get(ident) or {}).get("parent")
                if ident not in ids or parent not in ids:
                    continue
                out = written("operation.update-item", {"id": ids[ident], "parent": ids[parent]})
                if out["status"] != "completed":
                    if out.get("reason") == "item-not-found":
                        gone_there = none_there(parent)
                        if gone_there is not None:
                            return gone_there
                    return refused(
                        "the parent of %s, %s" % (ident, parent), out, (ids[ident], ids[parent])
                    )
                if ident in copies:
                    copies[ident] = dict(copies[ident], parent=ids[parent])
                unparented.remove(ident)
                save()
            # Each item an earlier run made and has not finished, brought in
            # line with what the source shows of it now, as the run reads
            # every such item: the source may have changed it while the move
            # stood stopped. Its title, priority and parent are written, and
            # the values of its claim, as the source shows them and in its
            # order; what only a make writes is kept as made, and said.
            for item in order:
                ident = item["id"]
                copy = copies.get(ident)
                if copy is None or ident in settled or ident in relink or ident in unread:
                    continue
                copy_id = ids[ident]
                change: dict[str, Any] = {}
                if item.get("title") and item["title"] != copy.get("title"):
                    change["title"] = item["title"]
                if item.get("priority") is not None and item["priority"] != copy.get("priority"):
                    change["priority"] = item["priority"]
                above = ids.get(item["parent"]) if item.get("parent") in ids else None
                if above is not None and above != copy.get("parent"):
                    change["parent"] = above
                if change:
                    out = written("operation.update-item", dict(change, id=copy_id))
                    if out["status"] != "completed":
                        if out.get("reason") == "item-not-found":
                            gone_there = none_there(item.get("parent"), ident)
                            if gone_there is not None:
                                return gone_there
                        return refused(
                            "the update of %s, made of %s" % (copy_id, ident),
                            out,
                            (copy_id, change["parent"]) if "parent" in change else None,
                        )
                    copies[ident] = copy = dict(copy, **change)
                    save()
                if above is not None:
                    aspect(copy_id, "parent", [])  # under the parent the source shows
                whole = wholes.get(ident) or item
                values_now = {v["label"]: v["text"] for v in whole.get("values") or []}
                values_there = {v["label"]: v["text"] for v in copy.get("values") or []}
                # Each label the source holds is written as it shows it, in its
                # order: from the first the copy holds otherwise, each taken
                # off and written again, as a label recorded anew stands last.
                # One only the copy holds is taken off where the move wrote it
                # and the source took it off since; one recorded on the copy
                # alone, while the move stood stopped, is kept, and said.
                ours_only = [
                    lb
                    for lb in values_there
                    if lb not in values_now and lb in (labels_of.get(ident) or [])
                ]
                there_in_turn = [(lb, values_there[lb]) for lb in values_there if lb in values_now]
                now_in_turn = list(values_now.items())
                k = 0
                while k < min(len(there_in_turn), len(now_in_turn)) and (
                    there_in_turn[k] == now_in_turn[k]
                ):
                    k += 1
                aspect(
                    copy_id,
                    "labels",
                    [
                        "%s on %s" % (lb, copy_id)
                        for lb in values_there
                        if lb not in values_now and lb not in ours_only
                    ],
                )
                writes = []
                if there_in_turn[k:] or ours_only:
                    writes.append(
                        [{"label": lb, "text": ""} for lb, _ in there_in_turn[k:]]
                        + [{"label": lb, "text": ""} for lb in ours_only]
                    )
                if now_in_turn[k:]:
                    writes.append([{"label": lb, "text": tx} for lb, tx in now_in_turn[k:]])
                aspect(copy_id, "values", [])
                for values in writes:
                    out = written("operation.record-values", {"id": copy_id, "values": values})
                    if out.get("reason") == "unsupported":
                        # None written there: the copy keeps what it was made with.
                        aspect(copy_id, "values", ["the values of %s" % copy_id])
                        break
                    if out["status"] != "completed":
                        return refused("the values of %s, made of %s" % (copy_id, ident), out)
                else:
                    labels_of[ident] = list(values_now)
                asked = given(item)
                aspect(
                    copy_id,
                    "fields",
                    [
                        "the %s of %s" % (MADE_FIELD_WORDS.get(field, field), copy_id)
                        for field in MADE_ONLY_BY_A_MAKE
                        if (copy.get(field) or None) != (asked.get(field) or None)
                    ],
                )
            # Everything after the make, for every item not settled: this run's, and
            # any an earlier run made and could not finish. A write repeated after a
            # run died between it and the record changes nothing. A need is written
            # where the copy, as read back, is without it, whatever the record
            # says was written -- it may have been taken off there since -- and
            # is recorded before it is written, so that a run dying after the
            # write leaves it the move's own, to take off should the source.
            unsettled = [i for i in order if i["id"] in ids and i["id"] not in settled]
            resumed = len(unsettled) - moved
            for item in unsettled:
                has = set((copies.get(item["id"]) or {}).get("needs") or [])
                needs = [n for n in item.get("needs") or [] if n in ids and ids[n] not in has]
                # Each need the source shows is the move's own, written now or
                # found written on the copy, to take off should the source.
                fresh = [
                    [item["id"], n]
                    for n in item.get("needs") or []
                    if n in ids and [item["id"], n] not in linked
                ]
                if fresh:
                    linked.extend(fresh)
                    save()
                for need in needs:
                    out = written("operation.add-need", {"id": ids[item["id"]], "needs": ids[need]})
                    if out["status"] != "completed":
                        if out.get("reason") == "item-not-found":
                            gone_there = none_there(need)
                            if gone_there is not None:
                                return gone_there
                        return refused(
                            "the need of %s on %s" % (item["id"], need),
                            out,
                            (ids[need], ids[item["id"]]),
                        )
            # The status as the source shows it, open included: a copy an
            # earlier run moved on, or closed in a close cut short, of an item
            # the source has since set back, is set back too. One the source
            # shows closed is closed below, where a copy closed already keeps
            # the reason it was closed with, or the one a close cut short left
            # out, written there by the target's close.
            for item in unsettled:
                if item["id"] in relink:
                    continue
                want = item.get("status") or "open"
                standing = (copies.get(item["id"]) or {}).get("status") or "open"
                copy_id = ids[item["id"]]
                if want != "closed":
                    aspect(copy_id, "reason", [])  # open, as the source shows it
                if want != "closed" and want != standing:
                    out = written("operation.update-item", {"id": copy_id, "status": want})
                    if out["status"] != "completed":
                        return refused("status %s on %s" % (want, item["id"]), out)

            # What is not to be closed has nothing left to write once its needs
            # and its status are: settled now, so that nothing holds it while a
            # close the target refuses stops the run, as a close of it there
            # may be what lets that close through.
            def settle(idents: list[str]) -> None:
                """Settled, with what each leaves out kept for the run that
                finishes the move to say."""
                for ident in idents:
                    settled.append(ident)
                    item = byid.get(ident) or {}
                    note(
                        "leftOut",
                        [
                            "%s needs %s" % (ident, n)
                            for n in item.get("needs") or []
                            if n in unlisted
                        ]
                        + [
                            "%s %s %s" % (ident, how, item[above])
                            for above, how in (
                                ("parent", "stands under"),
                                ("run", "is in the run of"),
                            )
                            if item.get(above) in unlisted
                        ],
                    )
                note("goneHeard", [n for n in unlisted if n in source_gone])

            done = [i["id"] for i in unsettled if i.get("status") != "closed" or i["id"] in relink]
            if done:
                settle(done)
                relink[:] = [i for i in relink if i not in done]
                save()
            # Closed ones close when their needs and children have, so in
            # passes, each settled as it closes.
            # Each close leaves open what the source shows open and what the
            # move has yet to close itself (keepOpen): a root closed in the
            # wake of its last step would not carry its own reason.
            left = [i for i in unsettled if i.get("status") == "closed" and i["id"] not in done]
            open_there = {
                ids[i["id"]]
                for i in items
                if i["id"] in ids and (i.get("status") != "closed" or i["id"] not in settled)
            }
            while left:
                still: list[Any] = []
                answers: dict[str, Response] = {}
                for item in left:
                    out = written(
                        "operation.close-item",
                        {
                            "id": ids[item["id"]],
                            "closeReason": item.get("reason"),
                            "keepOpen": sorted(open_there - {ids[item["id"]]}),
                        },
                    )
                    if out["status"] == "blocked":
                        still.append(item)
                        answers[item["id"]] = out
                    elif out["status"] != "completed":
                        return refused("the close of %s" % item["id"], out)
                    else:
                        # Closed already with another reason than the source
                        # shows -- closed by an earlier run before the source
                        # closed it again -- it keeps it, and that is said.
                        copy_id = ids[item["id"]]
                        closed_as = as_updated(item["id"], out) or {}
                        aspect(
                            copy_id,
                            "reason",
                            ["the close reason of %s" % copy_id]
                            if (closed_as.get("reason") or None) != (item.get("reason") or None)
                            else [],
                        )
                        settle([item["id"]])
                        open_there.discard(copy_id)
                        save()
                if len(still) == len(left):
                    # The close to name is one held by what can be closed:
                    # neither a close the move has yet to make, nor what waits
                    # in the source -- through its needs, its children, the
                    # items poured in its run -- on one, to any depth, so that
                    # closing what it names lets the move go on.
                    waits_on = {i["id"]: set(i.get("needs") or []) for i in items}
                    for i in items:
                        for over in (i.get("parent"), i.get("run")):
                            if over in waits_on:
                                waits_on[over].add(i["id"])
                    held_up = {i["id"] for i in still}
                    grew = True
                    while grew:
                        grew = False
                        for at, on in waits_on.items():
                            if at not in held_up and on & held_up:
                                held_up.add(at)
                                grew = True
                    # And in the target, as it shows each item read back --
                    # its open needs and open children, to any depth -- where
                    # it holds what the source does not: a copy left as made,
                    # a need written there.
                    back = {made: source for source, made in ids.items()}
                    closing = {ids[i["id"]] for i in still}
                    known: dict[str, bool] = {}

                    def held_there(
                        copy_id: str,
                        way: frozenset[str] = frozenset(),
                        closing: set[str] = closing,
                        known: dict[str, bool] = known,
                    ) -> bool:
                        if copy_id in closing:
                            return True
                        if copy_id in known:
                            return known[copy_id]
                        if copy_id in way:
                            return False
                        shown = shown_by_its_id(
                            copy_id, written("operation.show-item", {"id": copy_id})
                        )
                        item = shown.get("item") if shown["status"] == "completed" else None
                        if item is None:
                            known[copy_id] = True  # not read: none to name
                        elif item.get("status") == "closed":
                            known[copy_id] = False
                        else:
                            onward = list(item.get("needs") or []) + [
                                c["id"]
                                for c in shown.get("children") or []
                                if c.get("id") and c.get("status") != "closed"
                            ]
                            known[copy_id] = any(
                                held_there(n, way | {copy_id}, closing, known) for n in onward
                            )
                        return known[copy_id]

                    blocked_close = next(
                        (
                            i
                            for i in still
                            if any(
                                back.get(b) not in held_up and not held_there(b)
                                for b in answers[i["id"]].get("blockedBy") or []
                            )
                        ),
                        still[0],
                    )
                    return refused(
                        "the close of %s" % blocked_close["id"], answers[blocked_close["id"]]
                    )
                left = still
            mapped = sum(1 for a, b in ids.items() if a != b)
            plural = "" if moved == 1 else "s"
            summary = "Moved %d item%s from %s to %s" % (moved, plural, src, dst)
            if resumed:
                finished = "%d item%s an earlier run left" % (resumed, "" if resumed == 1 else "s")
                summary = (
                    "%s; finished %s" % (summary, finished)
                    if moved
                    else "Finished %s from %s to %s" % (finished, src, dst)
                )
            if mapped:
                summary += "; %d id%s mapped" % (mapped, "" if mapped == 1 else "s")
            # Said, not dropped, by the run that finishes the move, of every
            # run since it last finished: the needs and parents the source
            # holds of none it lists or shows, what was kept as made, and the
            # copies left as they were made, or forgotten with their item.
            if said.get("leftOut"):
                summary += "; left out, as %s lists none of them: %s" % (
                    src,
                    some_of(said["leftOut"]),
                )

            # What an earlier run said of a copy this run did not look at --
            # settled, or left as made -- read back, and said only as the copy
            # still holds it: a need or a parent taken off there since, or a
            # label, is said no more.
            for copy_id in [c for c in of_copies if c not in looked_at]:
                there = shown_by_its_id(copy_id, written("operation.show-item", {"id": copy_id}))
                now = there.get("item") if there["status"] == "completed" else None
                if now is None:
                    continue  # not read: said as it was
                said_of = of_copies[copy_id]
                labels = {v.get("label") for v in now.get("values") or []}
                aspect(
                    copy_id,
                    "needs",
                    [
                        r
                        for r in said_of.get("needs") or []
                        if r.split(" needs ", 1)[-1] in (now.get("needs") or [])
                    ],
                )
                aspect(
                    copy_id,
                    "labels",
                    [
                        r
                        for r in said_of.get("labels") or []
                        if r[: -len(" on " + copy_id)] in labels
                    ],
                )
                aspect(copy_id, "parent", said_of.get("parent") or [] if now.get("parent") else [])

            def kept(*what: str) -> list[str]:
                return [v for held in of_copies.values() for w in what for v in held.get(w) or []]

            if kept("fields", "values"):
                summary += "; kept as made, as only a make writes it: %s" % some_of(
                    kept("fields", "values")
                )
            if kept("parent", "reason"):
                summary += "; kept as %s has it, as it would not change it: %s" % (
                    dst,
                    some_of(kept("parent", "reason")),
                )
            if kept("labels", "needs"):
                summary += "; kept what %s holds and %s does not: %s" % (
                    dst,
                    src,
                    some_of(kept("labels", "needs")),
                )
            if said.get("dropped"):
                summary += "; forgot %s, gone from %s and from %s" % (
                    some_of(said["dropped"]),
                    src,
                    dst,
                )
            # And what the run was told that it had nothing to do of.
            unheard = sorted(deleted - set(said.get("deletedHeard") or []))
            if unheard:
                summary += "; nothing was made again of %s" % some_of(unheard)
            unheard = sorted(source_gone - set(said.get("goneHeard") or []))
            if unheard:
                summary += "; nothing was left as made of %s" % some_of(unheard)
            if said.get("leftAsMade"):
                summary += "; left %s as made, as %s holds none of what %s made it of" % (
                    some_of(said["leftAsMade"]),
                    src,
                    dst,
                )
            if record.pop("said", None) is not None:
                save()  # said once, by the run that finishes the move
            return {
                "status": "completed",
                "summary": summary + ".",
                "moved": moved,
                "resumed": resumed,
                "mapped": mapped,
                "mappingPath": path if unsettled else None,
                "assigneesLeft": sum(1 for i in items if i.get("assignee")),
                "exitCode": 0,
            }


def ChooseATracker(request: ChooseATrackerRequest) -> ChooseATrackerResponse:
    """journey.choose-a-tracker: list, use or check, one step each."""
    root, action, name = request.get("root"), request["action"], request.get("name")
    if action == "list":
        out = invoke("operation.list-trackers", {"root": root})
        return {
            "status": out["status"],
            "summary": out["summary"],
            "trackers": out.get("trackers"),
            "chosen": out.get("chosen"),
            "exitCode": out["exitCode"],
        }
    if action == "use":
        out = invoke("operation.use-tracker", {"root": root, "name": name or ""})
        return {
            "status": out["status"],
            "summary": out["summary"],
            "chosen": out.get("name"),
            "reason": out.get("reason"),
            "exitCode": out["exitCode"],
        }
    out = invoke(
        "operation.check-tracker",
        {"root": root, "name": name or "", "path": request.get("path")},
    )
    return {
        "status": out["status"],
        "summary": out["summary"],
        "results": out.get("results"),
        "passed": out.get("passed"),
        "reason": out.get("reason"),
        "exitCode": out["exitCode"],
    }


def ShipATracker(request: ShipATrackerRequest) -> ShipATrackerResponse:
    """journey.ship-a-tracker: one step, the file."""
    out = invoke(
        "operation.write-tracker",
        {"name": request["name"], "directory": request.get("directory")},
    )
    return {
        "status": out["status"],
        "summary": out["summary"],
        "path": out.get("path"),
        "reason": out.get("reason"),
        "exitCode": out["exitCode"],
    }


def WriteTracker(request: WriteTrackerRequest) -> WriteTrackerResponse:
    """step.write-tracker: the file a tracker starts from, in the directory
    given or the current one. Nothing else is written, and a file that exists is
    left as it was."""
    name = request["name"]
    if not re.fullmatch(TRACKER_NAME, name):
        return failed_as(WriteTrackerResponse, "bad-name", BAD_TRACKER_NAME % name)
    if name in TRACKERS and not is_loaded(TRACKERS[name]):
        return failed_as(WriteTrackerResponse, "shipped-name", SHIPPED_TRACKER_NAME % name)
    path = os.path.join(request.get("directory") or os.getcwd(), name + ".py")
    try:
        with open(path, "x", encoding="utf-8") as fh:
            fh.write(TRACKER_SKELETON.replace("<NAME>", name))
    except FileExistsError:
        return failed_as(WriteTrackerResponse, "exists", "%s already exists." % path)
    except OSError as e:
        return failed_as(
            WriteTrackerResponse, "unwritable", "%s cannot be written: %s." % (path, e.strerror)
        )
    return {"status": "completed", "summary": "Wrote %s." % path, "path": path, "exitCode": 0}


def MoveAWorkspace(request: MoveAWorkspaceRequest) -> MoveAWorkspaceResponse:
    """journey.move-a-workspace: one step, the move; given no checkout, it
    moves nothing and says so."""
    root = request.get("root")
    if not root:
        return {
            "status": "failed",
            "summary": "Nothing was moved: no checkout was given to move.",
            "exitCode": 2,
        }
    out = invoke(
        "operation.migrate-workspace",
        {
            "root": root,
            "fromTracker": request["fromTracker"],
            "toTracker": request["toTracker"],
            "deletedIds": request.get("deletedIds"),
            "sourceGoneIds": request.get("sourceGoneIds"),
            "fromStore": request.get("fromStore"),
            "toStore": request.get("toStore"),
        },
    )
    return {
        "status": out["status"],
        "summary": out["summary"],
        "moved": out.get("moved"),
        "resumed": out.get("resumed"),
        "mapped": out.get("mapped"),
        "mappingPath": out.get("mappingPath"),
        "assigneesLeft": out.get("assigneesLeft"),
        "reason": out.get("reason"),
        "exitCode": out["exitCode"],
    }


# ============================================================ the beads adapter
#
# The tracker that ships underneath, bd, as an adapter: the one place that
# names the binary, runs it, hands it its directory, turns its metrics off,
# and rewrites its name in what it prints. Every operation of the interface
# answers in records. Three of them -- open, create and pour -- run bd's own
# command with the worker's terminal when the request says the terminal is
# there, so that what a worker sees under this adapter is what bd prints,
# byte for byte, and the record is read from the stream. Two extras beyond
# the interface: forward, the pass-through of every command dotdiw does not
# own, and metrics-off. Nothing outside this section calls bd.

# bd ships with anonymous usage metrics on and asks nothing: the first run
# prints a notice and starts queueing the name of every command, keyed by a
# machine-derived ID, for gastownhall-eventsapi.com. The setting is per
# machine, in ~/.config/bd/config.yaml, so a tool that runs bd on somebody's
# behalf decides it for them by staying silent. This one decides: off.
#
# Read the file rather than ask bd. `bd metrics` is itself a bd command, and
# while metrics are on it queues an event for itself and flushes the queue;
# `bd metrics off` queues nothing. Both found by running them against an
# empty HOME and looking at ~/.beads/eventsData afterwards.
BD_CONFIG = "~/.config/bd/config.yaml"

# ~/.dotdiw/<key>/.beads is bd's directory for one checkout, told to bd
# through BEADS_DIR. bd's stealth mode is asked for, because it is what
# declines the sync remote; --skip-agents because the declaration dotdiw
# writes is the instruction surface and bd's files would only teach the
# second name.
BEADS_STORE = ".beads"
INIT_FLAGS = ("--stealth", "--skip-hooks", "--skip-agents")

# The two answers every operation here can give before bd runs.
BEADS_NOT_INSTALLED = ("not-installed", "beads is not installed. Run: brew install beads", 127)
BEADS_NO_WORKSPACE = ("no-workspace", "This checkout has no tracker; init adopts it.", 1)
BEADS_STATUSES = ("open", "in_progress", "blocked", "closed")
BEADS_NOT_FOUND = ("no issue found", "no issues found", "not found")
# bd's create and update flags that consume the next argument, so that the
# pass-through never reads a value as an option of its own.
BEADS_VALUE_FLAGS = {
    "--title",
    "-s",
    "-d",
    "--description",
    "-p",
    "--priority",
    "-t",
    "--type",
    "-a",
    "--assignee",
    "-l",
    "--label",
    "--labels",
    "--design",
    "--acceptance",
    "--notes",
    "--parent",
    "--estimate",
    "--status",
    "--due",
    "--repo",
    "--db",
    "--actor",
    "--external-id",
}
# The issue metadata the beads adapter keeps its own data under, and the file
# in the workspace that says a workspace poured into before 3.0.0 has had the
# means to prove its runs moved out of its descriptions and into that metadata.
BEADS_KEY = "dotdiw"
# The rows bd's list leaves out unless asked: an item made ephemeral, one of
# an infrastructure type, a gate. A listing that holds a run to its rules
# asks for them, or a step so made would stand open where no check sees it.
BEADS_EVERY_ROW = ("--include-ephemeral", "--include-infra", "--include-gates")
# What a listing that is no list of items is answered with: it says nothing
# of what it leaves out, so it is not read as holding none.
BEADS_NO_LISTING = "The tracker answered no list of items."
# The type a root has, by each name bd takes for it, whatever its case.
BEADS_ROOT_TYPES = ("molecule", "mol")
BEADS_MEANS_MOVED = "means-in-metadata"


def beads_find() -> str | None:
    return shutil.which("bd") or shutil.which("beads")


def beads_store(root: str | None) -> str | None:
    """bd's directory under this checkout's workspace, or None without a key."""
    ws = workspace(root) if root else None
    return os.path.join(ws, BEADS_STORE) if ws else None


def beads_env(root: str | None) -> str | None:
    """This checkout's store, which bd is told through BEADS_DIR, when the
    tracker was opened here; None when it never was. Nothing is set on the
    process: each run of bd is told it alone (beads_environment)."""
    store = beads_store(root)
    return store if store and os.path.isdir(store) else None


def beads_environment(
    root: str | None, session: str | None = None, store: str | None = None
) -> dict[str, str]:
    """The environment of one run of bd: the process's, with this checkout's
    store -- or the store given, for the init that makes it -- and the
    session a close runs under. Given to that run alone, never set on the
    process, whose environment every request running in it shares."""
    env = dict(os.environ)
    store = store or beads_env(root)
    if store:
        env["BEADS_DIR"] = store
    if session is not None:
        env["CLAUDE_SESSION_ID"] = session
    return env


def beads_metadata(row: dict[str, Any]) -> dict[str, Any]:
    """An issue's metadata as bd answers it, as a dict whatever its form."""
    held = row.get("metadata")
    if isinstance(held, str):
        try:
            held = json.loads(held)
        except ValueError:
            held = None
    return dict(held) if isinstance(held, dict) else {}


def beads_own(row: dict[str, Any]) -> dict[str, Any] | None:
    """What the adapter keeps in an issue's metadata under its own key: {}
    while the key is absent, or None where an earlier version left the key
    holding a value of the issue's own, null included, which the adapter
    leaves as it is and reads nothing from."""
    held = beads_metadata(row)
    if BEADS_KEY not in held:
        return {}
    own = held[BEADS_KEY]
    return dict(own) if isinstance(own, dict) else None


def beads_left_as_given(kept: list[str]) -> str:
    """The upgrade's line for the issues whose metadata holds dotdiw as a
    value of their own, which keep their descriptions as they were."""
    if len(kept) == 1:
        return (
            "%s keeps the means in its description, since its metadata holds dotdiw as a "
            "value of its own" % kept[0]
        )
    return (
        "%s and %s keep the means in their descriptions, since their metadata holds dotdiw "
        "as a value of their own" % (", ".join(kept[:-1]), kept[-1])
    )


def beads_means(row: dict[str, Any], means: list[str], moved: bool = False) -> str:
    """The issue's metadata with the means to prove a run kept under the
    adapter's own key, everything else in it as it was, as bd takes it; with
    moved, the mark that the upgrade has moved them out of its description.
    The upgrade hands it no issue whose key holds a value of its own."""
    held = beads_metadata(row)
    mine = dict(held.get(BEADS_KEY) or {})
    if moved:
        mine["meansMoved"] = True
    if means:
        mine["verifyUsing"] = list(means)
    else:
        mine.pop("verifyUsing", None)
    if mine:
        held[BEADS_KEY] = mine
    else:
        held.pop(BEADS_KEY, None)
    return json.dumps(held, ensure_ascii=False)


def beads_quiet(
    args: list[str],
    root: str | None = None,
    session: str | None = None,
    store: str | None = None,
) -> tuple[int, str, str]:
    """Run bd for its output only, nothing printed: exit code, stdout, stderr.
    One the system will not start -- given more than a command line holds,
    say -- answers as bd failing, saying so (BEADS_UNSTARTED), and is the
    adapter's failure wherever bd's failures are answered (beads_failed)."""
    bd = beads_find()
    if not bd:
        return 127, "", ""
    env = beads_environment(root, session, store)
    try:
        p = subprocess.run([bd] + list(args), capture_output=True, text=True, env=env)
    except OSError as e:
        return 126, "", "%s: %s" % (BEADS_UNSTARTED, e.strerror or e)
    return p.returncode, p.stdout, p.stderr


# What beads_quiet says where the system would not start bd at all.
BEADS_UNSTARTED = "dotdiw could not start the tracker"


def beads_batch(lines: list[list[str]], root: str | None) -> tuple[int, str, str]:
    """bd's batch: the writes given, each a line of words, in one
    transaction, all of them or none. It reads each id whole: one bd holds
    nothing of is not found and nothing is written, where bd's other
    commands read it as the one item whose id begins with it (beads_holds),
    and write that one. The batch reads a line by its words, so a word that
    would not stand as one -- empty, holding a space, a quote or a
    backslash, or opening a comment -- is no id bd holds, and nothing is
    written: a line cannot carry a second write in an id."""
    for words in lines:
        for word in words:
            if not re.fullmatch(r'[^\s"\\#][^\s"\\]*', word):
                return 1, "", "no issue found: %s" % json.dumps(word)
    fd, path = tempfile.mkstemp(prefix="%s-" % PROG, suffix=".batch")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write("".join(" ".join(words) + "\n" for words in lines))
        return beads_quiet(["batch", "--json", "-f", path], root)
    finally:
        os.unlink(path)


def beads_left_out(rows: list[dict[str, Any]], root: str | None) -> str | None:
    """What a listing of every item leaves out, by bd's own account, not the
    listing's: an item of a run, or the root of the run a listed item names;
    either one bd holds, or does not say it holds no more (beads_shown,
    beads_holds). bd's query, which is no listing, answers every item bd
    holds, and each is read as an item of a run three ways at once, so that
    an edit of any leaves the others: by BEADS_RUN_LABEL, which the create
    that made it gave it, wherever it stands; by the run its own metadata
    names under the adapter's key, which the create gave it too, and which
    bd's own commands that edit labels, parents and fields leave as it is;
    and by id, every item whose id runs on from that of a root listed or of
    a run an item names, as bd makes the id of each item under another -- a
    step's from its root's -- and keeps it wherever the item is moved, and
    whatever its labels. A root of a run is one too. None where each is
    listed or held no more; else the sentence naming the first left out, or
    saying that bd's query could not be read."""
    listed = {str(r.get("id")) for r in rows}
    code, out, err = beads_quiet(["query", 'id="*"', "--all", "-n", "0", "--json"], root)
    found = beads_rows(out) if code == 0 else None
    if found is None:
        said = (
            beads_failed(ListItemsResponse, out, err, [])["summary"] if code else BEADS_NO_LISTING
        )
        return "The tracker could not say which items its runs hold: %s" % said
    runs = {str(r.get("id")) for r in rows if r.get("issue_type") == "molecule"}
    runs |= {
        str(n)
        for n in ((beads_own(r) or {}).get("run") for r in list(rows) + found)
        if isinstance(n, str)
    }

    def in_a_run(row: dict[str, Any]) -> bool:
        ident = str(row.get("id"))
        return (
            BEADS_RUN_LABEL in (row.get("labels") or [])
            or isinstance((beads_own(row) or {}).get("run"), str)
            or ident in runs
            or any(ident.startswith(n + ".") for n in runs)
        )

    for f in found:
        other = str(f["id"])
        if other in listed or not in_a_run(f):
            continue
        shown = beads_shown([other], root)
        if shown is None or other in shown:
            run = (beads_own((shown or {}).get(other) or {}) or {}).get("run")
            return "The tracker's list of every item leaves out %s, which it holds%s." % (
                other,
                " in a run with %s" % run if isinstance(run, str) else "",
            )
    for r in rows:
        run = (beads_own(r) or {}).get("run")
        if isinstance(run, str) and run not in listed and beads_holds(run, root) is not False:
            return (
                "The tracker's list of every item leaves out %s, which it holds in a run with %s."
                % (
                    run,
                    r.get("id"),
                )
            )
    return None


def beads_partial(buf: bytes) -> tuple[bytes, bytes]:
    """Split off a short alphanumeric tail that may be half of a split token."""
    i, n = len(buf), 0
    while i > 0 and chr(buf[i - 1]).isalnum() and n < 3:
        i -= 1
        n += 1
    return buf[:i], buf[i:]


def beads_terminal(
    args: list[str], root: str | None = None, session: str | None = None
) -> tuple[int, str]:
    """Run bd with the worker's terminal, its name rewritten in every byte of
    output on the way out; through a pty when the terminal is interactive, so
    prompts still work. Returns the exit code and the rewritten text that
    went past, for the record to be read from."""
    bd = beads_find()
    if not bd:
        return 127, ""
    env = beads_environment(root, session)
    argv = [bd] + list(args)

    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        p = subprocess.run(argv, capture_output=True, text=True, env=env)
        out, err = _BD_WORD.sub(PROG, p.stdout), _BD_WORD.sub(PROG, p.stderr)
        sys.stdout.write(out)
        sys.stdout.flush()
        sys.stderr.write(err)
        sys.stderr.flush()
        return p.returncode, out + err

    import pty

    carry = bytearray()
    seen = bytearray()

    def reader(fd: int) -> bytes:
        data = os.read(fd, 4096)
        if not data:
            out = _BD_WORD_B.sub(PROG.encode(), bytes(carry))
            del carry[:]
            seen.extend(out)
            return out
        carry.extend(data)
        head, tail = beads_partial(bytes(carry))
        del carry[:]
        carry.extend(tail)
        out = _BD_WORD_B.sub(PROG.encode(), head)
        seen.extend(out)
        return out

    # A pty's child runs with the process's environment, so what this run
    # alone is told goes before bd, through env.
    told = ["%s=%s" % (k, v) for k, v in env.items() if os.environ.get(k) != v]
    code = os.waitstatus_to_exitcode(pty.spawn(["/usr/bin/env", *told, *argv], reader))
    return code, bytes(seen).decode("utf-8", "replace")


def beads_run(
    args: list[str], root: str | None, terminal: bool, session: str | None = None
) -> tuple[int, str, str]:
    """bd with the terminal when the request has one, quietly otherwise:
    exit code, output, and what stderr held when it was kept apart."""
    if terminal:
        code, out = beads_terminal(args, root, session=session)
        return code, out, ""
    return beads_quiet(args, root, session=session)


def beads_json(text: str | None) -> list[dict[str, Any]]:
    """The rows a bd --json answer holds, or [] when it is not JSON."""
    try:
        rows = json.loads(text or "[]")
    except ValueError:
        return []
    if isinstance(rows, dict):
        rows = [rows]
    return [r for r in rows if isinstance(r, dict)]


def beads_rows(text: str | None) -> list[dict[str, Any]] | None:
    """The rows of a bd --json listing: a list of issues, each with its id,
    and an empty list where there are none. None where the answer is
    anything else -- nothing, no JSON, one object, a row that is no issue --
    since a listing that cannot be read whole says nothing of what it leaves
    out, and what it leaves out would be taken for not there."""
    try:
        rows = json.loads(text or "")
    except ValueError:
        return None
    if not isinstance(rows, list) or not all(isinstance(r, dict) and r.get("id") for r in rows):
        return None
    return rows


def beads_held_time(stamp: Any) -> Any:
    """A time as bd's store holds it, to the whole second: bd's create and
    its writes print the time they ran to the microsecond, and the store
    keeps it rounded to the nearest second, which every later read shows. So
    a record answered from a write is the record a read gives, and has the
    same ETag. A time with no fraction, or none bd's form, is left as given."""
    if not isinstance(stamp, str) or "." not in stamp:
        return stamp
    try:
        at = datetime.datetime.fromisoformat(stamp)
    except ValueError:
        return stamp
    held = (at + datetime.timedelta(microseconds=500000)).replace(microsecond=0)
    return held.strftime("%Y-%m-%dT%H:%M:%SZ") if stamp.endswith("Z") else held.isoformat()


def beads_record(row: dict[str, Any]) -> TrackerItem:
    """A bd issue as the interface's record. bd's list and show name an
    edge's type differently; both are read. The edge a guarded pour gives a
    root or a calling step to its guard is the adapter's own, and no need:
    the record names the guard as its guard instead."""
    status = row.get("status")
    own = beads_own(row) or {}
    guard = own.get("guard") if isinstance(own.get("guard"), str) else None
    needs = [
        d.get("depends_on_id") or d.get("id")
        for d in row.get("dependencies") or []
        if (d.get("type") or d.get("dependency_type")) == "blocks"
    ]
    kind: Literal["root", "task", "guard"] = (
        "guard"
        if own.get("kind") == "guard"
        else "root"
        if row.get("issue_type") == "molecule"
        else "task"
    )
    item: TrackerItem = {
        "id": str(row.get("id")),
        "title": str(row.get("title") or ""),
        "kind": kind,
        "status": status if status in BEADS_STATUSES else "open",
        "priority": row.get("priority"),
        "parent": row.get("parent"),
        "assignee": row.get("assignee"),
        "reason": row.get("close_reason"),
        "needs": [n for n in needs if n and n != guard],
        "createdAt": beads_held_time(row.get("created_at")),
        "updatedAt": beads_held_time(row.get("updated_at")),
    }
    if row.get("description") is not None:
        item["description"] = row["description"]
    means = own.get("verifyUsing")
    if isinstance(means, list) and means:
        item["verifyUsing"] = [str(m) for m in means]
    if isinstance(own.get("step"), str):
        item["step"] = own["step"]
    if isinstance(own.get("claim"), dict):
        item["claim"] = own["claim"]
    if isinstance(own.get("run"), str):
        item["run"] = own["run"]
    for key in ("within", "calls", "guard"):
        if isinstance(own.get(key), str):
            item[key] = own[key]
    if own.get("whole") is True:
        item["whole"] = True
    kept = beads_values(row)
    if kept:
        item["values"] = [{"label": label, "text": text} for _, label, text in kept]
    return item


# Each claim value under a metadata key of its own, so that one value is
# never read as part of another, and a write of one label touches no other:
# bd's update sets and unsets each key alone (beads_record_values). bd's keys
# take no hyphen and a label takes no underscore, so each hyphen becomes one.
BEADS_VALUE = "dotdiw_value."

# Every item poured into a run, or moved into one, carries this label, given
# by the bd create that makes it, so that one write makes it and keeps it in
# the run; bd's query for the label, which is no listing, then answers every
# item of every run, wherever each stands (beads_left_out). It is no edge, so
# it leaves every edge between a root and an item of its run free.
BEADS_RUN_LABEL = "dotdiw-run"


def beads_values(row: dict[str, Any]) -> list[tuple[int, str, str]]:
    """The claim values an issue's metadata keeps: the order each was first
    recorded in, its label and its text, in that order."""
    kept = []
    for key, held in beads_metadata(row).items():
        if not key.startswith(BEADS_VALUE):
            continue
        try:
            value = json.loads(held) if isinstance(held, str) else held
        except ValueError:
            continue
        if isinstance(value, dict) and isinstance(value.get("text"), str) and value["text"]:
            label = key[len(BEADS_VALUE) :].replace("_", "-")
            kept.append((int(value.get("first") or 0), label, value["text"]))
    return sorted(kept)


def beads_value_key(label: str) -> str:
    """The metadata key a claim's label keeps its value under (BEADS_VALUE)."""
    return BEADS_VALUE + label.replace("-", "_")


def beads_value_held(text: str, first: int) -> str:
    """A claim value as its key holds it: the text, and the order it was
    first recorded in, so that values come back in that order (beads_values)."""
    return json.dumps({"text": text, "first": first}, ensure_ascii=False)


def beads_failed(
    shape: type[R], out: str, err: str, reasons: list[tuple[str, tuple[str, ...]]]
) -> R:
    """A failed response from what bd said, with the reason its words name:
    an id it found no issue for, a cycle, a status it does not have. bd
    asked for JSON says why in a JSON object, on stdout or, as its batch
    does, at the head of stderr; that object's error is what it said."""
    text = _BD_WORD.sub(PROG, (err or "") + (out or ""))
    said = beads_json(out)
    if not said and (err or "").lstrip().startswith("{"):
        try:
            head = json.JSONDecoder().raw_decode((err or "").lstrip())[0]
        except ValueError:
            head = None
        said = [head] if isinstance(head, dict) else []
    first = str(said[0].get("error") or "") if said else ""
    first = _BD_WORD.sub(PROG, first) or (
        text.strip().split("\n")[0] if text.strip() else "The tracker refused."
    )
    reason = None
    for key, words in reasons:
        if any(w in text for w in words):
            reason = key
            break
    if reason is None and BEADS_UNSTARTED in text:
        reason = "adapter-failed"
    return failed_as(shape, reason, first)


def beads_open(request: OpenTrackerRequest) -> OpenTrackerResponse:
    """operation.open-tracker: bd init in its stealth mode, under the key.

    A second open changes nothing.
    Where an earlier version's tracker sits in the tree, its prefix is kept,
    so that the ids the project is used to read on; nothing else of it is
    read. bd makes its directory itself and requires the workspace above it
    to exist, which the body that opens the tracker made.
    """
    if not beads_find():
        return failed_as(OpenTrackerResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    store = beads_store(root)
    if store is None:
        return failed_as(OpenTrackerResponse, *BEADS_NO_WORKSPACE)
    if os.path.isdir(store):
        return {
            "status": "completed",
            "summary": "Already open.",
            "path": store,
            "created": False,
            "exitCode": 0,
        }
    prefix = request.get("prefix")
    if not prefix and root:
        try:
            with open(os.path.join(root, BEADS_STORE, "metadata.json"), encoding="utf-8") as fh:
                prefix = str(json.load(fh).get("dolt_database") or "").strip() or None
        except (OSError, ValueError):
            prefix = None
    code, _, _ = beads_quiet(
        ["init", *INIT_FLAGS] + (["--prefix", prefix] if prefix else []), root, store=store
    )
    if code != 0:
        return {
            "status": "failed",
            "reason": "store-unwritable",
            "exitCode": code,
            "summary": "The tracker's init exited %d." % code,
        }
    beads_moved(store)
    return {
        "status": "completed",
        "summary": "Opened under %s." % store,
        "path": store,
        "created": True,
        "exitCode": 0,
    }


def beads_actor(root: str | None) -> TrackerActor | None:
    """Who bd records: $BEADS_ACTOR, git's user.name or $USER, in that order.
    Anyone can give any of them, so it is not verified."""
    name = (
        os.environ.get("BEADS_ACTOR")
        or git(["config", "user.name"], root).strip()
        or os.environ.get("USER")
    )
    return {"name": name, "verified": False} if name else None


def beads_typed(args: list[str], root: str | None) -> tuple[list[str], str | None]:
    """The arguments as typed, read option by option so that a value is never
    taken for an option: an assignee of me as the name bd records, where bd
    itself would keep the word. With them, why they are refused, never: the
    type a root has is refused before, read as bd reads it."""
    out = list(args)
    i = 0
    while i < len(out):
        a = out[i]
        if a.startswith("-") and "=" in a:
            flag, value = a.split("=", 1)
            at = i
        elif a in BEADS_VALUE_FLAGS and i + 1 < len(out):
            flag, value = a, out[i + 1]
            at = i + 1
        else:
            i += 1
            continue
        if flag in ("-a", "--assignee") and value == "me":
            actor = beads_actor(root)
            value = actor["name"] if actor else value
        out[at] = flag + "=" + value if at == i else value
        i = at + 1
    return out, None


def beads_describe(request: DescribeTrackerRequest) -> DescribeTrackerResponse:
    """operation.describe-tracker: what this adapter is, and bd's own version."""
    if not beads_find():
        return failed_as(DescribeTrackerResponse, *BEADS_NOT_INSTALLED)
    _, out, _ = beads_quiet(["--version"])
    number = re.search(r"\d+(?:\.\d+)+", out)
    store = beads_store(request.get("root"))
    return {
        "status": "completed",
        "summary": "The tracker underneath, through its adapter.",
        "info": {
            "name": "beads",
            "version": number.group(0) if number else "unknown",
            "origin": "shipped",
            "nativeNeeds": True,
            "nests": True,
            "checkTarget": "scratch",
            "extras": ["forward", "metrics-off", "upgrade", "read"],
        },
        "actor": beads_actor(request.get("root")),
        "path": store if store and os.path.isdir(store) else None,
        "exitCode": 0,
    }


def beads_create(request: CreateItemRequest) -> CreateItemResponse:
    """operation.create-item: bd create, from the fields given, and bd's JSON
    answer read as the record. One made in a run carries the label of every
    item of a run (BEADS_RUN_LABEL), given in that one create, so that
    nothing is left to write once the item is made."""
    if not beads_find():
        return failed_as(CreateItemResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(CreateItemResponse, *BEADS_NO_WORKSPACE)
    argv = [
        "create",
        "--title=" + request["title"],
        "--type=task",
        "--priority=%s" % (2 if request.get("priority") is None else request["priority"]),
        "--json",
    ]
    parent = request.get("parent")
    description = request.get("description")
    means = list(request.get("verifyUsing") or [])
    moved = {k: request[k] for k in ("step", "claim", "run", "within", "calls") if request.get(k)}
    values = list(request.get("values") or [])
    if parent:
        argv += ["--parent=" + parent]
    if description:
        argv += ["--description=" + description]
    if means or moved or values:
        given: dict[str, Any] = {
            beads_value_key(v["label"]): beads_value_held(v["text"], n)
            for n, v in enumerate(values)
        }
        given[BEADS_KEY] = moved
        argv += ["--metadata=" + beads_means({"metadata": given}, means)]
    if moved.get("run"):
        argv += ["--labels=" + BEADS_RUN_LABEL]
    if moved.get("within"):
        # The calling step needs what is poured within it: in this create,
        # which gives the edge from the other end.
        argv += ["--deps=blocks:" + str(moved["within"])]
    code, out, err = beads_quiet(argv, root)
    if code != 0:
        return beads_failed(CreateItemResponse, out, err, [("parent-not-found", ("parent issue",))])
    rows = beads_json(out)
    if not rows:
        return {"status": "failed", "exitCode": 1, "summary": "The tracker answered no record."}
    item = beads_record(rows[0])
    if request.get("parent") and not item.get("parent"):
        item["parent"] = request["parent"]  # bd's create answers without it
    return {
        "status": "completed",
        "summary": "Created %s." % item["id"],
        "item": item,
        "exitCode": 0,
    }


def beads_need(request: AddNeedRequest) -> AddNeedResponse:
    """operation.add-need: a blocks edge, written through bd's batch, which
    reads both ids whole (beads_batch): bd's dep add reads an id it holds
    nothing of as the one item whose id begins with it -- a deleted root's
    as its only step's -- and would give that one the need. An edge already
    there is written again as nothing, and bd refuses a cycle."""
    if not beads_find():
        return failed_as(AddNeedResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(AddNeedResponse, *BEADS_NO_WORKSPACE)
    code, out, err = beads_batch([["dep", "add", request["id"], request["needs"]]], root)
    if code != 0:
        return beads_failed(
            AddNeedResponse, out, err, [("cycle", ("cycle",)), ("item-not-found", BEADS_NOT_FOUND)]
        )
    return {
        "status": "completed",
        "summary": "%s needs %s." % (request["id"], request["needs"]),
        "edge": {"id": request["id"], "needs": request["needs"]},
        "exitCode": 0,
    }


def beads_pour(request: PourStepsRequest) -> PourStepsResponse:
    """operation.pour-steps: a root and one issue per step, each made with bd
    create in the order the needs allow and blocked by the steps it needs, as
    the local adapter pours; the step ids in the formula's order. The root
    keeps the formula's description, and the means to prove its run in its
    metadata. Each step names the run in its own metadata and carries the
    label of every item of a run (BEADS_RUN_LABEL), both in the create that
    makes it. A pour that fails after making its root names the root and the
    steps it made."""
    if not beads_find():
        return failed_as(PourStepsResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(PourStepsResponse, *BEADS_NO_WORKSPACE)
    steps = list(request.get("steps") or [])
    if not steps:
        return {
            "status": "failed",
            "reason": "no-steps",
            "exitCode": 1,
            "summary": "No steps to pour.",
        }
    shared = shared_step_id(steps)
    if shared is not None:
        return {
            "status": "failed",
            "reason": "duplicate-step",
            "exitCode": 1,
            "summary": "Two steps share the id %s, so nothing was poured." % shared,
        }
    try:
        ordered = steps_in_order(steps)
    except LookupError as e:
        return {"status": "failed", "reason": "step-not-found", "exitCode": 1, "summary": str(e)}
    except ValueError as e:
        return {"status": "failed", "reason": "cycle", "exitCode": 1, "summary": str(e)}
    if any(s.get("within") or s.get("calls") for s in steps):
        return beads_pour_guarded(request, steps, ordered, root)
    argv = ["create", "--title=" + request["title"], "--type=molecule", "--priority=2", "--json"]
    description = request.get("description")
    means = list(request.get("verifyUsing") or [])
    if description:
        argv += ["--description=" + description]
    if means:
        argv += ["--metadata=" + beads_means({}, means)]
    code, out, err = beads_quiet(argv, root)
    rows = beads_json(out) if code == 0 else []
    if not rows:
        return beads_failed(PourStepsResponse, out, err, [])
    root_id = str(rows[0].get("id"))
    ids: dict[str, str] = {}
    for s in ordered:
        argv = ["create", "--title=" + s["title"], "--parent=" + root_id, "--type=task", "--json"]
        poured: dict[str, Any] = {"step": s["id"], "run": root_id}
        if s.get("claim"):
            poured["claim"] = s["claim"]
        argv += ["--metadata=" + json.dumps({BEADS_KEY: poured}, ensure_ascii=False)]
        argv += ["--labels=" + BEADS_RUN_LABEL]
        needs = list(s.get("needs") or [])
        if needs:
            argv += ["--deps=" + ",".join("blocked-by:%s" % ids[n] for n in needs)]
        code, out, err = beads_quiet(argv, root)
        rows = beads_json(out) if code == 0 else []
        if not rows:
            said = " ".join((err or out).split())[:240] or "the tracker exited %d" % code
            return {
                "status": "failed",
                "reason": "adapter-failed",
                "exitCode": 1,
                "rootId": root_id,
                "stepIds": [ids[x["id"]] for x in steps if x["id"] in ids],
                "summary": "Poured %d of %d steps under %s%s, and the next failed: %s"
                % (
                    len(ids),
                    len(steps),
                    root_id,
                    " (%s)" % ", ".join(ids[x["id"]] for x in steps if x["id"] in ids)
                    if ids
                    else "",
                    said,
                ),
            }
        ids[s["id"]] = str(rows[0].get("id"))
    return {
        "status": "completed",
        "summary": "Poured %d steps under %s." % (len(ids), root_id),
        "rootId": root_id,
        "stepIds": [ids[s["id"]] for s in steps],
        "exitCode": 0,
    }


def beads_pour_guarded(
    request: PourStepsRequest, steps: list[Any], ordered: list[Any], root: str | None
) -> PourStepsResponse:
    """A pour of steps that call a formula, which bd cannot write at once,
    held on a guard until it is whole, one bd write at a time:

    1. the guard: an issue made blocked, under no parent -- outside the
       root's children -- marked the adapter's guard in its metadata;
    2. the root, made blocked by the guard and naming it in its metadata;
    3. the guard given the root's run, and the run's label, by one update;
    4. each step, in the order given, under the root, made with its step,
       its claim, its run and its label, the calling step it stands within,
       every need -- and, for a calling step, the formula it calls, that
       formula's description and means, and an edge to the guard, which it
       names in its metadata -- all in the create that makes it;
    5. the guard closed.

    Stopped after any of them, nothing it made can complete: the root and
    every calling step wait on the guard, which bd holds open to every
    close but its own and dotdiw closes only once the root reads whole
    (known_whole, GUARD_HELD); the root
    names it, and once the guard has the run it is an open item of the run
    too, so a root bd closes of its own accord when its last child closes
    is opened again by the next close through dotdiw (held_to_the_run). The
    edges to the guard are the adapter's own, and no need (beads_record).
    A pour that fails part of the way names the guard, the root and the
    steps it made, in the order given."""
    ref = request.get("formulaRef") or request["title"]

    def made(argv: list[str]) -> tuple[str | None, str]:
        """One bd create of the flags given; the id made, or what bd said."""
        code, out, err = beads_quiet(["create", *argv, "--json"], root)
        rows = beads_json(out) if code == 0 else []
        if not rows:
            return None, " ".join((err or out).split())[:240] or "the tracker exited %d" % code
        return str(rows[0].get("id")), ""

    def stopped(
        said: str, guard: str | None, root_id: str | None, ids: dict[str, str]
    ) -> PourStepsResponse:
        done = [ids[step_named(x)] for x in steps if step_named(x) in ids]
        out: PourStepsResponse = {
            "status": "failed",
            "reason": "adapter-failed",
            "exitCode": 1,
            "stepIds": done,
            "summary": "Poured %d of %d steps%s%s, and the next write failed: %s"
            % (
                len(done),
                len(steps),
                " under %s" % root_id if root_id else ", no root made",
                " (%s)" % ", ".join(done) if done else "",
                said,
            ),
        }
        if root_id:
            out["rootId"] = root_id
        if guard:
            out["guardId"] = guard
        return out

    guard, said = made(
        [
            "--title=Pour of " + ref,
            "--type=task",
            "--status=blocked",
            "--priority=2",
            "--metadata=" + json.dumps({BEADS_KEY: {"kind": "guard"}}, ensure_ascii=False),
        ]
    )
    if guard is None:
        return beads_failed(PourStepsResponse, "", said, [])
    argv = [
        "--title=" + request["title"],
        "--type=molecule",
        "--priority=2",
        "--deps=blocked-by:" + guard,
        "--metadata="
        + beads_means(
            {"metadata": {BEADS_KEY: {"guard": guard}}}, list(request.get("verifyUsing") or [])
        ),
    ]
    if request.get("description"):
        argv += ["--description=" + str(request["description"])]
    root_id, said = made(argv)
    if root_id is None:
        return stopped(said, guard, None, {})
    code, out, err = beads_quiet(
        [
            "update",
            guard,
            "--metadata=" + json.dumps({BEADS_KEY: {"kind": "guard", "run": root_id}}),
            "--add-label=" + BEADS_RUN_LABEL,
            "--json",
        ],
        root,
    )
    wrote = beads_json(out) if code == 0 else []
    if not wrote or str(wrote[0].get("id")) != guard:
        said = " ".join((err or out).split())[:240] or "the tracker wrote no guard %s" % guard
        return stopped(said, guard, root_id, {})
    ids: dict[str, str] = {}
    for s in ordered:
        poured: dict[str, Any] = {"step": s["id"], "run": root_id}
        if s.get("claim"):
            poured["claim"] = s["claim"]
        needs = ["blocked-by:%s" % ids[str(n)] for n in s.get("needs") or []]
        if s.get("within"):
            poured["within"] = ids[str(s["within"])]
            needs.append("blocks:%s" % poured["within"])
        argv = ["--title=" + s["title"], "--parent=" + root_id, "--type=task"]
        if s.get("calls"):
            poured["calls"] = s["calls"]
            poured["guard"] = guard
            needs.append("blocked-by:%s" % guard)
            if s.get("description"):
                argv += ["--description=" + str(s["description"])]
        metadata = {BEADS_KEY: poured}
        argv += [
            "--metadata=" + beads_means({"metadata": metadata}, list(s.get("verifyUsing") or [])),
            "--labels=" + BEADS_RUN_LABEL,
        ]
        if needs:
            argv += ["--deps=" + ",".join(needs)]
        ident, said = made(argv)
        if ident is None:
            return stopped(said, guard, root_id, ids)
        ids[step_named(s)] = ident
    # The root marked whole, its own words kept -- the guard it names, its
    # means: so a guard the tracker no longer holds, housekeeping having
    # deleted it once it closed, holds nothing of the run.
    code, out, err = beads_quiet(
        [
            "update",
            root_id,
            "--metadata="
            + beads_means(
                {"metadata": {BEADS_KEY: {"guard": guard, "whole": True}}},
                list(request.get("verifyUsing") or []),
            ),
            "--json",
        ],
        root,
    )
    wrote = beads_json(out) if code == 0 else []
    if not wrote or str(wrote[0].get("id")) != root_id:
        said = " ".join((err or out).split())[:240] or "the tracker wrote no root %s" % root_id
        return stopped(said, guard, root_id, ids)
    code, out, err = beads_quiet(["close", guard, "--reason", "poured whole", "--json"], root)
    if code != 0:
        said = " ".join((err or out).split())[:240] or "the tracker exited %d" % code
        failed = stopped(said, guard, root_id, ids)
        failed["summary"] = (
            "Poured every step under %s, and the guard %s could not be closed: %s"
            % (
                root_id,
                guard,
                said,
            )
        )
        return failed
    return {
        "status": "completed",
        "summary": "Poured %d steps under %s." % (len(ids), root_id),
        "rootId": root_id,
        "stepIds": [ids[step_named(s)] for s in steps],
        "exitCode": 0,
    }


def beads_close(request: CloseItemRequest) -> CloseItemResponse:
    """operation.close-item: bd close with the reason, held to the run rule
    before it runs and after it (held_to_the_run).

    bd knows no run, and closes a molecule of its own accord when its last
    child closes. So every item is listed first, and the close is refused
    while an open item poured in the one named stands open, wherever it
    stands; bd itself refuses while an open need or an open child exists,
    and the ids it names come back. The id is read as bd reads it, a short
    one as the full one, since bd keeps a run by the full id; the full id is
    the one named. Save where bd shows an item whose id runs on past the one
    given (shown_for_a_word): bd holds nothing by that id, and reads it as
    another item's, so nothing is closed. A listing that leaves out the item
    named is not every item, and nothing is closed on its word.

    The close runs under a session of its own, which bd keeps on what it
    closes. After it every item is listed again, and that listing is every
    item only where it holds each one listed before that bd still holds
    (beads_holds); one another deleted as the close ran is no gap. What
    carries the session is what this close closed: the item, and any root
    that stood open before and stands closed now. An item closed already is
    named as closed already, not as closed by this close, and bd's close is
    not run for it again.

    bd's close holds its own rule in the write that closes, and no write of
    bd's that holds that rule reads an id whole: it reads an id it holds
    nothing of as the one item whose id begins with it -- a deleted root's
    as its only step's -- and closes that one. So an item deleted between
    the read and bd's close may have another closed in its place. Any
    other item bd's close printed is read back too, and one that carries
    the session is named as closed by this close, and as closed in the
    place of the item named, which the tracker holds no more; the close
    fails. A write held to the item read is the tracker's to give.

    What bd's close did is read from the tracker, not from how it exited.
    Only a refusal bd gives its reason for -- what blocks the item, or no
    such item -- is answered as it stands, nothing having closed. Any other
    error is followed by the same listing, the same session read back and
    the same rule, and the close fails with bd's words, naming what it
    closed. And where bd answers without an error and the item stands open
    after it, the close fails saying so.

    Then the rule is held of the items as they stand, whatever stood above
    the item when it was first read, and on every path -- the item closed
    already or not, the session read back or not: what stands closed
    against the rule is opened again, and a root this close closed with
    nothing of its run open is named after the item. Where the item named
    is opened again the close is blocked by what it waits on; where the
    items or the session cannot be read back after the close, or one will
    not open again, it fails, naming what it closed, and why. So it does
    where bd holds the item named no more after the close, another having
    deleted it: nothing of that item is read back or named as closed, and
    the rule is held of the rest."""
    if not beads_find():
        return failed_as(CloseItemResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(CloseItemResponse, *BEADS_NO_WORKSPACE)
    code, out, err = beads_quiet(["show", request["id"], "--json"], root)
    found = beads_json(out) if code == 0 else []
    if not found:
        return beads_failed(CloseItemResponse, out, err, [("item-not-found", BEADS_NOT_FOUND)])
    whole = shown_for_a_word(request["id"], {"status": "completed", "item": found[0]})
    if whole["status"] != "completed":
        return failed_as(CloseItemResponse, "item-not-found", whole["summary"])
    ident = str(found[0].get("id"))
    listed = beads_list({"root": root, "scope": "all"})
    if listed["status"] != "completed":
        return failed_as(CloseItemResponse, "adapter-failed", listed["summary"])
    every: dict[str, TrackerItem] = {i["id"]: i for i in listed.get("items") or []}
    if ident not in every:
        return failed_as(
            CloseItemResponse,
            "adapter-failed",
            "Nothing closed: the tracker shows %s, and its list of every item leaves it out, "
            "so what a close of it waits on could not be read." % ident,
        )
    before = {i: o for i, o in every.items() if o.get("status") != "closed"}
    # Closed already: bd's close is not run, and the items stand as listed.
    now = every
    item: TrackerItem | None = beads_record(found[0])
    marked: list[str] | None = []
    # What bd said of a close it failed without a reason, first in the answer.
    said: list[str] = []
    errored = left_open = gone = False
    # Any other item bd's close printed: one it closed in the place of the
    # item named, deleted between the read and the close.
    instead: list[str] = []
    unread = (
        "%s could not be read back after the close, so whether this close closed it is not "
        "known." % ident
    )
    # The pours not known to be whole (pours_held): a guard of one is closed
    # by nothing but its pour, and what one holds from closing waits on its
    # guard, whatever that reads as. A guard that stands open closes only
    # where its pour is known to be whole (known_whole): the pour's own last
    # write again.
    pours = pours_held(every, lambda g: beads_show({"root": root, "id": g}))
    holding = closes_held(pours)
    if (every[ident].get("kind") == "guard" or ident in pours) and (
        every[ident].get("status") == "closed" or not known_whole(ident, every)
    ):
        return {
            "status": "blocked",
            "reason": "blocked",
            "exitCode": 1,
            "summary": GUARD_HELD % ident,
        }
    if ident in before:
        poured = [i for i, o in before.items() if ident in (o.get("run"), o.get("within"))]
        guard = every[ident].get("guard")
        if (
            guard
            and guard in before
            and before[guard].get("kind") == "guard"
            and guard not in poured
        ):
            poured.append(str(guard))
        pour = holding.get(ident)
        if pour and pours[pour]["unread"]:
            return failed_as(
                CloseItemResponse,
                "adapter-failed",
                "Nothing closed: %s is held on %s, the guard of a pour not known to be whole, "
                "which could not be read: %s" % (ident, pour, pours[pour]["unread"]),
            )
        if pour and pour not in poured:
            poured.append(pour)
        if poured:
            return {
                "status": "blocked",
                "reason": "blocked",
                "blockedBy": poured,
                "exitCode": 1,
                "summary": "%s is blocked by %s." % (ident, ", ".join(poured)),
            }
        argv = ["close", ident, "--json"]
        reason = request.get("closeReason")
        if reason:
            argv += ["--reason", reason]
        session = beads_session(os.environ.get("CLAUDE_SESSION_ID"))
        code, out, err = beads_quiet(argv, root, session=session)
        printed: list[dict[str, Any]] = []
        if code == 0:
            rows_printed = beads_rows(out) or []
            printed = [r for r in rows_printed if r.get("id") == ident]
            instead = [str(r["id"]) for r in rows_printed if r.get("id") not in (None, ident)]
        else:
            m = re.search(r"blocked by \[(.*?)\]", out + err)
            if m:
                blocked = [x.strip() for x in m.group(1).split(",") if x.strip()]
            else:
                # bd names no child it refuses over; those listed open under
                # the item are they, unless one was made since.
                blocked = [i for i, o in before.items() if o.get("parent") == ident]
            if blocked and (m or "open child" in out + err):
                return {
                    "status": "blocked",
                    "reason": "blocked",
                    "blockedBy": blocked,
                    "exitCode": 1,
                    "summary": "%s is blocked by %s." % (ident, ", ".join(blocked)),
                }
            refused = beads_failed(
                CloseItemResponse,
                out,
                err,
                [("item-not-found", BEADS_NOT_FOUND), ("blocked", ("open child", "blocked by"))],
            )
            if refused.get("reason"):
                return refused
            # An error that names no refusal does not say that nothing closed.
            errored = True
            said.append(str(refused["summary"]))
        listed = beads_list({"root": root, "scope": "all"})
        if listed["status"] != "completed":
            return failed_as(
                CloseItemResponse,
                "adapter-failed",
                " ".join(said + [unread, str(listed["summary"])]),
            )
        now = {i["id"]: i for i in listed.get("items") or []}
        for absent in [i for i in every if i not in now]:
            if beads_holds(absent, root) is not False:
                return failed_as(
                    CloseItemResponse,
                    "adapter-failed",
                    " ".join(said + [unread])
                    + " The tracker's list of every item leaves out %s, which it listed before."
                    % absent,
                )
        # What may carry the session: the item, any other bd's close printed,
        # and each root that stood open before and stands closed now. One bd
        # holds no more has no row.
        rows = beads_shown(
            list(
                dict.fromkeys(
                    ([ident] if ident in now else [])
                    + [i for i in instead if i in now and i in before]
                    + [
                        i
                        for i, o in before.items()
                        if i != ident
                        and o.get("kind") == "root"
                        and i in now
                        and now[i].get("status") == "closed"
                    ]
                )
            ),
            root,
        )
        marked = None if rows is None else beads_marked(rows, session)
        gone = ident not in now or (rows is not None and ident not in rows)
        if gone:
            # The item named, deleted since bd's close ran: nothing of it is
            # read back, and it is no item as they stand now, listed or not.
            now = {i: o for i, o in now.items() if i != ident}
            item = None
        else:
            left_open = now[ident].get("status") != "closed"
            # The record as bd's close printed it, or as listed after the close.
            item = beads_record(printed[0]) if printed and not left_open else now[ident]
    unopened: list[str] = []

    def reopen(one: str, status: str) -> str | None:
        # A status written and nothing else: it gives the item the status
        # it had, and clears the session its close kept. Written to the id
        # read whole, so one deleted meanwhile opens no other item.
        code, out, err = beads_to_status(one, status, root)
        if code == 0:
            return None
        unopened.append(one)
        return str(beads_failed(UpdateItemResponse, out, err, [])["summary"])

    closed, notes, standing = held_to_the_run(
        [ident],
        marked or [],
        before,
        now,
        reopen,
        list(request.get("keepOpen") or []),
        closes_held(pours_held(now, lambda g: beads_show({"root": root, "id": g}))),
    )
    if left_open:
        if not errored:
            said.append(
                "The tracker answered the close without an error, and %s stands open." % ident
            )
    elif gone:
        said.append("%s The tracker holds it no more." % unread)
        taken = [i for i in instead if i in (marked or [])]
        if taken:
            said.append("The tracker closed %s in its place." % ", ".join(taken))
    elif marked is None:
        said.append(unread)
    elif ident not in closed and ident not in standing:
        # Closed by another close: bd keeps the session of the first.
        said.append("%s was closed already." % ident)
    if closed:
        said.append("Closed %s." % ", ".join(closed))
    said += [str(n["summary"]) for n in notes]
    answer: CloseItemResponse = {
        "status": "completed",
        "summary": " ".join(said),
        "closedIds": closed,
        "exitCode": 0,
    }
    held = [n for n in notes if n["status"] == "blocked"]
    if errored or left_open or gone or marked is None or unopened:
        answer["status"], answer["reason"], answer["exitCode"] = "failed", "adapter-failed", 1
    elif held:
        # The item named, opened again: what it waits on blocks its close.
        answer["status"], answer["reason"], answer["exitCode"] = "blocked", "blocked", 1
        answer["blockedBy"] = held[0]["blockedBy"]
    if answer["status"] != "blocked" and item is not None:
        answer["item"] = item
    return answer


def beads_show(request: ShowItemRequest) -> ShowItemResponse:
    """operation.show-item: the record and its children, the id read as bd
    reads it, a short one as the full one, for both. The children are a
    listing of bd's: what it prints there that is no list of issues fails
    the read, and is not an item with no children."""
    if not beads_find():
        return failed_as(ShowItemResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(ShowItemResponse, *BEADS_NO_WORKSPACE)
    code, out, err = beads_quiet(["show", request["id"], "--json"], root)
    rows = beads_json(out) if code == 0 else []
    if not rows:
        return beads_failed(ShowItemResponse, out, err, [("item-not-found", BEADS_NOT_FOUND)])
    ident = str(rows[0].get("id"))
    code, listing, err = beads_quiet(
        ["list", "--all", "--json", "-n", "0", *BEADS_EVERY_ROW, "--parent", ident],
        root,
    )
    if code != 0:
        return beads_failed(ShowItemResponse, listing, err, [])
    children = beads_rows(listing)
    if children is None:
        return failed_as(ShowItemResponse, "adapter-failed", BEADS_NO_LISTING)
    return {
        "status": "completed",
        "summary": "Showed %s." % ident,
        "item": beads_record(rows[0]),
        "children": [beads_record(r) for r in children],
        "exitCode": 0,
    }


def beads_list(request: ListItemsRequest) -> ListItemsResponse:
    """operation.list-items: the open items, or all of them, perhaps under a
    parent or in a run -- every row, those bd's list leaves out unless asked
    included, and a parent read as bd's show reads it. bd filters no key
    nested in the metadata, where the run is kept, so a run is listed whole
    and kept here, and limited after.

    A listing is answered whole or not at all, since what it leaves out is
    taken for not there: what bd prints that is no list of issues, each with
    its id, fails it, and so does a parent bd could not show -- under the id
    as given bd lists nothing. A parent bd holds no more has no children.
    And a listing of every item, under no parent and unlimited, that leaves
    out an item of a run whose root it lists, or the root of a run an item
    it lists is in, is not every item, and fails (beads_left_out)."""
    if not beads_find():
        return failed_as(ListItemsResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(ListItemsResponse, *BEADS_NO_WORKSPACE)
    run, limit = request.get("run"), request.get("limit") or 0
    argv = ["list", "--json", "-n", "0" if run is not None else str(limit)]
    argv += BEADS_EVERY_ROW
    if request.get("scope") == "all":
        argv.append("--all")
    parent = request.get("parent")
    if parent:
        # bd's list reads no short id for a parent, as its show does.
        code, out, err = beads_quiet(["show", parent, "--json"], root)
        shown = beads_json(out) if code == 0 else []
        if not shown:
            # The show's own failure, which may be that no such item exists.
            unshown = beads_failed(
                ShowItemResponse, out, err, [("item-not-found", BEADS_NOT_FOUND)]
            )
            if unshown.get("reason") != "item-not-found":
                return failed_as(ListItemsResponse, "adapter-failed", unshown["summary"])
        argv += ["--parent", str(shown[0].get("id")) if shown else parent]
    code, out, err = beads_quiet(argv, root)
    if code != 0:
        return beads_failed(ListItemsResponse, out, err, [])
    rows = beads_rows(out)
    if rows is None:
        return failed_as(ListItemsResponse, "adapter-failed", BEADS_NO_LISTING)
    if request.get("scope") == "all" and not parent and (run is not None or not limit):
        left_out = beads_left_out(rows, root)
        if left_out is not None:
            return failed_as(ListItemsResponse, "adapter-failed", left_out)
    items = [beads_record(r) for r in rows]
    if run is not None:
        items = [i for i in items if i.get("run") == run][: limit or None]
    return {
        "status": "completed",
        "summary": "%d items." % len(items),
        "items": items,
        "exitCode": 0,
    }


def beads_to_status(ident: str, status: str, root: str | None) -> tuple[int, str, str]:
    """Write one of bd's own statuses, not closed, to the item of this very
    id, through bd's batch, which reads the id whole (beads_batch) and
    writes a status as bd's update does. The batch checks no status, so it
    is given none but bd's own."""
    if status not in BEADS_STATUSES or status == "closed":
        return 1, "", "invalid status: %s" % status
    return beads_batch([["update", ident, "status=" + status]], root)


def beads_update(request: UpdateItemRequest) -> UpdateItemResponse:
    """operation.update-item: bd update; a close is close-item's, not this.

    One of bd's own statuses given alone -- how an item is opened again --
    is written through bd's batch, which reads the id whole
    (beads_to_status), with nothing read first: a reopen needs no read that
    another writer may have made bd fail. Any other update reads the id as
    bd reads it first, a short one as the full one, and one bd shows as an
    item whose id runs on past it names none (shown_for_a_word): nothing
    is written. Then it is bd's update of the full id, which writes all of
    it or none,
    holds bd's own rules -- a status of its own, no cycle, no parent it
    holds nothing of -- and, given a parent, takes away every parent the
    item had in the same write, so that two at once leave the item under
    one. bd's update reads an id it holds nothing of as the one item whose
    id begins with it: an item deleted between the read and the update may
    have the update written to another in its place. bd's answer names the
    item it wrote, and where that is another, the update fails, naming it.
    The item is read back whole after."""
    if not beads_find():
        return failed_as(UpdateItemResponse, *BEADS_NOT_INSTALLED)
    if request.get("status") == "closed":
        return {
            "status": "failed",
            "reason": "close-through-update",
            "exitCode": 1,
            "summary": "Closing is close-item's, with a reason.",
        }
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(UpdateItemResponse, *BEADS_NO_WORKSPACE)
    status, priority = request.get("status"), request.get("priority")
    if status is not None and status not in BEADS_STATUSES:
        return failed_as(UpdateItemResponse, "bad-status", "invalid status: %s" % status)
    if priority is not None and not 0 <= priority <= 4:
        return failed_as(
            UpdateItemResponse, None, "A priority is 0 to 4, 0 the highest: %d." % priority
        )
    ident = request["id"]
    given: Mapping[str, Any] = dict(request, parent=request.get("parent") or None)
    if given.get("parent") and request.get("dropParent"):
        return failed_as(
            UpdateItemResponse, None, "A parent given and taken off at once: give one or the other."
        )
    flags: list[str] = []
    for key, flag in (
        ("title", "--title"),
        ("status", "-s"),
        ("priority", "-p"),
        ("parent", "--parent"),
        ("assignee", "-a"),
    ):
        if given.get(key) is not None:
            flags += [flag, str(given[key])]
    if request.get("dropParent"):
        flags += ["--parent", ""]  # bd's update takes an empty parent as none
    refusals = [
        ("item-not-found", BEADS_NOT_FOUND),
        ("bad-status", ("invalid status",)),
        ("cycle", ("cycle",)),
    ]
    drop = [str(n) for n in request.get("dropNeeds") or []]
    if flags[::2] == ["-s"] and not drop:
        code, out, err = beads_to_status(ident, str(status), root)
        if code != 0:
            return beads_failed(UpdateItemResponse, out, err, refusals)
    else:
        code, out, err = beads_quiet(["show", ident, "--json"], root)
        found = beads_json(out) if code == 0 else []
        if not found:
            return beads_failed(UpdateItemResponse, out, err, [("item-not-found", BEADS_NOT_FOUND)])
        whole = shown_for_a_word(ident, {"status": "completed", "item": found[0]})
        if whole["status"] != "completed":
            return failed_as(UpdateItemResponse, "item-not-found", whole["summary"])
        ident = str(found[0].get("id"))
        if (beads_own(found[0]) or {}).get("kind") == "guard":
            return failed_as(UpdateItemResponse, None, GUARD_HELD % ident)
        for need in drop:
            code, out, err = beads_quiet(["show", need, "--json"], root)
            held = beads_json(out) if code == 0 else []
            if held and (beads_own(held[0]) or {}).get("within") == ident:
                return failed_as(UpdateItemResponse, None, CALL_NEED_HELD % (ident, need))
        if drop:
            # Each need taken off through bd's batch, which reads both ids
            # whole, as add-need's are written -- before the parent is
            # written, so that one that waited on the item only through
            # such a need is no cycle.
            code, out, err = beads_batch([["dep", "remove", ident, n] for n in drop], root)
            if code != 0:
                return beads_failed(UpdateItemResponse, out, err, refusals)
        if flags:
            code, out, err = beads_quiet(
                ["update", ident, "--json"] + beads_typed(flags, root)[0], root
            )
            if code != 0:
                if drop:
                    # bd refused the rest: the needs taken off for it are
                    # put back, so that a refused update writes none of it.
                    beads_batch([["dep", "add", ident, n] for n in drop], root)
                return beads_failed(UpdateItemResponse, out, err, refusals)
            wrote = [str(r.get("id")) for r in beads_json(out)]
            if wrote and ident not in wrote:
                return failed_as(
                    UpdateItemResponse,
                    "item-not-found",
                    "The tracker holds %s no more, and wrote the update to %s in its place."
                    % (ident, wrote[0]),
                )
    after = beads_shown([ident], root)
    if not after or ident not in after:
        return failed_as(
            UpdateItemResponse,
            "adapter-failed",
            "Updated %s, and the tracker did not show it after." % ident,
        )
    return {
        "status": "completed",
        "summary": "Updated %s." % ident,
        "item": beads_record(after[ident]),
        "exitCode": 0,
    }


def beads_record_values(request: RecordValuesRequest) -> RecordValuesResponse:
    """operation.record-values: the claim's values merged in, each label given
    replacing its value, a label given empty removed, every other kept
    (merged_values) -- in one bd update of the item's whole id, which sets or
    unsets each label given under a metadata key of its own (BEADS_VALUE),
    so that no other key the issue holds is written, and writes all of it or
    none. A label kept keeps the order it was first recorded in; one new to
    the item, or given empty and then again, follows every one it holds.

    The id is read first and held whole: one bd shows as another item's
    names none, and nothing is written. bd's update reads an id it holds
    nothing of as the one item whose id begins with it, so an item deleted
    between that read and the update may have the values written to another
    in its place: bd's answer names the item it wrote, and where that is
    another the write fails, naming it, as an update's does (beads_update)."""
    if not beads_find():
        return failed_as(RecordValuesResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(RecordValuesResponse, *BEADS_NO_WORKSPACE)
    ident = request["id"]
    code, out, err = beads_quiet(["show", ident, "--json"], root)
    found = beads_json(out) if code == 0 else []
    if not found:
        return beads_failed(RecordValuesResponse, out, err, [("item-not-found", BEADS_NOT_FOUND)])
    whole = shown_by_its_id(ident, {"status": "completed", "item": found[0]})
    if whole["status"] != "completed":
        return failed_as(RecordValuesResponse, "item-not-found", whole["summary"])
    given = list(request["values"])
    held = beads_values(found[0])
    merged = merged_values([{"label": label, "text": text} for _, label, text in held], given)
    # Values come back in the order each was first recorded in. A label held
    # and never given empty here keeps its number. Every other label merged
    # -- new to the item, or given empty and then again -- stands after all
    # of those, in the order merged_values puts it, so it is numbered after
    # every one held.
    emptied = {v["label"] for v in given if not v["text"]}
    first = {label: n for n, label, _ in held if label not in emptied}
    last = max((n for n, _, _ in held), default=-1)
    for v in merged:
        if v["label"] not in first:
            last += 1
            first[v["label"]] = last
    now = {v["label"]: v["text"] for v in merged}
    flags = []
    for label in dict.fromkeys(v["label"] for v in given):
        key = beads_value_key(label)
        if label in now:
            flags.append("--set-metadata=%s=%s" % (key, beads_value_held(now[label], first[label])))
        else:
            flags.append("--unset-metadata=" + key)
    # bd's update given nothing to write writes nothing, and says so.
    if flags:
        code, out, err = beads_quiet(["update", ident, "--json"] + flags, root)
        if code != 0:
            return beads_failed(
                RecordValuesResponse, out, err, [("item-not-found", BEADS_NOT_FOUND)]
            )
        wrote = [str(r.get("id")) for r in beads_json(out)]
        if wrote and ident not in wrote:
            return failed_as(
                RecordValuesResponse,
                "item-not-found",
                "The tracker holds %s no more, and wrote the values to %s in its place."
                % (ident, wrote[0]),
            )
    shown = beads_shown([ident], root)
    if not shown or ident not in shown:
        return failed_as(
            RecordValuesResponse,
            "adapter-failed",
            "Recorded values on %s, and the tracker did not show it after." % ident,
        )
    return {
        "status": "completed",
        "summary": "Recorded %d value%s on %s."
        % (len(given), "" if len(given) == 1 else "s", ident),
        "item": beads_record(shown[ident]),
        "exitCode": 0,
    }


def beads_ready(request: ReadyItemsRequest) -> ReadyItemsResponse:
    """operation.ready-items: the unblocked open set, bd ready, without the
    steps of a cooked formula that bd lists among them. What bd prints that
    is no list of issues fails the read, and is not nothing ready."""
    if not beads_find():
        return failed_as(ReadyItemsResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(ReadyItemsResponse, *BEADS_NO_WORKSPACE)
    code, out, err = beads_quiet(["ready", "--json", "-n", "0"], root)
    if code != 0:
        return beads_failed(ReadyItemsResponse, out, err, [])
    rows = beads_rows(out)
    if rows is None:
        return failed_as(ReadyItemsResponse, "adapter-failed", BEADS_NO_LISTING)
    items = [beads_record(r) for r in rows if not r.get("is_template")]
    # Nothing a pour not known to be whole holds (pours_held): bd holds one
    # on its guard by the edges the pour wrote and the root its steps stand
    # under, which a write outside dotdiw, or a step moved from under its
    # root, can undo; the guard named on its root and calling steps holds it
    # whatever becomes of those.
    listed = beads_list({"root": root, "scope": "all"})
    if listed["status"] != "completed":
        return failed_as(ReadyItemsResponse, "adapter-failed", listed["summary"])
    every = {i["id"]: i for i in listed.get("items") or []}
    pours = pours_held(every, lambda g: beads_show({"root": root, "id": g}))
    held = {i for p in pours.values() for i in p["holds"]}
    unread = sorted(g for g, p in pours.items() if p["unread"])
    items = [i for i in items if i.get("kind") != "guard" and i["id"] not in held]
    return {
        "status": "completed",
        "summary": "%d ready." % len(items)
        + (
            " Left out: what the pour held on %s made, whose guard could not be read."
            % ", ".join(unread)
            if unread
            else ""
        ),
        "items": items,
        "exitCode": 0,
    }


def beads_moved(store: str) -> None:
    """Say in the workspace that its issues keep the means to prove a run in
    their metadata, as every store opened by 3.0.0 does."""
    with open(os.path.join(os.path.dirname(store), BEADS_MEANS_MOVED), "w", encoding="utf-8") as fh:
        fh.write("The means to prove each run are kept in the issue's metadata.\n")


def beads_upgrade(request: Request) -> Response:
    """The upgrade extra: a workspace poured into before 3.0.0 keeps the means
    to prove a run as the last section of an issue's description. Asked
    without apply, it says so; with apply, each such issue gets its
    description back as it was given and the means in its metadata, marked
    there as moved, and the workspace says that it has. A write bd refuses
    fails the upgrade and leaves that unsaid; tried again, it moves only the
    issues not yet marked, so a description it gave back is never read for
    the means a second time. Every issue is read, those bd's list leaves out
    unless asked included, and what bd prints that is no list of issues
    fails the upgrade before anything moves: the workspace says that its
    means have moved only once every issue was read. An issue whose metadata
    holds dotdiw as a value of its own keeps its description as it was, since
    the means cannot be kept beside that value, and the account names it."""
    nothing: Response = {
        "status": "completed",
        "summary": "Nothing to bring up to date.",
        "pending": [],
        "done": [],
        "exitCode": 0,
    }
    root = request.get("root")
    store = beads_store(root)
    if not store or not os.path.isdir(store):
        return nothing
    if os.path.exists(os.path.join(os.path.dirname(store), BEADS_MEANS_MOVED)):
        return nothing
    if not request.get("apply"):
        return dict(
            nothing,
            summary="Issues keep the means to prove a run inside their descriptions.",
            pending=["its issues keep the means to prove a run inside their descriptions"],
        )
    code, out, err = beads_quiet(["list", "--all", "--json", "-n", "0", *BEADS_EVERY_ROW], root)
    if code != 0:
        return beads_failed(dict, out, err, [])
    rows = beads_rows(out)
    if rows is None:
        return failed_as(dict, "adapter-failed", BEADS_NO_LISTING)
    moved, kept = 0, []
    for row in rows:
        own = beads_own(row)
        if own is not None and own.get("meansMoved"):
            continue
        text = row.get("description")
        description, means = read_verify_using(text)
        if not text or (description == text and not means):
            continue
        if own is None:
            kept.append(str(row.get("id")))
            continue
        argv = [
            "update",
            str(row.get("id")),
            "--description=" + (description or ""),
            "--metadata=" + beads_means(row, means, moved=True),
        ]
        code, out, err = beads_quiet(argv, root)
        if code != 0:
            return beads_failed(dict, out, err, [])
        moved += 1
    beads_moved(store)
    return dict(
        nothing,
        summary="Moved the means of %d issue%s into metadata." % (moved, "" if moved == 1 else "s"),
        done=[
            "the means to prove a run are kept in each issue's metadata, out of %d description%s"
            % (moved, "" if moved == 1 else "s")
        ]
        + ([beads_left_as_given(kept)] if kept else []),
    )


# bd's own reading of a command's options, by command path, kept for the
# length of a run: each option by every name it takes, its long name and its
# kind -- a switch, one value, one value given only after "=", many values,
# or a kind dotdiw cannot read -- and the command's subcommands.
BEADS_OPTIONS: dict[tuple[str, ...], dict[str, Any] | None] = {}
BEADS_ONE_VALUE = (
    "string",
    "int",
    "int32",
    "int64",
    "uint",
    "uint64",
    "float",
    "float32",
    "float64",
    "duration",
)
BEADS_MANY_VALUES = ("strings", "stringArray", "stringSlice", "ints", "intSlice")
# A switch's value as bd's options read one.
BEADS_SWITCH = {
    "1": True,
    "t": True,
    "T": True,
    "TRUE": True,
    "true": True,
    "True": True,
    "0": False,
    "f": False,
    "F": False,
    "FALSE": False,
    "false": False,
    "False": False,
}
BEADS_NOT_COMMANDS = (
    "Usage",
    "Aliases",
    "Examples",
    "Flags",
    "Global Flags",
    "Additional help topics",
)


def beads_options(path: list[str], root: str | None) -> dict[str, Any] | None:
    """A command's options and subcommands as bd's own help for it states
    them; None where the help does not answer."""
    key = tuple(path)
    if key in BEADS_OPTIONS:
        return BEADS_OPTIONS[key]
    code, out, _ = beads_quiet(list(path) + ["--help"], root)
    found: dict[str, Any] | None = None
    if code == 0:
        table: dict[str, tuple[str, str]] = {}
        subs: list[str] = []
        section = ""
        for line in out.splitlines():
            if line and not line.startswith(" "):
                section = line[:-1] if line.endswith(":") else ""
                continue
            if section in ("Flags", "Global Flags"):
                m = re.match(r"^\s+(?:-(\S), )?--([\w-]+)(?: (\S+))?(?:\s{2,}|$)", line)
                if not m:
                    continue
                short, long, kind = m.groups()
                if kind is None:
                    arity = "switch"
                elif "[=" in kind:
                    default = re.search(r'\[="(.*)"\]', kind)
                    arity = "optional:%s" % (default.group(1) if default else "")
                elif kind in BEADS_ONE_VALUE:
                    arity = "one"
                elif kind in BEADS_MANY_VALUES:
                    arity = "many"
                else:
                    arity = "unknown"
                table["--" + long] = (long, arity)
                if short:
                    table["-" + short] = (long, arity)
            elif section and section not in BEADS_NOT_COMMANDS:
                m = re.match(r"^  ([a-z][\w-]*)\s+\S", line)
                if m:
                    subs.append(m.group(1))
        found = {"options": table, "subcommands": subs}
    BEADS_OPTIONS[key] = found
    return found


def beads_command(words: list[str], root: str | None) -> list[str] | None:
    """The command path of bd's the words name, an alias resolved, as bd's
    own help reads them; None where bd knows no command by them."""
    code, out, _ = beads_quiet(["help"] + list(words), root)
    m = re.search(r"^Usage:\n\s+\S+((?: [a-z][\w-]*)+)", out, re.M) if code == 0 else None
    return m.group(1).split() if m else None


def beads_keep(options: dict[str, Any], long: str, arity: str, value: str) -> None:
    """A value given an option: the last given, or one more of many."""
    if arity == "many":
        options.setdefault(long, []).append(value)
    else:
        options[long] = value


def beads_take(
    table: Mapping[str, tuple[str, str]], args: list[str], j: int, options: dict[str, Any]
) -> int | str:
    """The option at args[j], read as bd's options are read: a value after
    "=", or in the next word, or joined to its letter; letters of switches
    run together. Where the next word starts, or why it cannot be read."""
    a = args[j]
    if a.startswith("--"):
        name, eq, value = a[2:].partition("=")
        entry = table.get("--" + name)
        if entry is None:
            return "--%s is no option of the command." % name
        long, arity = entry
        if arity == "switch":
            if eq and value not in BEADS_SWITCH:
                return "--%s=%s is no value a switch takes." % (name, value)
            options[long] = BEADS_SWITCH[value] if eq else True
            return j + 1
        if arity.startswith("optional:"):
            options[long] = value if eq else arity.split(":", 1)[1]
            return j + 1
        if arity == "unknown":
            return "--%s takes a value of a kind dotdiw cannot read." % name
        if eq:
            beads_keep(options, long, arity, value)
            return j + 1
        if j + 1 >= len(args):
            return "--%s wants a value." % name
        beads_keep(options, long, arity, args[j + 1])
        return j + 2
    k = 1
    while k < len(a):
        entry = table.get("-" + a[k])
        if entry is None:
            return "-%s is no option of the command." % a[k]
        long, arity = entry
        if arity == "switch":
            if a[k + 1 : k + 2] == "=":
                if a[k + 2 :] not in BEADS_SWITCH:
                    return "-%s=%s is no value a switch takes." % (a[k], a[k + 2 :])
                options[long] = BEADS_SWITCH[a[k + 2 :]]
                return j + 1
            options[long] = True
            k += 1
            continue
        if arity not in ("one", "many"):
            return "-%s takes a value of a kind dotdiw cannot read." % a[k]
        if k + 1 < len(a):
            beads_keep(options, long, arity, a[k + 2 :] if a[k + 1] == "=" else a[k + 1 :])
            return j + 1
        if j + 1 >= len(args):
            return "-%s wants a value." % a[k]
        beads_keep(options, long, arity, args[j + 1])
        return j + 2
    return j + 1


def beads_read(request: Request) -> Response:
    """The read extra: a command as bd itself will read it -- its command
    path, its words, and its options by their long names, each value as bd
    keeps it: the last given for an option of one value, all given for one
    of many, a switch read as bd reads a switch's value -- from bd's own help
    for that command, by the rules bd's options follow. A word bd's help
    cannot place is refused as unreadable, never read another way; a command
    path of None is a word bd knows by no command, for bd to refuse."""
    if not beads_find():
        return failed_as(dict, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(dict, *BEADS_NO_WORKSPACE)
    args = [str(a) for a in request.get("arguments") or []]
    options: dict[str, Any] = {}

    def unreadable(why: str) -> Response:
        return {"status": "failed", "reason": "unreadable", "exitCode": 1, "summary": why}

    def read(path: list[str] | None, words: list[str]) -> Response:
        return {
            "status": "completed",
            "summary": "Read %s." % " ".join(path or ["nothing"]),
            "command": path,
            "words": words,
            "options": options,
            "exitCode": 0,
        }

    top = beads_options([], root)
    if top is None:
        return unreadable("The tracker's own help could not be read.")
    i = 0
    while i < len(args) and args[i].startswith("-") and args[i] not in ("-", "--"):
        nxt = beads_take(top["options"], args, i, options)
        if isinstance(nxt, str):
            return unreadable(nxt)
        i = nxt
    if i < len(args) and args[i] == "--":
        return unreadable("-- stands before the command.")
    if i >= len(args):
        return read([], [])
    word = args[i]
    path = [word] if word in top["subcommands"] else beads_command([word], root)
    if path is None:
        return read(None, [])
    found = beads_options(path, root)
    rest = args[i + 1 :]
    while found is not None and found["subcommands"]:
        j, at = 0, None
        while j < len(rest) and rest[j] != "--":
            if rest[j].startswith("-") and rest[j] != "-":
                nxt = beads_take(found["options"], rest, j, {})
                if isinstance(nxt, str):
                    return unreadable(nxt)
                j = nxt
                continue
            at = j
            break
        if at is None:
            break
        sub = rest[at]
        deeper = path + [sub] if sub in found["subcommands"] else beads_command(path + [sub], root)
        if deeper is None or len(deeper) <= len(path):
            break
        path, rest = deeper, rest[:at] + rest[at + 1 :]
        found = beads_options(path, root)
    if found is None:
        return unreadable("The tracker's help for %s could not be read." % " ".join(path))
    words: list[str] = []
    j = 0
    while j < len(rest):
        if rest[j] == "--":
            words += rest[j + 1 :]
            break
        if rest[j].startswith("-") and rest[j] != "-":
            nxt = beads_take(found["options"], rest, j, options)
            if isinstance(nxt, str):
                return unreadable(nxt)
            j = nxt
            continue
        words.append(rest[j])
        j += 1
    return read(path, words)


def beads_session(theirs: str | None) -> str:
    """A session to close under that no other close carries: the session the
    worker gave or runs in, where there is one, marked as dotdiw's."""
    mark = "dotdiw-%s" % os.urandom(8).hex()
    return "%s#%s" % (theirs, mark) if theirs else mark


def beads_holds(ident: str, root: str | None) -> bool | None:
    """Whether bd holds an item of this very id; None where bd does not say.
    bd reads an id it holds nothing of as that of the one item whose id
    begins with it -- a deleted item's as its only child's -- and shows that
    one. So an item is held only where a row bd shows carries the id asked,
    and held no more where the rows carry another, or bd finds no issue."""
    code, out, err = beads_quiet(["show", ident, "--json"], root)
    shown = [str(r["id"]) for r in (beads_json(out) if code == 0 else []) if r.get("id")]
    if shown:
        return ident in shown
    gone = beads_failed(ShowItemResponse, out, err, [("item-not-found", BEADS_NOT_FOUND)])
    return False if gone.get("reason") == "item-not-found" else None


def beads_shown(ids: list[str], root: str | None) -> dict[str, dict[str, Any]] | None:
    """Those of the ids given that bd holds now, each as bd shows it, by id,
    in the order given. One bd holds no more has no row: asked for several,
    bd leaves it out, or shows another item in its place (beads_holds).
    None where bd does not say of an id it shows no row for whether it
    holds it, since then nothing is known of that one."""
    if not ids:
        return {}
    code, out, _ = beads_quiet(["show"] + list(ids) + ["--json"], root)
    rows = {str(r.get("id")): r for r in (beads_json(out) if code == 0 else [])}
    if any(beads_holds(i, root) is not False for i in dict.fromkeys(ids) if i not in rows):
        return None
    return {i: rows[i] for i in dict.fromkeys(ids) if i in rows}


def beads_marked(rows: Mapping[str, Mapping[str, Any]], session: str) -> list[str]:
    """Of the items shown (beads_shown), the ids of those closed under the
    session given, as bd keeps the session a close ran under and keeps it
    through a later close. A close that kept no session is no close of the
    session's, whatever bd it ran under."""
    return [
        i
        for i, row in rows.items()
        if row.get("status") == "closed" and row.get("closed_by_session") == session
    ]


def beads_label_kept(reading: Response, root: str | None) -> str | None:
    """Why a command, as bd will read it (beads_read), is refused for taking
    BEADS_RUN_LABEL off an item: that label marks the items of a run, and
    only dotdiw writes it, as only dotdiw writes what it keeps in an item's
    metadata. An update that removes it, one that sets the labels of an
    item that carries it without it, and a label remove of it are refused;
    labels given together are split as bd splits them, an update's as one
    line of comma-separated values, quotes and all, a label remove's at each
    comma. Whether the items an update sets the labels of carry it is read
    from bd's own show of the words, as the update will read them; where
    that cannot be read, the update is refused, since then it cannot be
    checked. None where the command leaves the label as it is."""
    path = reading.get("command")
    given: Mapping[str, Any] = reading.get("options") or {}
    words = [str(w) for w in reading.get("words") or []]
    off = (
        "Nothing ran: %s marks the items of a run, and only dotdiw writes it, so a command "
        "that takes it off an item is refused." % BEADS_RUN_LABEL
    )
    if path == ["label", "remove"]:
        named = [x.strip() for x in words[-1].split(",")] if len(words) > 1 else []
        return off if BEADS_RUN_LABEL in named else None
    if path != ["update"]:
        return None

    def labels(values: Any) -> list[str]:
        out: list[str] = []
        for value in values if isinstance(values, list) else [values]:
            if isinstance(value, str):
                out += [x.strip() for x in next(csv.reader([value]), [])]
        return out

    if BEADS_RUN_LABEL in labels(given.get("remove-label")):
        return off
    if "set-labels" not in given or BEADS_RUN_LABEL in labels(given.get("set-labels")):
        return None
    code, out, _ = beads_quiet(["show", *words, "--json"], root)
    rows = beads_json(out) if code == 0 else []
    if not rows:
        return (
            "Nothing ran: whether the items named carry %s, which marks the items of a run, "
            "could not be read, so a command that sets their labels cannot be checked."
            % BEADS_RUN_LABEL
        )
    carrying = list(
        dict.fromkeys(str(r.get("id")) for r in rows if BEADS_RUN_LABEL in (r.get("labels") or []))
    )
    if carrying:
        return (
            "Nothing ran: %s %s %s, which marks the items of a run, and only dotdiw writes it; "
            "labels set keep it only when %s is among them."
            % (
                ", ".join(carrying),
                "carries" if len(carrying) == 1 else "carry",
                BEADS_RUN_LABEL,
                BEADS_RUN_LABEL,
            )
        )
    return None


def beads_forward(request: Request) -> Response:
    """The pass-through, an extra: the command as typed, with the worker's
    terminal where the request says one is there (terminal) and quietly,
    its output in the answer, where not, and bd's name rewritten on the way
    back. The rewrite is the whole of "one name for all four", so it happens
    here and nowhere else.
    An update or a quick capture that asks for the type a root has is
    refused, read as bd reads it, and so is a command that takes off an item
    the label that marks the items of a run (beads_label_kept); one that
    cannot be read so is refused, since then it cannot be checked. Given a mark (mark) and the ids
    to answer for (marked), the command closes under a session of its own,
    given that run alone, and the answer names those of the ids that closed
    under it (markedIds)."""
    if not beads_find():
        return failed_as(dict, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    args = list(request.get("arguments") or [])
    reading: Response = {}
    if args and (
        request.get("mark") or args[0].startswith("-") or args[0] in ("update", "q", "label")
    ):
        reading = beads_read({"root": root, "arguments": args})
        if reading["status"] != "completed" and reading.get("reason") not in TRACKER_CANNOT_ANSWER:
            return {
                "status": "failed",
                "exitCode": 1,
                "output": "",
                "printed": False,
                "summary": "dotdiw does not run this: it cannot read the command as the tracker "
                "would, so it cannot check what the command asks. %s" % reading["summary"],
            }
    given: Mapping[str, Any] = reading.get("options") or {}
    if (
        reading.get("command") in (["update"], ["q"])
        and str(given.get("type", "")).strip().lower() in BEADS_ROOT_TYPES
    ):
        return {
            "status": "failed",
            "exitCode": 1,
            "output": "",
            "printed": False,
            "summary": "Only formula pour makes a root, so a type of molecule is refused.",
        }
    unlabelled = beads_label_kept(reading, root)
    if unlabelled:
        return {
            "status": "failed",
            "exitCode": 1,
            "output": "",
            "printed": False,
            "summary": unlabelled,
        }
    if args[:1] == ["update"]:
        args, refused = beads_typed(args, root)
        if refused:
            return {
                "status": "failed",
                "exitCode": 1,
                "output": "",
                "printed": False,
                "summary": refused,
            }
    session: str | None = None
    kept = os.environ.get("CLAUDE_SESSION_ID")
    if request.get("mark"):
        theirs = given.get("session") if isinstance(given.get("session"), str) else None
        session = beads_session(theirs or kept)
        if theirs is not None:
            if "--" in args:
                return {
                    "status": "failed",
                    "exitCode": 1,
                    "output": "",
                    "printed": False,
                    "summary": "A close given its own session after -- cannot be marked.",
                }
            args = args + ["--session", session]
    terminal = bool(request.get("terminal"))
    code, out, _ = beads_run(args, root, terminal, session=session)
    answer: Response = {
        "status": "completed" if code == 0 else "failed",
        "exitCode": code,
        "output": out,
        "printed": terminal,
        "summary": "%s exited %d." % (args[0] if args else "the tracker", code),
    }
    if session is not None:
        # None where bd does not say of each id asked whether it holds it; an
        # id another deleted as the command ran is no such gap.
        shown = beads_shown([str(i) for i in request.get("marked") or []], root)
        answer["markedIds"] = None if shown is None else beads_marked(shown, session)
    return answer


def beads_metrics_off(request: Request) -> Response:
    """Metrics off for this machine, an extra: read bd's config rather than
    ask bd, and say whether it was this call that turned them off."""

    def off_already() -> bool:
        try:
            with open(os.path.expanduser(BD_CONFIG), encoding="utf-8") as fh:
                text = fh.read()
        except OSError:
            return False
        block = re.search(r"(?m)^metrics:[ \t]*\n((?:[ \t]+.*\n?)*)", text)
        return bool(
            block and re.search(r"(?m)^[ \t]+disabled:[ \t]*[Tt]rue[ \t]*$", block.group(1))
        )

    if off_already() or not beads_find():
        return {
            "status": "completed",
            "summary": "Metrics were already off.",
            "turnedOff": False,
            "path": BD_CONFIG,
            "exitCode": 0,
        }
    beads_quiet(["metrics", "off"])
    if not off_already():
        return {
            "status": "failed",
            "summary": "The tracker did not turn its metrics off.",
            "turnedOff": False,
            "path": BD_CONFIG,
            "exitCode": 1,
        }
    return {
        "status": "completed",
        "summary": "Turned the tracker's metrics off.",
        "turnedOff": True,
        "path": BD_CONFIG,
        "exitCode": 0,
    }


