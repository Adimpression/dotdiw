def register_tracker(name: str, table: Any) -> None:
    """Hold an adapter to the interface's shape before it can answer: every
    operation of the tracker door present and nothing beyond it, each a
    callable of one request, and an info record that names it and does not say
    it was written for another interface."""
    operations = table.get("operations") if isinstance(table, dict) else None
    if not isinstance(operations, dict):
        raise DoorError("tracker %s has no operations table" % name)
    missing = sorted(set(TRACKER_DOOR) - set(operations))
    if missing:
        raise DoorError("tracker %s lacks %s" % (name, ", ".join(missing)))
    for operation, fn in operations.items():
        if operation not in TRACKER_DOOR:
            raise DoorError(
                "tracker %s offers %s, which is not an operation of the tracker" % (name, operation)
            )
        if not callable(fn) or list(inspect.signature(fn).parameters) != ["request"]:
            raise DoorError("tracker %s: %s is not one callable of one request" % (name, operation))
    for extra, fn in (table.get("extras") or {}).items():
        if not callable(fn) or list(inspect.signature(fn).parameters) != ["request"]:
            raise DoorError(
                "tracker %s: the extra %s is not one callable of one request" % (name, extra)
            )
    store = table.get("store")
    if store is not None and (
        not callable(store) or list(inspect.signature(store).parameters) != ["root"]
    ):
        raise DoorError("tracker %s: store is not one callable of one root" % name)
    info = table.get("info") or {}
    for key in ("name", "version", "origin"):
        if not info.get(key):
            raise DoorError('tracker %s: "%s" is missing from its info' % (name, key))
    declared = info.get("interface")
    if declared is None:
        declared = 1  # written before a module said, for the interface there was
    if declared != TRACKER_INTERFACE or isinstance(declared, bool):
        raise DoorError(
            "tracker %s was written for tracker interface %r; this %s supports interface %d"
            % (name, declared, PROG, TRACKER_INTERFACE)
        )
    TRACKERS[name] = table


def formula_files(top: str) -> list[str]:
    """Every formula file under top, as local storage finds one: a directory
    whose name starts with a dot left out, no symbolic link followed, each
    directory's files in order."""
    out: list[str] = []
    for here, dirs, names in os.walk(top):
        dirs[:] = sorted(d for d in dirs if not d.startswith("."))
        for name in sorted(names):
            path = os.path.join(here, name)
            if not name.endswith((".formula.toml", ".formula.json")) or os.path.islink(path):
                continue
            if os.path.isfile(path):  # a FIFO or a device is never opened
                out.append(path)
    return out


