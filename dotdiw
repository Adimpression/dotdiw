# ============================================================ the local adapter
#
# The store that ships with dotdiw and needs no binary: one sqlite file under
# the keyed workspace, with items, edges and meta. Every operation of the
# interface answers in records. Pour is composition, a root and one item per
# step with its needs as edges; a close is refused while an open need or an
# open child exists, and names them; ready is a query; a poured root closes
# itself when its last step closes. It prints nothing and offers no extras:
# the commands dotdiw owns are answered through the interface and shown by
# the presenter, and any other command is unsupported here.
LOCAL_STORE = "dotdiw.sqlite"
LOCAL_SCHEMA = """
CREATE TABLE IF NOT EXISTS items (
    id TEXT PRIMARY KEY,
    title TEXT NOT NULL,
    kind TEXT NOT NULL,
    status TEXT NOT NULL,
    priority INTEGER NOT NULL,
    parent TEXT REFERENCES items(id),
    description TEXT,
    verify_using TEXT,
    step TEXT,
    claim TEXT,
    claim_values TEXT,
    run TEXT,
    assignee TEXT,
    reason TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    closed_at TEXT
);
CREATE INDEX IF NOT EXISTS items_parent ON items(parent);
CREATE TABLE IF NOT EXISTS edges (
    id TEXT NOT NULL REFERENCES items(id),
    needs TEXT NOT NULL REFERENCES items(id),
    PRIMARY KEY (id, needs)
);
CREATE INDEX IF NOT EXISTS edges_needs ON edges(needs);
CREATE TABLE IF NOT EXISTS meta (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL
);
"""
LOCAL_STATUSES = ("open", "in_progress", "blocked", "closed")
LOCAL_ID_CHARS = "abcdefghijklmnopqrstuvwxyz0123456789"
LOCAL_NO_WORKSPACE = ("no-workspace", "This checkout has no tracker; init adopts it.", 1)
LOCAL_WAIT_SECONDS = 5  # how long a write waits for another process's to finish


def local_store(root: str | None) -> str | None:
    """The store's file under this checkout's workspace, or None without a key."""
    ws = workspace(root) if root else None
    return os.path.join(ws, LOCAL_STORE) if ws else None


def local_connect(root: str | None) -> sqlite3.Connection | None:
    """A connection to this checkout's store, or None when it was never opened."""
    store = local_store(root)
    if not store or not os.path.isfile(store):
        return None
    conn = sqlite3.connect(store, timeout=LOCAL_WAIT_SECONDS)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    return conn


@contextlib.contextmanager
def local_write(conn: sqlite3.Connection) -> Iterator[None]:
    """One transaction with the write lock taken before anything is read, so
    that what a check saw still holds when its write commits, whoever else
    has this store open. Committed on the way out, rolled back on an error."""
    with conn:
        conn.execute("BEGIN IMMEDIATE")
        yield


def local_refused(shape: type[R], error: sqlite3.Error) -> R:
    """A write the store would not take, in one line."""
    if "locked" in str(error):
        return failed_as(
            shape, "adapter-failed", "Nothing was written: another writer holds the store."
        )
    return failed_as(shape, "adapter-failed", "The store refused the write: %s" % error)


def local_now() -> str:
    return datetime.datetime.now(datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def local_new_id(conn: sqlite3.Connection) -> str:
    """<prefix>-<four of a-z0-9>, random, unused."""
    row = conn.execute("SELECT value FROM meta WHERE key = 'prefix'").fetchone()
    prefix = row[0] if row else "work"
    while True:
        tail = "".join(LOCAL_ID_CHARS[b % len(LOCAL_ID_CHARS)] for b in os.urandom(4))
        ident = "%s-%s" % (prefix, tail)
        if not conn.execute("SELECT 1 FROM items WHERE id = ?", (ident,)).fetchone():
            return ident


def local_fetch(conn: sqlite3.Connection, ident: str) -> sqlite3.Row | None:
    row: sqlite3.Row | None = conn.execute("SELECT * FROM items WHERE id = ?", (ident,)).fetchone()
    return row


def local_record(conn: sqlite3.Connection, row: sqlite3.Row) -> TrackerItem:
    """An item as the interface's record, its needs read from the edges."""
    needs = [
        r[0]
        for r in conn.execute("SELECT needs FROM edges WHERE id = ? ORDER BY needs", (row["id"],))
    ]
    item: TrackerItem = {
        "id": row["id"],
        "title": row["title"],
        # A store made before 1.0.0 holds its roots as molecule.
        "kind": "root" if row["kind"] in ("root", "molecule") else "task",
        "status": row["status"],
        "priority": row["priority"],
        "parent": row["parent"],
        "assignee": row["assignee"],
        "reason": row["reason"],
        "needs": needs,
        "createdAt": row["created_at"],
        "updatedAt": row["updated_at"],
    }
    if row["description"] is not None:
        item["description"] = row["description"]
    kept = row["verify_using"] if "verify_using" in row.keys() else None
    if kept:
        item["verifyUsing"] = [str(m) for m in json.loads(kept)]
    held = row.keys()
    if "step" in held and row["step"]:
        item["step"] = row["step"]
    if "claim" in held and row["claim"]:
        item["claim"] = json.loads(row["claim"])
    if "claim_values" in held and row["claim_values"]:
        item["values"] = json.loads(row["claim_values"])
    if "run" in held and row["run"]:
        item["run"] = row["run"]
    return item


def local_blockers(conn: sqlite3.Connection, ident: str) -> list[str]:
    """What keeps an item from closing: its open needs, then its open
    children, then the open items poured in its run, wherever they stand."""
    needs = [
        r[0]
        for r in conn.execute(
            "SELECT e.needs FROM edges e JOIN items n ON n.id = e.needs "
            "WHERE e.id = ? AND n.status != 'closed' ORDER BY e.needs",
            (ident,),
        )
    ]
    under = [
        r[0]
        for r in conn.execute(
            "SELECT id FROM items WHERE (parent = ? OR run = ?) AND status != 'closed' "
            "ORDER BY parent IS NOT ?, created_at, id",
            (ident, ident, ident),
        )
    ]
    return needs + [c for c in under if c not in needs]


def local_waiting(conn: sqlite3.Connection, start: str) -> set[str]:
    """Every item start waits on before it can close, to any depth: its
    needs, its children and the items poured in its run -- the cycle check,
    read inside the write it guards."""
    seen: set[str] = set()
    todo = [start]
    while todo:
        at = todo.pop()
        for (nxt,) in conn.execute(
            "SELECT needs FROM edges WHERE id = ? UNION SELECT id FROM items "
            "WHERE parent = ? OR run = ?",
            (at, at, at),
        ):
            if nxt not in seen:
                seen.add(nxt)
                todo.append(nxt)
    return seen


def local_closing(
    conn: sqlite3.Connection, row: sqlite3.Row, reason: str | None, now: str
) -> list[str]:
    """Close one item, and when it was the last open step, the poured root
    above it and the root of the run it was poured in, wherever it stands;
    the ids closed, the item's first."""
    conn.execute(
        "UPDATE items SET status = 'closed', reason = ?, closed_at = ?, updated_at = ? "
        "WHERE id = ?",
        (reason, now, now, row["id"]),
    )
    closed = [row["id"]]
    above = []
    if row["parent"]:
        parent = local_fetch(conn, row["parent"])
        if parent and parent["kind"] in ("root", "molecule"):
            above.append(parent)
    run = row["run"] if "run" in row.keys() else None
    if run and run != row["parent"]:
        root = local_fetch(conn, run)
        if root:
            above.append(root)
    for item in above:
        if item["status"] != "closed" and not local_blockers(conn, item["id"]):
            conn.execute(
                "UPDATE items SET status = 'closed', reason = ?, closed_at = ?, "
                "updated_at = ? WHERE id = ?",
                ("every step closed", now, now, item["id"]),
            )
            closed.append(item["id"])
    return closed


def local_open(request: OpenTrackerRequest) -> OpenTrackerResponse:
    """operation.open-tracker: the file and its schema under the key; a second
    open changes nothing. The prefix is the one given, else the checkout's
    directory name, kept in meta."""
    root = request.get("root")
    store = local_store(root)
    if store is None:
        return failed_as(OpenTrackerResponse, *LOCAL_NO_WORKSPACE)
    created = not os.path.exists(store)
    try:
        os.makedirs(os.path.dirname(store), exist_ok=True)
        conn = sqlite3.connect(store, timeout=LOCAL_WAIT_SECONDS)
        try:
            with conn:
                conn.executescript(LOCAL_SCHEMA)
                conn.execute(
                    "INSERT OR IGNORE INTO meta (key, value) VALUES ('schema', ?)",
                    ("3" if created else "1",),
                )
                prefix = request.get("prefix")
                if not prefix and created:
                    prefix = re.sub(r"[^a-z0-9]+", "-", os.path.basename(root or "").lower()).strip(
                        "-"
                    )
                if prefix:
                    conn.execute(
                        "INSERT OR IGNORE INTO meta (key, value) VALUES ('prefix', ?)", (prefix,)
                    )
        finally:
            conn.close()
    except (sqlite3.Error, OSError) as e:
        return {
            "status": "failed",
            "reason": "store-unwritable",
            "exitCode": 1,
            "summary": "%s: %s" % (store, e),
        }
    return {
        "status": "completed",
        "summary": "Opened %s." % store,
        "path": store,
        "created": created,
        "exitCode": 0,
    }


def local_columns(conn: sqlite3.Connection) -> set[str]:
    return {r["name"] for r in conn.execute("PRAGMA table_info(items)")}


def local_upgrade(request: Request) -> Response:
    """The upgrade extra: a store made before 3.0.0, at schema 1, keeps the
    means to prove a run as the last section of a description, and one made
    before 4.0.0 has no place for a step's claim. Asked without apply, it says
    what is left; with apply, the columns are added and every section of means
    moves into its own, in one transaction, at schema 3."""
    nothing: Response = {
        "status": "completed",
        "summary": "Nothing to bring up to date.",
        "pending": [],
        "done": [],
        "exitCode": 0,
    }
    store = local_store(request.get("root"))
    if not store or not os.path.isfile(store):
        return nothing
    conn = sqlite3.connect(store, timeout=LOCAL_WAIT_SECONDS)
    conn.row_factory = sqlite3.Row
    moved, done = 0, []
    try:
        left = []
        if "verify_using" not in local_columns(conn):
            left.append("its store keeps the means to prove a run inside descriptions")
        if "claim" not in local_columns(conn):
            left.append("its store has no place for a step's claim")
        if not left:
            return nothing
        if not request.get("apply"):
            return dict(nothing, summary="The store is %s." % "; ".join(left), pending=left)
        with local_write(conn):
            if "verify_using" not in local_columns(conn):
                conn.execute("ALTER TABLE items ADD COLUMN verify_using TEXT")
                for row in conn.execute("SELECT id, description FROM items").fetchall():
                    description, means = read_verify_using(row["description"])
                    if description != row["description"] or means:
                        conn.execute(
                            "UPDATE items SET description = ?, verify_using = ? WHERE id = ?",
                            (description, json.dumps(means) if means else None, row["id"]),
                        )
                        moved += 1
                done.append(
                    "the means to prove a run are kept in a column of their own, out of %d "
                    "description%s" % (moved, "" if moved == 1 else "s")
                )
            if "claim" not in local_columns(conn):
                for column in ("step", "claim", "claim_values", "run"):
                    conn.execute("ALTER TABLE items ADD COLUMN %s TEXT" % column)
                done.append("the store keeps each poured step's claim and its values")
            conn.execute("INSERT OR REPLACE INTO meta (key, value) VALUES ('schema', '3')")
    except sqlite3.OperationalError as e:
        return local_refused(dict, e)
    finally:
        conn.close()
    return dict(nothing, summary="Brought the store up to date.", done=done)


def local_describe(request: DescribeTrackerRequest) -> DescribeTrackerResponse:
    """operation.describe-tracker: what this adapter is."""
    store = local_store(request.get("root"))
    return {
        "status": "completed",
        "summary": "The store that ships with %s." % PROG,
        "info": {
            "name": "local",
            "version": VERSION,
            "origin": "shipped",
            "nativeNeeds": True,
            "extras": ["upgrade"],
            "checkTarget": "scratch",
        },
        "path": store if store and os.path.isfile(store) else None,
        "exitCode": 0,
    }


def local_create(request: CreateItemRequest) -> CreateItemResponse:
    """operation.create-item: one row, open, under the parent given."""
    conn = local_connect(request.get("root"))
    if conn is None:
        return failed_as(CreateItemResponse, *LOCAL_NO_WORKSPACE)
    try:
        with local_write(conn):
            parent = request.get("parent")
            if parent and not local_fetch(conn, parent):
                return {
                    "status": "failed",
                    "reason": "parent-not-found",
                    "exitCode": 1,
                    "summary": "%s names no item here." % parent,
                }
            now, ident = local_now(), request.get("id") or local_new_id(conn)
            priority = request.get("priority")
            if request.get("id") and local_fetch(conn, ident):
                ident = local_new_id(conn)  # the id asked for is taken: a fresh one, mapped
            means = list(request.get("verifyUsing") or [])
            values = list(request.get("values") or [])
            conn.execute(
                "INSERT INTO items (id, title, kind, status, priority, parent, description, "
                "verify_using, step, claim, claim_values, run, created_at, updated_at) "
                "VALUES (?, ?, ?, 'open', ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
                (
                    ident,
                    request["title"],
                    "task",
                    2 if priority is None else int(priority),
                    parent,
                    request.get("description"),
                    json.dumps(means) if means else None,
                    request.get("step"),
                    json.dumps(request["claim"]) if request.get("claim") else None,
                    json.dumps(values) if values else None,
                    request.get("run"),
                    now,
                    now,
                ),
            )
            fetched = local_fetch(conn, ident)
            item = local_record(conn, fetched) if fetched is not None else None
    except sqlite3.OperationalError as e:
        return local_refused(CreateItemResponse, e)
    finally:
        conn.close()
    return {
        "status": "completed",
        "summary": "Created %s." % ident,
        "item": item,
        "exitCode": 0,
    }


def local_need(request: AddNeedRequest) -> AddNeedResponse:
    """operation.add-need: a blocks edge, refused where what it needs waits
    on it to close, through needs, children or a run; checked under the
    write lock, so that two writers at once cannot each pass it."""
    conn = local_connect(request.get("root"))
    if conn is None:
        return failed_as(AddNeedResponse, *LOCAL_NO_WORKSPACE)
    ident, needs = request["id"], request["needs"]
    try:
        with local_write(conn):
            for one in (ident, needs):
                if not local_fetch(conn, one):
                    return {
                        "status": "failed",
                        "reason": "item-not-found",
                        "exitCode": 1,
                        "summary": "%s names no item here." % one,
                    }
            if ident == needs or ident in local_waiting(conn, needs):
                return {
                    "status": "failed",
                    "reason": "cycle",
                    "exitCode": 1,
                    "summary": "%s cannot need %s, which waits on it to close, so neither "
                    "could close." % (ident, needs)
                    if ident != needs
                    else "%s cannot need %s: an item cannot wait on itself." % (ident, needs),
                }
            conn.execute("INSERT OR IGNORE INTO edges (id, needs) VALUES (?, ?)", (ident, needs))
            conn.execute("UPDATE items SET updated_at = ? WHERE id = ?", (local_now(), ident))
    except sqlite3.OperationalError as e:
        return local_refused(AddNeedResponse, e)
    finally:
        conn.close()
    return {
        "status": "completed",
        "summary": "%s needs %s." % (ident, needs),
        "edge": {"id": ident, "needs": needs},
        "exitCode": 0,
    }


def local_pour(request: PourStepsRequest) -> PourStepsResponse:
    """operation.pour-steps: a root named after the formula, keeping its
    description and the means to prove its run, and one item per step under
    it, each needing the steps it names; all or nothing."""
    steps = list(request.get("steps") or [])
    if not steps:
        return {
            "status": "failed",
            "reason": "no-steps",
            "exitCode": 1,
            "summary": "No steps to pour.",
        }
    shared = shared_step_id(steps)
    if shared is not None:
        return {
            "status": "failed",
            "reason": "duplicate-step",
            "exitCode": 1,
            "summary": "Two steps share the id %s, so nothing was poured." % shared,
        }
    try:
        ordered = steps_in_order(steps)
    except LookupError as e:
        return {"status": "failed", "reason": "step-not-found", "exitCode": 1, "summary": str(e)}
    except ValueError as e:
        return {"status": "failed", "reason": "cycle", "exitCode": 1, "summary": str(e)}
    conn = local_connect(request.get("root"))
    if conn is None:
        return failed_as(PourStepsResponse, *LOCAL_NO_WORKSPACE)
    try:
        with local_write(conn):
            now = local_now()
            root_id = local_new_id(conn)
            means = list(request.get("verifyUsing") or [])
            conn.execute(
                "INSERT INTO items (id, title, kind, status, priority, description, "
                "verify_using, created_at, updated_at) "
                "VALUES (?, ?, 'root', 'open', 2, ?, ?, ?, ?)",
                (
                    root_id,
                    request["title"],
                    request.get("description"),
                    json.dumps(means) if means else None,
                    now,
                    now,
                ),
            )
            ids: dict[str, str] = {}
            for s in ordered:
                ident = local_new_id(conn)
                conn.execute(
                    "INSERT INTO items (id, title, kind, status, priority, parent, step, claim, "
                    "run, created_at, updated_at) "
                    "VALUES (?, ?, 'task', 'open', 2, ?, ?, ?, ?, ?, ?)",
                    (
                        ident,
                        s["title"],
                        root_id,
                        s["id"],
                        json.dumps(s["claim"]) if s.get("claim") else None,
                        root_id,
                        now,
                        now,
                    ),
                )
                for n in s.get("needs") or []:
                    conn.execute(
                        "INSERT OR IGNORE INTO edges (id, needs) VALUES (?, ?)", (ident, ids[n])
                    )
                ids[s["id"]] = ident
    except sqlite3.OperationalError as e:
        return local_refused(PourStepsResponse, e)
    finally:
        conn.close()
    return {
        "status": "completed",
        "summary": "Poured %d steps under %s." % (len(ids), root_id),
        "rootId": root_id,
        "stepIds": [ids[s["id"]] for s in steps],
        "exitCode": 0,
    }


def local_close(request: CloseItemRequest) -> CloseItemResponse:
    """operation.close-item: closed with the reason, unless an open need or an
    open child stands in the way, in which case they are named."""
    conn = local_connect(request.get("root"))
    if conn is None:
        return failed_as(CloseItemResponse, *LOCAL_NO_WORKSPACE)
    ident = request["id"]
    try:
        with local_write(conn):
            row = local_fetch(conn, ident)
            if not row:
                return {
                    "status": "failed",
                    "reason": "item-not-found",
                    "exitCode": 1,
                    "summary": "%s names no item here." % ident,
                }
            if row["status"] == "closed":
                return {
                    "status": "completed",
                    "summary": "%s was closed already." % ident,
                    "item": local_record(conn, row),
                    "closedIds": [],
                    "exitCode": 0,
                }
            blocked = local_blockers(conn, ident)
            if blocked:
                return {
                    "status": "blocked",
                    "reason": "blocked",
                    "blockedBy": blocked,
                    "exitCode": 1,
                    "summary": "%s is blocked by %s." % (ident, ", ".join(blocked)),
                }
            closed = local_closing(conn, row, request.get("closeReason"), local_now())
            fetched = local_fetch(conn, ident)
            item = local_record(conn, fetched) if fetched is not None else None
    except sqlite3.OperationalError as e:
        return local_refused(CloseItemResponse, e)
    finally:
        conn.close()
    return {
        "status": "completed",
        "summary": "Closed %s." % ", ".join(closed),
        "item": item,
        "closedIds": closed,
        "exitCode": 0,
    }


def local_show(request: ShowItemRequest) -> ShowItemResponse:
    """operation.show-item: the record and its children."""
    conn = local_connect(request.get("root"))
    if conn is None:
        return failed_as(ShowItemResponse, *LOCAL_NO_WORKSPACE)
    try:
        row = local_fetch(conn, request["id"])
        if not row:
            return {
                "status": "failed",
                "reason": "item-not-found",
                "exitCode": 1,
                "summary": "%s names no item here." % request["id"],
            }
        children = [
            local_record(conn, r)
            for r in conn.execute(
                "SELECT * FROM items WHERE parent = ? ORDER BY created_at, id", (request["id"],)
            )
        ]
        item = local_record(conn, row)
    finally:
        conn.close()
    return {
        "status": "completed",
        "summary": "Showed %s." % request["id"],
        "item": item,
        "children": children,
        "exitCode": 0,
    }


def local_list(request: ListItemsRequest) -> ListItemsResponse:
    """operation.list-items: open items, or all of them, perhaps under a parent
    or in a run; open first, newest last."""
    conn = local_connect(request.get("root"))
    if conn is None:
        return failed_as(ListItemsResponse, *LOCAL_NO_WORKSPACE)
    where, args = [], []
    if request.get("scope") != "all":
        where.append("status != 'closed'")
    if request.get("parent"):
        where.append("parent = ?")
        args.append(request["parent"])
    if request.get("run") is not None:
        where.append("run = ?")
        args.append(request["run"])
    sql = "SELECT * FROM items" + (" WHERE " + " AND ".join(where) if where else "")
    sql += " ORDER BY (status = 'closed'), created_at, id"
    limit = request.get("limit")
    if limit:
        sql += " LIMIT %d" % int(limit)
    try:
        items = [local_record(conn, r) for r in conn.execute(sql, args)]
    finally:
        conn.close()
    return {
        "status": "completed",
        "summary": "%d items." % len(items),
        "items": items,
        "exitCode": 0,
    }


def local_update(request: UpdateItemRequest) -> UpdateItemResponse:
    """operation.update-item: title, status, priority, parent or assignee; a
    close is close-item's, with its reason and its refusals. A parent that
    waits on the item to close is refused under the write lock, as add-need
    refuses such a need."""
    if request.get("status") == "closed":
        return {
            "status": "failed",
            "reason": "close-through-update",
            "exitCode": 1,
            "summary": "Closing is close-item's, with a reason.",
        }
    if request.get("status") is not None and request["status"] not in LOCAL_STATUSES:
        return {
            "status": "failed",
            "reason": "bad-status",
            "exitCode": 1,
            "summary": "%s is not a status here." % request["status"],
        }
    conn = local_connect(request.get("root"))
    if conn is None:
        return failed_as(UpdateItemResponse, *LOCAL_NO_WORKSPACE)
    ident = request["id"]
    try:
        with local_write(conn):
            if not local_fetch(conn, ident):
                return {
                    "status": "failed",
                    "reason": "item-not-found",
                    "exitCode": 1,
                    "summary": "%s names no item here." % ident,
                }
            parent = request.get("parent")
            if parent and not local_fetch(conn, parent):
                return {
                    "status": "failed",
                    "reason": "item-not-found",
                    "exitCode": 1,
                    "summary": "%s names no item here." % parent,
                }
            if parent and (parent == ident or parent in local_waiting(conn, ident)):
                return {
                    "status": "failed",
                    "reason": "cycle",
                    "exitCode": 1,
                    "summary": "%s cannot stand under %s, which waits on it to close, so "
                    "neither could close." % (ident, parent)
                    if parent != ident
                    else "%s cannot stand under %s: an item cannot wait on itself."
                    % (ident, parent),
                }
            sets = ["updated_at = ?"]
            args: list[Any] = [local_now()]
            given: Mapping[str, Any] = request
            for key, column in (
                ("title", "title"),
                ("status", "status"),
                ("priority", "priority"),
                ("parent", "parent"),
                ("assignee", "assignee"),
            ):
                if given.get(key) is not None:
                    sets.append("%s = ?" % column)
                    args.append(int(given[key]) if key == "priority" else given[key])
            conn.execute("UPDATE items SET %s WHERE id = ?" % ", ".join(sets), args + [ident])
            fetched = local_fetch(conn, ident)
            item = local_record(conn, fetched) if fetched is not None else None
    except sqlite3.OperationalError as e:
        return local_refused(UpdateItemResponse, e)
    finally:
        conn.close()
    return {"status": "completed", "summary": "Updated %s." % ident, "item": item, "exitCode": 0}


def local_record_values(request: RecordValuesRequest) -> RecordValuesResponse:
    """operation.record-values: the claim's values merged in, each label given
    replacing its value, a label given empty removed, every other kept."""
    conn = local_connect(request.get("root"))
    if conn is None:
        return failed_as(RecordValuesResponse, *LOCAL_NO_WORKSPACE)
    try:
        with local_write(conn):
            row = local_fetch(conn, request["id"])
            if row is None:
                return {
                    "status": "failed",
                    "reason": "item-not-found",
                    "exitCode": 1,
                    "summary": "%s names no item here." % request["id"],
                }
            held = json.loads(row["claim_values"]) if row["claim_values"] else []
            values = merged_values(held, list(request["values"]))
            conn.execute(
                "UPDATE items SET claim_values = ?, updated_at = ? WHERE id = ?",
                (json.dumps(values) if values else None, local_now(), request["id"]),
            )
            fetched = local_fetch(conn, request["id"])
            item = local_record(conn, fetched) if fetched is not None else None
    except sqlite3.OperationalError as e:
        return local_refused(RecordValuesResponse, e)
    finally:
        conn.close()
    return {
        "status": "completed",
        "summary": "Recorded %d value%s on %s."
        % (len(request["values"]), "" if len(request["values"]) == 1 else "s", request["id"]),
        "item": item,
        "exitCode": 0,
    }


def local_ready(request: ReadyItemsRequest) -> ReadyItemsResponse:
    """operation.ready-items: the open items with no open need."""
    conn = local_connect(request.get("root"))
    if conn is None:
        return failed_as(ReadyItemsResponse, *LOCAL_NO_WORKSPACE)
    try:
        items = [
            local_record(conn, r)
            for r in conn.execute(
                "SELECT * FROM items WHERE status = 'open' AND id NOT IN "
                "(SELECT e.id FROM edges e JOIN items n ON n.id = e.needs "
                "WHERE n.status != 'closed') "
                "ORDER BY created_at, id"
            )
        ]
    finally:
        conn.close()
    return {
        "status": "completed",
        "summary": "%d ready." % len(items),
        "items": items,
        "exitCode": 0,
    }


