PRESENTER = None


class DoorError(TypeError):
    """A request or a response outside its type, or an operation that is not one."""


def invoke(operation, request):
    """Run one operation: the request held to its type, the body, the response
    held to its type, the witness appended, the response shown and returned."""
    spec = DOOR.get(operation)
    if spec is None:
        raise DoorError("%s is not an operation of %s" % (operation, PROG))
    for key in request:
        if key not in spec["request"]:
            raise DoorError('%s: "%s" is not a field of its request' % (operation, key))
    for key in spec["requestRequired"]:
        if request.get(key) is None:
            raise DoorError('%s: "%s" is required in its request and missing'
                            % (operation, key))
    response = globals()[spec["body"]](request)
    for key in response:
        if key not in spec["response"]:
            raise DoorError('%s: "%s" is not a field of its response' % (operation, key))
    for key in spec["responseRequired"]:
        if response.get(key) is None:
            raise DoorError('%s: "%s" is required in its response and missing'
                            % (operation, key))
    if response["status"] not in STATUSES:
        raise DoorError('%s: status "%s" is not one of %s'
                        % (operation, response["status"], ", ".join(STATUSES)))
    witness_from(operation, request, response)
    if PRESENTER is not None:
        PRESENTER(operation, request, response)
    return response


def witness_from(operation, request, response):
    """The six observed labels, each from the typed response of the operation
    the IDL binds it to; nothing when this checkout keeps no log.

    A pour that names no work is placed by the log: the create that surfaced
    the formula, failing that the most recent named work. A pour the log
    cannot place is exactly what the contract is there to say. A close is
    placed the same way: through the pours the log holds.
    """
    root = request.get("root")
    ws = workspace(root) if root else None
    if not witness_on(ws):
        return
    if operation == "operation.name-the-work":
        if response.get("exitCode") == 0 and response.get("workRef"):
            witness(ws, "dotdiwInvocations", "work_named", workId=response["workRef"],
                    title=request.get("title"), startedAt=STARTED_AT)
    elif operation == "operation.match-formulas":
        if request.get("surface", True) and request.get("workRef"):
            surfaced = response.get("surfaced") or []
            for f in surfaced:
                witness(ws, "dotdiwInvocations", "formula_surfaced",
                        workId=request["workRef"], formulaId=f.get("formulaRef"),
                        path=f.get("path"))
            if not surfaced:
                witness(ws, "dotdiwInvocations", "nothing_surfaced",
                        workId=request["workRef"], title=request.get("title"))
    elif operation == "operation.pour-procedure":
        if (response.get("exitCode") == 0 and response.get("formulaRef")
                and response.get("moleculeRef")):
            work = request.get("workRef")
            if not work:
                log = witnessed(ws)
                for e in reversed(log):
                    if (e.get("label") == "formula_surfaced"
                            and e.get("formulaId") == response["formulaRef"]):
                        work = e.get("workId")
                        break
                else:
                    for e in reversed(log):
                        if e.get("label") == "work_named":
                            work = e.get("workId")
                            break
            witness(ws, "dotdiwInvocations", "procedure_poured", workId=work,
                    formulaId=response["formulaRef"], moleculeId=response["moleculeRef"],
                    stepIds=response.get("stepRefs") or [])
    elif operation == "operation.forward-to-the-tracker":
        closed = response.get("closedRefs") or []
        if closed and response.get("exitCode") == 0:
            poured = {}
            for e in witnessed(ws):
                if e.get("label") == "procedure_poured" and e.get("moleculeId"):
                    poured[e["moleculeId"]] = e
            for ident in closed:
                if ident in poured:
                    witness(ws, "beadsIssues", "molecule_closed",
                            workId=poured[ident].get("workId"), moleculeId=ident)
                    continue
                for mol, e in poured.items():
                    if ident in (e.get("stepIds") or []):
                        witness(ws, "beadsIssues", "step_closed", workId=e.get("workId"),
                                moleculeId=mol, stepId=ident)


# ============================================================ the command line
#
# The interface binding: parse the affordance, build the request, call the
# operation through the door, return its exit code, and show what came back.
# No product decision lives here. What runs before every command -- metrics
# off, an earlier adoption put right -- runs here because every affordance
# supports those two operations (binding.cli-every-run-*); resolving the
# workspace and handing bd its BEADS_DIR is how the interface reaches the
# tracker; the version is the tool's identity and no operation.
#
# present() is what main() installs in the door: one renderer per operation
# that has something to show, run as that operation returns, so the order on
# the terminal is the order of the calls. The wording is the product's and
# test_dotdiw.py holds it; the facts come from the typed response and the
# request, never from anywhere else.

def show_teach(request, response):
    sys.stdout.write(response["text"])


def show_index(request, response):
    if response["status"] == "failed" and response.get("fileCount"):
        n = response["fileCount"]
        sys.stderr.write(
            "%s needs Python 3.11 or newer to read formulas (tomllib), and this "
            "is %d.%d.\n  %d formula file%s in this repo cannot be parsed.\n"
            "  brew install %s installs its own interpreter; this one came from "
            "elsewhere.\n"
            % (PROG, sys.version_info[0], sys.version_info[1], n,
               "" if n == 1 else "s", PROG))


def show_list(request, response):
    if response["status"] != "completed":
        return
    forms = response["formulas"]
    if request.get("json"):
        print(json.dumps([{"formula": f["formulaRef"], "name": f["name"],
                           "path": f["path"], "description": f["description"],
                           "examples": f["examples"]} for f in forms], indent=2))
    elif not forms:
        print("No formulas in this repo yet. %s learn says how to write one."
              % PROG)
    else:
        w = max(len(f["formulaRef"]) for f in forms)
        print("%d formula%s in this repo:"
              % (len(forms), "" if len(forms) == 1 else "s"))
        for f in sorted(forms, key=lambda g: g["name"]):
            d = " ".join(f["description"].split())
            if len(d) > 70 - w:
                d = d[:69 - w] + "…"
            print("  %-*s  %s" % (w, f["formulaRef"], d))
            print("  %-*s  %s" % (w, "", f["path"]))
        print("\nRun one: %s mol pour <id>" % PROG)


def show_show(request, response):
    if response["status"] == "completed":
        sys.stdout.write(response["text"])
    elif response["status"] == "failed" and response.get("path"):
        sys.stderr.write("%s: %s\n" % (response["path"], response["summary"]))


def show_match(request, response):
    top = response.get("surfaced") or []
    if not top or not request.get("surface", True):
        return
    w = max(len(f["name"]) for f in top)
    print("\n\U0001f4dc Formulas that may apply:", file=sys.stderr)
    for f in top:
        d = " ".join(f["description"].split())
        if len(d) > 74 - w:
            d = d[:73 - w] + "…"
        print("  %-*s  %s" % (w, f["name"], d), file=sys.stderr)
        print("  %-*s  %s" % (w, "", f["path"]), file=sys.stderr)
    # One command. It used to print `cook --persist && mol wisp create`,
    # whose wisp is ephemeral and never synced via git -- which is
    # management and sharing both given up. `mol pour` is the durable one,
    # and it now cooks from the formula's own path first.
    print("  Run it: %s mol pour %s" % (PROG, top[0]["formulaRef"]), file=sys.stderr)


def show_notice(found):
    """The handmade notice, shown by the check that carries it."""
    if not found:
        return
    sys.stdout.flush()
    print("\n\U0001f4dc %d procedure%s carried out here, never declared:"
          % (len(found), "" if len(found) == 1 else "s"), file=sys.stderr)
    for p in found[:TOP_N]:
        print("    %s  (%d ordered steps, built by hand)"
              % (p["title"] or p["workRef"], p["stepCount"]), file=sys.stderr)
        print("      %s formula new \"%s\" --from %s" % (PROG, p["title"], p["workRef"]),
              file=sys.stderr)
    if len(found) > TOP_N:
        print("    ... and %d more" % (len(found) - TOP_N), file=sys.stderr)


def show_check(request, response):
    if response["status"] == "failed":          # the index said why
        return
    probs, mode = response["problems"], request.get("mode") or "check"
    undeclared = response.get("undeclared") or []

    def show(limit):
        shown = probs if limit is None else probs[:limit]
        w = max(len(p["where"]) for p in shown)
        for p in shown:
            print("  %-*s  %s" % (w, p["where"], p["what"]), file=sys.stderr)
        rest = len(probs) - len(shown)
        if rest > 0:
            print("  ... and %d more. See them all: %s check" % (rest, PROG),
                  file=sys.stderr)

    if mode == "quiet":
        # Under a create the notice comes before the problems: the thing the
        # worker can act on first, then the housekeeping.
        show_notice(undeclared)
        if probs:
            print("\n%d formula problem%s:" % (len(probs), "" if len(probs) == 1 else "s"),
                  file=sys.stderr)
            show(3)
    elif mode == "doctor":
        if probs:
            print("\n%d %s convention problem%s:"
                  % (len(probs), PROG, "" if len(probs) == 1 else "s"),
                  file=sys.stderr)
            show(5)
        show_notice(undeclared)
    else:
        n = response["formulaCount"]
        if not n and not probs:
            print("No formulas yet. %s learn says how to write one." % PROG)
        elif not probs:
            print("✓ %d formula%s, all discoverable." % (n, "" if n == 1 else "s"))
        else:
            print("%d problem%s:" % (len(probs), "" if len(probs) == 1 else "s"),
                  file=sys.stderr)
            show(None)
        show_notice(undeclared)


def show_nudge(request, response):
    if response["nudged"]:
        print("\n\U0001f4dc That reads like a procedure. A formula can be "
              "matched against a\n   title and poured into tracked steps; "
