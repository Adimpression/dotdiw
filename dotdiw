def package_dirs(home: str, shared_under: str) -> list[str]:
    """Where a module may be, in the order they are looked in: home, under the
    home directory, then shared_under above the bin/ this tool runs from, then
    the same above Cellar/ when this file is inside a Homebrew keg. A package
    cannot write to a home directory; it can write there."""
    here = os.path.abspath(__file__)
    prefixes = []
    if os.path.basename(os.path.dirname(here)) == "bin":
        prefixes.append(os.path.dirname(os.path.dirname(here)))
    real, cellar = os.path.realpath(here), os.sep + "Cellar" + os.sep
    if cellar in real:
        prefixes.append(real.split(cellar)[0])
    dirs = [os.path.expanduser(home)]
    for prefix in prefixes:
        shared = os.path.join(prefix, shared_under)
        if shared not in dirs:
            dirs.append(shared)
    return dirs


def module_loader(name: str, path: str) -> importlib.machinery.SourceFileLoader:
    """The loader of a module file. A package's file is a symlink into its
    keg; it is read from there, so that its bytecode goes with the keg and not
    into the directory packages share."""
    return importlib.machinery.SourceFileLoader(name, os.path.realpath(path))


def tracker_dirs() -> list[str]:
    """Where a tracker module may be: share/dotdiw/trackers under a prefix,
    ~/.dotdiw/trackers first."""
    return package_dirs(TRACKERS_DIR, TRACKERS_SHARED)


def tracker_file(name: str) -> str | None:
    """The first file of this name in those directories, or None."""
    for directory in tracker_dirs():
        path = os.path.join(directory, name + ".py")
        if os.path.isfile(path):
            return path
    return None


def load_tracker(name: str, given: str | None = None) -> bool:
    """An adapter by name from the first file of that name in tracker_dirs, or
    from the file given, a module that exposes TRACKER in the registry's shape;
    False when there is no such file, when the module exposes no table, or when
    it raised on load or its table is out of shape, which LOAD_FAILED then says
    in one line. A file that fails is refused; a later directory is not tried
    instead. A file given is read as it stands, with no bytecode read for it.

    Before the module runs it is handed two names: dotdiw_workspace, the
    callable of one root that says where this checkout's workspace is under
    ~/.dotdiw, so an adapter keeps its store there without reading git itself;
    and dotdiw_version, this tool's."""
    if not re.fullmatch(TRACKER_NAME, name or ""):
        return False
    if given is None and name in LOAD_TRIED:
        return False
    path = given or tracker_file(name)
    if path is None:
        return False
    loader = module_loader("dotdiw_tracker_" + name, path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        return False
    module = importlib.util.module_from_spec(spec)
    vars(module)["dotdiw_workspace"] = workspace
    vars(module)["dotdiw_version"] = VERSION
    sys.modules[loader.name] = module  # a dataclass looks its module up by name
    loaded = False
    try:
        if given:  # bytecode is matched by size and second, which a same-sized edit can keep
            exec(loader.source_to_code(loader.get_data(loader.path), loader.path), vars(module))
        else:
            loader.exec_module(module)
        table = getattr(module, "TRACKER", None)
        if not isinstance(table, dict):
            if given:
                LOAD_FAILED[name] = "%s holds no TRACKER table." % path
            LOAD_TRIED.add(name)
            return False  # a file there that is not an adapter
        info = table.setdefault("info", {})
        info["origin"], info["source"] = "loaded", path  # what the loader knows, not the module
        register_tracker(name, table)
        loaded = True
    except MODULE_MISTAKES as e:  # the module's mistake: one line, never a traceback
        said = " ".join(str(e).split()) or "no message"
        LOAD_FAILED[name] = "%s did not load from %s: %s" % (
            name,
            path,
            said if isinstance(e, DoorError) else "%s: %s" % (type(e).__name__, said),
        )
        LOAD_TRIED.add(name)
        return False
    finally:
        if not loaded:
            sys.modules.pop(loader.name, None)
    LOAD_FAILED.pop(name, None)
    return True


def tracker_name(root: str) -> str | None:
    """The workspace's adapter from the checkout's config, or None.

    Read with --local like the key, so a worktree sees the checkout's choice
    and a global value is never taken for one."""
    if root not in CHOICES:
        CHOICES[root] = git(["config", "--local", "--get", TRACKER_KEY], root).strip() or None
    return CHOICES[root]


def tracker_with_store(root: str) -> str | None:
    """The one registered adapter holding a store under this checkout's
    workspace, or None when none does or more than one does: how a
    workspace adopted before there was a choice is answered by the tracker
    it was adopted under."""
    found = []
    for name in sorted(TRACKERS):
        adapter = TRACKERS[name]
        store = adapter.get("store")
        try:
            path = store(root) if store else None
            if path and os.path.exists(path):
                found.append(name)
        except MODULE_MISTAKES:  # a module's mistake must not stop another adapter answering
            if not is_loaded(adapter):
                raise
    return found[0] if len(found) == 1 else None


def resolve_tracker(request: Request) -> tuple[str, TrackerTable | None]:
    """The adapter a request is answered by, as its name and its table: the
    one the request names, else the workspace's, else the one holding a
    store there, else the shipped default. The table is None when no
    adapter of that name is registered or loads."""
    root = request.get("root") or repo_root()
    name = (
        request.get("tracker") or tracker_name(root) or tracker_with_store(root) or DEFAULT_TRACKER
    )
    if name in TRACKERS or load_tracker(name):
        return name, TRACKERS[name]
    return name, None


def tracker_unknown(shape: type[R], name: str) -> R:
    """The failed response for a name no adapter answers to: why a module of
    that name did not load, else which names are registered."""
    if name in LOAD_FAILED:
        return failed_as(shape, "adapter-failed", LOAD_FAILED[name])
    return failed_as(
        shape,
        "tracker-unknown",
        "%s is not a tracker here; registered: %s." % (name, ", ".join(sorted(TRACKERS)) or "none"),
    )


def is_loaded(adapter: TrackerTable) -> bool:
    """Whether an adapter came from a file: its mistakes are its author's, and
    a worker's situation; a shipped adapter's are the project's."""
    return adapter["info"].get("origin") == "loaded"


def adapter_failed(shape: type[R], name: str, what: str, error: BaseException) -> R:
    """A loaded adapter's mistake as one line naming it, the operation or the
    extra, and the error, never a traceback."""
    return failed_as(
        shape,
        "adapter-failed",
        "%s failed inside %s: %s: %s"
        % (
            name,
            what.split(".", 1)[-1],
            type(error).__name__,
            " ".join(str(error).split()) or "no message",
        ),
    )


def invoke_tracker(operation: str, request: Request) -> Response:
    """Run one operation of the tracker interface: the request held to its
    type, the adapter resolved and its callable run, the response held to
    its type and returned. An unknown adapter is a failed response; a key
    outside either type, or a value of another kind than the IDL declares for
    it, is the project's mistake and raises. A word of an enum in a request is
    the adapter's to refuse, as bad-status refuses a status it cannot reach.
    Asked from outside any request, it begins one (a_request)."""
    with a_request():
        return asked_of_the_tracker(operation, request)


def asked_of_the_tracker(operation: str, request: Request) -> Response:
    """invoke_tracker's answer, within the request it is asked in."""
    spec = TRACKER_DOOR.get(operation)
    if spec is None:
        raise DoorError("%s is not an operation of the tracker" % operation)
    for key in request:
        if key not in spec["request"]:
            raise DoorError('%s: "%s" is not a field of its request' % (operation, key))
    for key in spec["requestRequired"]:
        if request.get(key) is None:
            raise DoorError('%s: "%s" is required in its request and missing' % (operation, key))
    kinds = record_kinds(spec["requestType"])
    for key, value in request.items():
        hold_value(operation, key, value, kinds[key], words=False)
    name, adapter = resolve_tracker(request)
    response: Response
    if adapter is None:
        response = tracker_unknown(dict, name)
    else:
        settle_adapter(name, adapter, request.get("root"))
        try:
            response = adapter["operations"][operation](request)
            hold_tracker_response(operation, name, response)
        except MODULE_MISTAKES as e:
            if not is_loaded(adapter):
                raise  # a shipped adapter's mistake is the project's
            response = adapter_failed(dict, name, operation, e)
    hold_tracker_response(operation, name, response)
    return response


def settle_adapter(name: str, adapter: TrackerTable, root: str | None) -> None:
    """The first time a run reaches an adapter that keeps usage metrics, chosen
    or not, they go off before anything else is asked of it, and it is said."""
    if name in SETTLED or "metrics-off" not in (adapter.get("extras") or {}):
        return
    SETTLED.add(name)
    invoke("operation.turn-metrics-off", {"root": root, "tracker": name})


def hold_tracker_response(operation: str, name: str, response: Response) -> None:
    """The adapter's answer held to its type, the adapter that answered
    stamped on it: a key outside the type, a required one missing, a status
    outside the four or a value that is not what the IDL declares raises
    naming the operation and the key, and so does a completed answer without
    the record its callers read. An exit code is settled against the status."""
    spec = TRACKER_DOOR[operation]
    if isinstance(response, dict):
        response["tracker"] = name  # which adapter answered: the witness records it
    for key in response:
        if key not in spec["response"]:
            raise DoorError('%s: "%s" is not a field of its response' % (operation, key))
    for key in spec["responseRequired"]:
        if response.get(key) is None:
            raise DoorError('%s: "%s" is required in its response and missing' % (operation, key))
    if response["status"] not in STATUSES:
        raise DoorError(
            '%s: status "%s" is not one of %s'
            % (operation, response["status"], ", ".join(STATUSES))
        )
    kinds = record_kinds(spec["responseType"])
    for key, value in response.items():
        hold_value(operation, key, value, kinds[key])
    settle_exit_code(operation, response)
    if response["status"] == "completed":
        for key in TRACKER_ANSWERS.get(operation, ()):
            if response.get(key) is None:
                raise DoorError('%s: a completed answer carries "%s"' % (operation, key))


def settle_exit_code(what: str, response: Response) -> None:
    """A status and an exit code that agree, since callers read either. One left
    out is read from the status; one against it raises, naming what answered."""
    code, failing = response.get("exitCode"), response["status"] in ("failed", "blocked")
    if code is None:
        response["exitCode"] = 1 if failing else 0
    elif not isinstance(code, int) or isinstance(code, bool):
        raise DoorError('%s: "exitCode" is not an integer' % what)
    elif failing == (code & 0xFF == 0):  # 256 is read as success by whatever ran this
        raise DoorError("%s: a %s answer cannot exit %d" % (what, response["status"], code))


def record_kinds(kind: Any) -> dict[str, Any]:
    """A record type's fields and their types, without Required."""
    if kind not in RECORD_KINDS:
        RECORD_KINDS[kind] = get_type_hints(kind)
    return RECORD_KINDS[kind]


def hold_value(operation: str, where: str, value: Any, kind: Any, words: bool = True) -> None:
    """One value against its type in the IDL: a record to its fields, a list
    item by item, an enum to its values, or with words false to being text.
    Absent and None read alike. What it raises names the field and not the
    value, which may be anything."""

    def outside(said: str) -> DoorError:
        return DoorError('%s: "%s" %s' % (operation, where, said))

    origin = get_origin(kind)
    if origin in (Union, UnionType):
        if value is not None:
            one = [k for k in get_args(kind) if k is not type(None)][0]
            hold_value(operation, where, value, one, words)
    elif origin is Literal:
        if not words:
            if not isinstance(value, str):
                raise outside("is not text")
        elif value not in get_args(kind):
            raise outside("is not one of %s" % ", ".join(get_args(kind)))
    elif origin is list:
        if not isinstance(value, list):
            raise outside("is not a list")
        for n, one in enumerate(value):
            hold_value(operation, "%s[%d]" % (where, n), one, get_args(kind)[0], words)
    elif origin is dict:
        if not isinstance(value, dict):
            raise outside("is not a map")
        for key, one in value.items():
            hold_value(operation, "%s.%s" % (where, key), key, get_args(kind)[0], words)
            hold_value(operation, "%s.%s" % (where, key), one, get_args(kind)[1], words)
    elif is_typeddict(kind):
        if not isinstance(value, dict):
            raise outside("is not a record")
        kinds = record_kinds(kind)
        for key in value:
            if key not in kinds:
                raise DoorError(
                    '%s: "%s.%s" is not a field of its record' % (operation, where, key)
                )
        for key in kind.__required_keys__:
            if value.get(key) is None:
                raise DoorError('%s: "%s.%s" is required and missing' % (operation, where, key))
        for key, one in value.items():
            hold_value(operation, "%s.%s" % (where, key), one, kinds[key], words)
    elif kind is bool:
        if not isinstance(value, bool):
            raise outside("is not a boolean")
    elif kind is int:
        if not isinstance(value, int) or isinstance(value, bool):
            raise outside("is not an integer")
    elif kind is str:
        if not isinstance(value, str):
            raise outside("is not a string")


def invoke_extra(extra: str, request: Request) -> Response:
    """Run one extra of the chosen adapter, what it offers beyond the
    interface, resolved exactly like an operation. An adapter without the
    extra answers unsupported, a worker's situation. No table types an
    extra, so the response is held to a status and a summary only. Asked
    from outside any request, it begins one (a_request)."""
    with a_request():
        return asked_of_an_extra(extra, request)


def invoke_adapter(adapter: str, operation: str, request: Request) -> Response:
    """Run one adapter's own callable for an operation of the tracker
    interface, as the registry holds it and with nothing held of the request
    or the response: what an implementation binding of that adapter resolves
    to. Asked from outside any request, it begins one (a_request)."""
    with a_request():
        answer: Response = TRACKERS[adapter]["operations"][operation](request)
        return answer


def asked_of_an_extra(extra: str, request: Request) -> Response:
    """invoke_extra's answer, within the request it is asked in."""
    name, adapter = resolve_tracker(request)
    if adapter is None:
        return tracker_unknown(dict, name)
    if extra == "metrics-off":
        SETTLED.add(name)
    else:
        settle_adapter(name, adapter, request.get("root"))
    fn = (adapter.get("extras") or {}).get(extra)
    if fn is None:
        return {
            "status": "failed",
            "reason": "unsupported",
            "exitCode": 1,
            "summary": "%s does not offer %s." % (name, extra),
        }
    try:
        response = fn(request)
        if (
            not isinstance(response, dict)
            or response.get("status") not in STATUSES
            or not response.get("summary")
        ):
            raise DoorError("%s: the %s extra answered outside its shape" % (name, extra))
        settle_exit_code("%s: the %s extra" % (name, extra), response)
    except MODULE_MISTAKES as e:
        if not is_loaded(adapter):
            raise  # a shipped adapter's mistake is the project's
        response = adapter_failed(dict, name, extra, e)
    response["tracker"] = name
    return response


def AnswerThroughTheTracker(
    request: AnswerThroughTheTrackerRequest,
) -> AnswerThroughTheTrackerResponse:
    """One operation of the tracker interface, by id, through the tracker
    door: how a transport reaches the tracker without knowing the adapter."""
    operation = request["operation"]
    if operation not in TRACKER_DOOR:
        return {
            "status": "failed",
            "reason": "operation-not-of-the-tracker",
            "exitCode": 1,
            "summary": "%s is not an operation of the tracker" % operation,
        }
    inner: Request = dict(request.get("request") or {})
    for key in ("tracker", "root"):
        if request.get(key) is not None and inner.get(key) is None:
            inner[key] = request[key]
    response = invoke_tracker(operation, inner)
    out: AnswerThroughTheTrackerResponse = {
        "status": response["status"],
        "summary": response["summary"],
        "exitCode": response.get("exitCode", 0),
        "response": response,
    }
    if response.get("reason") in ("tracker-unknown", "adapter-failed"):
        out["reason"] = response["reason"]
    return out


# ------------------------------------------- duty.put-all-four-under-one-name, the choosing


def ListTrackers(request: ListTrackersRequest) -> ListTrackersResponse:
    """step.list-trackers: every adapter registered or in tracker_dirs, each
    described through the tracker door, and the one this checkout uses."""
    root = request.get("root")
    failed: list[TrackerInfo] = []
    files = [p for d in tracker_dirs() for p in glob.glob(os.path.join(glob.escape(d), "*.py"))]
    for name in sorted({os.path.basename(path)[:-3] for path in files}):
        if name not in TRACKERS and not load_tracker(name) and name in LOAD_FAILED:
            failed.append(
                {
                    "name": name,
                    "version": "did not load",
                    "origin": "loaded",
                    "source": tracker_file(name),
                }
            )  # said here; why, when the name is used
    trackers: list[TrackerInfo] = []
    for name in sorted(TRACKERS):
        held = TRACKERS[name]["info"]
        described = invoke_tracker("operation.describe-tracker", {"root": root, "tracker": name})
        # What the adapter said of itself, the fields it left out filled below.
        info = cast(
            TrackerInfo,
            dict(described.get("info") or {}) if described["status"] == "completed" else {},
        )
        info.setdefault("name", name)
        info.setdefault(
            "version",
            "not installed"
            if described.get("reason") == "not-installed"
            else held.get("version") or "unknown",
        )
        info["origin"] = held["origin"]
        if held.get("source"):
            info["source"] = held["source"]
        trackers.append(info)
    trackers.extend(failed)
    chosen, _ = resolve_tracker({"root": root})
    return {
        "status": "completed",
        "summary": "%d tracker%s; this checkout uses %s."
        % (len(trackers), "" if len(trackers) == 1 else "s", chosen),
        "trackers": trackers,
        "chosen": chosen,
        "exitCode": 0,
    }


def UseTracker(request: UseTrackerRequest) -> UseTrackerResponse:
    """step.use-tracker: dotdiw.tracker names the adapter in the checkout's
    config and its store is open, through the adoption step, quietly; an
    unknown name is refused with the registered names and nothing is
    written. The work in the adapter used before stays there. Where the
    tracker checked who it acts as, that name is said each time."""
    root, name = request["root"], request["name"]
    if not git(["rev-parse", "--is-inside-work-tree"], root).strip():
        return {
            "status": "failed",
            "summary": "Not a git repository.",
            "reason": "not-a-repository",
            "exitCode": 2,
        }
    if not (name in TRACKERS or load_tracker(name)):
        return tracker_unknown(UseTrackerResponse, name)
    previous = tracker_name(root) or tracker_with_store(root)
    made = invoke(
        "operation.adopt-repository",
        {"root": root, "quiet": True, "tracker": name},
    )
    if made["status"] != "completed":
        return {
            "status": "failed",
            "summary": made["summary"],
            "reason": made.get("reason")
            if made.get("reason")
            in ("tracker-unknown", "adapter-failed", "not-a-repository", "key-not-written")
            else None,
            "exitCode": made["exitCode"],
        }
    # The adoption asks only of a store it opened; one already open is
    # written to as someone all the same.
    actor = made.get("actor")
    if not made.get("created"):
        described = invoke_tracker("operation.describe-tracker", {"root": root, "tracker": name})
        actor = described.get("actor")
    return {
        "status": "completed",
        "summary": "This checkout's tracker is %s%s."
        % (name, "" if previous in (None, name) else ", was %s" % previous),
        "name": name,
        "previous": previous if previous != name else None,
        "actor": actor,
        "exitCode": 0,
    }


def conformance_scenario(
    answering: Callable[..., Response], prefix: str = "chk"
) -> list[TrackerCheckResult]:
    """The scenario that defines an adapter, as one result per operation of
    the interface: what every adapter must answer, in records, against a
    store it may fill, opened under the prefix given -- the adapter's
    declared check target. `ask` reaches one adapter through the tracker
    door."""

    class Held(dict[str, Any]):
        """The items the scenario made; asking for one that was not made is an
        operation that could not be tried, and says so."""

        def __missing__(self, key: str) -> Any:
            earlier = "close-item" if key == "closed" else "create-item"
            raise AssertionError("cannot be tried until operation.%s passes" % earlier)

    results: list[TrackerCheckResult] = []
    held = Held()
    nowhere = "%s-nowhere" % prefix

    def ask(operation: str, **request: Any) -> Response:
        out = answering(operation, **request)
        if out.get("reason") == "adapter-failed":
            raise AssertionError(out["summary"])  # its own words, whatever was expected
        return out

    def check(operation: str, body: Callable[[], None]) -> None:
        try:
            body()
            results.append({"operation": operation, "status": "pass"})
        except AssertionError as e:
            results.append({"operation": operation, "status": "fail", "detail": str(e)})
        except Exception as e:  # an adapter that raises fails its operation
            results.append(
                {
                    "operation": operation,
                    "status": "fail",
                    "detail": "%s: %s" % (type(e).__name__, e),
                }
            )

    def expect(condition: object, detail: str) -> None:
        if not condition:
            raise AssertionError(detail)  # not an assert: python -O must not pass a check

    def open_tracker() -> None:
        first = ask("open-tracker", prefix=prefix)
        expect(
            first["status"] == "completed" and first.get("created") is True,
            "the first open makes the store: %s" % first.get("summary"),
        )
        again = ask("open-tracker", prefix=prefix)
        expect(
            again["status"] == "completed" and again.get("created") is False,
            "a second open changes nothing: %s" % again.get("summary"),
        )

    def describe() -> None:
        out = ask("describe-tracker")
        info = out.get("info") or {}
        expect(
            out["status"] == "completed"
            and all(info.get(k) for k in ("name", "version", "origin")),
            "name, version and origin come back: %s" % out.get("summary"),
        )
        expect(bool(out.get("path")), "the store's path comes back once it is open")

    # A description that reads like the means, and the means a move carries:
    # an adapter gives both back exactly as given.
    DESCRIBED = "Verify using:\n- a line of this description, not a means"
    CARRIED = ["run:make check", "https://example.invalid/runs/2"]

    def create() -> None:
        a = ask("create-item", title="First", priority=0)
        expect(
            a["status"] == "completed" and a.get("item", {}).get("id"),
            "an item comes back as a record: %s" % a.get("summary"),
        )
        held["a"] = a["item"]["id"]
        expect(
            (a["item"].get("title"), a["item"].get("status")) == ("First", "open"),
            "the record carries the title and status open",
        )
        expect(a["item"].get("priority") == 0, "priority 0 is kept")
        b = ask("create-item", title="Second", parent=held["a"])
        expect(
            b["status"] == "completed" and b["item"].get("parent") == held["a"],
            "a child carries its parent",
        )
        expect(
            (b["item"].get("kind", "task"), b["item"].get("priority")) == ("task", 2),
            "kind is task and priority 2 when unsaid",
        )
        held["b"] = b["item"]["id"]
        held["c"] = ask("create-item", title="Third")["item"]["id"]
        d = ask("create-item", title="Described", description=DESCRIBED)
        expect(
            ((d.get("item") or {}).get("description"), (d.get("item") or {}).get("verifyUsing"))
            in ((DESCRIBED, None), (DESCRIBED, [])),
            "a description that reads like the means comes back as given, with no means",
        )
        held["d"] = d["item"]["id"]
        e = ask("create-item", title="Moved", description="Was a root.", verifyUsing=CARRIED)
        expect(
            ((e.get("item") or {}).get("description"), (e.get("item") or {}).get("verifyUsing"))
            == ("Was a root.", CARRIED),
            "the means a move carries come back as given",
        )
        held["e"] = e["item"]["id"]
        orphan = ask("create-item", title="Orphan", parent=nowhere)
        expect(
            orphan["status"] == "failed" and orphan.get("reason") == "parent-not-found",
            "a parent that does not exist is parent-not-found: %s" % orphan.get("reason"),
        )

    def need() -> None:
        edge = ask("add-need", id=held["c"], needs=held["b"])
        expect(
            edge["status"] == "completed"
            and edge.get("edge") == {"id": held["c"], "needs": held["b"]},
            "an edge comes back: %s" % edge.get("summary"),
        )
        expect(
            ask("add-need", id=held["c"], needs=held["b"])["status"] == "completed",
            "a need already there answers completed, since an interrupted move asks again",
        )
        expect(
            ask("add-need", id=held["c"], needs=nowhere).get("reason") == "item-not-found",
            "a need that does not exist is item-not-found",
        )
        expect(
            ask("add-need", id=held["b"], needs=held["c"]).get("reason") == "cycle",
            "a cycle is refused",
        )

    def show() -> None:
        out = ask("show-item", id=held["a"])
        expect(
            out["status"] == "completed" and out["item"]["id"] == held["a"], "the record comes back"
        )
        expect(
            [k["id"] for k in out.get("children") or []] == [held["b"]], "the children come back"
        )
        expect(
            ask("show-item", id=held["c"])["item"].get("needs") == [held["b"]],
            "the needs come back",
        )
        expect(
            ask("show-item", id=nowhere).get("reason") == "item-not-found",
            "unknown is item-not-found",
        )
        for key, given, means in (("d", DESCRIBED, []), ("e", "Was a root.", CARRIED)):
            item = ask("show-item", id=held[key]).get("item") or {}
            expect(
                (item.get("description"), list(item.get("verifyUsing") or [])) == (given, means),
                "an item's description and means come back from show as given",
            )

    def listing() -> None:
        closed = held["closed"]
        out = ask("list-items", scope="all")
        expect(
            {i["id"] for i in out.get("items") or []}
            == {held["a"], held["b"], held["c"], held["d"], held["e"]},
            "every item is listed",
        )
        under = ask("list-items", parent=held["a"], scope="all")
        expect(
            [i["id"] for i in under.get("items") or []] == [held["b"]],
            "a parent's children are listed",
        )
        expect(
            closed not in {i["id"] for i in ask("list-items", parent=held["a"]).get("items") or []}
            and not ask("list-items", parent=held["a"]).get("items"),
            "a parent's open children are listed when scope is unsaid, here none",
        )
        for scoped in (ask("list-items", scope="open"), ask("list-items")):
            expect(
                {i["id"] for i in scoped.get("items") or []}
                == {held["a"], held["c"], held["d"], held["e"]},
                "open items are listed when asked and when unsaid, the closed one is not",
            )
        expect(len(ask("list-items", scope="all", limit=1).get("items") or []) == 1, "limit limits")

    def ready() -> None:
        ids = {i["id"] for i in ask("ready-items").get("items") or []}
        expect(
            held["a"] in ids and held["b"] in ids and held["c"] not in ids,
            "the unblocked open items are ready, the blocked one is not",
        )

    def close() -> None:
        blocked = ask("close-item", id=held["c"])
        expect(
            blocked["status"] == "blocked" and blocked.get("blockedBy") == [held["b"]],
            "a close is refused while an open need exists, naming it: %s" % blocked.get("summary"),
        )
        parent = ask("close-item", id=held["a"])
        expect(
            parent["status"] == "blocked" and parent.get("blockedBy") == [held["b"]],
            "a close is refused while an open child exists, naming it",
        )
        done = ask("close-item", id=held["b"], closeReason="done")
        expect(
            done["status"] == "completed" and done.get("closedIds") == [held["b"]],
            "the close names what it closed",
        )
        expect(
            (done.get("item") or {}).get("status") == "closed"
            and (done.get("item") or {}).get("reason") == "done",
            "the closed record keeps the reason",
        )
        expect(
            held["c"] in {i["id"] for i in ask("ready-items").get("items") or []},
            "the need met, the item is ready",
        )
        held["closed"] = held["b"]

    def update() -> None:
        out = ask(
            "update-item", id=held["c"], title="Third, renamed", status="in_progress", priority=0
        )
        item = out.get("item") or {}
        expect(
            (item.get("title"), item.get("status"), item.get("priority"))
            == ("Third, renamed", "in_progress", 0),
            "title, status and priority change: %s" % out.get("summary"),
        )
        expect(
            ask("update-item", id=held["c"], status="closed").get("reason")
            == "close-through-update",
            "closing is close-item's",
        )
        expect(
            ask("update-item", id=held["c"], status="no-such-status").get("reason") == "bad-status",
            "a status the tracker cannot reach is bad-status",
        )

    def pour() -> None:
        steps = [
            {"id": "one", "title": "One"},
            {"id": "two", "title": "Two", "needs": ["one"]},
            {"id": "three", "title": "Three", "needs": ["two"]},
        ]
        means = [
            "run:make check",
            "git+https://example.invalid/acme/shop.git#RELEASING.md",
            "https://example.invalid/runs/1",
        ]
        said = "Verify using:\n- a line of the formula's description, not a means"
        out = ask(
            "pour-steps",
            formulaRef="mol-check",
            title="mol-check",
            steps=steps,
            description=said,
            verifyUsing=means,
        )
        expect(
            out["status"] == "completed" and len(out.get("stepIds") or []) == 3,
            "a root and three steps: %s" % out.get("summary"),
        )
        root_id, (one, two, three) = out["rootId"], out["stepIds"]
        shown = ask("show-item", id=root_id)
        expect(
            {k["id"] for k in shown.get("children") or []} == {one, two, three},
            "the steps are the root's children",
        )
        expect(shown["item"].get("kind") == "root", "the root is of kind root")
        expect(
            all(k.get("kind", "task") == "task" for k in shown.get("children") or []),
            "every step is of kind task",
        )
        expect(
            (shown["item"].get("description"), shown["item"].get("verifyUsing")) == (said, means),
            "the root's description and verify-using come back exactly as given",
        )
        expect(ask("show-item", id=two)["item"].get("needs") == [one], "the order is in the edges")
        expect(
            ask("close-item", id=three).get("blockedBy") == [two],
            "a step cannot close before the steps it needs",
        )
        for step in (one, two):
            expect(
                ask("close-item", id=step, closeReason="did").get("closedIds") == [step],
                "a step closes in its order",
            )
        last = ask("close-item", id=three, closeReason="did")
        expect(last["status"] == "completed", "the last step closes")
        if root_id not in (last.get("closedIds") or []):
            expect(
                ask("close-item", id=root_id).get("closedIds") == [root_id],
                "the root closes once its steps have",
            )
        expect(
            ask("show-item", id=root_id)["item"].get("status") == "closed",
            "the poured root is closed",
        )
        expect(
            ask("pour-steps", formulaRef="mol-none", title="mol-none", steps=[]).get("reason")
            == "no-steps",
            "no steps is no-steps",
        )
        later = ask(
            "pour-steps",
            formulaRef="mol-later",
            title="mol-later",
            steps=[
                {"id": "second", "title": "Second", "needs": ["first"]},
                {"id": "first", "title": "First"},
            ],
        )
        expect(
            later["status"] == "completed" and len(later.get("stepIds") or []) == 2,
            "a need on a step declared later is a need: %s" % later.get("summary"),
        )
        second, first = later["stepIds"]
        expect(
            ask("show-item", id=second)["item"].get("needs") == [first],
            "stepIds come back in the order given, and the edge runs the right way",
        )
        expect(
            ask(
                "pour-steps",
                formulaRef="mol-gap",
                title="mol-gap",
                steps=[{"id": "only", "title": "Only", "needs": ["gone"]}],
            ).get("reason")
            == "step-not-found",
            "a need naming no step is step-not-found",
        )
        before = len(ask("list-items", scope="all").get("items") or [])
        looped = ask(
            "pour-steps",
            formulaRef="mol-loop",
            title="mol-loop",
            steps=[
                {"id": "x", "title": "X", "needs": ["y"]},
                {"id": "y", "title": "Y", "needs": ["x"]},
            ],
        )
        expect(looped.get("reason") == "cycle", "a cycle among the steps is refused")
        expect(
            len(ask("list-items", scope="all").get("items") or []) == before,
            "a refused pour writes nothing",
        )

    def claims() -> None:
        claim = {"statement": "Counted {{ n }} at {{ place }}.", "slots": ["n", "place"]}
        poured = ask(
            "pour-steps",
            formulaRef="mol-claim",
            title="mol-claim",
            steps=[
                {"id": "count", "title": "Count", "claim": claim},
                {"id": "file", "title": "File it", "needs": ["count"]},
            ],
        )
        expect(poured["status"] == "completed", "a claimed pour: %s" % poured.get("summary"))
        counted, filed = poured["stepIds"]
        shown = ask("show-item", id=counted)["item"]
        expect(
            (shown.get("step"), shown.get("claim"), shown.get("run"))
            == ("count", claim, poured["rootId"]),
            "a pour keeps the step's id, its claim and its run: %s" % shown,
        )
        expect(
            ask("show-item", id=filed)["item"].get("step") == "file"
            and not ask("show-item", id=filed)["item"].get("claim"),
            "a step with no claim keeps its id alone",
        )
        n42 = {"label": "n", "text": "42"}
        north = {"label": "place", "text": "north plot"}
        n43 = {"label": "n", "text": "43"}
        extra = {"label": "extra", "text": "x: y"}
        said = ask("record-values", id=counted, values=[n42, north])
        # A tracker that cannot hold a write of values to the item named
        # declines them all, and writes nothing.
        declined = said.get("reason") == "unsupported"
        if declined:
            expect(
                not ask("show-item", id=counted)["item"].get("values"),
                "record-values declined as unsupported records nothing",
            )
        else:
            expect(
                (said.get("item") or {}).get("values") == [n42, north],
                "record-values sets each label given: %s" % said.get("summary"),
            )
            said = ask("record-values", id=counted, values=[n43, {"label": "place", "text": ""}])
            expect(
                (said.get("item") or {}).get("values") == [n43],
                "a label given replaces its value, and one given empty is removed",
            )
            said = ask("record-values", id=counted, values=[extra])
            expect(
                (said.get("item") or {}).get("values") == [n43, extra],
                "every other label stays",
            )
        root = ask("show-item", id=poured["rootId"])
        kids = {k["id"]: k for k in root.get("children") or []}
        expect(
            (kids.get(counted) or {}).get("values") == (None if declined else [n43, extra])
            and (kids.get(counted) or {}).get("claim") == claim,
            "show-item returns step, claim and values for each child",
        )
        moved = ask(
            "create-item",
            title="Moved",
            step="count",
            claim=claim,
            run=poured["rootId"],
            values=[n43, extra],
        )
        expect(moved["status"] == "completed", "a create for a move: %s" % moved.get("summary"))
        again = ask("show-item", id=moved["item"]["id"])["item"]
        expect(
            (again.get("step"), again.get("claim"), again.get("run"), again.get("values"))
            == ("count", claim, poured["rootId"], [n43, extra]),
            "create-item takes step, claim, run and values for a move",
        )
        under = ask("list-items", scope="all", run=poured["rootId"])
        expect(
            sorted(i["id"] for i in under.get("items") or [])
            == sorted([counted, filed, moved["item"]["id"]]),
            "list-items in a run answers the items poured in it, wherever each stands, "
            "and no other: %s" % under.get("summary"),
        )
        expect(
            ask("list-items", scope="all", run="").get("items") == [],
            "list-items in a run no item roots answers nothing, and never every item",
        )
        for step in (counted, filed):
            ask("close-item", id=step)
        held = ask("close-item", id=poured["rootId"])
        expect(
            held.get("status") == "blocked"
            and moved["item"]["id"] in (held.get("blockedBy") or []),
            "close-item refuses a root while an item poured in its run is open, wherever it "
            "stands, and names it: %s" % held.get("summary"),
        )
        expect(
            declined
            or ask("record-values", id=nowhere, values=[n42]).get("reason") == "item-not-found",
            "record-values on an id that does not exist is item-not-found",
        )

    for operation, body in (
        ("operation.open-tracker", open_tracker),
        ("operation.describe-tracker", describe),
        ("operation.create-item", create),
        ("operation.add-need", need),
        ("operation.show-item", show),
        ("operation.ready-items", ready),
        ("operation.close-item", close),
        ("operation.list-items", listing),
        ("operation.update-item", update),
        ("operation.pour-steps", pour),
        ("operation.record-values", claims),
    ):
        check(operation, body)
    return results


@contextlib.contextmanager
def candidate_registered(name: str) -> Iterator[None]:
    """The length of a check by path: what the file registers under this stem lasts
    that long. After it the adapter of that name and its module are back, a file that
    did not load counts against nothing, and nothing the file imported has left
    bytecode beside it."""
    tables: list[tuple[dict[str, Any], str]] = [
        (TRACKERS, name),
        (sys.modules, "dotdiw_tracker_" + name),
        (LOAD_FAILED, name),
    ]
    held = [(table, key, table.get(key)) for table, key in tables]
    tried, writes = name in LOAD_TRIED, sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        yield
    finally:
        sys.dont_write_bytecode = writes
        (LOAD_TRIED.add if tried else LOAD_TRIED.discard)(name)
        for table, key, value in held:
            if value is None:
                table.pop(key, None)
            else:
                table[key] = value


def CheckTracker(request: CheckTrackerRequest) -> CheckTrackerResponse:
    """step.check-tracker: the conformance scenario against the adapter's
    declared check target, one result per operation; never against live
    work. The target is the prefix the scenario opens its store under --
    the project a hosted tracker lets the check fill -- and the workspace
    it runs in is a scratch one under ~/.dotdiw, made for the run and
    removed after it; the shipped adapters' stores go with it. A file given
    by path is checked without being installed, under its stem, as it stands
    now, and registered for the length of the check. The check runs alone in
    its process (Gate): it changes, for its length, the working directory,
    the environment and the adapter registered under the name, which every
    request running in the process shares."""
    name, path = request["name"], request.get("path")
    registered: contextlib.AbstractContextManager[None] = contextlib.nullcontext()
    if path:
        if not re.fullmatch(TRACKER_NAME, name):
            return failed_as(CheckTrackerResponse, "bad-name", BAD_TRACKER_NAME % name)
        if name in TRACKERS and not is_loaded(TRACKERS[name]):
            return failed_as(CheckTrackerResponse, "shipped-name", SHIPPED_TRACKER_NAME % name)
        if not os.path.isfile(path):
            return failed_as(CheckTrackerResponse, "no-such-file", "%s is not a file." % path)
        registered = candidate_registered(name)
    with GATE.by_itself(), registered:
        if not (load_tracker(name, path) if path else name in TRACKERS or load_tracker(name)):
            return tracker_unknown(CheckTrackerResponse, name)
        described = invoke_tracker(
            "operation.describe-tracker", {"root": request.get("root"), "tracker": name}
        )
        if described.get("reason") == "not-installed":
            return failed_as(
                CheckTrackerResponse, "not-installed", described["summary"], described["exitCode"]
            )
        target = TRACKERS[name]["info"].get("checkTarget")
        if not target:
            return {
                "status": "failed",
                "reason": "no-check-target",
                "exitCode": 1,
                "summary": "%s declares no check target; the scenario runs against nothing unasked."
                % name,
            }
        key = "check-" + os.urandom(6).hex()
        ws = os.path.join(os.path.expanduser(DOTDIW_HOME), key)
        scratch, here = "", ""
        # A hook in a linked worktree runs with GIT_DIR exported, which would turn every
        # git call below on that checkout, whatever directory the call runs in. A
        # tracker's own binary reads the directory it runs in, so that moves as well.
        hidden = {
            k: os.environ.pop(k)
            for k in git(["rev-parse", "--local-env-vars"]).split()
            if k in os.environ
        }
        try:
            here = os.getcwd()
            scratch = tempfile.mkdtemp(prefix="%s-check-" % PROG)
            git(["init", "-q"], scratch)
            git(["config", "--local", WORKSPACE_KEY, key], scratch)
            os.makedirs(ws, exist_ok=True)
            os.chdir(scratch)
            results = conformance_scenario(
                lambda operation, **req: invoke_tracker(
                    "operation." + operation, dict(req, root=scratch, tracker=name)
                ),
                prefix=target,
            )
        except OSError as e:
            return {
                "status": "failed",
                "summary": "The check has nowhere to run: %s" % e,
                "exitCode": 1,
            }
        finally:
            os.environ.update(hidden)
            if here:
                os.chdir(here)
            forget_workspace(scratch)
            if scratch:
                shutil.rmtree(scratch, ignore_errors=True)
            shutil.rmtree(ws, ignore_errors=True)
        failed = [r for r in results if r["status"] != "pass"]
        return {
            "status": "completed" if not failed else "failed",
            "summary": "%s passed %d of %d." % (name, len(results) - len(failed), len(results))
            if not failed
            else "%s failed at %s: %s" % (name, failed[0]["operation"], failed[0].get("detail")),
            "results": results,
            "passed": not failed,
            "exitCode": 0 if not failed else 1,
        }


def MigrateWorkspace(request: MigrateWorkspaceRequest) -> MigrateWorkspaceResponse:
    """step.migrate-workspace: everything the source holds, written into the
    target -- open items first, then closed ones with their reasons, then
    the needs -- each item read whole, its description and its means handed
    over as given, and the source left as it was. Ids are asked for and kept
    where the target honours them. The record beside the stores says which
    items are made and which have nothing left to write, and is saved as
    each item is made, so a second run makes only what the record does not
    hold and finishes the needs, statuses and closes of those it holds
    unfinished. A target that refuses any of it stops the move, failed, with
    what it refused named; what was written stays, and the next run continues."""
    root, src, dst = request["root"], request["fromTracker"], request["toTracker"]
    if src == dst:
        return {
            "status": "failed",
            "reason": "same-tracker",
            "exitCode": 1,
            "summary": "%s is the source and the target both." % src,
        }
    for name in (src, dst):
        if not (name in TRACKERS or load_tracker(name)):
            return tracker_unknown(MigrateWorkspaceResponse, name)
    ws = workspace(root)
    if ws is None:
        return {
            "status": "failed",
            "summary": "This checkout has no workspace; init adopts it.",
            "exitCode": 1,
        }
    listed = invoke_tracker("operation.list-items", {"root": root, "tracker": src, "scope": "all"})
    if listed["status"] != "completed":
        return {
            "status": "failed",
            "summary": listed["summary"],
            "exitCode": 1,
            "reason": listed.get("reason")
            if listed.get("reason") in ("tracker-unknown", "adapter-failed")
            else None,
        }
    items = listed.get("items") or []
    opened = invoke_tracker("operation.open-tracker", {"root": root, "tracker": dst})
    if opened["status"] != "completed":
        return {
            "status": "failed",
            "summary": opened["summary"],
            "exitCode": 1,
            "reason": opened.get("reason")
            if opened.get("reason") in ("tracker-unknown", "adapter-failed")
            else None,
        }

    path = os.path.join(ws, "migration-%s-to-%s.json" % (src, dst))
    try:
        with open(path, encoding="utf-8") as fh:
            record = json.load(fh)
    except (OSError, ValueError):
        record = {"from": src, "to": dst, "ids": {}}
    ids = record.setdefault("ids", {})  # source id -> target id: the item is made there
    linked = record.setdefault("linked", [])  # [source id, source need]: the edge is there
    settled = record.setdefault("settled", [])  # source ids with nothing left to write
    unparented = record.setdefault("unparented", [])  # made before their parent: it is set after
    moved = 0

    def save() -> None:
        record["at"] = datetime.datetime.now(datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
        temporary = path + ".tmp"
        with open(temporary, "w", encoding="utf-8") as fh:
            json.dump(record, fh, indent=2, sort_keys=True)
            fh.write("\n")
        os.replace(temporary, path)  # a run that dies leaves the last whole record

    def refused(what: str, answer: Response) -> MigrateWorkspaceResponse:
        save()
        return {
            "status": "failed",
            "reason": "item-refused",
            "exitCode": 1,
            "summary": "%s refused %s: %s" % (dst, what, answer["summary"]),
            "moved": moved,
            "mapped": sum(1 for a, b in ids.items() if a != b),
            "mappingPath": path,
        }

    # Each item once, after its parent and after the root of the run it was
    # poured in, so that both new ids are known when it is written. Where the
    # two wait on each other -- a root moved under a step of its own run --
    # the item goes first and its parent is set once both are made; a run is
    # never cut, so runs that wait on each other stop the move before any
    # item is written.
    byid = {i["id"]: i for i in items}
    order: list[Any] = []
    placed: set[str] = set()

    def waits(item: Any, on: str) -> bool:
        return item.get(on) in byid and item.get(on) not in placed

    while len(order) < len(items):
        progress = False
        for item in items:
            if item["id"] in placed or waits(item, "parent") or waits(item, "run"):
                continue
            order.append(item)
            placed.add(item["id"])
            progress = True
        if not progress:
            left = [i for i in items if i["id"] not in placed]
            cut = [i for i in left if not waits(i, "run")]
            if not cut:
                stuck = sorted(i["id"] for i in left)
                return {
                    "status": "failed",
                    "exitCode": 1,
                    "summary": "The runs of %s wait on each other, so no item was written."
                    % ", ".join(stuck),
                    "moved": 0,
                    "mapped": sum(1 for a, b in ids.items() if a != b),
                    "mappingPath": path,
                }
            order.append(cut[0])
            placed.add(cut[0]["id"])
    for item in order:
        if item["id"] in ids:
            continue
        # list-items need not carry a description or the means; show-item does.
        shown = shown_by_its_id(
            item["id"],
            invoke_tracker("operation.show-item", {"root": root, "tracker": src, "id": item["id"]}),
        )
        if shown["status"] != "completed" or not shown.get("item"):
            save()
            return {
                "status": "failed",
                "reason": shown.get("reason")
                if shown.get("reason") in ("tracker-unknown", "adapter-failed")
                else None,
                "exitCode": 1,
                "summary": "%s could not show %s: %s" % (src, item["id"], shown["summary"]),
                "moved": moved,
                "mapped": sum(1 for a, b in ids.items() if a != b),
                "mappingPath": path,
            }
        whole = shown["item"]
        early = item.get("parent") in byid and item.get("parent") not in ids
        made = invoke_tracker(
            "operation.create-item",
            {
                "root": root,
                "tracker": dst,
                "id": item["id"],
                "title": item["title"],
                "priority": item.get("priority"),
                "parent": ids.get(item.get("parent")) if item.get("parent") else None,
                "description": whole.get("description"),
                "verifyUsing": list(whole.get("verifyUsing") or []) or None,
                "step": whole.get("step"),
                "claim": whole.get("claim"),
                "run": ids.get(whole["run"]) if whole.get("run") else None,
                "values": list(whole.get("values") or []) or None,
            },
        )
        if made["status"] != "completed" or not made.get("item"):
            return refused(item["id"], made)
        ids[item["id"]] = made["item"]["id"]
        if early:
            unparented.append(item["id"])
        moved += 1
        save()
    for ident in list(unparented):
        parent = (byid.get(ident) or {}).get("parent")
        if ident not in ids or parent not in ids:
            continue
        out = invoke_tracker(
            "operation.update-item",
            {"root": root, "tracker": dst, "id": ids[ident], "parent": ids[parent]},
        )
        if out["status"] != "completed":
            return refused("the parent of %s, %s" % (ident, parent), out)
        unparented.remove(ident)
        save()
    # Everything after the make, for every item not settled: this run's, and
    # any an earlier run made and could not finish. A write repeated after a
    # run died between it and the record changes nothing.
    unsettled = [i for i in order if i["id"] in ids and i["id"] not in settled]
    resumed = len(unsettled) - moved
    for item in unsettled:
        for need in item.get("needs") or []:
            if need in ids and [item["id"], need] not in linked:
                out = invoke_tracker(
                    "operation.add-need",
                    {"root": root, "tracker": dst, "id": ids[item["id"]], "needs": ids[need]},
                )
                if out["status"] != "completed":
                    return refused("the need of %s on %s" % (item["id"], need), out)
                linked.append([item["id"], need])
    for item in unsettled:
        if item.get("status") in ("in_progress", "blocked"):
            out = invoke_tracker(
                "operation.update-item",
                {"root": root, "tracker": dst, "id": ids[item["id"]], "status": item["status"]},
            )
            if out["status"] != "completed":
                return refused("status %s on %s" % (item["status"], item["id"]), out)
    # Closed ones close when their needs and children have, so in passes.
    left = [i for i in unsettled if i.get("status") == "closed"]
    while left:
        still, answers = [], {}
        for item in left:
            out = invoke_tracker(
                "operation.close-item",
                {
                    "root": root,
                    "tracker": dst,
                    "id": ids[item["id"]],
                    "closeReason": item.get("reason"),
                },
            )
            if out["status"] == "blocked":
                still.append(item)
                answers[item["id"]] = out
            elif out["status"] != "completed":
                return refused("the close of %s" % item["id"], out)
        if len(still) == len(left):
            return refused("the close of %s" % still[0]["id"], answers[still[0]["id"]])
        left = still
    settled.extend(i["id"] for i in unsettled)
    if unsettled:
        save()
    mapped = sum(1 for a, b in ids.items() if a != b)
    plural = "" if moved == 1 else "s"
    summary = "Moved %d item%s from %s to %s" % (moved, plural, src, dst)
    if resumed:
        finished = "%d item%s an earlier run left" % (resumed, "" if resumed == 1 else "s")
        summary = (
            "%s; finished %s" % (summary, finished)
            if moved
            else "Finished %s from %s to %s" % (finished, src, dst)
        )
    if mapped:
        summary += "; %d id%s mapped" % (mapped, "" if mapped == 1 else "s")
    return {
        "status": "completed",
        "summary": summary + ".",
        "moved": moved,
        "resumed": resumed,
        "mapped": mapped,
        "mappingPath": path if unsettled else None,
        "assigneesLeft": sum(1 for i in items if i.get("assignee")),
        "exitCode": 0,
    }


def ChooseATracker(request: ChooseATrackerRequest) -> ChooseATrackerResponse:
    """journey.choose-a-tracker: list, use or check, one step each."""
    root, action, name = request.get("root"), request["action"], request.get("name")
    if action == "list":
        out = invoke("operation.list-trackers", {"root": root})
        return {
            "status": out["status"],
            "summary": out["summary"],
            "trackers": out.get("trackers"),
            "chosen": out.get("chosen"),
            "exitCode": out["exitCode"],
        }
    if action == "use":
        out = invoke("operation.use-tracker", {"root": root, "name": name or ""})
        return {
            "status": out["status"],
            "summary": out["summary"],
            "chosen": out.get("name"),
            "reason": out.get("reason"),
            "exitCode": out["exitCode"],
        }
    out = invoke(
        "operation.check-tracker",
        {"root": root, "name": name or "", "path": request.get("path")},
    )
    return {
        "status": out["status"],
        "summary": out["summary"],
        "results": out.get("results"),
        "passed": out.get("passed"),
        "reason": out.get("reason"),
        "exitCode": out["exitCode"],
    }


def ShipATracker(request: ShipATrackerRequest) -> ShipATrackerResponse:
    """journey.ship-a-tracker: one step, the file."""
    out = invoke(
        "operation.write-tracker",
        {"name": request["name"], "directory": request.get("directory")},
    )
    return {
        "status": out["status"],
        "summary": out["summary"],
        "path": out.get("path"),
        "reason": out.get("reason"),
        "exitCode": out["exitCode"],
    }


def WriteTracker(request: WriteTrackerRequest) -> WriteTrackerResponse:
    """step.write-tracker: the file a tracker starts from, in the directory
    given or the current one. Nothing else is written, and a file that exists is
    left as it was."""
    name = request["name"]
    if not re.fullmatch(TRACKER_NAME, name):
        return failed_as(WriteTrackerResponse, "bad-name", BAD_TRACKER_NAME % name)
    if name in TRACKERS and not is_loaded(TRACKERS[name]):
        return failed_as(WriteTrackerResponse, "shipped-name", SHIPPED_TRACKER_NAME % name)
    path = os.path.join(request.get("directory") or os.getcwd(), name + ".py")
    try:
        with open(path, "x", encoding="utf-8") as fh:
            fh.write(TRACKER_SKELETON.replace("<NAME>", name))
    except FileExistsError:
        return failed_as(WriteTrackerResponse, "exists", "%s already exists." % path)
    except OSError as e:
        return failed_as(
            WriteTrackerResponse, "unwritable", "%s cannot be written: %s." % (path, e.strerror)
        )
    return {"status": "completed", "summary": "Wrote %s." % path, "path": path, "exitCode": 0}


def MoveAWorkspace(request: MoveAWorkspaceRequest) -> MoveAWorkspaceResponse:
    """journey.move-a-workspace: one step, the move."""
    out = invoke(
        "operation.migrate-workspace",
        {
            "root": request.get("root"),
            "fromTracker": request["fromTracker"],
            "toTracker": request["toTracker"],
        },
    )
    return {
        "status": out["status"],
        "summary": out["summary"],
        "moved": out.get("moved"),
        "resumed": out.get("resumed"),
        "mapped": out.get("mapped"),
        "mappingPath": out.get("mappingPath"),
        "assigneesLeft": out.get("assigneesLeft"),
        "reason": out.get("reason"),
        "exitCode": out["exitCode"],
    }


# ============================================================ the beads adapter
#
# The tracker that ships underneath, bd, as an adapter: the one place that
# names the binary, runs it, hands it its directory, turns its metrics off,
# and rewrites its name in what it prints. Every operation of the interface
# answers in records. Three of them -- open, create and pour -- run bd's own
# command with the worker's terminal when the request says the terminal is
# there, so that what a worker sees under this adapter is what bd prints,
# byte for byte, and the record is read from the stream. Two extras beyond
# the interface: forward, the pass-through of every command dotdiw does not
# own, and metrics-off. Nothing outside this section calls bd.

# bd ships with anonymous usage metrics on and asks nothing: the first run
# prints a notice and starts queueing the name of every command, keyed by a
# machine-derived ID, for gastownhall-eventsapi.com. The setting is per
# machine, in ~/.config/bd/config.yaml, so a tool that runs bd on somebody's
# behalf decides it for them by staying silent. This one decides: off.
#
# Read the file rather than ask bd. `bd metrics` is itself a bd command, and
# while metrics are on it queues an event for itself and flushes the queue;
# `bd metrics off` queues nothing. Both found by running them against an
# empty HOME and looking at ~/.beads/eventsData afterwards.
BD_CONFIG = "~/.config/bd/config.yaml"

# ~/.dotdiw/<key>/.beads is bd's directory for one checkout, told to bd
# through BEADS_DIR. bd's stealth mode is asked for, because it is what
# declines the sync remote; --skip-agents because the declaration dotdiw
# writes is the instruction surface and bd's files would only teach the
# second name.
BEADS_STORE = ".beads"
INIT_FLAGS = ("--stealth", "--skip-hooks", "--skip-agents")

# The two answers every operation here can give before bd runs.
BEADS_NOT_INSTALLED = ("not-installed", "beads is not installed. Run: brew install beads", 127)
BEADS_NO_WORKSPACE = ("no-workspace", "This checkout has no tracker; init adopts it.", 1)
BEADS_STATUSES = ("open", "in_progress", "blocked", "closed")
BEADS_NOT_FOUND = ("no issue found", "no issues found", "not found")
# bd's create and update flags that consume the next argument, so that the
# pass-through never reads a value as an option of its own.
BEADS_VALUE_FLAGS = {
    "--title",
    "-s",
    "-d",
    "--description",
    "-p",
    "--priority",
    "-t",
    "--type",
    "-a",
    "--assignee",
    "-l",
    "--label",
    "--labels",
    "--design",
    "--acceptance",
    "--notes",
    "--parent",
    "--estimate",
    "--status",
    "--due",
    "--repo",
    "--db",
    "--actor",
    "--external-id",
}
# The issue metadata the beads adapter keeps its own data under, and the file
# in the workspace that says a workspace poured into before 3.0.0 has had the
# means to prove its runs moved out of its descriptions and into that metadata.
BEADS_KEY = "dotdiw"
# The rows bd's list leaves out unless asked: an item made ephemeral, one of
# an infrastructure type, a gate. A listing that holds a run to its rules
# asks for them, or a step so made would stand open where no check sees it.
BEADS_EVERY_ROW = ("--include-ephemeral", "--include-infra", "--include-gates")
# What a listing that is no list of items is answered with: it says nothing
# of what it leaves out, so it is not read as holding none.
BEADS_NO_LISTING = "The tracker answered no list of items."
# The type a root has, by each name bd takes for it, whatever its case.
BEADS_ROOT_TYPES = ("molecule", "mol")
BEADS_MEANS_MOVED = "means-in-metadata"


def beads_find() -> str | None:
    return shutil.which("bd") or shutil.which("beads")


def beads_store(root: str | None) -> str | None:
    """bd's directory under this checkout's workspace, or None without a key."""
    ws = workspace(root) if root else None
    return os.path.join(ws, BEADS_STORE) if ws else None


def beads_env(root: str | None) -> str | None:
    """This checkout's store, which bd is told through BEADS_DIR, when the
    tracker was opened here; None when it never was. Nothing is set on the
    process: each run of bd is told it alone (beads_environment)."""
    store = beads_store(root)
    return store if store and os.path.isdir(store) else None


def beads_environment(
    root: str | None, session: str | None = None, store: str | None = None
) -> dict[str, str]:
    """The environment of one run of bd: the process's, with this checkout's
    store -- or the store given, for the init that makes it -- and the
    session a close runs under. Given to that run alone, never set on the
    process, whose environment every request running in it shares."""
    env = dict(os.environ)
    store = store or beads_env(root)
    if store:
        env["BEADS_DIR"] = store
    if session is not None:
        env["CLAUDE_SESSION_ID"] = session
    return env


def beads_metadata(row: dict[str, Any]) -> dict[str, Any]:
    """An issue's metadata as bd answers it, as a dict whatever its form."""
    held = row.get("metadata")
    if isinstance(held, str):
        try:
            held = json.loads(held)
        except ValueError:
            held = None
    return dict(held) if isinstance(held, dict) else {}


def beads_own(row: dict[str, Any]) -> dict[str, Any] | None:
    """What the adapter keeps in an issue's metadata under its own key: {}
    while the key is absent, or None where an earlier version left the key
    holding a value of the issue's own, null included, which the adapter
    leaves as it is and reads nothing from."""
    held = beads_metadata(row)
    if BEADS_KEY not in held:
        return {}
    own = held[BEADS_KEY]
    return dict(own) if isinstance(own, dict) else None


def beads_left_as_given(kept: list[str]) -> str:
    """The upgrade's line for the issues whose metadata holds dotdiw as a
    value of their own, which keep their descriptions as they were."""
    if len(kept) == 1:
        return (
            "%s keeps the means in its description, since its metadata holds dotdiw as a "
            "value of its own" % kept[0]
        )
    return (
        "%s and %s keep the means in their descriptions, since their metadata holds dotdiw "
        "as a value of their own" % (", ".join(kept[:-1]), kept[-1])
    )


def beads_means(row: dict[str, Any], means: list[str], moved: bool = False) -> str:
    """The issue's metadata with the means to prove a run kept under the
    adapter's own key, everything else in it as it was, as bd takes it; with
    moved, the mark that the upgrade has moved them out of its description.
    The upgrade hands it no issue whose key holds a value of its own."""
    held = beads_metadata(row)
    mine = dict(held.get(BEADS_KEY) or {})
    if moved:
        mine["meansMoved"] = True
    if means:
        mine["verifyUsing"] = list(means)
    else:
        mine.pop("verifyUsing", None)
    if mine:
        held[BEADS_KEY] = mine
    else:
        held.pop(BEADS_KEY, None)
    return json.dumps(held, ensure_ascii=False)


def beads_quiet(
    args: list[str],
    root: str | None = None,
    session: str | None = None,
    store: str | None = None,
) -> tuple[int, str, str]:
    """Run bd for its output only, nothing printed: exit code, stdout, stderr."""
    bd = beads_find()
    if not bd:
        return 127, "", ""
    env = beads_environment(root, session, store)
    p = subprocess.run([bd] + list(args), capture_output=True, text=True, env=env)
    return p.returncode, p.stdout, p.stderr


def beads_batch(lines: list[list[str]], root: str | None) -> tuple[int, str, str]:
    """bd's batch: the writes given, each a line of words, in one
    transaction, all of them or none. It reads each id whole: one bd holds
    nothing of is not found and nothing is written, where bd's other
    commands read it as the one item whose id begins with it (beads_holds),
    and write that one. The batch reads a line by its words, so a word that
    would not stand as one -- empty, holding a space, a quote or a
    backslash, or opening a comment -- is no id bd holds, and nothing is
    written: a line cannot carry a second write in an id."""
    for words in lines:
        for word in words:
            if not re.fullmatch(r'[^\s"\\#][^\s"\\]*', word):
                return 1, "", "no issue found: %s" % json.dumps(word)
    fd, path = tempfile.mkstemp(prefix="%s-" % PROG, suffix=".batch")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write("".join(" ".join(words) + "\n" for words in lines))
        return beads_quiet(["batch", "--json", "-f", path], root)
    finally:
        os.unlink(path)


def beads_left_out(rows: list[dict[str, Any]], root: str | None) -> str | None:
    """What a listing of every item leaves out, by bd's own account, not the
    listing's: an item of a run, or the root of the run a listed item names;
    either one bd holds, or does not say it holds no more (beads_shown,
    beads_holds). bd's query, which is no listing, answers every item bd
    holds, and each is read as an item of a run three ways at once, so that
    an edit of any leaves the others: by BEADS_RUN_LABEL, which the create
    that made it gave it, wherever it stands; by the run its own metadata
    names under the adapter's key, which the create gave it too, and which
    bd's own commands that edit labels, parents and fields leave as it is;
    and by id, every item whose id runs on from that of a root listed or of
    a run an item names, as bd makes the id of each item under another -- a
    step's from its root's -- and keeps it wherever the item is moved, and
    whatever its labels. A root of a run is one too. None where each is
    listed or held no more; else the sentence naming the first left out, or
    saying that bd's query could not be read."""
    listed = {str(r.get("id")) for r in rows}
    code, out, err = beads_quiet(["query", 'id="*"', "--all", "-n", "0", "--json"], root)
    found = beads_rows(out) if code == 0 else None
    if found is None:
        said = (
            beads_failed(ListItemsResponse, out, err, [])["summary"] if code else BEADS_NO_LISTING
        )
        return "The tracker could not say which items its runs hold: %s" % said
    runs = {str(r.get("id")) for r in rows if r.get("issue_type") == "molecule"}
    runs |= {
        str(n)
        for n in ((beads_own(r) or {}).get("run") for r in list(rows) + found)
        if isinstance(n, str)
    }

    def in_a_run(row: dict[str, Any]) -> bool:
        ident = str(row.get("id"))
        return (
            BEADS_RUN_LABEL in (row.get("labels") or [])
            or isinstance((beads_own(row) or {}).get("run"), str)
            or ident in runs
            or any(ident.startswith(n + ".") for n in runs)
        )

    for f in found:
        other = str(f["id"])
        if other in listed or not in_a_run(f):
            continue
        shown = beads_shown([other], root)
        if shown is None or other in shown:
            run = (beads_own((shown or {}).get(other) or {}) or {}).get("run")
            return "The tracker's list of every item leaves out %s, which it holds%s." % (
                other,
                " in a run with %s" % run if isinstance(run, str) else "",
            )
    for r in rows:
        run = (beads_own(r) or {}).get("run")
        if isinstance(run, str) and run not in listed and beads_holds(run, root) is not False:
            return (
                "The tracker's list of every item leaves out %s, which it holds in a run with %s."
                % (
                    run,
                    r.get("id"),
                )
            )
    return None


def beads_partial(buf: bytes) -> tuple[bytes, bytes]:
    """Split off a short alphanumeric tail that may be half of a split token."""
    i, n = len(buf), 0
    while i > 0 and chr(buf[i - 1]).isalnum() and n < 3:
        i -= 1
        n += 1
    return buf[:i], buf[i:]


def beads_terminal(
    args: list[str], root: str | None = None, session: str | None = None
) -> tuple[int, str]:
    """Run bd with the worker's terminal, its name rewritten in every byte of
    output on the way out; through a pty when the terminal is interactive, so
    prompts still work. Returns the exit code and the rewritten text that
    went past, for the record to be read from."""
    bd = beads_find()
    if not bd:
        return 127, ""
    env = beads_environment(root, session)
    argv = [bd] + list(args)

    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        p = subprocess.run(argv, capture_output=True, text=True, env=env)
        out, err = _BD_WORD.sub(PROG, p.stdout), _BD_WORD.sub(PROG, p.stderr)
        sys.stdout.write(out)
        sys.stdout.flush()
        sys.stderr.write(err)
        sys.stderr.flush()
        return p.returncode, out + err

    import pty

    carry = bytearray()
    seen = bytearray()

    def reader(fd: int) -> bytes:
        data = os.read(fd, 4096)
        if not data:
            out = _BD_WORD_B.sub(PROG.encode(), bytes(carry))
            del carry[:]
            seen.extend(out)
            return out
        carry.extend(data)
        head, tail = beads_partial(bytes(carry))
        del carry[:]
        carry.extend(tail)
        out = _BD_WORD_B.sub(PROG.encode(), head)
        seen.extend(out)
        return out

    # A pty's child runs with the process's environment, so what this run
    # alone is told goes before bd, through env.
    told = ["%s=%s" % (k, v) for k, v in env.items() if os.environ.get(k) != v]
    code = os.waitstatus_to_exitcode(pty.spawn(["/usr/bin/env", *told, *argv], reader))
    return code, bytes(seen).decode("utf-8", "replace")


def beads_run(
    args: list[str], root: str | None, terminal: bool, session: str | None = None
) -> tuple[int, str, str]:
    """bd with the terminal when the request has one, quietly otherwise:
    exit code, output, and what stderr held when it was kept apart."""
    if terminal:
        code, out = beads_terminal(args, root, session=session)
        return code, out, ""
    return beads_quiet(args, root, session=session)


def beads_json(text: str | None) -> list[dict[str, Any]]:
    """The rows a bd --json answer holds, or [] when it is not JSON."""
    try:
        rows = json.loads(text or "[]")
    except ValueError:
        return []
    if isinstance(rows, dict):
        rows = [rows]
    return [r for r in rows if isinstance(r, dict)]


def beads_rows(text: str | None) -> list[dict[str, Any]] | None:
    """The rows of a bd --json listing: a list of issues, each with its id,
    and an empty list where there are none. None where the answer is
    anything else -- nothing, no JSON, one object, a row that is no issue --
    since a listing that cannot be read whole says nothing of what it leaves
    out, and what it leaves out would be taken for not there."""
    try:
        rows = json.loads(text or "")
    except ValueError:
        return None
    if not isinstance(rows, list) or not all(isinstance(r, dict) and r.get("id") for r in rows):
        return None
    return rows


def beads_record(row: dict[str, Any]) -> TrackerItem:
    """A bd issue as the interface's record. bd's list and show name an
    edge's type differently; both are read."""
    status = row.get("status")
    needs = [
        d.get("depends_on_id") or d.get("id")
        for d in row.get("dependencies") or []
        if (d.get("type") or d.get("dependency_type")) == "blocks"
    ]
    item: TrackerItem = {
        "id": str(row.get("id")),
        "title": str(row.get("title") or ""),
        "kind": "root" if row.get("issue_type") == "molecule" else "task",
        "status": status if status in BEADS_STATUSES else "open",
        "priority": row.get("priority"),
        "parent": row.get("parent"),
        "assignee": row.get("assignee"),
        "reason": row.get("close_reason"),
        "needs": [n for n in needs if n],
        "createdAt": row.get("created_at"),
        "updatedAt": row.get("updated_at"),
    }
    if row.get("description") is not None:
        item["description"] = row["description"]
    means = (beads_own(row) or {}).get("verifyUsing")
    if isinstance(means, list) and means:
        item["verifyUsing"] = [str(m) for m in means]
    own = beads_own(row) or {}
    if isinstance(own.get("step"), str):
        item["step"] = own["step"]
    if isinstance(own.get("claim"), dict):
        item["claim"] = own["claim"]
    if isinstance(own.get("run"), str):
        item["run"] = own["run"]
    kept = beads_values(row)
    if kept:
        item["values"] = [{"label": label, "text": text} for _, label, text in kept]
    return item


# Each claim value under a metadata key of its own, so that one value is
# never read as part of another. bd's keys take no hyphen and a label takes
# no underscore, so each hyphen becomes one. Under beads only a create
# writes values -- for a move, onto the item it makes -- since no write of
# bd's that reads an id whole sets one (beads_record_values).
BEADS_VALUE = "dotdiw_value."

# Every item poured into a run, or moved into one, carries this label, given
# by the bd create that makes it, so that one write makes it and keeps it in
# the run; bd's query for the label, which is no listing, then answers every
# item of every run, wherever each stands (beads_left_out). It is no edge, so
# it leaves every edge between a root and an item of its run free.
BEADS_RUN_LABEL = "dotdiw-run"


def beads_values(row: dict[str, Any]) -> list[tuple[int, str, str]]:
    """The claim values an issue's metadata keeps: the order each was first
    recorded in, its label and its text, in that order."""
    kept = []
    for key, held in beads_metadata(row).items():
        if not key.startswith(BEADS_VALUE):
            continue
        try:
            value = json.loads(held) if isinstance(held, str) else held
        except ValueError:
            continue
        if isinstance(value, dict) and isinstance(value.get("text"), str) and value["text"]:
            label = key[len(BEADS_VALUE) :].replace("_", "-")
            kept.append((int(value.get("first") or 0), label, value["text"]))
    return sorted(kept)


def beads_failed(
    shape: type[R], out: str, err: str, reasons: list[tuple[str, tuple[str, ...]]]
) -> R:
    """A failed response from what bd said, with the reason its words name:
    an id it found no issue for, a cycle, a status it does not have. bd
    asked for JSON says why in a JSON object, on stdout or, as its batch
    does, at the head of stderr; that object's error is what it said."""
    text = _BD_WORD.sub(PROG, (err or "") + (out or ""))
    said = beads_json(out)
    if not said and (err or "").lstrip().startswith("{"):
        try:
            head = json.JSONDecoder().raw_decode((err or "").lstrip())[0]
        except ValueError:
            head = None
        said = [head] if isinstance(head, dict) else []
    first = str(said[0].get("error") or "") if said else ""
    first = _BD_WORD.sub(PROG, first) or (
        text.strip().split("\n")[0] if text.strip() else "The tracker refused."
    )
    reason = None
    for key, words in reasons:
        if any(w in text for w in words):
            reason = key
            break
    return failed_as(shape, reason, first)


def beads_open(request: OpenTrackerRequest) -> OpenTrackerResponse:
    """operation.open-tracker: bd init in its stealth mode, under the key.

    A second open changes nothing.
    Where an earlier version's tracker sits in the tree, its prefix is kept,
    so that the ids the project is used to read on; nothing else of it is
    read. bd makes its directory itself and requires the workspace above it
    to exist, which the body that opens the tracker made.
    """
    if not beads_find():
        return failed_as(OpenTrackerResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    store = beads_store(root)
    if store is None:
        return failed_as(OpenTrackerResponse, *BEADS_NO_WORKSPACE)
    if os.path.isdir(store):
        return {
            "status": "completed",
            "summary": "Already open.",
            "path": store,
            "created": False,
            "exitCode": 0,
        }
    prefix = request.get("prefix")
    if not prefix and root:
        try:
            with open(os.path.join(root, BEADS_STORE, "metadata.json"), encoding="utf-8") as fh:
                prefix = str(json.load(fh).get("dolt_database") or "").strip() or None
        except (OSError, ValueError):
            prefix = None
    code, _, _ = beads_quiet(
        ["init", *INIT_FLAGS] + (["--prefix", prefix] if prefix else []), root, store=store
    )
    if code != 0:
        return {
            "status": "failed",
            "reason": "store-unwritable",
            "exitCode": code,
            "summary": "The tracker's init exited %d." % code,
        }
    beads_moved(store)
    return {
        "status": "completed",
        "summary": "Opened under %s." % store,
        "path": store,
        "created": True,
        "exitCode": 0,
    }


def beads_actor(root: str | None) -> TrackerActor | None:
    """Who bd records: $BEADS_ACTOR, git's user.name or $USER, in that order.
    Anyone can give any of them, so it is not verified."""
    name = (
        os.environ.get("BEADS_ACTOR")
        or git(["config", "user.name"], root).strip()
        or os.environ.get("USER")
    )
    return {"name": name, "verified": False} if name else None


def beads_typed(args: list[str], root: str | None) -> tuple[list[str], str | None]:
    """The arguments as typed, read option by option so that a value is never
    taken for an option: an assignee of me as the name bd records, where bd
    itself would keep the word. With them, why they are refused, never: the
    type a root has is refused before, read as bd reads it."""
    out = list(args)
    i = 0
    while i < len(out):
        a = out[i]
        if a.startswith("-") and "=" in a:
            flag, value = a.split("=", 1)
            at = i
        elif a in BEADS_VALUE_FLAGS and i + 1 < len(out):
            flag, value = a, out[i + 1]
            at = i + 1
        else:
            i += 1
            continue
        if flag in ("-a", "--assignee") and value == "me":
            actor = beads_actor(root)
            value = actor["name"] if actor else value
        out[at] = flag + "=" + value if at == i else value
        i = at + 1
    return out, None


def beads_describe(request: DescribeTrackerRequest) -> DescribeTrackerResponse:
    """operation.describe-tracker: what this adapter is, and bd's own version."""
    if not beads_find():
        return failed_as(DescribeTrackerResponse, *BEADS_NOT_INSTALLED)
    _, out, _ = beads_quiet(["--version"])
    number = re.search(r"\d+(?:\.\d+)+", out)
    store = beads_store(request.get("root"))
    return {
        "status": "completed",
        "summary": "The tracker underneath, through its adapter.",
        "info": {
            "name": "beads",
            "version": number.group(0) if number else "unknown",
            "origin": "shipped",
            "nativeNeeds": True,
            "checkTarget": "scratch",
            "extras": ["forward", "metrics-off", "upgrade", "read"],
        },
        "actor": beads_actor(request.get("root")),
        "path": store if store and os.path.isdir(store) else None,
        "exitCode": 0,
    }


def beads_create(request: CreateItemRequest) -> CreateItemResponse:
    """operation.create-item: bd create, from the fields given, and bd's JSON
    answer read as the record. One made in a run carries the label of every
    item of a run (BEADS_RUN_LABEL), given in that one create, so that
    nothing is left to write once the item is made."""
    if not beads_find():
        return failed_as(CreateItemResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(CreateItemResponse, *BEADS_NO_WORKSPACE)
    argv = [
        "create",
        "--title=" + request["title"],
        "--type=task",
        "--priority=%s" % (2 if request.get("priority") is None else request["priority"]),
        "--json",
    ]
    parent = request.get("parent")
    description = request.get("description")
    means = list(request.get("verifyUsing") or [])
    moved = {k: request[k] for k in ("step", "claim", "run") if request.get(k)}
    values = list(request.get("values") or [])
    if parent:
        argv += ["--parent=" + parent]
    if description:
        argv += ["--description=" + description]
    if means or moved or values:
        given: dict[str, Any] = {
            BEADS_VALUE + v["label"].replace("-", "_"): json.dumps(
                {"text": v["text"], "first": n}, ensure_ascii=False
            )
            for n, v in enumerate(values)
        }
        given[BEADS_KEY] = moved
        argv += ["--metadata=" + beads_means({"metadata": given}, means)]
    if moved.get("run"):
        argv += ["--labels=" + BEADS_RUN_LABEL]
    code, out, err = beads_quiet(argv, root)
    if code != 0:
        return beads_failed(CreateItemResponse, out, err, [("parent-not-found", ("parent issue",))])
    rows = beads_json(out)
    if not rows:
        return {"status": "failed", "exitCode": 1, "summary": "The tracker answered no record."}
    item = beads_record(rows[0])
    if request.get("parent") and not item.get("parent"):
        item["parent"] = request["parent"]  # bd's create answers without it
    return {
        "status": "completed",
        "summary": "Created %s." % item["id"],
        "item": item,
        "exitCode": 0,
    }


def beads_need(request: AddNeedRequest) -> AddNeedResponse:
    """operation.add-need: a blocks edge, written through bd's batch, which
    reads both ids whole (beads_batch): bd's dep add reads an id it holds
    nothing of as the one item whose id begins with it -- a deleted root's
    as its only step's -- and would give that one the need. An edge already
    there is written again as nothing, and bd refuses a cycle."""
    if not beads_find():
        return failed_as(AddNeedResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(AddNeedResponse, *BEADS_NO_WORKSPACE)
    code, out, err = beads_batch([["dep", "add", request["id"], request["needs"]]], root)
    if code != 0:
        return beads_failed(
            AddNeedResponse, out, err, [("cycle", ("cycle",)), ("item-not-found", BEADS_NOT_FOUND)]
        )
    return {
        "status": "completed",
        "summary": "%s needs %s." % (request["id"], request["needs"]),
        "edge": {"id": request["id"], "needs": request["needs"]},
        "exitCode": 0,
    }


def beads_pour(request: PourStepsRequest) -> PourStepsResponse:
    """operation.pour-steps: a root and one issue per step, each made with bd
    create in the order the needs allow and blocked by the steps it needs, as
    the local adapter pours; the step ids in the formula's order. The root
    keeps the formula's description, and the means to prove its run in its
    metadata. Each step names the run in its own metadata and carries the
    label of every item of a run (BEADS_RUN_LABEL), both in the create that
    makes it. A pour that fails after making its root names the root and the
    steps it made."""
    if not beads_find():
        return failed_as(PourStepsResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(PourStepsResponse, *BEADS_NO_WORKSPACE)
    steps = list(request.get("steps") or [])
    if not steps:
        return {
            "status": "failed",
            "reason": "no-steps",
            "exitCode": 1,
            "summary": "No steps to pour.",
        }
    shared = shared_step_id(steps)
    if shared is not None:
        return {
            "status": "failed",
            "reason": "duplicate-step",
            "exitCode": 1,
            "summary": "Two steps share the id %s, so nothing was poured." % shared,
        }
    try:
        ordered = steps_in_order(steps)
    except LookupError as e:
        return {"status": "failed", "reason": "step-not-found", "exitCode": 1, "summary": str(e)}
    except ValueError as e:
        return {"status": "failed", "reason": "cycle", "exitCode": 1, "summary": str(e)}
    argv = ["create", "--title=" + request["title"], "--type=molecule", "--priority=2", "--json"]
    description = request.get("description")
    means = list(request.get("verifyUsing") or [])
    if description:
        argv += ["--description=" + description]
    if means:
        argv += ["--metadata=" + beads_means({}, means)]
    code, out, err = beads_quiet(argv, root)
    rows = beads_json(out) if code == 0 else []
    if not rows:
        return beads_failed(PourStepsResponse, out, err, [])
    root_id = str(rows[0].get("id"))
    ids: dict[str, str] = {}
    for s in ordered:
        argv = ["create", "--title=" + s["title"], "--parent=" + root_id, "--type=task", "--json"]
        poured: dict[str, Any] = {"step": s["id"], "run": root_id}
        if s.get("claim"):
            poured["claim"] = s["claim"]
        argv += ["--metadata=" + json.dumps({BEADS_KEY: poured}, ensure_ascii=False)]
        argv += ["--labels=" + BEADS_RUN_LABEL]
        needs = list(s.get("needs") or [])
        if needs:
            argv += ["--deps=" + ",".join("blocked-by:%s" % ids[n] for n in needs)]
        code, out, err = beads_quiet(argv, root)
        rows = beads_json(out) if code == 0 else []
        if not rows:
            said = " ".join((err or out).split())[:240] or "the tracker exited %d" % code
            return {
                "status": "failed",
                "reason": "adapter-failed",
                "exitCode": 1,
                "rootId": root_id,
                "stepIds": [ids[x["id"]] for x in steps if x["id"] in ids],
                "summary": "Poured %d of %d steps under %s%s, and the next failed: %s"
                % (
                    len(ids),
                    len(steps),
                    root_id,
                    " (%s)" % ", ".join(ids[x["id"]] for x in steps if x["id"] in ids)
                    if ids
                    else "",
                    said,
                ),
            }
        ids[s["id"]] = str(rows[0].get("id"))
    return {
        "status": "completed",
        "summary": "Poured %d steps under %s." % (len(ids), root_id),
        "rootId": root_id,
        "stepIds": [ids[s["id"]] for s in steps],
        "exitCode": 0,
    }


def beads_close(request: CloseItemRequest) -> CloseItemResponse:
    """operation.close-item: bd close with the reason, held to the run rule
    before it runs and after it (held_to_the_run).

    bd knows no run, and closes a molecule of its own accord when its last
    child closes. So every item is listed first, and the close is refused
    while an open item poured in the one named stands open, wherever it
    stands; bd itself refuses while an open need or an open child exists,
    and the ids it names come back. The id is read as bd reads it, a short
    one as the full one, since bd keeps a run by the full id; the full id is
    the one named. Save where bd shows an item whose id runs on past the one
    given (shown_for_a_word): bd holds nothing by that id, and reads it as
    another item's, so nothing is closed. A listing that leaves out the item
    named is not every item, and nothing is closed on its word.

    The close runs under a session of its own, which bd keeps on what it
    closes. After it every item is listed again, and that listing is every
    item only where it holds each one listed before that bd still holds
    (beads_holds); one another deleted as the close ran is no gap. What
    carries the session is what this close closed: the item, and any root
    that stood open before and stands closed now. An item closed already is
    named as closed already, not as closed by this close, and bd's close is
    not run for it again.

    bd's close holds its own rule in the write that closes, and no write of
    bd's that holds that rule reads an id whole: it reads an id it holds
    nothing of as the one item whose id begins with it -- a deleted root's
    as its only step's -- and closes that one. So an item deleted between
    the read and bd's close may have another closed in its place. Any
    other item bd's close printed is read back too, and one that carries
    the session is named as closed by this close, and as closed in the
    place of the item named, which the tracker holds no more; the close
    fails. A write held to the item read is the tracker's to give.

    What bd's close did is read from the tracker, not from how it exited.
    Only a refusal bd gives its reason for -- what blocks the item, or no
    such item -- is answered as it stands, nothing having closed. Any other
    error is followed by the same listing, the same session read back and
    the same rule, and the close fails with bd's words, naming what it
    closed. And where bd answers without an error and the item stands open
    after it, the close fails saying so.

    Then the rule is held of the items as they stand, whatever stood above
    the item when it was first read, and on every path -- the item closed
    already or not, the session read back or not: what stands closed
    against the rule is opened again, and a root this close closed with
    nothing of its run open is named after the item. Where the item named
    is opened again the close is blocked by what it waits on; where the
    items or the session cannot be read back after the close, or one will
    not open again, it fails, naming what it closed, and why. So it does
    where bd holds the item named no more after the close, another having
    deleted it: nothing of that item is read back or named as closed, and
    the rule is held of the rest."""
    if not beads_find():
        return failed_as(CloseItemResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(CloseItemResponse, *BEADS_NO_WORKSPACE)
    code, out, err = beads_quiet(["show", request["id"], "--json"], root)
    found = beads_json(out) if code == 0 else []
    if not found:
        return beads_failed(CloseItemResponse, out, err, [("item-not-found", BEADS_NOT_FOUND)])
    whole = shown_for_a_word(request["id"], {"status": "completed", "item": found[0]})
    if whole["status"] != "completed":
        return failed_as(CloseItemResponse, "item-not-found", whole["summary"])
    ident = str(found[0].get("id"))
    listed = beads_list({"root": root, "scope": "all"})
    if listed["status"] != "completed":
        return failed_as(CloseItemResponse, "adapter-failed", listed["summary"])
    every: dict[str, TrackerItem] = {i["id"]: i for i in listed.get("items") or []}
    if ident not in every:
        return failed_as(
            CloseItemResponse,
            "adapter-failed",
            "Nothing closed: the tracker shows %s, and its list of every item leaves it out, "
            "so what a close of it waits on could not be read." % ident,
        )
    before = {i: o for i, o in every.items() if o.get("status") != "closed"}
    # Closed already: bd's close is not run, and the items stand as listed.
    now = every
    item: TrackerItem | None = beads_record(found[0])
    marked: list[str] | None = []
    # What bd said of a close it failed without a reason, first in the answer.
    said: list[str] = []
    errored = left_open = gone = False
    # Any other item bd's close printed: one it closed in the place of the
    # item named, deleted between the read and the close.
    instead: list[str] = []
    unread = (
        "%s could not be read back after the close, so whether this close closed it is not "
        "known." % ident
    )
    if ident in before:
        poured = [i for i, o in before.items() if o.get("run") == ident]
        if poured:
            return {
                "status": "blocked",
                "reason": "blocked",
                "blockedBy": poured,
                "exitCode": 1,
                "summary": "%s is blocked by %s." % (ident, ", ".join(poured)),
            }
        argv = ["close", ident, "--json"]
        reason = request.get("closeReason")
        if reason:
            argv += ["--reason", reason]
        session = beads_session(os.environ.get("CLAUDE_SESSION_ID"))
        code, out, err = beads_quiet(argv, root, session=session)
        printed: list[dict[str, Any]] = []
        if code == 0:
            rows_printed = beads_rows(out) or []
            printed = [r for r in rows_printed if r.get("id") == ident]
            instead = [str(r["id"]) for r in rows_printed if r.get("id") not in (None, ident)]
        else:
            m = re.search(r"blocked by \[(.*?)\]", out + err)
            if m:
                blocked = [x.strip() for x in m.group(1).split(",") if x.strip()]
            else:
                # bd names no child it refuses over; those listed open under
                # the item are they, unless one was made since.
                blocked = [i for i, o in before.items() if o.get("parent") == ident]
            if blocked and (m or "open child" in out + err):
                return {
                    "status": "blocked",
                    "reason": "blocked",
                    "blockedBy": blocked,
                    "exitCode": 1,
                    "summary": "%s is blocked by %s." % (ident, ", ".join(blocked)),
                }
            refused = beads_failed(
                CloseItemResponse,
                out,
                err,
                [("item-not-found", BEADS_NOT_FOUND), ("blocked", ("open child", "blocked by"))],
            )
            if refused.get("reason"):
                return refused
            # An error that names no refusal does not say that nothing closed.
            errored = True
            said.append(str(refused["summary"]))
        listed = beads_list({"root": root, "scope": "all"})
        if listed["status"] != "completed":
            return failed_as(
                CloseItemResponse,
                "adapter-failed",
                " ".join(said + [unread, str(listed["summary"])]),
            )
        now = {i["id"]: i for i in listed.get("items") or []}
        for absent in [i for i in every if i not in now]:
            if beads_holds(absent, root) is not False:
                return failed_as(
                    CloseItemResponse,
                    "adapter-failed",
                    " ".join(said + [unread])
                    + " The tracker's list of every item leaves out %s, which it listed before."
                    % absent,
                )
        # What may carry the session: the item, any other bd's close printed,
        # and each root that stood open before and stands closed now. One bd
        # holds no more has no row.
        rows = beads_shown(
            list(
                dict.fromkeys(
                    ([ident] if ident in now else [])
                    + [i for i in instead if i in now and i in before]
                    + [
                        i
                        for i, o in before.items()
                        if i != ident
                        and o.get("kind") == "root"
                        and i in now
                        and now[i].get("status") == "closed"
                    ]
                )
            ),
            root,
        )
        marked = None if rows is None else beads_marked(rows, session)
        gone = ident not in now or (rows is not None and ident not in rows)
        if gone:
            # The item named, deleted since bd's close ran: nothing of it is
            # read back, and it is no item as they stand now, listed or not.
            now = {i: o for i, o in now.items() if i != ident}
            item = None
        else:
            left_open = now[ident].get("status") != "closed"
            # The record as bd's close printed it, or as listed after the close.
            item = beads_record(printed[0]) if printed and not left_open else now[ident]
    unopened: list[str] = []

    def reopen(one: str, status: str) -> str | None:
        # A status written and nothing else: it gives the item the status
        # it had, and clears the session its close kept. Written to the id
        # read whole, so one deleted meanwhile opens no other item.
        code, out, err = beads_to_status(one, status, root)
        if code == 0:
            return None
        unopened.append(one)
        return str(beads_failed(UpdateItemResponse, out, err, [])["summary"])

    closed, notes, standing = held_to_the_run([ident], marked or [], before, now, reopen)
    if left_open:
        if not errored:
            said.append(
                "The tracker answered the close without an error, and %s stands open." % ident
            )
    elif gone:
        said.append("%s The tracker holds it no more." % unread)
        taken = [i for i in instead if i in (marked or [])]
        if taken:
            said.append("The tracker closed %s in its place." % ", ".join(taken))
    elif marked is None:
        said.append(unread)
    elif ident not in closed and ident not in standing:
        # Closed by another close: bd keeps the session of the first.
        said.append("%s was closed already." % ident)
    if closed:
        said.append("Closed %s." % ", ".join(closed))
    said += [str(n["summary"]) for n in notes]
    answer: CloseItemResponse = {
        "status": "completed",
        "summary": " ".join(said),
        "closedIds": closed,
        "exitCode": 0,
    }
    held = [n for n in notes if n["status"] == "blocked"]
    if errored or left_open or gone or marked is None or unopened:
        answer["status"], answer["reason"], answer["exitCode"] = "failed", "adapter-failed", 1
    elif held:
        # The item named, opened again: what it waits on blocks its close.
        answer["status"], answer["reason"], answer["exitCode"] = "blocked", "blocked", 1
        answer["blockedBy"] = held[0]["blockedBy"]
    if answer["status"] != "blocked" and item is not None:
        answer["item"] = item
    return answer


def beads_show(request: ShowItemRequest) -> ShowItemResponse:
    """operation.show-item: the record and its children, the id read as bd
    reads it, a short one as the full one, for both. The children are a
    listing of bd's: what it prints there that is no list of issues fails
    the read, and is not an item with no children."""
    if not beads_find():
        return failed_as(ShowItemResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(ShowItemResponse, *BEADS_NO_WORKSPACE)
    code, out, err = beads_quiet(["show", request["id"], "--json"], root)
    rows = beads_json(out) if code == 0 else []
    if not rows:
        return beads_failed(ShowItemResponse, out, err, [("item-not-found", BEADS_NOT_FOUND)])
    ident = str(rows[0].get("id"))
    code, listing, err = beads_quiet(
        ["list", "--all", "--json", "--brief", "-n", "0", *BEADS_EVERY_ROW, "--parent", ident],
        root,
    )
    if code != 0:
        return beads_failed(ShowItemResponse, listing, err, [])
    children = beads_rows(listing)
    if children is None:
        return failed_as(ShowItemResponse, "adapter-failed", BEADS_NO_LISTING)
    return {
        "status": "completed",
        "summary": "Showed %s." % ident,
        "item": beads_record(rows[0]),
        "children": [beads_record(r) for r in children],
        "exitCode": 0,
    }


def beads_list(request: ListItemsRequest) -> ListItemsResponse:
    """operation.list-items: the open items, or all of them, perhaps under a
    parent or in a run -- every row, those bd's list leaves out unless asked
    included, and a parent read as bd's show reads it. bd filters no key
    nested in the metadata, where the run is kept, so a run is listed whole
    and kept here, and limited after.

    A listing is answered whole or not at all, since what it leaves out is
    taken for not there: what bd prints that is no list of issues, each with
    its id, fails it, and so does a parent bd could not show -- under the id
    as given bd lists nothing. A parent bd holds no more has no children.
    And a listing of every item, under no parent and unlimited, that leaves
    out an item of a run whose root it lists, or the root of a run an item
    it lists is in, is not every item, and fails (beads_left_out)."""
    if not beads_find():
        return failed_as(ListItemsResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(ListItemsResponse, *BEADS_NO_WORKSPACE)
    run, limit = request.get("run"), request.get("limit") or 0
    argv = ["list", "--json", "--brief", "-n", "0" if run is not None else str(limit)]
    argv += BEADS_EVERY_ROW
    if request.get("scope") == "all":
        argv.append("--all")
    parent = request.get("parent")
    if parent:
        # bd's list reads no short id for a parent, as its show does.
        code, out, err = beads_quiet(["show", parent, "--json"], root)
        shown = beads_json(out) if code == 0 else []
        if not shown:
            # The show's own failure, which may be that no such item exists.
            unshown = beads_failed(
                ShowItemResponse, out, err, [("item-not-found", BEADS_NOT_FOUND)]
            )
            if unshown.get("reason") != "item-not-found":
                return failed_as(ListItemsResponse, "adapter-failed", unshown["summary"])
        argv += ["--parent", str(shown[0].get("id")) if shown else parent]
    code, out, err = beads_quiet(argv, root)
    if code != 0:
        return beads_failed(ListItemsResponse, out, err, [])
    rows = beads_rows(out)
    if rows is None:
        return failed_as(ListItemsResponse, "adapter-failed", BEADS_NO_LISTING)
    if request.get("scope") == "all" and not parent and (run is not None or not limit):
        left_out = beads_left_out(rows, root)
        if left_out is not None:
            return failed_as(ListItemsResponse, "adapter-failed", left_out)
    items = [beads_record(r) for r in rows]
    if run is not None:
        items = [i for i in items if i.get("run") == run][: limit or None]
    return {
        "status": "completed",
        "summary": "%d items." % len(items),
        "items": items,
        "exitCode": 0,
    }


def beads_to_status(ident: str, status: str, root: str | None) -> tuple[int, str, str]:
    """Write one of bd's own statuses, not closed, to the item of this very
    id, through bd's batch, which reads the id whole (beads_batch) and
    writes a status as bd's update does. The batch checks no status, so it
    is given none but bd's own."""
    if status not in BEADS_STATUSES or status == "closed":
        return 1, "", "invalid status: %s" % status
    return beads_batch([["update", ident, "status=" + status]], root)


def beads_update(request: UpdateItemRequest) -> UpdateItemResponse:
    """operation.update-item: bd update; a close is close-item's, not this.

    One of bd's own statuses given alone -- how an item is opened again --
    is written through bd's batch, which reads the id whole
    (beads_to_status), with nothing read first: a reopen needs no read that
    another writer may have made bd fail. Any other update reads the id as
    bd reads it first, a short one as the full one, and one bd shows as an
    item whose id runs on past it names none (shown_for_a_word): nothing
    is written. Then it is bd's update of the full id, which writes all of
    it or none,
    holds bd's own rules -- a status of its own, no cycle, no parent it
    holds nothing of -- and, given a parent, takes away every parent the
    item had in the same write, so that two at once leave the item under
    one. bd's update reads an id it holds nothing of as the one item whose
    id begins with it: an item deleted between the read and the update may
    have the update written to another in its place. bd's answer names the
    item it wrote, and where that is another, the update fails, naming it.
    The item is read back whole after."""
    if not beads_find():
        return failed_as(UpdateItemResponse, *BEADS_NOT_INSTALLED)
    if request.get("status") == "closed":
        return {
            "status": "failed",
            "reason": "close-through-update",
            "exitCode": 1,
            "summary": "Closing is close-item's, with a reason.",
        }
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(UpdateItemResponse, *BEADS_NO_WORKSPACE)
    status, priority = request.get("status"), request.get("priority")
    if status is not None and status not in BEADS_STATUSES:
        return failed_as(UpdateItemResponse, "bad-status", "invalid status: %s" % status)
    if priority is not None and not 0 <= priority <= 4:
        return failed_as(
            UpdateItemResponse, None, "A priority is 0 to 4, 0 the highest: %d." % priority
        )
    ident = request["id"]
    given: Mapping[str, Any] = request
    flags: list[str] = []
    for key, flag in (
        ("title", "--title"),
        ("status", "-s"),
        ("priority", "-p"),
        ("parent", "--parent"),
        ("assignee", "-a"),
    ):
        if given.get(key) is not None:
            flags += [flag, str(given[key])]
    refusals = [
        ("item-not-found", BEADS_NOT_FOUND),
        ("bad-status", ("invalid status",)),
        ("cycle", ("cycle",)),
    ]
    if flags[::2] == ["-s"]:
        code, out, err = beads_to_status(ident, str(status), root)
        if code != 0:
            return beads_failed(UpdateItemResponse, out, err, refusals)
    else:
        code, out, err = beads_quiet(["show", ident, "--json"], root)
        found = beads_json(out) if code == 0 else []
        if not found:
            return beads_failed(UpdateItemResponse, out, err, [("item-not-found", BEADS_NOT_FOUND)])
        whole = shown_for_a_word(ident, {"status": "completed", "item": found[0]})
        if whole["status"] != "completed":
            return failed_as(UpdateItemResponse, "item-not-found", whole["summary"])
        ident = str(found[0].get("id"))
        if flags:
            code, out, err = beads_quiet(
                ["update", ident, "--json"] + beads_typed(flags, root)[0], root
            )
            if code != 0:
                return beads_failed(UpdateItemResponse, out, err, refusals)
            wrote = [str(r.get("id")) for r in beads_json(out)]
            if wrote and ident not in wrote:
                return failed_as(
                    UpdateItemResponse,
                    "item-not-found",
                    "The tracker holds %s no more, and wrote the update to %s in its place."
                    % (ident, wrote[0]),
                )
    after = beads_shown([ident], root)
    if not after or ident not in after:
        return failed_as(
            UpdateItemResponse,
            "adapter-failed",
            "Updated %s, and the tracker did not show it after." % ident,
        )
    return {
        "status": "completed",
        "summary": "Updated %s." % ident,
        "item": beads_record(after[ident]),
        "exitCode": 0,
    }


def beads_record_values(request: RecordValuesRequest) -> RecordValuesResponse:
    """operation.record-values: not offered under beads in this release, and
    nothing is written. bd sets a value only through its update, which
    reads an id it holds nothing of as the one item whose id begins with
    it, and no write of bd's that reads an id whole sets one; so an item
    deleted as the write ran would have the value written to another. The
    values a create is given, for a move, are the new item's own from the
    start, and are kept (beads_create)."""
    if not beads_find():
        return failed_as(RecordValuesResponse, *BEADS_NOT_INSTALLED)
    return failed_as(
        RecordValuesResponse,
        "unsupported",
        "This tracker records no claim's values in this release: it cannot yet hold such a "
        "write to the item named, so nothing was recorded on %s." % request["id"],
    )


def beads_ready(request: ReadyItemsRequest) -> ReadyItemsResponse:
    """operation.ready-items: the unblocked open set, bd ready, without the
    steps of a cooked formula that bd lists among them. What bd prints that
    is no list of issues fails the read, and is not nothing ready."""
    if not beads_find():
        return failed_as(ReadyItemsResponse, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(ReadyItemsResponse, *BEADS_NO_WORKSPACE)
    code, out, err = beads_quiet(["ready", "--json", "--brief", "-n", "0"], root)
    if code != 0:
        return beads_failed(ReadyItemsResponse, out, err, [])
    rows = beads_rows(out)
    if rows is None:
        return failed_as(ReadyItemsResponse, "adapter-failed", BEADS_NO_LISTING)
    items = [beads_record(r) for r in rows if not r.get("is_template")]
    return {
        "status": "completed",
        "summary": "%d ready." % len(items),
        "items": items,
        "exitCode": 0,
    }


def beads_moved(store: str) -> None:
    """Say in the workspace that its issues keep the means to prove a run in
    their metadata, as every store opened by 3.0.0 does."""
    with open(os.path.join(os.path.dirname(store), BEADS_MEANS_MOVED), "w", encoding="utf-8") as fh:
        fh.write("The means to prove each run are kept in the issue's metadata.\n")


def beads_upgrade(request: Request) -> Response:
    """The upgrade extra: a workspace poured into before 3.0.0 keeps the means
    to prove a run as the last section of an issue's description. Asked
    without apply, it says so; with apply, each such issue gets its
    description back as it was given and the means in its metadata, marked
    there as moved, and the workspace says that it has. A write bd refuses
    fails the upgrade and leaves that unsaid; tried again, it moves only the
    issues not yet marked, so a description it gave back is never read for
    the means a second time. Every issue is read, those bd's list leaves out
    unless asked included, and what bd prints that is no list of issues
    fails the upgrade before anything moves: the workspace says that its
    means have moved only once every issue was read. An issue whose metadata
    holds dotdiw as a value of its own keeps its description as it was, since
    the means cannot be kept beside that value, and the account names it."""
    nothing: Response = {
        "status": "completed",
        "summary": "Nothing to bring up to date.",
        "pending": [],
        "done": [],
        "exitCode": 0,
    }
    root = request.get("root")
    store = beads_store(root)
    if not store or not os.path.isdir(store):
        return nothing
    if os.path.exists(os.path.join(os.path.dirname(store), BEADS_MEANS_MOVED)):
        return nothing
    if not request.get("apply"):
        return dict(
            nothing,
            summary="Issues keep the means to prove a run inside their descriptions.",
            pending=["its issues keep the means to prove a run inside their descriptions"],
        )
    code, out, err = beads_quiet(["list", "--all", "--json", "-n", "0", *BEADS_EVERY_ROW], root)
    if code != 0:
        return beads_failed(dict, out, err, [])
    rows = beads_rows(out)
    if rows is None:
        return failed_as(dict, "adapter-failed", BEADS_NO_LISTING)
    moved, kept = 0, []
    for row in rows:
        own = beads_own(row)
        if own is not None and own.get("meansMoved"):
            continue
        text = row.get("description")
        description, means = read_verify_using(text)
        if not text or (description == text and not means):
            continue
        if own is None:
            kept.append(str(row.get("id")))
            continue
        argv = [
            "update",
            str(row.get("id")),
            "--description=" + (description or ""),
            "--metadata=" + beads_means(row, means, moved=True),
        ]
        code, out, err = beads_quiet(argv, root)
        if code != 0:
            return beads_failed(dict, out, err, [])
        moved += 1
    beads_moved(store)
    return dict(
        nothing,
        summary="Moved the means of %d issue%s into metadata." % (moved, "" if moved == 1 else "s"),
        done=[
            "the means to prove a run are kept in each issue's metadata, out of %d description%s"
            % (moved, "" if moved == 1 else "s")
        ]
        + ([beads_left_as_given(kept)] if kept else []),
    )


# bd's own reading of a command's options, by command path, kept for the
# length of a run: each option by every name it takes, its long name and its
# kind -- a switch, one value, one value given only after "=", many values,
# or a kind dotdiw cannot read -- and the command's subcommands.
BEADS_OPTIONS: dict[tuple[str, ...], dict[str, Any] | None] = {}
BEADS_ONE_VALUE = (
    "string",
    "int",
    "int32",
    "int64",
    "uint",
    "uint64",
    "float",
    "float32",
    "float64",
    "duration",
)
BEADS_MANY_VALUES = ("strings", "stringArray", "stringSlice", "ints", "intSlice")
# A switch's value as bd's options read one.
BEADS_SWITCH = {
    "1": True,
    "t": True,
    "T": True,
    "TRUE": True,
    "true": True,
    "True": True,
    "0": False,
    "f": False,
    "F": False,
    "FALSE": False,
    "false": False,
    "False": False,
}
BEADS_NOT_COMMANDS = (
    "Usage",
    "Aliases",
    "Examples",
    "Flags",
    "Global Flags",
    "Additional help topics",
)


def beads_options(path: list[str], root: str | None) -> dict[str, Any] | None:
    """A command's options and subcommands as bd's own help for it states
    them; None where the help does not answer."""
    key = tuple(path)
    if key in BEADS_OPTIONS:
        return BEADS_OPTIONS[key]
    code, out, _ = beads_quiet(list(path) + ["--help"], root)
    found: dict[str, Any] | None = None
    if code == 0:
        table: dict[str, tuple[str, str]] = {}
        subs: list[str] = []
        section = ""
        for line in out.splitlines():
            if line and not line.startswith(" "):
                section = line[:-1] if line.endswith(":") else ""
                continue
            if section in ("Flags", "Global Flags"):
                m = re.match(r"^\s+(?:-(\S), )?--([\w-]+)(?: (\S+))?(?:\s{2,}|$)", line)
                if not m:
                    continue
                short, long, kind = m.groups()
                if kind is None:
                    arity = "switch"
                elif "[=" in kind:
                    default = re.search(r'\[="(.*)"\]', kind)
                    arity = "optional:%s" % (default.group(1) if default else "")
                elif kind in BEADS_ONE_VALUE:
                    arity = "one"
                elif kind in BEADS_MANY_VALUES:
                    arity = "many"
                else:
                    arity = "unknown"
                table["--" + long] = (long, arity)
                if short:
                    table["-" + short] = (long, arity)
            elif section and section not in BEADS_NOT_COMMANDS:
                m = re.match(r"^  ([a-z][\w-]*)\s+\S", line)
                if m:
                    subs.append(m.group(1))
        found = {"options": table, "subcommands": subs}
    BEADS_OPTIONS[key] = found
    return found


def beads_command(words: list[str], root: str | None) -> list[str] | None:
    """The command path of bd's the words name, an alias resolved, as bd's
    own help reads them; None where bd knows no command by them."""
    code, out, _ = beads_quiet(["help"] + list(words), root)
    m = re.search(r"^Usage:\n\s+\S+((?: [a-z][\w-]*)+)", out, re.M) if code == 0 else None
    return m.group(1).split() if m else None


def beads_keep(options: dict[str, Any], long: str, arity: str, value: str) -> None:
    """A value given an option: the last given, or one more of many."""
    if arity == "many":
        options.setdefault(long, []).append(value)
    else:
        options[long] = value


def beads_take(
    table: Mapping[str, tuple[str, str]], args: list[str], j: int, options: dict[str, Any]
) -> int | str:
    """The option at args[j], read as bd's options are read: a value after
    "=", or in the next word, or joined to its letter; letters of switches
    run together. Where the next word starts, or why it cannot be read."""
    a = args[j]
    if a.startswith("--"):
        name, eq, value = a[2:].partition("=")
        entry = table.get("--" + name)
        if entry is None:
            return "--%s is no option of the command." % name
        long, arity = entry
        if arity == "switch":
            if eq and value not in BEADS_SWITCH:
                return "--%s=%s is no value a switch takes." % (name, value)
            options[long] = BEADS_SWITCH[value] if eq else True
            return j + 1
        if arity.startswith("optional:"):
            options[long] = value if eq else arity.split(":", 1)[1]
            return j + 1
        if arity == "unknown":
            return "--%s takes a value of a kind dotdiw cannot read." % name
        if eq:
            beads_keep(options, long, arity, value)
            return j + 1
        if j + 1 >= len(args):
            return "--%s wants a value." % name
        beads_keep(options, long, arity, args[j + 1])
        return j + 2
    k = 1
    while k < len(a):
        entry = table.get("-" + a[k])
        if entry is None:
            return "-%s is no option of the command." % a[k]
        long, arity = entry
        if arity == "switch":
            if a[k + 1 : k + 2] == "=":
                if a[k + 2 :] not in BEADS_SWITCH:
                    return "-%s=%s is no value a switch takes." % (a[k], a[k + 2 :])
                options[long] = BEADS_SWITCH[a[k + 2 :]]
                return j + 1
            options[long] = True
            k += 1
            continue
        if arity not in ("one", "many"):
            return "-%s takes a value of a kind dotdiw cannot read." % a[k]
        if k + 1 < len(a):
            beads_keep(options, long, arity, a[k + 2 :] if a[k + 1] == "=" else a[k + 1 :])
            return j + 1
        if j + 1 >= len(args):
            return "-%s wants a value." % a[k]
        beads_keep(options, long, arity, args[j + 1])
        return j + 2
    return j + 1


def beads_read(request: Request) -> Response:
    """The read extra: a command as bd itself will read it -- its command
    path, its words, and its options by their long names, each value as bd
    keeps it: the last given for an option of one value, all given for one
    of many, a switch read as bd reads a switch's value -- from bd's own help
    for that command, by the rules bd's options follow. A word bd's help
    cannot place is refused as unreadable, never read another way; a command
    path of None is a word bd knows by no command, for bd to refuse."""
    if not beads_find():
        return failed_as(dict, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    if beads_env(root) is None:
        return failed_as(dict, *BEADS_NO_WORKSPACE)
    args = [str(a) for a in request.get("arguments") or []]
    options: dict[str, Any] = {}

    def unreadable(why: str) -> Response:
        return {"status": "failed", "reason": "unreadable", "exitCode": 1, "summary": why}

    def read(path: list[str] | None, words: list[str]) -> Response:
        return {
            "status": "completed",
            "summary": "Read %s." % " ".join(path or ["nothing"]),
            "command": path,
            "words": words,
            "options": options,
            "exitCode": 0,
        }

    top = beads_options([], root)
    if top is None:
        return unreadable("The tracker's own help could not be read.")
    i = 0
    while i < len(args) and args[i].startswith("-") and args[i] not in ("-", "--"):
        nxt = beads_take(top["options"], args, i, options)
        if isinstance(nxt, str):
            return unreadable(nxt)
        i = nxt
    if i < len(args) and args[i] == "--":
        return unreadable("-- stands before the command.")
    if i >= len(args):
        return read([], [])
    word = args[i]
    path = [word] if word in top["subcommands"] else beads_command([word], root)
    if path is None:
        return read(None, [])
    found = beads_options(path, root)
    rest = args[i + 1 :]
    while found is not None and found["subcommands"]:
        j, at = 0, None
        while j < len(rest) and rest[j] != "--":
            if rest[j].startswith("-") and rest[j] != "-":
                nxt = beads_take(found["options"], rest, j, {})
                if isinstance(nxt, str):
                    return unreadable(nxt)
                j = nxt
                continue
            at = j
            break
        if at is None:
            break
        sub = rest[at]
        deeper = path + [sub] if sub in found["subcommands"] else beads_command(path + [sub], root)
        if deeper is None or len(deeper) <= len(path):
            break
        path, rest = deeper, rest[:at] + rest[at + 1 :]
        found = beads_options(path, root)
    if found is None:
        return unreadable("The tracker's help for %s could not be read." % " ".join(path))
    words: list[str] = []
    j = 0
    while j < len(rest):
        if rest[j] == "--":
            words += rest[j + 1 :]
            break
        if rest[j].startswith("-") and rest[j] != "-":
            nxt = beads_take(found["options"], rest, j, options)
            if isinstance(nxt, str):
                return unreadable(nxt)
            j = nxt
            continue
        words.append(rest[j])
        j += 1
    return read(path, words)


def beads_session(theirs: str | None) -> str:
    """A session to close under that no other close carries: the session the
    worker gave or runs in, where there is one, marked as dotdiw's."""
    mark = "dotdiw-%s" % os.urandom(8).hex()
    return "%s#%s" % (theirs, mark) if theirs else mark


def beads_holds(ident: str, root: str | None) -> bool | None:
    """Whether bd holds an item of this very id; None where bd does not say.
    bd reads an id it holds nothing of as that of the one item whose id
    begins with it -- a deleted item's as its only child's -- and shows that
    one. So an item is held only where a row bd shows carries the id asked,
    and held no more where the rows carry another, or bd finds no issue."""
    code, out, err = beads_quiet(["show", ident, "--json"], root)
    shown = [str(r["id"]) for r in (beads_json(out) if code == 0 else []) if r.get("id")]
    if shown:
        return ident in shown
    gone = beads_failed(ShowItemResponse, out, err, [("item-not-found", BEADS_NOT_FOUND)])
    return False if gone.get("reason") == "item-not-found" else None


def beads_shown(ids: list[str], root: str | None) -> dict[str, dict[str, Any]] | None:
    """Those of the ids given that bd holds now, each as bd shows it, by id,
    in the order given. One bd holds no more has no row: asked for several,
    bd leaves it out, or shows another item in its place (beads_holds).
    None where bd does not say of an id it shows no row for whether it
    holds it, since then nothing is known of that one."""
    if not ids:
        return {}
    code, out, _ = beads_quiet(["show"] + list(ids) + ["--json"], root)
    rows = {str(r.get("id")): r for r in (beads_json(out) if code == 0 else [])}
    if any(beads_holds(i, root) is not False for i in dict.fromkeys(ids) if i not in rows):
        return None
    return {i: rows[i] for i in dict.fromkeys(ids) if i in rows}


def beads_marked(rows: Mapping[str, Mapping[str, Any]], session: str) -> list[str]:
    """Of the items shown (beads_shown), the ids of those closed under the
    session given, as bd keeps the session a close ran under and keeps it
    through a later close. A close that kept no session is no close of the
    session's, whatever bd it ran under."""
    return [
        i
        for i, row in rows.items()
        if row.get("status") == "closed" and row.get("closed_by_session") == session
    ]


def beads_label_kept(reading: Response, root: str | None) -> str | None:
    """Why a command, as bd will read it (beads_read), is refused for taking
    BEADS_RUN_LABEL off an item: that label marks the items of a run, and
    only dotdiw writes it, as only dotdiw writes what it keeps in an item's
    metadata. An update that removes it, one that sets the labels of an
    item that carries it without it, and a label remove of it are refused;
    labels given together are split as bd splits them, an update's as one
    line of comma-separated values, quotes and all, a label remove's at each
    comma. Whether the items an update sets the labels of carry it is read
    from bd's own show of the words, as the update will read them; where
    that cannot be read, the update is refused, since then it cannot be
    checked. None where the command leaves the label as it is."""
    path = reading.get("command")
    given: Mapping[str, Any] = reading.get("options") or {}
    words = [str(w) for w in reading.get("words") or []]
    off = (
        "Nothing ran: %s marks the items of a run, and only dotdiw writes it, so a command "
        "that takes it off an item is refused." % BEADS_RUN_LABEL
    )
    if path == ["label", "remove"]:
        named = [x.strip() for x in words[-1].split(",")] if len(words) > 1 else []
        return off if BEADS_RUN_LABEL in named else None
    if path != ["update"]:
        return None

    def labels(values: Any) -> list[str]:
        out: list[str] = []
        for value in values if isinstance(values, list) else [values]:
            if isinstance(value, str):
                out += [x.strip() for x in next(csv.reader([value]), [])]
        return out

    if BEADS_RUN_LABEL in labels(given.get("remove-label")):
        return off
    if "set-labels" not in given or BEADS_RUN_LABEL in labels(given.get("set-labels")):
        return None
    code, out, _ = beads_quiet(["show", *words, "--json"], root)
    rows = beads_json(out) if code == 0 else []
    if not rows:
        return (
            "Nothing ran: whether the items named carry %s, which marks the items of a run, "
            "could not be read, so a command that sets their labels cannot be checked."
            % BEADS_RUN_LABEL
        )
    carrying = list(
        dict.fromkeys(str(r.get("id")) for r in rows if BEADS_RUN_LABEL in (r.get("labels") or []))
    )
    if carrying:
        return (
            "Nothing ran: %s %s %s, which marks the items of a run, and only dotdiw writes it; "
            "labels set keep it only when %s is among them."
            % (
                ", ".join(carrying),
                "carries" if len(carrying) == 1 else "carry",
                BEADS_RUN_LABEL,
                BEADS_RUN_LABEL,
            )
        )
    return None


def beads_forward(request: Request) -> Response:
    """The pass-through, an extra: the command as typed, with the worker's
    terminal and bd's name rewritten on the way back. The rewrite is the
    whole of "one name for all four", so it happens here and nowhere else.
    An update or a quick capture that asks for the type a root has is
    refused, read as bd reads it, and so is a command that takes off an item
    the label that marks the items of a run (beads_label_kept); one that
    cannot be read so is refused, since then it cannot be checked. Given a mark (mark) and the ids
    to answer for (marked), the command closes under a session of its own,
    given that run alone, and the answer names those of the ids that closed
    under it (markedIds)."""
    if not beads_find():
        return failed_as(dict, *BEADS_NOT_INSTALLED)
    root = request.get("root")
    args = list(request.get("arguments") or [])
    reading: Response = {}
    if args and (
        request.get("mark") or args[0].startswith("-") or args[0] in ("update", "q", "label")
    ):
        reading = beads_read({"root": root, "arguments": args})
        if reading["status"] != "completed" and reading.get("reason") not in TRACKER_CANNOT_ANSWER:
            return {
                "status": "failed",
                "exitCode": 1,
                "output": "",
                "printed": False,
                "summary": "dotdiw does not run this: it cannot read the command as the tracker "
                "would, so it cannot check what the command asks. %s" % reading["summary"],
            }
    given: Mapping[str, Any] = reading.get("options") or {}
    if (
        reading.get("command") in (["update"], ["q"])
        and str(given.get("type", "")).strip().lower() in BEADS_ROOT_TYPES
    ):
        return {
            "status": "failed",
            "exitCode": 1,
            "output": "",
            "printed": False,
            "summary": "Only formula pour makes a root, so a type of molecule is refused.",
        }
    unlabelled = beads_label_kept(reading, root)
    if unlabelled:
        return {
            "status": "failed",
            "exitCode": 1,
            "output": "",
            "printed": False,
            "summary": unlabelled,
        }
    if args[:1] == ["update"]:
        args, refused = beads_typed(args, root)
        if refused:
            return {
                "status": "failed",
                "exitCode": 1,
                "output": "",
                "printed": False,
                "summary": refused,
            }
    session: str | None = None
    kept = os.environ.get("CLAUDE_SESSION_ID")
    if request.get("mark"):
        theirs = given.get("session") if isinstance(given.get("session"), str) else None
        session = beads_session(theirs or kept)
        if theirs is not None:
            if "--" in args:
                return {
                    "status": "failed",
                    "exitCode": 1,
                    "output": "",
                    "printed": False,
                    "summary": "A close given its own session after -- cannot be marked.",
                }
            args = args + ["--session", session]
    code, out, _ = beads_run(args, root, True, session=session)
    answer: Response = {
        "status": "completed" if code == 0 else "failed",
        "exitCode": code,
        "output": out,
        "printed": True,
        "summary": "%s exited %d." % (args[0] if args else "the tracker", code),
    }
    if session is not None:
        # None where bd does not say of each id asked whether it holds it; an
        # id another deleted as the command ran is no such gap.
        shown = beads_shown([str(i) for i in request.get("marked") or []], root)
        answer["markedIds"] = None if shown is None else beads_marked(shown, session)
    return answer


def beads_metrics_off(request: Request) -> Response:
    """Metrics off for this machine, an extra: read bd's config rather than
    ask bd, and say whether it was this call that turned them off."""

    def off_already() -> bool:
        try:
            with open(os.path.expanduser(BD_CONFIG), encoding="utf-8") as fh:
                text = fh.read()
        except OSError:
            return False
        block = re.search(r"(?m)^metrics:[ \t]*\n((?:[ \t]+.*\n?)*)", text)
        return bool(
            block and re.search(r"(?m)^[ \t]+disabled:[ \t]*[Tt]rue[ \t]*$", block.group(1))
        )

    if off_already() or not beads_find():
        return {
            "status": "completed",
            "summary": "Metrics were already off.",
            "turnedOff": False,
            "path": BD_CONFIG,
            "exitCode": 0,
        }
    beads_quiet(["metrics", "off"])
    if not off_already():
        return {
            "status": "failed",
            "summary": "The tracker did not turn its metrics off.",
            "turnedOff": False,
            "path": BD_CONFIG,
            "exitCode": 1,
        }
    return {
        "status": "completed",
        "summary": "Turned the tracker's metrics off.",
        "turnedOff": True,
        "path": BD_CONFIG,
        "exitCode": 0,
    }


