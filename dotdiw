def parent_a_guard(
    root: str, tracker: str | None, parent: str | None
) -> NameTheWorkResponse | None:
    """Why no item is made under the parent given, or None where it may be:
    a pour's guard -- one that reads as one, or the guard of a pour not
    known to be whole, whatever it reads as (pours_held) -- is written by
    nothing but its pour, and an item made under it would be written onto
    it. Every item is listed for it, and the parent read as the tracker
    reads it; what the tracker cannot give for want of itself leaves the
    create to answer."""
    if not parent:
        return None
    common = {"root": root, "tracker": tracker}
    listed = invoke_tracker("operation.list-items", dict(common, scope="all"))
    if listed["status"] != "completed":
        if listed.get("reason") in TRACKER_CANNOT_ANSWER:
            return None
        return {
            "status": "failed",
            "summary": "Nothing was made: what the tracker holds could not be read, so whether "
            "%s is a pour's guard could not be told. %s" % (parent, listed["summary"]),
            "reason": "adapter-failed",
            "exitCode": 1,
        }
    every = {i["id"]: i for i in listed.get("items") or []}
    pours = pours_held(every, lambda g: invoke_tracker("operation.show-item", dict(common, id=g)))

    def guarded(ident: str, item: Mapping[str, Any] | None) -> bool:
        return (item or {}).get("kind") == "guard" or ident in pours

    ident = parent
    if not (parent in every and guarded(parent, every[parent])):
        shown = shown_for_a_word(
            parent, invoke_tracker("operation.show-item", dict(common, id=parent))
        )
        if shown["status"] != "completed":
            if shown.get("reason") in ("item-not-found",) + TRACKER_CANNOT_ANSWER:
                return None  # the create names it no item, and says so
            return {
                "status": "failed",
                "summary": "Nothing was made: what %s names could not be read, so whether it "
                "is a pour's guard could not be told. %s" % (parent, shown["summary"]),
                "reason": "adapter-failed",
                "exitCode": 1,
            }
        ident = str((shown.get("item") or {}).get("id") or parent)
        if not guarded(ident, shown.get("item")):
            return None
    return {
        "status": "failed",
        "summary": "Nothing was made: %s" % (GUARD_HELD % ident),
        "reason": None,
        "exitCode": 1,
    }


def NameTheWork(request: NameTheWorkRequest) -> NameTheWorkResponse:
    """step.name-the-work: the work item, created under the title given.

    Through the tracker door, with the fields dotdiw's own flags filled: the
    title, the description, the priority and the parent. The id comes back
    in the record. Under a parent, it is made under the lock of the store it
    writes to, the lock a close holds from checking that nothing under the
    item it closes stands open through closing it, so that no child is made
    between the two, left open under a parent closed for having nothing
    open under it; given ETags or not. Given the ETags the create rests on
    -- its parent's, say -- they are compared under that lock, held through
    the create, and one that changed creates nothing.
    """
    root = request["root"]
    etags = list(request.get("etags") or [])
    with (
        held_for_writing(root, request.get("tracker"))
        if etags or request.get("parent")
        else contextlib.nullcontext(True) as held
    ):
        if not held:
            return {
                "status": "failed",
                "summary": TRACKER_BUSY["summary"],
                "reason": "adapter-failed",
                "exitCode": 1,
            }
        if etags:
            compared = invoke(
                "operation.compare-what-was-read",
                {"root": root, "tracker": request.get("tracker"), "etags": etags},
            )
            if compared["status"] != "completed":
                return {
                    "status": "failed",
                    "summary": compared["summary"],
                    "reason": compared.get("reason") or "adapter-failed",
                    "exitCode": compared.get("exitCode") or 1,
                }
        guarded = parent_a_guard(root, request.get("tracker"), request.get("parent"))
        if guarded is not None:
            return guarded
        made = invoke_tracker(
            "operation.create-item",
            {
                "root": root,
                "tracker": request.get("tracker"),
                "title": request["title"],
                "description": request.get("description"),
                "priority": request.get("priority"),
                "parent": request.get("parent"),
            },
        )
    code = made.get("exitCode", 0 if made["status"] == "completed" else 1)
    work = (made.get("item") or {}).get("id") if code == 0 else None
    return {
        "status": made["status"],
        "summary": "Named %s." % (work or "the work") if code == 0 else made["summary"],
        "workRef": work,
        "item": made.get("item") if code == 0 else None,
        "reason": made.get("reason"),
        "tracker": made.get("tracker"),
        "exitCode": code,
    }


def PourProcedure(request: PourProcedureRequest) -> PourProcedureResponse:
    """step.pour-procedure: a surfaced formula becomes tracked, ordered steps.

    The formula is read from where it actually lives, every time, and its
    steps handed to the tracker with their needs: the file is the formula,
    so a formula edited in place pours as it reads now, not as a copy the
    tracker happened to hold. Every adapter pours the steps it is given.

    A step that calls a formula has that formula's steps poured within it,
    in the same run: every call is read, and refused where it cannot be
    poured, before anything is written (planned_calls), and the tracker is
    handed the whole job at once, each step under a key, as read
    (planned_steps), where it says it pours calls.
    """
    root = request["root"]
    r = invoke("operation.resolve-formula", {"root": root, "ident": request.get("ident")})
    found = r["status"] == "completed"
    # An id refused here never reaches the tracker: one that two formulas
    # share, or one with a provider's suffix that the provider does not serve,
    # whose copy the tracker may still hold.
    if not found and r.get("reason") in (
        "ambiguous",
        "provider-formula-unserved",
        "provider-failed",
    ):
        return {
            "status": r["status"],
            "summary": r["summary"],
            "formulaRef": None,
            "reason": r["reason"],
            "exitCode": 1,
        }
    # The formula poured is the one the lookup selected, as its reading parsed
    # it: its id, its title, its description, its means to prove and its
    # steps, one version whatever is written to its file meanwhile. Nothing
    # reads the file again, and nothing is written for it.
    body = r.get("formula") if found else None
    formula = (
        {
            "id": r["formulaRef"],
            "desc": body["description"],
            "steps": body["steps"],
            "verifyUsing": body["verifyUsing"],
        }
        if body
        else {}
    )
    ident = request.get("ident") or ""
    ref = formula.get("id")
    top = list(formula.get("steps") or [])
    shared = shared_step_id(top)
    if shared is not None:
        return {
            "status": "failed",
            "summary": "Two steps of %s share the id %s, so nothing was poured." % (ref, shared),
            "formulaRef": ref,
            "reason": "duplicate-step",
            "exitCode": 1,
        }
    # Every formula a step calls, and every one those call, read and held to
    # the rules of a call before anything is written, so that a call refused
    # leaves the tracker as it was; what was read is what is poured.
    calls, refused = planned_calls(
        root, ref or ident, top, [(formula_identity(r), ref)] if ref else []
    )
    if refused is not None:
        return {
            "status": "failed",
            "summary": refused[1],
            "formulaRef": ref,
            "reason": refused[0],
            "exitCode": 1,
        }
    where: dict[str, Any] = {"root": root, "tracker": request.get("tracker")}
    plan: list[TrackerStep] | None = None
    if calls:
        try:
            plan = planned_steps(top, calls)
        except LookupError as e:
            return {
                "status": "failed",
                "summary": "%s Nothing was poured." % e,
                "formulaRef": ref,
                "reason": "step-not-found",
                "exitCode": 1,
            }
        except ValueError as e:
            return {
                "status": "failed",
                "summary": "%s Nothing was poured." % e,
                "formulaRef": ref,
                "reason": "cycle",
                "exitCode": 1,
            }
        described = invoke_tracker("operation.describe-tracker", dict(where))
        info = (described.get("info") or {}) if described["status"] == "completed" else {}
        if not info.get("nests"):
            first = calls[0]
            return {
                "status": "failed",
                "summary": "Step %s of %s calls %s, and %s does not pour a step that calls a "
                "formula%s. Nothing was poured."
                % (
                    first["step"],
                    ref,
                    first["ref"],
                    "the tracker %s" % info["name"] if info.get("name") else "the tracker",
                    "" if described["status"] == "completed" else ": %s" % described["summary"],
                ),
                "formulaRef": ref,
                "reason": "call-unsupported",
                "tracker": described.get("tracker"),
                "exitCode": 1,
            }
    # The steps are made under their root under the lock a close holds from
    # checking that nothing under the item it closes stands open through
    # closing it: a step closed while the pour runs, the root's only one so
    # far, would close the root, and the steps made after would stand open
    # under it. A ready read through dotdiw takes it too, so that no reader
    # sees a job half made.
    with held_for_writing(root, request.get("tracker")) as held:
        if not held:
            return {
                "status": "failed",
                "summary": TRACKER_BUSY["summary"],
                "formulaRef": ref,
                "reason": "adapter-failed",
                "exitCode": 1,
            }
        poured = invoke_tracker(
            "operation.pour-steps",
            dict(
                where,
                formulaRef=ref or ident,
                title=ref or ident,
                steps=plan if plan is not None else [tracker_step(s) for s in top],
                description=formula.get("desc") or None,
                verifyUsing=list(formula.get("verifyUsing") or []),
            ),
        )
    code = poured.get("exitCode", 0 if poured["status"] == "completed" else 1)
    ids = [str(i) for i in poured.get("stepIds") or []]
    claims: list[ClaimedStep] = []
    called: list[PouredCall] = []
    if plan is None:
        # A pour cut short answers fewer ids than there are steps.
        made = dict(zip([s["id"] for s in top], ids, strict=False))
        if code == 0:
            claims = claimed_steps(top, made)
        tops = ids
    else:
        # The tracker makes the steps in the order given, so those a pour cut
        # short made are the first ones.
        keyed = dict(zip([step_named(p) for p in plan], ids, strict=False))
        tops = [keyed[k] for k in (step_key([s["id"]]) for s in top) if k in keyed]
        claims, called = poured_within(top, calls, keyed, [], None)
    summary = poured["summary"]
    if code != 0 and poured.get("guardId"):
        guard_id, root_id = poured["guardId"], poured.get("rootId")
        # Cut short once every item was made and the root marked whole --
        # at the guard's close -- the guard's close is all that is left,
        # and dotdiw closes it; cut sooner, the pour is not whole.
        rooted: Response = (
            shown_by_its_id(root_id, invoke_tracker("operation.show-item", dict(where, id=root_id)))
            if root_id
            else {"status": "failed"}
        )
        if not root_id:
            summary = summary.rstrip() + (
                " Nothing but its guard %s was made, which holds nothing, and is left open."
                % guard_id
            )
        elif rooted["status"] == "completed" and (rooted.get("item") or {}).get("whole") is True:
            summary = summary.rstrip() + (
                " %s holds %s and every calling step it made open; every item is made and %s "
                "is marked whole, so %s close %s finishes the pour."
                % (guard_id, root_id, root_id, PROG, guard_id)
            )
        else:
            summary = summary.rstrip() + (
                " %s holds %s and every calling step it made open, so that none of them "
                "completes, and no close but a pour's closes it. To finish with the pour, remove "
                "its root, its steps and %s, which stands under no parent."
                % (guard_id, root_id or "the root", guard_id)
            )
    said = poured.get("reason")
    out: PourProcedureResponse = {
        "status": poured["status"],
        "summary": summary,
        "formulaRef": ref if found else None,
        "moleculeRef": poured.get("rootId") if found else None,
        "stepRefs": tops if found else [],
        "claims": claims,
        "verifyUsing": list(formula.get("verifyUsing") or []) if found and code == 0 else None,
        "reason": said if said in POUR_REASONS else "adapter-failed" if said else None,
        "tracker": poured.get("tracker"),
        "exitCode": code,
    }
    if called:
        out["calls"] = called
    if poured.get("guardId"):
        out["guardRef"] = str(poured["guardId"])
    return out


# The reasons a pour answers that a tracker's own answer may carry; any other a
# write it asked for failed with is the adapter's failure.
POUR_REASONS = (
    "not-installed",
    "no-workspace",
    "tracker-unknown",
    "adapter-failed",
    "no-steps",
    "step-not-found",
    "cycle",
    "duplicate-step",
)


# Why a call is refused before a pour writes anything.
CallRefused = Literal[
    "call-not-found",
    "call-cycle",
    "call-with-claim",
    "ambiguous",
    "provider-formula-unserved",
    "provider-failed",
    "duplicate-step",
    "no-steps",
    "step-not-found",
    "cycle",
]


def formula_identity(resolved: Mapping[str, Any]) -> str:
    """Which formula a lookup resolved, whatever id it declares: a file's by
    its path, a provider's by its id, which names that provider's alone. Two
    files may declare one id, each named by its path."""
    if resolved.get("path"):
        return "file:%s" % resolved["path"]
    return "provider:%s" % resolved.get("formulaRef")


def planned_calls(
    root: str, ref: str, steps: list[Any], path: list[tuple[str, str]]
) -> tuple[list[dict[str, Any]], tuple[CallRefused, str] | None]:
    """Each step of a formula that calls one, with the formula it calls as
    the pour's own lookup reads it -- its description, its means to prove
    and its steps, which are what is poured -- and that formula's calls in
    turn, to any depth; or the reason and the summary that refuse the first
    call that cannot be poured, naming the calling step, its formula and
    the reference. A call refused: one that names no formula as text, or
    none the lookup finds, or more than one, or one a provider does not
    serve or failed to show; one back to a formula already on the path of
    calls that reached it, directly or not -- the formula the lookup
    resolved, not the id it declares (formula_identity), each named by its
    id; a calling step that declares a claim, since what a call's work found
    is claimed by a step after it;
    and a formula called whose steps share an id, need a step that is none
    of them, wait on each other, or that has none. Two calls of one formula
    are two instances. Nothing is written."""
    calls: list[dict[str, Any]] = []
    for s in steps:
        if "formula" not in s:
            continue
        reference = s.get("formula") or ""
        where = "Step %s of %s calls %s" % (s["id"], ref, reference or "no formula")
        if not reference:
            return [], (
                "call-not-found",
                "%s: its formula is not text naming one. Nothing was poured." % where,
            )
        if s.get("claim"):
            return [], (
                "call-with-claim",
                "%s and declares a claim, but a step that calls a formula claims nothing: "
                "what its call found is claimed by a step that needs it. Nothing was poured."
                % where,
            )
        r = invoke("operation.resolve-formula", {"root": root, "ident": reference})
        if r["status"] != "completed" or not r.get("formula"):
            said = r.get("reason")
            why: CallRefused = (
                said
                if said in ("ambiguous", "provider-formula-unserved", "provider-failed")
                else "call-not-found"
            )
            return [], (why, "%s: %s Nothing was poured." % (where, r["summary"]))
        target, body = str(r["formulaRef"]), r["formula"]
        reached = formula_identity(r)
        seen = [identity for identity, _ in path]
        if reached in seen:
            loop = [name for _, name in path[seen.index(reached) :]] + [target]
            return [], (
                "call-cycle",
                "%s, and the calls go round: %s. Nothing was poured." % (where, " -> ".join(loop)),
            )
        shared = shared_step_id(body["steps"])
        if shared is not None:
            return [], (
                "duplicate-step",
                "%s: two steps of %s share the id %s. Nothing was poured."
                % (where, target, shared),
            )
        if not body["steps"]:
            return [], ("no-steps", "%s: %s has no steps. Nothing was poured." % (where, target))
        try:
            steps_in_order(list(body["steps"]))
        except LookupError as e:
            return [], ("step-not-found", "%s: %s Nothing was poured." % (where, e))
        except ValueError as e:
            return [], ("cycle", "%s: %s Nothing was poured." % (where, e))
        nested, refused = planned_calls(
            root, target, list(body["steps"]), path + [(reached, target)]
        )
        if refused is not None:
            return [], refused
        calls.append(
            {
                "step": s["id"],
                "ref": target,
                "desc": body["description"],
                "steps": list(body["steps"]),
                "verifyUsing": list(body.get("verifyUsing") or []),
                "calls": nested,
            }
        )
    return calls, None


def step_key(path: list[str]) -> str:
    """A step's key in a pour that calls a formula: the ids of the calling
    steps it stands within and its own, as compact JSON, so that no two
    steps of the job share one, whatever their ids hold."""
    return json.dumps(path, ensure_ascii=False, separators=(",", ":"))


def planned_steps(steps: list[Any], calls: list[dict[str, Any]]) -> list[TrackerStep]:
    """Every step of a pour that calls a formula, as the tracker is handed
    it, in the order it makes them: each level's steps after what they
    need, and each calling step's call right after it, to any depth. Each
    has a key (step_key); its needs, by key, are those of its own formula,
    and a step of a call that names none needs what its calling step needs
    -- or, where that needs nothing, what the step that one stands within
    needs -- so that nothing of a call is ready before its calling step
    could start. A calling step carries the formula it calls, that
    formula's description and its means to prove. A need naming no step
    raises LookupError, and a cycle ValueError."""
    plan: list[TrackerStep] = []

    def place(
        level: list[Any],
        called: dict[str, dict[str, Any]],
        path: list[str],
        within: str | None,
        gate: list[str],
    ) -> None:
        for s in steps_in_order(level):
            key = step_key(path + [s["id"]])
            needs = [step_key(path + [n]) for n in s.get("needs") or []]
            if within is not None and not needs:
                needs = list(gate)
            out: TrackerStep = {"key": key, "id": s["id"], "title": s["title"], "needs": needs}
            if s.get("claim"):
                out["claim"] = s["claim"]
            if within is not None:
                out["within"] = within
            call = called.get(s["id"])
            if call is not None:
                out["calls"] = call["ref"]
                if call["desc"]:
                    out["description"] = call["desc"]
                if call["verifyUsing"]:
                    out["verifyUsing"] = list(call["verifyUsing"])
            plan.append(out)
            if call is not None:
                place(
                    call["steps"],
                    {c["step"]: c for c in call["calls"]},
                    path + [s["id"]],
                    key,
                    needs,
                )

    place(steps, {c["step"]: c for c in calls}, [], None, [])
    return plan


def poured_within(
    steps: list[Any],
    calls: list[dict[str, Any]],
    made: dict[str, str],
    path: list[str],
    within: str | None,
) -> tuple[list[ClaimedStep], list[PouredCall]]:
    """What a pour that calls a formula made, in each formula's order: each
    claimed step, with the calling step it stands within, and each call
    whose calling step was made -- its item, the item it stands within, the
    formula, the items poured within it and its means to prove -- a call's
    own after its calling step."""
    claims: list[ClaimedStep] = []
    poured: list[PouredCall] = []
    called = {c["step"]: c for c in calls}
    for s in steps:
        item = made.get(step_key(path + [s["id"]]))
        if item is None:
            continue  # a pour cut short made no such step
        for c in claimed_steps([s], {s["id"]: item}):
            if within is not None:
                c["within"] = within
            claims.append(c)
        call = called.get(s["id"])
        if call is None:
            continue
        entry: PouredCall = {
            "step": s["id"],
            "stepRef": item,
            "formulaRef": call["ref"],
            "stepRefs": [
                made[k]
                for k in (step_key(path + [s["id"], c["id"]]) for c in call["steps"])
                if k in made
            ],
            "verifyUsing": list(call["verifyUsing"]),
        }
        if within is not None:
            entry["within"] = within
        poured.append(entry)
        inner_claims, inner_calls = poured_within(
            call["steps"], call["calls"], made, path + [s["id"]], item
        )
        claims += inner_claims
        poured += inner_calls
    return claims, poured


def claimed_steps(steps: list[Any], made: dict[str, str]) -> list[ClaimedStep]:
    """Each claimed step a pour made, so that whoever does it knows what to
    record: its statement and slots, every placeholder still open."""
    claims: list[ClaimedStep] = []
    for s in steps:
        claim = s.get("claim")
        if claim and made.get(s["id"]):
            statement, left = filled(claim["statement"], CLAIM_PLACEHOLDER, lambda _: None)
            claims.append(
                {
                    "item": made[s["id"]],
                    "step": s["id"],
                    "status": "open",
                    "statement": statement,
                    "slots": list(claim["slots"]),
                    "values": [],
                    "claim": statement,
                    "open": left,
                }
            )
    return claims


def StartNamedWork(request: StartNamedWorkRequest) -> StartNamedWorkResponse:
    """journey.start-named-work: name it, read what applies, and -- when asked -- pour."""
    root = request["root"]
    named = invoke(
        "operation.name-the-work",
        {
            "root": root,
            "title": request.get("title"),
            "description": request.get("description"),
            "tracker": request.get("tracker"),
            "priority": request.get("priority"),
            "parent": request.get("parent"),
            "json": request.get("json"),
            "etags": request.get("etags"),
        },
    )
    if named["exitCode"] != 0:
        return {
            "status": named["status"],
            "summary": named["summary"],
            "workRef": named.get("workRef"),
            "reason": named.get("reason"),
            "exitCode": named["exitCode"],
        }
    if request.get("quiet"):
        return {
            "status": "completed",
            "summary": named["summary"],
            "workRef": named["workRef"],
            "item": named.get("item"),
            "surfaced": [],
            "exitCode": 0,
        }

    invoke("operation.declare-conventions", {"root": root, "announce": "create"})
    built = invoke("operation.index-the-project", {"root": root, "background": True})
    if built["status"] != "completed":
        return {
            "status": "failed",
            "summary": built["summary"],
            "workRef": named["workRef"],
            "exitCode": built["exitCode"],
        }
    matched = invoke(
        "operation.match-formulas",
        {
            "root": root,
            "title": request.get("title"),
            "description": request.get("description"),
            "workRef": named["workRef"],
        },
    )
    invoke(
        "operation.describe-and-check",
        {"root": root, "mode": "quiet", "tracker": request.get("tracker")},
    )
    if request.get("formulaRef"):
        invoke(
            "operation.pour-procedure",
            {
                "root": root,
                "ident": request["formulaRef"],
                "workRef": named["workRef"],
                "tracker": request.get("tracker"),
            },
        )
    return {
        "status": "completed",
        "summary": named["summary"],
        "workRef": named["workRef"],
        "item": named.get("item"),
        "surfaced": matched["surfaced"],
        "exitCode": 0,
    }


# ------------------------------------------ duty.adopt-without-reaching-outside


def TurnMetricsOff(request: TurnMetricsOffRequest) -> TurnMetricsOffResponse:
    """step.turn-metrics-off: the tracker's usage metrics off for this machine, and say so once.

    Runs before any other tracker command, on every run, so a fresh machine,
    an upgrade or the metrics turned back on all get the same answer. Silent
    when they are already off, which is every run but the first. The
    mechanism is the adapter's, an extra named metrics-off: the beads adapter
    offers it, and an adapter without metrics does not, in which case there
    is nothing to turn off. main() asks it of the adapter this run uses; the
    tracker door asks it of any other adapter the run reaches, before the
    first thing asked of that adapter.
    """
    out = invoke_extra(
        "metrics-off", {"root": request.get("root"), "tracker": request.get("tracker")}
    )
    if out["status"] == "failed" and out.get("reason") != "unsupported":
        return {
            "status": "failed",
            "summary": "The tracker did not turn its metrics off.",
            "turnedOff": False,
            "path": out.get("path"),
            "exitCode": 0,
        }
    turned = bool(out.get("turnedOff"))
    return {
        "status": "completed",
        "summary": "Turned the tracker's metrics off." if turned else "Metrics were already off.",
        "turnedOff": turned,
        "path": out.get("path"),
        "exitCode": 0,
    }


def UndoEarlierAdoption(request: UndoEarlierAdoptionRequest) -> UndoEarlierAdoptionResponse:
    """step.undo-earlier-adoption: what an earlier version let bd do to a repository, said,
    and put right when init asks.

    v0.1.0 let bd point core.hooksPath at its own directory, which is undone
    because it decides which hooks git runs. Every version before 0.4.0
    kept bd's tracker in the tree -- v0.1.0 with a Dolt remote aimed at the
    git remote, 0.2.x committed, 0.3.0 excluded. That is the upgrade: a
    tracker is made under the home with the old prefix, once, and the
    in-tree copy is left exactly as it is, unused, for the worker to remove
    with the command named; a remote inside it reaches nothing, since no bd
    runs there any more. Earlier tasks are not carried over, and that is
    said. A workspace adopted before there was a choice of tracker has the
    one adapter holding a store there written as the choice.

    Only init puts any of it right, with apply. Every other command asks
    without it first: nothing is changed, and while anything is left the
    answer is blocked, naming init in one line. Silence when there is
    nothing to do. A store is brought up to date under the lock a write of
    an item holds (held_for_writing), since the upgrade rewrites items and
    so their ETags: kept waiting a minute for it, init brings nothing up to
    date, and says so.
    """
    root = request["root"]
    apply = bool(request.get("apply"))
    pending: list[str] = []

    def hooks_replaced() -> str:
        """bd's hook directory standing in for the repository's own, or ""."""
        got = git(["config", "--get", HOOKS_KEY], root).strip()
        if not got:
            return ""
        # realpath, not normpath: on macOS a checkout under /var or /tmp is
        # reached through a symlink, and `git rev-parse` hands back the
        # resolved path while the configured value keeps whichever form it
        # was written in. Comparing the two unresolved left the override in
        # place and said nothing -- the worst of both. Found by the test.
        mine = os.path.realpath(os.path.join(root, ".beads", "hooks"))
        return got if os.path.realpath(os.path.join(root, got)) == mine else ""

    done = []
    got = hooks_replaced()
    if got and not apply:
        pending.append("%s points at %s, a snapshot of this repository's hooks" % (HOOKS_KEY, got))
    elif got:
        git(["config", "--unset", HOOKS_KEY], root)
        if not hooks_replaced():
            done.append(
                "%s is unset. It pointed at %s, a snapshot of this "
                "repository's hooks taken when it was adopted, so any "
                "hook added since was being skipped; .git/hooks is read "
                "again." % (HOOKS_KEY, got)
            )

    # The upgrade: a tracker in the tree and no key means a version before
    # 0.4.0 adopted this repository. Adopt it under the home now, with the
    # old prefix and under the tracker every version before this one had,
    # so the command that was typed just works.
    ws = workspace(root)
    in_tree = os.path.isdir(os.path.join(root, ".beads"))
    made = None
    stopped = None
    if in_tree and not checkout_adopted(root) and not apply:
        pending.append("the tracker is in the tree, where a version before 0.4.0 kept it")
    elif in_tree and not checkout_adopted(root):
        result = invoke(
            "operation.adopt-repository",
            {"root": root, "quiet": True, "tracker": request.get("tracker") or "beads"},
        )
        if result["exitCode"] == 0:
            made = result["workspace"]
            ws = made
        else:
            stopped = (
                "the tracker kept in the tree could not be adopted under the home: %s"
                % (result["summary"])
            )

    # The other upgrade: a workspace adopted before there was a choice of
    # tracker holds one adapter's store and no choice. The choice is written
    # once, as the tracker the work is in, and said once.
    pinned = None
    if adopted(ws) and tracker_name(root) is None and not apply:
        found = tracker_with_store(root)
        if found:
            pending.append("no tracker is chosen for this checkout, whose work %s holds" % found)
    elif adopted(ws) and tracker_name(root) is None:
        # Under the lock an adoption holds, and only while still no choice is
        # written once held: one written meanwhile, by an adoption or a
        # switch, stands.
        with held_at(adoption_lock(root), until_logged=False) as held:
            if held and tracker_name(root) is None:
                pinned = tracker_with_store(root)
            if pinned:
                git(["config", "--local", TRACKER_KEY, pinned], root)
                forget_workspace(root)
                if tracker_name(root) == pinned:
                    done.append(
                        "%s = %s is written in .git/config: the tracker an earlier "
                        "version adopted this checkout under, where its work stays."
                        % (TRACKER_KEY, pinned)
                    )
    # The tracker's store as an earlier version kept it: the adapter that
    # keeps it says whether it needs bringing up to date, and brings it up to
    # date when init asks. An adapter without the upgrade extra has nothing to.
    if checkout_adopted(root) and stopped is None:
        # Brought up to date under the lock a write of an item holds from
        # comparing the ETags it rests on through writing: the upgrade
        # rewrites items, the means moved out of their descriptions, and so
        # changes their ETags, which must not change between that compare
        # and that write. Let go of once done, since nothing of it is logged.
        with (
            held_for_writing(root, request.get("tracker"), until_logged=False)
            if apply
            else contextlib.nullcontext(True) as held
        ):
            kept = (
                invoke_extra(
                    "upgrade", {"root": root, "tracker": request.get("tracker"), "apply": apply}
                )
                if held
                else None
            )
        if kept is None:
            stopped = (
                "another dotdiw command held this checkout's tracker for a minute, checking or "
                "writing what it changes, so the store an earlier version kept was not brought "
                "up to date"
            )
        elif kept["status"] == "completed":
            pending.extend(kept.get("pending") or [])
            done.extend(kept.get("done") or [])
        elif apply and kept.get("reason") != "unsupported":
            stopped = (
                "the store an earlier version kept could not be brought up to date: %s"
                % (kept["summary"])
            )
    command = None
    if in_tree and checkout_adopted(root):
        if git(["ls-files", "-z", "--", ".beads"], root):
            # git rm takes the tracked files; the database bd kept beside them
            # was never tracked, so the directory is removed after.
            command = (
                "git rm -r -q .beads && git commit -m \"Remove the tracker's files "
                'from the repository" && rm -rf .beads .beads.gate.lock'
            )
        else:
            command = "rm -rf .beads .beads.gate.lock"

    if stopped is not None:
        return {
            "status": "failed",
            "summary": "init stopped: %s." % stopped.rstrip("."),
            "undone": done,
            "pending": [],
            "exitCode": 1,
        }
    if pending:
        return {
            "status": "blocked",
            "summary": "This checkout was adopted by an earlier version of %s: %s. Run %s "
            "init once to bring it up to date." % (PROG, "; ".join(pending), PROG),
            "undone": [],
            "pending": pending,
            "exitCode": 1,
        }
    n = len(done) + bool(made)
    return {
        "status": "completed",
        "summary": "%d thing%s put right." % (n, "" if n == 1 else "s"),
        "undone": done,
        "pending": [],
        "workspace": ws,
        "adopted": made,
        "command": command,
        "hooksReplaced": bool(got),
        "tracker": pinned,
        "exitCode": 0,
    }


def DeclareConventions(request: DeclareConventionsRequest) -> DeclareConventionsResponse:
    """step.declare-conventions: the files agents read say where work starts, and name dotdiw.

    Three edits, each idempotent: bd renamed to dotdiw in every file an
    earlier version let it write for agents, which bd writes again on setup,
    doctor --fix and upgrades; the declaration between its markers in
    CLAUDE.md and AGENTS.md, created when absent; and the one exception
    inside bd's own git policy where those files carry it.
    """
    root = request["root"]

    renamed = []
    paths = [os.path.join(root, rel) for rel in AGENT_FILES]
    for rel in AGENT_TREES:
        for dirpath, _, names in os.walk(os.path.join(root, rel)):
            paths.extend(os.path.join(dirpath, n) for n in names)
    for path in paths:
        try:
            with open(path, encoding="utf-8") as fh:
                before = fh.read()
        except (OSError, UnicodeDecodeError, ValueError):
            continue
        after = _BD_WORD.sub(PROG, before)
        if after == before:
            continue
        try:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(after)
        except OSError:
            continue
        renamed.append(os.path.relpath(path, root))

    declared = []
    # Let the project's own declaration satisfy bd's git policy. Without this
    # the instruction files contradict each other, the stricter sentence wins,
    # and the formula stays uncommitted -- which by this design's own rule
    # means the project does not hold it.
    for rel in CONVENTION_FILES:
        path = os.path.join(root, rel)
        try:
            with open(path, encoding="utf-8") as fh:
                before = fh.read()
        except OSError:
            continue
        if BD_GIT_POLICY not in before or FORMULA_EXCEPTION in before:
            continue
        try:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(before.replace(BD_GIT_POLICY, BD_GIT_POLICY + FORMULA_EXCEPTION))
        except OSError:
            continue
        declared.append(rel)
    body = CONVENTIONS % {"p": PROG, "open": MARK_OPEN, "close": MARK_CLOSE}
    for rel in CONVENTION_FILES:
        path = os.path.join(root, rel)
        try:
            with open(path, encoding="utf-8") as fh:
                before = fh.read()
        except OSError:
            before = ""
        if MARK_OPEN in before and MARK_CLOSE in before:
            head, rest = before.split(MARK_OPEN, 1)
            after = head + body + rest.split(MARK_CLOSE, 1)[1]
        elif before.strip():
            after = before.rstrip() + "\n\n" + body + "\n"
        else:
            after = body + "\n"
        if after == before:
            continue
        try:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(after)
        except OSError:
            continue
        if rel not in declared:
            declared.append(rel)

    changed = list(dict.fromkeys(renamed + declared))
    return {
        "status": "completed",
        "summary": "%d file%s changed." % (len(changed), "" if len(changed) == 1 else "s"),
        "renamed": renamed,
        "declared": declared,
        "changed": changed,
        "exitCode": 0,
    }


def ReportWhatIsYoursToCommit(
    request: ReportWhatIsYoursToCommitRequest,
) -> ReportWhatIsYoursToCommitResponse:
    """step.report-what-is-yours-to-commit: the declaration files, and the one command.

    bd commits nothing. What init leaves behind is dotdiw's declaration of
    where work starts, written into the instruction files for the worker to
    commit so that every clone reads it. Say which files, and the command;
    committing is not this tool's to do.
    """
    root, rels = request["root"], list(request.get("paths") or [])
    yours = []
    if rels:
        out = git(["status", "--porcelain", "--"] + rels, root)
        yours = [line[3:] for line in out.split("\n") if line.strip()]
    return {
        "status": "completed",
        "summary": "%d file%s yours to commit." % (len(yours), "" if len(yours) == 1 else "s"),
        "yours": yours,
        "exitCode": 0,
    }


def AdoptRepository(request: AdoptRepositoryRequest) -> AdoptRepositoryResponse:
    """step.adopt-repository: the tracker made under the home, keyed to this checkout.

    Nothing of the tracker's goes into the repository. Two lines in the
    checkout's own .git/config: the key, and the adapter chosen -- the one
    named, else the one the workspace already has, else local. The store is
    under ~/.dotdiw/<key>/, made by that adapter when the tracker is opened,
    and a second open changes nothing. The prefix given goes to the
    adapter, which honours it where it can. One adoption of a checkout runs
    at a time (adoption_lock), and reads the key afresh once it runs: a
    second adoption at once finds the key the first wrote, and writes none.
    A move opens its target under the same lock, so that an adoption and a
    move cannot each find the tracker unopened and record a store of their
    own, the later over the earlier.
    """
    root = request["root"]
    if not git(["rev-parse", "--is-inside-work-tree"], root).strip():
        # There is no .git/config to key from, and a tracker's own init
        # might run git init on the worker's behalf.
        return {
            "status": "failed",
            "summary": "Not a git repository.",
            "reason": "not-a-repository",
            "exitCode": 2,
        }
    # One adoption of a checkout at a time, from reading its key through
    # writing its choice, and the key read again once held: two adoptions of
    # a checkout with no key would each find none and write their own, and
    # the one written second would take the checkout from the work made
    # under the first.
    lock = adoption_lock(root)
    with held_at(lock, until_logged=False) as held:
        if not held:
            return {"status": "failed", "summary": ADOPTION_BUSY % "adopted", "exitCode": 1}
        forget_workspace(root)
        prefix = request.get("prefix")
        ws = workspace(root)
        if ws is None:
            git(["config", "--local", WORKSPACE_KEY, os.urandom(8).hex()], root)
            forget_workspace(root)
            ws = workspace(root)
            if ws is None:
                return {
                    "status": "failed",
                    "summary": NOT_WRITTEN % WORKSPACE_KEY,
                    "reason": "key-not-written",
                    "exitCode": 1,
                }
        try:
            os.makedirs(
                ws, exist_ok=True
            )  # the workspace is this tool's; the store inside it is the adapter's
        except OSError as e:
            return {
                "status": "failed",
                "summary": str(e),
                "workspace": ws,
                "reason": "workspace-not-made",
                "exitCode": 1,
            }
        name, adapter = resolve_tracker({"root": root, "tracker": request.get("tracker")})
        if adapter is None:
            refused = tracker_unknown(AdoptRepositoryResponse, name)
            refused["workspace"], refused["created"], refused["tracker"] = ws, False, name
            return refused
        opened = invoke_tracker(
            "operation.open-tracker",
            {"root": root, "tracker": name, "prefix": prefix},
        )
        code = opened.get("exitCode", 0 if opened["status"] == "completed" else 1)
        if code != 0:
            return {
                "status": "failed",
                "summary": opened["summary"],
                "workspace": ws,
                "created": False,
                "reason": opened.get("reason") or "init-failed",
                "tracker": name,
                "exitCode": code,
            }
        if tracker_name(root) != name:  # written last: a store that did not open is not a choice
            git(["config", "--local", TRACKER_KEY, name], root)
            forget_workspace(root)
            if tracker_name(root) != name:
                return {
                    "status": "failed",
                    "summary": NOT_WRITTEN % TRACKER_KEY,
                    "workspace": ws,
                    "created": False,
                    "reason": "key-not-written",
                    "tracker": name,
                    "exitCode": 1,
                }
    created = bool(opened.get("created"))
    # Said once, before any work is written: the worst failure here is writing to
    # a tracker as the wrong person.
    actor = None
    if created:
        described = invoke_tracker("operation.describe-tracker", {"root": root, "tracker": name})
        actor = described.get("actor")
    return {
        "status": "completed",
        "summary": "Adopted under %s." % ws if created else "Already adopted.",
        "workspace": ws,
        "created": created,
        "tracker": name,
        "actor": actor,
        "exitCode": 0,
    }


def AdoptARepository(request: AdoptARepositoryRequest) -> AdoptARepositoryResponse:
    """journey.adopt-a-repository: one command; the tracker under the home, the declaration
    in the tree."""
    root, tracker = request["root"], request.get("tracker")
    invoke("operation.turn-metrics-off", {"root": root, "tracker": tracker})
    # What an earlier version left is put right first, so that a tracker kept
    # in the tree is adopted under the home with its own prefix; when it cannot
    # be, nothing else is adopted.
    undone = invoke(
        "operation.undo-earlier-adoption", {"root": root, "tracker": tracker, "apply": True}
    )
    if undone["status"] != "completed":
        return {"status": "failed", "summary": undone["summary"], "exitCode": 1}
    made = invoke(
        "operation.adopt-repository",
        {"root": root, "prefix": request.get("prefix"), "tracker": tracker},
    )
    if made["status"] != "completed":
        # Nothing was adopted, so there is nothing to declare work starts in.
        return {"status": made["status"], "summary": made["summary"], "exitCode": made["exitCode"]}
    declared = invoke("operation.declare-conventions", {"root": root, "announce": "init"})
    invoke("operation.report-what-is-yours-to-commit", {"root": root, "paths": declared["changed"]})
    return {
        "status": made["status"],
        "summary": made["summary"],
        "workspace": made.get("workspace"),
        "exitCode": made["exitCode"],
    }


