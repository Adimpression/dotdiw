def show_forward(request: Request, response: Response) -> None:
    """The pass-through showed itself; a command answered in records is
    shown here, in the shape the tracker underneath used to print."""
    if response.get("reason") == "not-installed":
        sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))
        return
    if response.get("reason") in ("unsupported-command", "tracker-unknown", "adapter-failed"):
        sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))
        return
    if response.get("printed"):
        return
    if not response.get("operation"):
        if response["status"] != "completed":
            sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))
        else:
            sys.stdout.write(response.get("output") or "")
        return
    glyphs = {"open": "\u25cb", "in_progress": "\u25d0", "blocked": "\u25cf", "closed": "\u2713"}
    as_json = "--json" in (request.get("arguments") or [])

    def line(item: dict[str, Any]) -> str:
        return "%s %s P%s %s" % (
            glyphs.get(item.get("status") or "", "?"),
            item["id"],
            item.get("priority", 2),
            item.get("title", ""),
        )

    def draw(item: dict[str, Any], kids: dict[str, Any], seen: set[str], lead: str) -> None:
        """An item's children under it, to any depth, each item once."""
        seen.add(item["id"])
        below = [k for k in kids.get(item["id"], []) if k["id"] not in seen]
        for n, child in enumerate(below):
            last = n == len(below) - 1
            print(
                "%s%s %s"
                % (lead, "\u2514\u2500\u2500" if last else "\u251c\u2500\u2500", line(child))
            )
            draw(child, kids, seen, lead + ("    " if last else "\u2502   "))

    written: list[dict[str, Any]] = []
    for answer in response.get("answers") or []:
        if answer["status"] != "completed":
            if answer.get("reason") == "blocked":
                sys.stderr.write(
                    "cannot close blocked issue: %s is blocked by [%s]\n"
                    % (answer["summary"].split(" ", 1)[0], ", ".join(answer.get("blockedBy") or []))
                )
            else:
                sys.stderr.write("%s: %s\n" % (PROG, answer["summary"]))
            continue
        operation = response["operation"]
        if operation in ("operation.list-items", "operation.ready-items"):
            items = answer.get("items") or []
            if as_json:
                print(json.dumps(items, indent=2, ensure_ascii=False))
                continue
            byid = {i["id"]: i for i in items}
            kids: dict[str, list[dict[str, Any]]] = {}
            for i in items:
                if i.get("parent") in byid:
                    kids.setdefault(i["parent"], []).append(i)
            seen: set[str] = set()
            for i in items:
                if i.get("parent") not in byid:
                    print(line(i))
                    draw(i, kids, seen, "")
            for i in items:  # a loop of parents has no root: each is still printed
                if i["id"] not in seen:
                    print(line(i))
                    draw(i, kids, seen, "")
            if operation == "operation.ready-items":
                print(
                    "\nReady: %d issue%s with no active blockers"
                    % (len(items), "" if len(items) == 1 else "s")
                )
            else:
                open_, active = (
                    sum(1 for i in items if i.get("status") != "closed"),
                    sum(1 for i in items if i.get("status") == "in_progress"),
                )
                print(
                    "\nTotal: %d issue%s (%d open, %d in progress)"
                    % (len(items), "" if len(items) == 1 else "s", open_, active)
                )
        elif operation == "operation.show-item":
            item = answer["item"]
            if as_json:
                print(
                    json.dumps(
                        dict(item, children=answer.get("children") or []),
                        indent=2,
                        ensure_ascii=False,
                    )
                )
                continue
            print(
                "%s %s \u00b7 %s   [P%s \u00b7 %s]"
                % (
                    glyphs.get(item["status"], "?"),
                    item["id"],
                    item["title"],
                    item.get("priority", 2),
                    item["status"].upper(),
                )
            )
            print("Type: %s" % (item.get("kind") or "task"))
            print(
                "Created: %s \u00b7 Updated: %s"
                % ((item.get("createdAt") or "")[:10], (item.get("updatedAt") or "")[:10])
            )
            if item.get("assignee"):
                print("Assignee: %s" % item["assignee"])
            if item.get("reason"):
                print("Close reason: %s" % item["reason"])
            if item.get("parent"):
                print("\nPARENT\n  \u2191 %s" % item["parent"])
            if item.get("needs"):
                print("\nDEPENDS ON")
                for n in item["needs"]:
                    print("  \u2192 %s" % n)
            if answer.get("children"):
                print("\nCHILDREN")
                for child in answer["children"]:
                    print("  \u21b3 %s" % line(child))
        elif operation == "operation.close-item":
            item = answer.get("item") or {}
            if as_json:
                written.append(item)
                continue
            for ident in answer.get("closedIds") or []:
                title = item.get("title", "") if ident == item.get("id") else ""
                reason = item.get("reason") if ident == item.get("id") else "every step closed"
                print(
                    "\u2713 Closed %s%s%s"
                    % (ident, " \u2014 " + title if title else "", ": " + reason if reason else "")
                )
            if not answer.get("closedIds"):
                print("%s was closed already" % item.get("id"))
        elif operation == "operation.update-item":
            item = answer["item"]
            if as_json:
                written.append(item)
                continue
            print("\u2713 Updated issue: %s \u2014 %s" % (item["id"], item["title"]))
        elif operation == "operation.add-need":
            edge = answer["edge"]
            if as_json:
                print(json.dumps(edge, indent=2, ensure_ascii=False))
                continue
            print("\u2713 Added dependency: %s depends on %s" % (edge["id"], edge["needs"]))
    if written:
        print(json.dumps(written, indent=2, ensure_ascii=False))


