def IndexTheProject(request):
    """step.index-the-project: the committed formulas, indexed with the project's own text.

    These documents are indexed and never returned. Their only job is to tell
    bm25 that "write", "test" and "version" are everyday words in this
    project, which a corpus of four formulas cannot work out on its own. On
    four documents of prose "version" was distinctive enough to pull up the
    release formula for a Go toolchain bump; on twenty-two it is not.
    """
    root = request["root"]
    held = held_index(root)
    if held is not None and (held[1] is not None or not request.get("background", True)):
        forms, idx = held
        return {"status": "completed",
                "summary": "%d committed formula%s." % (len(forms), "" if len(forms) == 1 else "s"),
                "formulaCount": len(forms), "exitCode": 0}
    rels = [p for p in git(["ls-files", "-z", "--", "*.formula.toml",
                            "*.formula.json"], root).split("\0") if p]
    if rels and tomllib is None:
        # Silently returning nothing here is the worst available answer: the
        # project is full of formulas and the tool says it holds none.
        return {"status": "failed",
                "summary": "%s needs Python 3.11 or newer to read formulas, and this is %d.%d."
                % (PROG, sys.version_info[0], sys.version_info[1]),
                "fileCount": len(rels), "formulaCount": 0, "exitCode": 3}
    forms = []
    for rel in rels:
        f = load_formula(root, rel)
        if f:
            forms.append(f)

    idx = None
    if request.get("background", True):
        bg = []
        for rel in git(["ls-files", "-z"], root).split("\0"):
            if not rel or rel.endswith(".formula.toml") or rel.endswith(".formula.json"):
                continue
            if os.path.splitext(rel)[1].lower() not in CORPUS_EXTS:
                continue
            p = os.path.join(root, rel)
            try:
                if os.path.getsize(p) > CORPUS_BYTES:
                    continue
                with open(p, errors="ignore") as fh:
                    bg.append(fh.read())
            except OSError:
                continue
            if len(bg) >= CORPUS_FILES:
                break
        idx = Index(forms, bg)
    hold_index(root, forms, idx)
    return {"status": "completed",
            "summary": "%d committed formula%s." % (len(forms), "" if len(forms) == 1 else "s"),
            "fileCount": len(rels), "formulaCount": len(forms), "exitCode": 0}


def ResolveFormula(request):
    """step.resolve-formula: a formula by its id, its file name, or its path."""
    root = request["root"]
    built = invoke("operation.index-the-project", {"root": root, "background": False})
    if built["status"] != "completed":
        return {"status": "failed", "summary": built["summary"], "exitCode": built["exitCode"]}
    forms = held_index(root)[0]
    ident = (request.get("ident") or "").strip()
    found = None
    if ident:
        base = os.path.basename(ident).split(".")[0]
        for f in forms:
            if ident in (f["id"], f["name"], f["rel"]) or base in (f["id"], f["name"]):
                found = f
                break
    return {"status": "completed" if found else "blocked",
            "summary": ("Resolved %s to %s." % (ident, found["rel"])) if found
            else "%s names no committed formula." % (ident or "nothing"),
            "formulaRef": found["id"] if found else None,
            "path": found["rel"] if found else None, "exitCode": 0}


def ListFormulas(request):
    """step.list-formulas: what this project holds.

    bd answers this question about its own search paths, so in a project whose
    formulas sit next to what they are about it says "No formulas found" --
    which is true of `.beads/formulas` and false of the project. Every agent in
    the trial believed it and moved the formulas. This answers about the
    project, which is what was asked.
    """
    root = request["root"]
    built = invoke("operation.index-the-project", {"root": root, "background": False})
    if built["status"] != "completed":
        return {"status": "failed", "summary": built["summary"], "exitCode": built["exitCode"]}
    forms = held_index(root)[0]
    return {"status": "completed", "summary": "%d formulas listed." % len(forms),
            "formulas": [held_formula(f) for f in forms], "formulaCount": len(forms),
            "exitCode": 0}


def ShowFormula(request):
    """step.show-formula: the formula as it is written, from where it is written."""
    root = request["root"]
    r = invoke("operation.resolve-formula", {"root": root, "ident": request.get("ident")})
    if r["status"] != "completed":
        return {"status": r["status"], "summary": r["summary"], "exitCode": r["exitCode"]}
    try:
        with open(os.path.join(root, r["path"]), encoding="utf-8") as fh:
            text = fh.read()
    except OSError as e:
        return {"status": "failed", "summary": str(e), "path": r["path"], "exitCode": 1}
    return {"status": "completed", "summary": "Showed %s." % r["path"],
            "path": r["path"], "text": text, "exitCode": 0}


def FindAHeldProcedure(request):
    """journey.find-a-held-procedure: list, show or resolve, by what is asked."""
    root = request["root"]
    built = invoke("operation.index-the-project", {"root": root, "background": False})
    if built["status"] != "completed":
        return {"status": "failed", "summary": built["summary"], "exitCode": built["exitCode"]}
    ask = request.get("ask")
    if ask == "list":
        return invoke("operation.list-formulas", {"root": root, "json": request.get("json")})
    if ask == "show":
        return invoke("operation.show-formula", {"root": root, "ident": request.get("ident")})
    return invoke("operation.resolve-formula", {"root": root, "ident": request.get("ident")})


def MatchFormulas(request):
    """step.match-formulas: the procedures that apply to a title.

    The one place a title is ranked against the project's formulas. The
    conventions check reuses it with one example taken out of the index, and
    the handmade notice reuses it to see whether a formula already reaches a
    title -- both through this body, so the threshold lives here once, and
    both with `surface` false, so what they find is returned and not shown.
    """
    root = request["root"]
    built = invoke("operation.index-the-project", {"root": root, "background": True})
    if built["status"] != "completed":
        return {"status": "failed", "summary": built["summary"], "exitCode": built["exitCode"]}
    forms, idx = held_index(root)
    text = "%s %s" % (request.get("title") or "", request.get("description") or "")
    words = toks(text)
    ranked = []
    taken_out = contextlib.nullcontext()
    exclude = request.get("exclude")
    if exclude:
        # The example named, where the index holds it: the formula's position
        # and the example's within it.
        for i, f in enumerate(forms):
            if f["id"] == exclude.get("formulaRef") and exclude.get("example") in f["examples"]:
                taken_out = idx.without_example(i, f["examples"].index(exclude["example"]))
                break
    with taken_out:
        rows = idx.rows(words) if forms else []
        total = sum(idx.weight(w) for w in words) if rows else 0
        for rowid, score in rows:
            held = sum(idx.weight(w) for w in words if rowid in idx.spread(w)[0])
            if total and held / total >= COVERAGE:
                ranked.append((score, forms[rowid - 1]))
    ranked.sort(key=lambda r: (-r[0], r[1]["name"]))
    seen, top = set(), []
    for score, f in ranked:
        if f["name"] in seen:
            continue
        seen.add(f["name"])
        top.append(f)
        if len(top) == TOP_N:
            break
    return {"status": "completed",
            "summary": "%d formula%s apply." % (len(top), "" if len(top) == 1 else "s"),
            "surfaced": [held_formula(f) for f in top], "exitCode": 0}


def NoticeHandmadeProcedures(request):
    """step.notice-handmade-procedures: procedures this project carried out but never declared.

    Pouring a formula leaves a molecule behind. A parent that is not a molecule,
    with several ordered children, is that same shape built by hand: the
    procedure exists, in the tracker, where nothing can match it against a
    title or pour it a second time. Unlike a guess at what two titles have in
    common, this cannot misfire -- the DAG is either there or it is not.
    Suppressed once a formula reaches the title, which is what writing it down
    means -- so this stops the moment it is acted on, and `--from` turns the
    work that was actually done into the steps.
    """
    root = request["root"]
    code, out = bd_quiet(["list", "--all", "--json", "--brief", "-n", "300"])
    rows = []
    if code == 0:
        try:
            rows = json.loads(out)
        except (ValueError, TypeError):
            rows = []
    byid, kids = {}, {}
    for r in rows:
        if not isinstance(r, dict):
            continue
        byid[r.get("id")] = r
        if r.get("parent"):
            kids.setdefault(r["parent"], []).append(r)
    found = []
    for pid, ks in sorted(kids.items(), key=lambda kv: -len(kv[1])):
        p = byid.get(pid) or {}
        if p.get("issue_type") in ("molecule", "epic"):
            continue
        if len(ks) < HANDMADE_STEPS:
            continue
        if not any(d.get("type") == "blocks"
                   for k in ks for d in (k.get("dependencies") or [])):
            continue
        title = " ".join(str(p.get("title") or "").split())
        if invoke("operation.match-formulas",
                  {"root": root, "title": title, "surface": False})["surfaced"]:
            continue
        found.append((pid, title, len(ks)))
    return {"status": "completed",
            "summary": "%d undeclared procedure%s." % (len(found), "" if len(found) == 1 else "s"),
            "undeclared": [{"workRef": pid, "title": title, "stepCount": k}
                           for pid, title, k in found],
            "exitCode": 0}


def NudgeTowardsAFormula(request):
    """step.nudge-towards-a-formula: a memory that reads like a procedure.

    A procedure kept as a memory is one nothing can match or instantiate.
    Three agents in five reached for this instead of writing a formula.
    """
    text = request.get("text") or ""
    t = " " + " ".join(text.lower().split()) + " "
    procedural = sum(1 for w in PROCEDURAL if w in t) >= 2
    command = None
    if procedural:
        # Cut to a word, not to a letter: this goes in a command to be copied.
        short = " ".join(text.split())
        if len(short) > 60:
            short = short[:short.rfind(" ", 0, 61)]
        command = "%s formula new \"%s\"" % (PROG, short)
    return {"status": "completed",
            "summary": "Reads like a procedure." if procedural else "Reads like a fact.",
            "nudged": procedural, "command": command, "exitCode": 0}


# The rest of WriteFormula's body: the titles the project has already given
# its work, and an issue's children as steps. Used by nothing else.

class Titles:
    """The work this project has already named, matched the way formulas are.

    Word weights come from the formula index, whose background is the project's
    own prose -- so "menu" counts as distinctive here for the same reason it
    does there, and this table holds nothing but the titles.
    """

    def __init__(self, titles, idx):
        self.titles = titles
        self.idx = idx
        self.db = sqlite3.connect(":memory:")
        try:
            self.db.execute("CREATE VIRTUAL TABLE t USING fts5(body, "
                            "tokenize='porter unicode61')")
        except sqlite3.Error:
            no_fts5()
        self.db.executemany("INSERT INTO t VALUES (?)",
                            [(t,) for t in titles])
        self._held = {}

    def holders(self, word):
        if word not in self._held:
            self._held[word] = frozenset(
                r[0] for r in self.db.execute(
                    "SELECT rowid FROM t WHERE t MATCH ?", ('"%s"' % word,)))
        return self._held[word]

    def echoes(self, text):
        """Earlier titles that look like this one, for seeding examples."""
        words = toks(text)
        if not words or not self.titles:
            return []
        total = sum(self.idx.weight(w) for w in words)
        if not total:
            return []
        out = []
        for i, t in enumerate(self.titles):
            held = sum(self.idx.weight(w) for w in words
                       if (i + 1) in self.holders(w))
            if held / total >= SEED:
                out.append((held / total, t))
        out.sort(key=lambda r: (-r[0], r[1]))
        return out


def slug(title, limit=4):
    words = [w for w in re.findall(r"[a-z0-9]+", title.lower())
             if len(w) >= 2 and w not in STOP]
    return "-".join(words[:limit]) or "procedure"


def past_titles(drop=None, limit=300):
    """The top-level work this project has named before.

    Children of a poured molecule are left out: those titles came out of a
    formula, so counting them as evidence that a formula is wanted is
    circular. `drop` removes one copy of a title -- the one `create` just made.
    """
    code, out = bd_quiet(["list", "--all", "--json", "--brief",
                          "-n", str(limit)])
    if code != 0:
        return []
    try:
        rows = json.loads(out)
    except (ValueError, TypeError):
        return []
    titles = []
    for r in rows:
        if not isinstance(r, dict) or r.get("parent"):
            continue
        if r.get("issue_type") in ("molecule", "epic"):
            continue
        t = " ".join(str(r.get("title") or "").split())
        if t:
            titles.append(t)
    if drop:
        drop = " ".join(drop.split())
        if drop in titles:
            titles.remove(drop)
    return titles


def steps_from(ident, limit=300):
    """An issue's children as steps, with its blocks edges as `needs`.

    The highest-fidelity capture there is: the procedure as it was actually
    carried out, rather than as someone remembers it afterwards.
    """
    code, out = bd_quiet(["list", "--all", "--json", "--brief",
                          "-n", str(limit)])
    if code != 0:
        return None
    try:
        rows = json.loads(out)
    except (ValueError, TypeError):
        return None
    byid = {r.get("id"): r for r in rows if isinstance(r, dict)}
    hit = [i for i in byid if i == ident or str(i).endswith("-" + ident)]
    if len(hit) != 1:
        return None
    parent = hit[0]
    kids = [r for r in rows if r.get("parent") == parent]
    if not kids:
        return None
    ids, used = {}, set()
    for r in kids:
        sid, k = slug(str(r.get("title") or ""), 3), 1
        while sid in used:
            k += 1
            sid = "%s-%d" % (slug(str(r.get("title") or ""), 3), k)
        used.add(sid)
        ids[r.get("id")] = sid
    needs = {}
    for r in kids:
        needs[ids[r["id"]]] = [ids[d.get("depends_on_id")]
                               for d in (r.get("dependencies") or [])
                               if d.get("type") == "blocks"
                               and d.get("depends_on_id") in ids]
    # In the order the work was done, not the order the tracker lists it: a
    # formula is read top to bottom by whoever has to follow it.
    order, left = [], [ids[r["id"]] for r in kids]
    while left:
        ready = [x for x in left if all(d in order for d in needs[x])]
        if not ready:                       # a cycle; keep what is left as-is
            order.extend(left)
            break
        order.extend(ready)
        left = [x for x in left if x not in ready]
    titles = {ids[r["id"]]: str(r.get("title") or "").replace('"', "'")
              for r in kids}
    out = []
    for sid in order:
        block = STEP % {"id": sid, "title": titles[sid]}
        if needs[sid]:
            block += "needs = [%s]\n" % ", ".join('"%s"' % x for x in needs[sid])
        out.append(block)
    return "\n".join(out)


def WriteFormula(request):
    """step.write-formula: a formula for work the project keeps doing.

    The expensive part of declaring a procedure was never the thinking, it was
    the TOML: fifteen agents in the trial wrote the procedure down as prose
    instead, where nothing can match it against a title or pour it into steps.
    This writes the file, seeds the examples from the titles the work has
    actually been given here, and leaves the thinking marked TODO.
    """
    root, title = request["root"], request.get("title") or ""
    at, frm = request.get("directory"), request.get("fromRef")
    if not title:
        return {"status": "failed", "summary": "No title given.", "reason": "no-title",
                "exitCode": 2}
    built = invoke("operation.index-the-project", {"root": root, "background": True})
    if built["status"] != "completed":
        return {"status": "failed", "summary": built["summary"], "exitCode": built["exitCode"]}
    idx = held_index(root)[1]
    cases = [title]
    for _, t in Titles(past_titles(), idx).echoes(title):
        if t not in cases:
            cases.append(t)
    steps = (frm and steps_from(frm)) or PLACEHOLDER_STEPS
    name = slug(title)
    path = os.path.join(at or os.getcwd(), name + ".formula.toml")
    if os.path.exists(path):
        return {"status": "failed", "summary": "The file already exists.",
                "path": os.path.relpath(path, root), "reason": "exists", "exitCode": 1}
    body = SCAFFOLD % {
        "p": PROG, "slug": name, "title": title.replace('"', "'"),
        "examples": "".join('  "%s",\n' % c.replace('"', "'") for c in cases),
        "steps": steps,
    }
    try:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(body)
    except OSError as e:
        return {"status": "failed", "summary": str(e), "path": os.path.relpath(path, root),
                "reason": "unwritable", "exitCode": 1}
    rel = os.path.relpath(path, root)
    done = frm and steps is not PLACEHOLDER_STEPS
    return {"status": "completed", "summary": "Wrote %s." % rel, "path": rel,
            "seeded": len(cases), "stepsFrom": frm if done else None,
            "left": ["description"] if done else ["description", "steps"],
            "exitCode": 0}


def DescribeAndCheck(request):
    """step.describe-and-check: the two conventions, checked rather than hoped for.

    Three places ask: `check` itself, in full; every `create`, quietly, with
    the first three problems; and `doctor` and `lint`, with the first five
    under the tracker's own report, because nobody in the trial ran `check`
    or `learn` and everybody ran those two. The request's `mode` names which,
    and the handmade notice rides along in the response for all three.
    """
    root, mode = request["root"], request.get("mode") or "check"
    built = invoke("operation.index-the-project", {"root": root, "background": True})
    if built["status"] != "completed":
        return {"status": "failed", "summary": built["summary"], "exitCode": built["exitCode"]}
    forms = held_index(root)[0]

    probs = []                                  # (kind, where, what)
    # Only once the project has adopted any of this: a plain repo is not in
    # breach of a convention it has never declared.
    if adopted(workspace(root)):
        if git(["ls-files", "-z", "--", ".beads"], root):
            probs.append(("convention", ".beads",
                          "tracked in git, left by an adoption before 0.4.0 -- "
                          "run: git rm -r -q .beads && git commit && rm -rf .beads"))
        for rel in CONVENTION_FILES:
            try:
                with open(os.path.join(root, rel), encoding="utf-8") as fh:
                    if MARK_OPEN in fh.read():
                        continue
            except OSError:
                pass
            probs.append(("convention", rel,
                          "does not say where work starts -- run `%s init`" % PROG))

    extra = []
    for rel in [p for p in git(["ls-files", "-z", "--others", "--exclude-standard",
                                "--", "*.formula.toml", "*.formula.json"],
                               root).split("\0") if p]:
        probs.append(("formula", rel, "not committed, so nobody else can see it"))
        f = load_formula(root, rel)
        if f:
            extra.append(f)

    home = os.path.expanduser("~/.beads/formulas")
    for p in sorted(glob.glob(os.path.join(home, "*.toml"))
                    + glob.glob(os.path.join(home, "*.json"))):
        probs.append(("formula", p, "outside the repo: the tracker finds it, nobody else does"))

    for f in forms + extra:
        n = len(f["desc"].split())
        if n < MIN_DESC_WORDS:
            probs.append(("formula", f["rel"],
                          "description is %d word%s -- write a sentence "
                          "naming the situation, and when to use it"
                          % (n, "" if n == 1 else "s")))
        try:
            with open(os.path.join(root, f["rel"]), encoding="utf-8") as fh:
                if "TODO" in fh.read():
                    probs.append(("formula", f["rel"],
                                  "still has TODO in it -- a scaffold is not yet a procedure"))
        except OSError:
            pass
        if len(f["examples"]) < MIN_EXAMPLES:
            probs.append(("formula", f["rel"], "has %d example title%s, needs %d"
                          % (len(f["examples"]),
                             "" if len(f["examples"]) == 1 else "s", MIN_EXAMPLES)))

    for f in forms:
        for ex in f["examples"]:
            top = [s["name"] for s in invoke(
                "operation.match-formulas",
                {"root": root, "title": ex, "surface": False,
                 "exclude": {"formulaRef": f["id"], "example": ex}})["surfaced"]]
            if f["name"] not in top:
                probs.append(("formula", f["rel"], 'example "%s" does not retrieve it' % ex))

    noticed = invoke("operation.notice-handmade-procedures", {"root": root})
    return {"status": "completed" if not probs else "blocked",
            "summary": "%d problem%s." % (len(probs), "" if len(probs) == 1 else "s"),
            "problems": [{"kind": k, "where": w, "what": x} for k, w, x in probs],
            "undeclared": noticed["undeclared"], "formulaCount": len(forms),
            "exitCode": 1 if probs and mode == "check" else 0}


def CommitFormula(request):
    """step.commit-formula: the one step dotdiw never performs.

    The commit is the worker's act, which the project asks for; a tool that
    made it would be deciding what goes into history on somebody's behalf.
    So this body refuses, and says exactly what to run instead.
    """
    path = request.get("path") or "<the formula file>"
    command = "git add %s && git commit -m \"Add the %s formula\"" % (
        path, os.path.basename(path).split(".")[0])
    return {"status": "blocked",
            "summary": "The commit is the worker's: %s never commits, pushes or syncs." % PROG,
            "command": command, "exitCode": 0}


def WriteAProcedureDown(request):
    """journey.write-a-procedure-down, as one executable: notice, nudge, write, check, and stop at the commit."""
    root = request["root"]
    built = invoke("operation.index-the-project", {"root": root, "background": True})
    if built["status"] != "completed":
        return {"status": "failed", "summary": built["summary"], "exitCode": built["exitCode"]}
    invoke("operation.notice-handmade-procedures", {"root": root})
    if request.get("text"):
        invoke("operation.nudge-towards-a-formula", {"root": root, "text": request["text"]})
    path = request.get("path")
    if request.get("title"):
        written = invoke("operation.write-formula",
                         {"root": root, "title": request["title"],
                          "directory": request.get("directory"),
                          "fromRef": request.get("fromRef")})
        if written["status"] != "completed":
            return {"status": written["status"], "summary": written["summary"],
                    "path": written.get("path"), "exitCode": written["exitCode"]}
        path = written["path"]
    checked = invoke("operation.describe-and-check", {"root": root, "mode": "check"})
    commit = invoke("operation.commit-formula", {"root": root, "path": path})
    return {"status": "blocked", "summary": commit["summary"],
            "command": commit["command"], "problems": checked["problems"],
            "path": path, "exitCode": checked["exitCode"]}


# ------------------------------------------- duty.put-all-four-under-one-name

def ForwardToTheTracker(request):
    """step.forward-to-the-tracker: the command, unchanged, with bd's name rewritten on the way back.

    The rewrite is the whole of "one name for all four", so it happens in
    this body and nowhere else: every operation that runs a tracker command
    with the worker's terminal comes through here. A close that succeeded
    names the ids it closed, and the door writes the steps and molecules
    among them to the witness log; this body knows nothing of the log.
    """
    argv = list(request["arguments"])
    code, out = run_bd(argv, lambda s: _BD_WORD.sub(PROG, s),
                       lambda b: _BD_WORD_B.sub(PROG.encode(), b))
    closed = []
    if code == 0 and argv and argv[0] == "close":
        closed = [a for a in argv[1:] if not a.startswith("-")]
    return {"status": "completed" if code == 0 else "failed",
            "summary": "%s %s exited %d." % ("tracker", argv[0] if argv else "", code),
            "exitCode": code, "output": out, "closedRefs": closed}


def RunATrackerCommand(request):
    """journey.run-a-tracker-command: forward, with what rides along on cook, doctor, lint and remember."""
    root, argv = request["root"], list(request["arguments"])
    # `cook <id>` means that formula's file, wherever in the tree it sits.
    if argv and argv[0] == "cook" and len(argv) > 1 and not argv[1].startswith("-"):
        r = invoke("operation.resolve-formula", {"root": root, "ident": argv[1]})
        if r["status"] == "completed" and not os.path.exists(argv[1]):
            argv = ["cook", os.path.join(root, r["path"])] + argv[2:]
    fwd = invoke("operation.forward-to-the-tracker", {"root": root, "arguments": argv})
    # The conventions, checked where someone actually looks. Nobody in the
    # trial ran `check` or `learn`; they ran these two.
    if argv and argv[0] in ("doctor", "lint"):
        invoke("operation.describe-and-check", {"root": root, "mode": "doctor"})
    if argv and argv[0] == "remember" and fwd["exitCode"] == 0:
        invoke("operation.nudge-towards-a-formula",
               {"root": root, "text": " ".join(argv[1:])})
    return {"status": fwd["status"], "summary": fwd["summary"],
            "exitCode": fwd["exitCode"]}


# --------------------------------- duty.surface-procedures-when-work-starts

def NameTheWork(request):
    """step.name-the-work: the work item, created under the title given."""
    root = request["root"]
    fwd = invoke("operation.forward-to-the-tracker",
                 {"root": root, "arguments": request["arguments"]})
    work = None
    if fwd["exitCode"] == 0:
        m = re.search(r"Created issue:\s+(\S+)", fwd.get("output") or "")
        work = m.group(1) if m else None
    return {"status": fwd["status"],
            "summary": "Named %s." % (work or "the work") if fwd["exitCode"] == 0
            else "The tracker refused the create.",
            "workRef": work, "exitCode": fwd["exitCode"]}


def PourProcedure(request):
    """step.pour-procedure: a surfaced formula becomes tracked, ordered steps.

    Cooks the formula from where it actually lives, every time. bd pours only
    what it has cooked, and cooks only from its own directories; cooking by
    path closes that gap, so a formula never has to be moved or linked out of
    the place it belongs. Unconditionally, and with --force, because the file
    is the formula: cooking only when bd had never heard of the id meant that
    a formula edited in place poured the version bd happened to hold -- found
    by editing this project's own commit formula and watching `mol pour`
    instantiate the step that edit had just removed.
    """
    root = request["root"]
    r = invoke("operation.resolve-formula", {"root": root, "ident": request.get("ident")})
    found = r["status"] == "completed"
    argv = ["mol", "pour", request.get("ident")] + list(request.get("arguments") or [])
    if found:
        path = os.path.join(root, r["path"])
        code, _ = bd_quiet(["cook", path, "--persist", "--force"])
        if code != 0:
            # Older bd without --force on cook: the stale proto is better
            # than none, and bd may already hold the formula.
            code, _ = bd_quiet(["cook", path, "--persist"])
            if code != 0:
                code, _ = bd_quiet(["formula", "show", r["formulaRef"]])
        if code == 0:
            argv = ["mol", "pour", r["formulaRef"]] + list(request.get("arguments") or [])
    fwd = invoke("operation.forward-to-the-tracker", {"root": root, "arguments": argv})

    molecule, steps = None, []
    if fwd["exitCode"] == 0 and found:
        m = re.search(r"Root issue:\s+(\S+)", fwd.get("output") or "")
        molecule = m.group(1) if m else None
        if molecule:
            # The steps the pour made, so that the witness can record them
            # with the molecule; the body cannot know whether the log is on.
            code, out = bd_quiet(["list", "--all", "--json", "--brief", "-n", "300"])
            if code == 0:
                try:
                    steps = sorted(str(x.get("id")) for x in json.loads(out)
                                   if isinstance(x, dict) and x.get("parent") == molecule)
                except (ValueError, TypeError):
                    steps = []
    return {"status": fwd["status"], "summary": fwd["summary"],
            "formulaRef": r["formulaRef"] if found else None,
            "moleculeRef": molecule, "stepRefs": steps, "exitCode": fwd["exitCode"]}


def StartNamedWork(request):
    """journey.start-named-work: name it, read what applies, and -- when asked -- pour."""
    root = request["root"]
    named = invoke("operation.name-the-work",
                   {"root": root, "arguments": request["arguments"],
                    "title": request.get("title")})
    if named["exitCode"] != 0:
        return named
    if request.get("quiet"):
        return {"status": "completed", "summary": named["summary"],
                "workRef": named["workRef"], "surfaced": [], "exitCode": 0}

    invoke("operation.declare-conventions", {"root": root, "announce": "create"})
    built = invoke("operation.index-the-project", {"root": root, "background": True})
    if built["status"] != "completed":
        return {"status": "failed", "summary": built["summary"],
                "workRef": named["workRef"], "exitCode": built["exitCode"]}
    matched = invoke("operation.match-formulas",
                     {"root": root, "title": request.get("title"),
                      "description": request.get("description"),
                      "workRef": named["workRef"]})
    invoke("operation.describe-and-check", {"root": root, "mode": "quiet"})
    if request.get("formulaRef"):
        invoke("operation.pour-procedure",
               {"root": root, "ident": request["formulaRef"], "workRef": named["workRef"]})
    return {"status": "completed", "summary": named["summary"],
            "workRef": named["workRef"], "surfaced": matched["surfaced"],
            "exitCode": 0}


# ------------------------------------------ duty.adopt-without-reaching-outside

def TurnMetricsOff(request):
    """step.turn-metrics-off: bd's usage metrics off for this machine, and say so once.

    Runs before any other bd command, on every run, so a fresh machine, a bd
    upgrade or `bd metrics on` all get the same answer. Silent when they are
    already off, which is every run but the first.
    """
    def off_already():
        try:
            with open(os.path.expanduser(BD_CONFIG), encoding="utf-8") as fh:
                text = fh.read()
        except OSError:
            return False
        block = re.search(r"(?m)^metrics:[ \t]*\n((?:[ \t]+.*\n?)*)", text)
        return bool(block and re.search(r"(?m)^[ \t]+disabled:[ \t]*[Tt]rue[ \t]*$",
                                        block.group(1)))

    if off_already() or not find_bd():
        return {"status": "completed", "summary": "Metrics were already off.",
                "turnedOff": False, "exitCode": 0}
    bd_quiet(["metrics", "off"])
    if not off_already():
        return {"status": "failed", "summary": "The tracker did not turn its metrics off.",
                "turnedOff": False, "exitCode": 0}
    return {"status": "completed", "summary": "Turned the tracker's metrics off.",
            "turnedOff": True, "exitCode": 0}


def UndoEarlierAdoption(request):
    """step.undo-earlier-adoption: what an earlier version let bd do to a repository, put right and said.

    v0.1.0 let bd point core.hooksPath at its own directory, which is undone
    here because it decides which hooks git runs. Every version before 0.4.0
    kept bd's tracker in the tree -- v0.1.0 with a Dolt remote aimed at the
    git remote, 0.2.x committed, 0.3.0 excluded. That is the upgrade: a
    tracker is made under the home with the old prefix, once, on the first
    command, and the in-tree copy is left exactly as it is, unused, for the
    worker to remove with the command named; a remote inside it reaches
    nothing, since no bd runs there any more. Earlier tasks are not carried
    over, and that is said. Silence when there was nothing to do.
    """
    root = request["root"]

    def hooks_replaced():
        """bd's hook directory standing in for the repository's own, or ""."""
        got = git(["config", "--get", HOOKS_KEY], root).strip()
        if not got:
            return ""
        # realpath, not normpath: on macOS a checkout under /var or /tmp is
        # reached through a symlink, and `git rev-parse` hands back the
        # resolved path while the configured value keeps whichever form it
        # was written in. Comparing the two unresolved left the override in
        # place and said nothing -- the worst of both. Found by the test.
        mine = os.path.realpath(os.path.join(root, ".beads", "hooks"))
        return got if os.path.realpath(os.path.join(root, got)) == mine else ""

    done = []
    got = hooks_replaced()
    if got:
        git(["config", "--unset", HOOKS_KEY], root)
        if not hooks_replaced():
            done.append("%s is unset. It pointed at %s, a snapshot of this "
                        "repository's hooks taken when it was adopted, so any "
                        "hook added since was being skipped; .git/hooks is read "
                        "again." % (HOOKS_KEY, got))

    # The upgrade: a tracker in the tree and no key means a version before
    # 0.4.0 adopted this repository. Adopt it under the home now, with the
    # old prefix, so the command that was typed just works.
    ws = workspace(root)
    in_tree = os.path.isdir(os.path.join(root, ".beads"))
    made = None
    if in_tree and not adopted(ws):
        result = invoke("operation.adopt-repository",
                        {"root": root, "arguments": ["init"], "quiet": True})
        if result["exitCode"] == 0:
            made = result["workspace"]
            ws = made
    command = None
    if in_tree and adopted(ws):
        if git(["ls-files", "-z", "--", ".beads"], root):
            # git rm takes the tracked files; the database bd kept beside them
            # was never tracked, so the directory is removed after.
            command = ("git rm -r -q .beads && git commit -m \"Remove the tracker's files "
                       "from the repository\" && rm -rf .beads .beads.gate.lock")
        else:
            command = "rm -rf .beads .beads.gate.lock"

    n = len(done) + bool(made)
    return {"status": "completed",
            "summary": "%d thing%s put right." % (n, "" if n == 1 else "s"),
            "undone": done, "workspace": ws, "adopted": made, "command": command,
            "hooksReplaced": bool(got), "exitCode": 0}


def DeclareConventions(request):
    """step.declare-conventions: the files agents read say where work starts, and name dotdiw.

    Three edits, each idempotent: bd renamed to dotdiw in every file an
    earlier version let it write for agents, which bd writes again on setup,
    doctor --fix and upgrades; the declaration between its markers in
    CLAUDE.md and AGENTS.md, created when absent; and the one exception
    inside bd's own git policy where those files carry it.
    """
    root = request["root"]

    renamed = []
    paths = [os.path.join(root, rel) for rel in AGENT_FILES]
    for rel in AGENT_TREES:
        for dirpath, _, names in os.walk(os.path.join(root, rel)):
            paths.extend(os.path.join(dirpath, n) for n in names)
    for path in paths:
        try:
            with open(path, encoding="utf-8") as fh:
                before = fh.read()
        except (OSError, UnicodeDecodeError, ValueError):
            continue
        after = _BD_WORD.sub(PROG, before)
        if after == before:
            continue
        try:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(after)
        except OSError:
            continue
        renamed.append(os.path.relpath(path, root))

    declared = []
    # Let the project's own declaration satisfy bd's git policy. Without this
    # the instruction files contradict each other, the stricter sentence wins,
    # and the formula stays uncommitted -- which by this design's own rule
    # means the project does not hold it.
    for rel in CONVENTION_FILES:
        path = os.path.join(root, rel)
        try:
            with open(path, encoding="utf-8") as fh:
                before = fh.read()
        except OSError:
            continue
        if BD_GIT_POLICY not in before or FORMULA_EXCEPTION in before:
            continue
        try:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(before.replace(BD_GIT_POLICY,
                                        BD_GIT_POLICY + FORMULA_EXCEPTION))
        except OSError:
            continue
        declared.append(rel)
    body = CONVENTIONS % {"p": PROG, "open": MARK_OPEN, "close": MARK_CLOSE}
    for rel in CONVENTION_FILES:
        path = os.path.join(root, rel)
        try:
            with open(path, encoding="utf-8") as fh:
                before = fh.read()
        except OSError:
            before = ""
        if MARK_OPEN in before and MARK_CLOSE in before:
            head, rest = before.split(MARK_OPEN, 1)
            after = head + body + rest.split(MARK_CLOSE, 1)[1]
        elif before.strip():
            after = before.rstrip() + "\n\n" + body + "\n"
        else:
            after = body + "\n"
        if after == before:
            continue
        try:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(after)
        except OSError:
            continue
        if rel not in declared:
            declared.append(rel)

    changed = list(dict.fromkeys(renamed + declared))
    return {"status": "completed",
            "summary": "%d file%s changed." % (len(changed), "" if len(changed) == 1 else "s"),
            "renamed": renamed, "declared": declared, "changed": changed,
            "exitCode": 0}


def ReportWhatIsYoursToCommit(request):
    """step.report-what-is-yours-to-commit: the declaration files, and the one command.

    bd commits nothing. What init leaves behind is dotdiw's declaration of
    where work starts, written into the instruction files for the worker to
    commit so that every clone reads it. Say which files, and the command;
    committing is not this tool's to do. Where an earlier version let bd
    commit its own files, say the one command that keeps the tracker local
    from here on, too.
    """
    root, rels = request["root"], list(request.get("paths") or [])
    yours = []
    if rels:
        out = git(["status", "--porcelain", "--"] + rels, root)
        yours = [line[3:] for line in out.split("\n") if line.strip()]
    return {"status": "completed",
            "summary": "%d file%s yours to commit." % (len(yours), "" if len(yours) == 1 else "s"),
            "yours": yours, "exitCode": 0}

def AdoptRepository(request):
    """step.adopt-repository: the tracker made under the home, keyed to this checkout.

    Nothing of bd's goes into the repository. The key is one line in the
    checkout's own .git/config; the state is ~/.dotdiw/<key>/.beads, which bd
    is told through BEADS_DIR. bd runs in its stealth mode with hooks and
    agent files declined: stealth is what declines the sync remote (BEADS_DIR
    alone does not), and the declaration dotdiw writes is the instruction
    surface. Where an earlier version's tracker sits in the tree, its prefix
    is kept so that issue ids read on; its tasks are not carried over.
    """
    root = request["root"]
    if not git(["rev-parse", "--is-inside-work-tree"], root).strip():
        # There is no .git/config to key from, and bd's own init would run
        # git init on the worker's behalf.
        return {"status": "failed", "summary": "Not a git repository.",
                "reason": "not-a-repository", "exitCode": 2}
    argv = list(request["arguments"])
    ws = workspace(root)
    if adopted(ws) and not any(a in REINIT_FLAGS for a in argv):
        return {"status": "completed", "summary": "Already adopted.", "workspace": ws,
                "created": False, "exitCode": 0}
    if ws is None:
        git(["config", "--local", WORKSPACE_KEY, os.urandom(8).hex()], root)
        forget_workspace(root)
        ws = workspace(root)
        if ws is None:
            return {"status": "failed", "summary": "The key could not be written.",
                    "reason": "key-not-written", "exitCode": 1}
    try:
        os.makedirs(ws, exist_ok=True)       # bd requires the parent to exist
    except OSError as e:
        return {"status": "failed", "summary": str(e), "workspace": ws,
                "reason": "workspace-not-made", "exitCode": 1}
    if not any(a == "-p" or a.startswith("--prefix") for a in argv):
        # An earlier version's tracker in the tree: keep its prefix, so the
        # ids the project is used to read on. Nothing else of it is read.
        try:
            with open(os.path.join(root, ".beads", "metadata.json"), encoding="utf-8") as fh:
                old = str(json.load(fh).get("dolt_database") or "").strip()
        except (OSError, ValueError):
            old = ""
        if old:
            argv += ["--prefix", old]
    for flag in INIT_FLAGS:
        if flag not in argv:
            argv.insert(1, flag)
    os.environ["BEADS_DIR"] = beads_dir(ws)
    if request.get("quiet"):
        code, _ = bd_quiet(argv)
    else:
        code = invoke("operation.forward-to-the-tracker",
                      {"root": root, "arguments": argv})["exitCode"]
    return {"status": "completed" if code == 0 else "failed",
            "summary": "Adopted under %s." % ws if code == 0 else "The tracker's init failed.",
            "workspace": ws, "created": code == 0,
            "reason": None if code == 0 else "init-failed", "exitCode": code}


def AdoptARepository(request):
    """journey.adopt-a-repository: one command; the tracker under the home, the declaration in the tree."""
    root = request["root"]
    invoke("operation.turn-metrics-off", {})
    made = invoke("operation.adopt-repository", {"root": root, "arguments": request["arguments"]})
    if made["exitCode"] == 2:              # not a git repository: nothing else applies
        return {"status": made["status"], "summary": made["summary"], "exitCode": made["exitCode"]}
    undone = invoke("operation.undo-earlier-adoption", {"root": root})
    declared = invoke("operation.declare-conventions", {"root": root, "announce": "init"})
    invoke("operation.report-what-is-yours-to-commit",
           {"root": root, "paths": declared["changed"],
            "command": undone["command"] if undone.get("adopted") else None})
    return {"status": made["status"], "summary": made["summary"],
            "workspace": made.get("workspace"), "exitCode": made["exitCode"]}


