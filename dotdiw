def TurnMetricsOff(request: TurnMetricsOffRequest) -> TurnMetricsOffResponse:
    """step.turn-metrics-off: the tracker's usage metrics off for this machine, and say so once.

    Runs before any other tracker command, on every run, so a fresh machine,
    an upgrade or the metrics turned back on all get the same answer. Silent
    when they are already off, which is every run but the first. The
    mechanism is the adapter's, an extra named metrics-off: the beads adapter
    offers it, and an adapter without metrics does not, in which case there
    is nothing to turn off. main() asks it of the adapter this run uses; the
    tracker door asks it of any other adapter the run reaches, before the
    first thing asked of that adapter.
    """
    out = invoke_extra(
        "metrics-off", {"root": request.get("root"), "tracker": request.get("tracker")}
    )
    if out["status"] == "failed" and out.get("reason") != "unsupported":
        return {
            "status": "failed",
            "summary": "The tracker did not turn its metrics off.",
            "turnedOff": False,
            "path": out.get("path"),
            "exitCode": 0,
        }
    turned = bool(out.get("turnedOff"))
    return {
        "status": "completed",
        "summary": "Turned the tracker's metrics off." if turned else "Metrics were already off.",
        "turnedOff": turned,
        "path": out.get("path"),
        "exitCode": 0,
    }


def UndoEarlierAdoption(request: UndoEarlierAdoptionRequest) -> UndoEarlierAdoptionResponse:
    """step.undo-earlier-adoption: what an earlier version let bd do to a repository, said,
    and put right when init asks.

    v0.1.0 let bd point core.hooksPath at its own directory, which is undone
    because it decides which hooks git runs. Every version before 0.4.0
    kept bd's tracker in the tree -- v0.1.0 with a Dolt remote aimed at the
    git remote, 0.2.x committed, 0.3.0 excluded. That is the upgrade: a
    tracker is made under the home with the old prefix, once, and the
    in-tree copy is left exactly as it is, unused, for the worker to remove
    with the command named; a remote inside it reaches nothing, since no bd
    runs there any more. Earlier tasks are not carried over, and that is
    said. A workspace adopted before there was a choice of tracker has the
    one adapter holding a store there written as the choice.

    Only init puts any of it right, with apply. Every other command asks
    without it first: nothing is changed, and while anything is left the
    answer is blocked, naming init in one line. Silence when there is
    nothing to do.
    """
    root = request["root"]
    apply = bool(request.get("apply"))
    pending: list[str] = []

    def hooks_replaced() -> str:
        """bd's hook directory standing in for the repository's own, or ""."""
        got = git(["config", "--get", HOOKS_KEY], root).strip()
        if not got:
            return ""
        # realpath, not normpath: on macOS a checkout under /var or /tmp is
        # reached through a symlink, and `git rev-parse` hands back the
        # resolved path while the configured value keeps whichever form it
        # was written in. Comparing the two unresolved left the override in
        # place and said nothing -- the worst of both. Found by the test.
        mine = os.path.realpath(os.path.join(root, ".beads", "hooks"))
        return got if os.path.realpath(os.path.join(root, got)) == mine else ""

    done = []
    got = hooks_replaced()
    if got and not apply:
        pending.append("%s points at %s, a snapshot of this repository's hooks" % (HOOKS_KEY, got))
    elif got:
        git(["config", "--unset", HOOKS_KEY], root)
        if not hooks_replaced():
            done.append(
                "%s is unset. It pointed at %s, a snapshot of this "
                "repository's hooks taken when it was adopted, so any "
                "hook added since was being skipped; .git/hooks is read "
                "again." % (HOOKS_KEY, got)
            )

    # The upgrade: a tracker in the tree and no key means a version before
    # 0.4.0 adopted this repository. Adopt it under the home now, with the
    # old prefix and under the tracker every version before this one had,
    # so the command that was typed just works.
    ws = workspace(root)
    in_tree = os.path.isdir(os.path.join(root, ".beads"))
    made = None
    stopped = None
    if in_tree and not checkout_adopted(root) and not apply:
        pending.append("the tracker is in the tree, where a version before 0.4.0 kept it")
    elif in_tree and not checkout_adopted(root):
        result = invoke(
            "operation.adopt-repository",
            {"root": root, "quiet": True, "tracker": request.get("tracker") or "beads"},
        )
        if result["exitCode"] == 0:
            made = result["workspace"]
            ws = made
        else:
            stopped = (
                "the tracker kept in the tree could not be adopted under the home: %s"
                % (result["summary"])
            )

    # The other upgrade: a workspace adopted before there was a choice of
    # tracker holds one adapter's store and no choice. The choice is written
    # once, as the tracker the work is in, and said once.
    pinned = None
    if adopted(ws) and tracker_name(root) is None and not apply:
        found = tracker_with_store(root)
        if found:
            pending.append("no tracker is chosen for this checkout, whose work %s holds" % found)
    elif adopted(ws) and tracker_name(root) is None:
        pinned = tracker_with_store(root)
        if pinned:
            git(["config", "--local", TRACKER_KEY, pinned], root)
            forget_workspace(root)
            if tracker_name(root) == pinned:
                done.append(
                    "%s = %s is written in .git/config: the tracker an earlier "
                    "version adopted this checkout under, where its work stays."
                    % (TRACKER_KEY, pinned)
                )
    # The tracker's store as an earlier version kept it: the adapter that
    # keeps it says whether it needs bringing up to date, and brings it up to
    # date when init asks. An adapter without the upgrade extra has nothing to.
    if checkout_adopted(root) and stopped is None:
        kept = invoke_extra(
            "upgrade", {"root": root, "tracker": request.get("tracker"), "apply": apply}
        )
        if kept["status"] == "completed":
            pending.extend(kept.get("pending") or [])
            done.extend(kept.get("done") or [])
        elif apply and kept.get("reason") != "unsupported":
            stopped = (
                "the store an earlier version kept could not be brought up to date: %s"
                % (kept["summary"])
            )
    command = None
    if in_tree and checkout_adopted(root):
        if git(["ls-files", "-z", "--", ".beads"], root):
            # git rm takes the tracked files; the database bd kept beside them
            # was never tracked, so the directory is removed after.
            command = (
                "git rm -r -q .beads && git commit -m \"Remove the tracker's files "
                'from the repository" && rm -rf .beads .beads.gate.lock'
            )
        else:
            command = "rm -rf .beads .beads.gate.lock"

    if stopped is not None:
        return {
            "status": "failed",
            "summary": "init stopped: %s." % stopped.rstrip("."),
            "undone": done,
            "pending": [],
            "exitCode": 1,
        }
    if pending:
        return {
            "status": "blocked",
            "summary": "This checkout was adopted by an earlier version of %s: %s. Run %s "
            "init once to bring it up to date." % (PROG, "; ".join(pending), PROG),
            "undone": [],
            "pending": pending,
            "exitCode": 1,
        }
    n = len(done) + bool(made)
    return {
        "status": "completed",
        "summary": "%d thing%s put right." % (n, "" if n == 1 else "s"),
        "undone": done,
        "pending": [],
        "workspace": ws,
        "adopted": made,
        "command": command,
        "hooksReplaced": bool(got),
        "tracker": pinned,
        "exitCode": 0,
    }


def DeclareConventions(request: DeclareConventionsRequest) -> DeclareConventionsResponse:
    """step.declare-conventions: the files agents read say where work starts, and name dotdiw.

    Three edits, each idempotent: bd renamed to dotdiw in every file an
    earlier version let it write for agents, which bd writes again on setup,
    doctor --fix and upgrades; the declaration between its markers in
    CLAUDE.md and AGENTS.md, created when absent; and the one exception
    inside bd's own git policy where those files carry it.
    """
    root = request["root"]

    renamed = []
    paths = [os.path.join(root, rel) for rel in AGENT_FILES]
    for rel in AGENT_TREES:
        for dirpath, _, names in os.walk(os.path.join(root, rel)):
            paths.extend(os.path.join(dirpath, n) for n in names)
    for path in paths:
        try:
            with open(path, encoding="utf-8") as fh:
                before = fh.read()
        except (OSError, UnicodeDecodeError, ValueError):
            continue
        after = _BD_WORD.sub(PROG, before)
        if after == before:
            continue
        try:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(after)
        except OSError:
            continue
        renamed.append(os.path.relpath(path, root))

    declared = []
    # Let the project's own declaration satisfy bd's git policy. Without this
    # the instruction files contradict each other, the stricter sentence wins,
    # and the formula stays uncommitted -- which by this design's own rule
    # means the project does not hold it.
    for rel in CONVENTION_FILES:
        path = os.path.join(root, rel)
        try:
            with open(path, encoding="utf-8") as fh:
                before = fh.read()
        except OSError:
            continue
        if BD_GIT_POLICY not in before or FORMULA_EXCEPTION in before:
            continue
        try:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(before.replace(BD_GIT_POLICY, BD_GIT_POLICY + FORMULA_EXCEPTION))
        except OSError:
            continue
        declared.append(rel)
    body = CONVENTIONS % {"p": PROG, "open": MARK_OPEN, "close": MARK_CLOSE}
    for rel in CONVENTION_FILES:
        path = os.path.join(root, rel)
        try:
            with open(path, encoding="utf-8") as fh:
                before = fh.read()
        except OSError:
            before = ""
        if MARK_OPEN in before and MARK_CLOSE in before:
            head, rest = before.split(MARK_OPEN, 1)
            after = head + body + rest.split(MARK_CLOSE, 1)[1]
        elif before.strip():
            after = before.rstrip() + "\n\n" + body + "\n"
        else:
            after = body + "\n"
        if after == before:
            continue
        try:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(after)
        except OSError:
            continue
        if rel not in declared:
            declared.append(rel)

    changed = list(dict.fromkeys(renamed + declared))
    return {
        "status": "completed",
        "summary": "%d file%s changed." % (len(changed), "" if len(changed) == 1 else "s"),
        "renamed": renamed,
        "declared": declared,
        "changed": changed,
        "exitCode": 0,
    }


def ReportWhatIsYoursToCommit(
    request: ReportWhatIsYoursToCommitRequest,
) -> ReportWhatIsYoursToCommitResponse:
    """step.report-what-is-yours-to-commit: the declaration files, and the one command.

    bd commits nothing. What init leaves behind is dotdiw's declaration of
    where work starts, written into the instruction files for the worker to
    commit so that every clone reads it. Say which files, and the command;
    committing is not this tool's to do.
    """
    root, rels = request["root"], list(request.get("paths") or [])
    yours = []
    if rels:
        out = git(["status", "--porcelain", "--"] + rels, root)
        yours = [line[3:] for line in out.split("\n") if line.strip()]
    return {
        "status": "completed",
        "summary": "%d file%s yours to commit." % (len(yours), "" if len(yours) == 1 else "s"),
        "yours": yours,
        "exitCode": 0,
    }


def AdoptRepository(request: AdoptRepositoryRequest) -> AdoptRepositoryResponse:
    """step.adopt-repository: the tracker made under the home, keyed to this checkout.

    Nothing of the tracker's goes into the repository. Two lines in the
    checkout's own .git/config: the key, and the adapter chosen -- the one
    named, else the one the workspace already has, else local. The store is
    under ~/.dotdiw/<key>/, made by that adapter when the tracker is opened,
    and a second open changes nothing. The prefix given goes to the
    adapter, which honours it where it can.
    """
    root = request["root"]
    if not git(["rev-parse", "--is-inside-work-tree"], root).strip():
        # There is no .git/config to key from, and a tracker's own init
        # might run git init on the worker's behalf.
        return {
            "status": "failed",
            "summary": "Not a git repository.",
            "reason": "not-a-repository",
            "exitCode": 2,
        }
    prefix = request.get("prefix")
    ws = workspace(root)
    if ws is None:
        git(["config", "--local", WORKSPACE_KEY, os.urandom(8).hex()], root)
        forget_workspace(root)
        ws = workspace(root)
        if ws is None:
            return {
                "status": "failed",
                "summary": NOT_WRITTEN % WORKSPACE_KEY,
                "reason": "key-not-written",
                "exitCode": 1,
            }
    try:
        os.makedirs(
            ws, exist_ok=True
        )  # the workspace is this tool's; the store inside it is the adapter's
    except OSError as e:
        return {
            "status": "failed",
            "summary": str(e),
            "workspace": ws,
            "reason": "workspace-not-made",
            "exitCode": 1,
        }
    name, adapter = resolve_tracker({"root": root, "tracker": request.get("tracker")})
    if adapter is None:
        refused = tracker_unknown(AdoptRepositoryResponse, name)
        refused["workspace"], refused["created"], refused["tracker"] = ws, False, name
        return refused
    opened = invoke_tracker(
        "operation.open-tracker",
        {"root": root, "tracker": name, "prefix": prefix},
    )
    code = opened.get("exitCode", 0 if opened["status"] == "completed" else 1)
    if code != 0:
        return {
            "status": "failed",
            "summary": opened["summary"],
            "workspace": ws,
            "created": False,
            "reason": opened.get("reason") or "init-failed",
            "tracker": name,
            "exitCode": code,
        }
    if tracker_name(root) != name:  # written last: a store that did not open is not a choice
        git(["config", "--local", TRACKER_KEY, name], root)
        forget_workspace(root)
        if tracker_name(root) != name:
            return {
                "status": "failed",
                "summary": NOT_WRITTEN % TRACKER_KEY,
                "workspace": ws,
                "created": False,
                "reason": "key-not-written",
                "tracker": name,
                "exitCode": 1,
            }
    created = bool(opened.get("created"))
    # Said once, before any work is written: the worst failure here is writing to
    # a tracker as the wrong person.
    actor = None
    if created:
        described = invoke_tracker("operation.describe-tracker", {"root": root, "tracker": name})
        actor = described.get("actor")
    return {
        "status": "completed",
        "summary": "Adopted under %s." % ws if created else "Already adopted.",
        "workspace": ws,
        "created": created,
        "tracker": name,
        "actor": actor,
        "exitCode": 0,
    }


def AdoptARepository(request: AdoptARepositoryRequest) -> AdoptARepositoryResponse:
    """journey.adopt-a-repository: one command; the tracker under the home, the declaration
    in the tree."""
    root, tracker = request["root"], request.get("tracker")
    invoke("operation.turn-metrics-off", {"root": root, "tracker": tracker})
    # What an earlier version left is put right first, so that a tracker kept
    # in the tree is adopted under the home with its own prefix; when it cannot
    # be, nothing else is adopted.
    undone = invoke(
        "operation.undo-earlier-adoption", {"root": root, "tracker": tracker, "apply": True}
    )
    if undone["status"] != "completed":
        return {"status": "failed", "summary": undone["summary"], "exitCode": 1}
    made = invoke(
        "operation.adopt-repository",
        {"root": root, "prefix": request.get("prefix"), "tracker": tracker},
    )
    if made["status"] != "completed":
        # Nothing was adopted, so there is nothing to declare work starts in.
        return {"status": made["status"], "summary": made["summary"], "exitCode": made["exitCode"]}
    declared = invoke("operation.declare-conventions", {"root": root, "announce": "init"})
    invoke("operation.report-what-is-yours-to-commit", {"root": root, "paths": declared["changed"]})
    return {
        "status": made["status"],
        "summary": made["summary"],
        "workspace": made.get("workspace"),
        "exitCode": made["exitCode"],
    }


