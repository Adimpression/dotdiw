def resolve(forms, ident):
    """A formula by its id, its file name, or its path."""
    ident = (ident or "").strip()
    if not ident:
        return None
    base = os.path.basename(ident).split(".")[0]
    for f in forms:
        if ident in (f["id"], f["name"], f["rel"]) or base in (f["id"], f["name"]):
            return f
    return None


def bd_knows(ident):
    """Whether bd has this formula cooked. bd only looks in its own two
    directories, so it can say no about a formula the project plainly holds."""
    code, _ = bd_quiet(["formula", "show", ident])
    return code == 0


