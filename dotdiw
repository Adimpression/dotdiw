TRACKERS_SHARED = os.path.join("share", PROG, "trackers")
# Where a formula management provider's module may be, in the order they are
# looked in, and the registry of the providers registered under a name. The
# registry is the home's, so every registered provider serves every checkout.
PROVIDERS_DIR = os.path.join(DOTDIW_HOME, "formula-providers")
PROVIDERS_SHARED = os.path.join("share", PROG, "formula-providers")
PROVIDER_REGISTRY = os.path.join(DOTDIW_HOME, "formula-providers.json")
PROVIDER_NAME = r"[A-Za-z0-9]+"
PROVIDER_MODULE = r"[a-z0-9][a-z0-9-]*"
# A provider's own id for a formula: letters, digits, dots, hyphens and
# underscores, starting with a letter or a digit -- nothing a path or a shell
# reads as more than a name.
PROVIDER_FORMULA_ID = r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}"
PROVIDER_LOCK = os.path.join(DOTDIW_HOME, "formula-providers.lock")
# The formula management provider interface a module says it was written for,
# in its info: 2 from 3.0.0, when show came to answer a formula as data.
PROVIDER_INTERFACE = 2
# module name -> its PROVIDER table: the shipped ones, then each loaded.
PROVIDER_MODULES: dict[str, dict[str, Any]] = {}
# The directory provider's last listing of each store: each id and the file
# that holds it, so that a show reads one file.
DIRECTORY_FOUND: dict[str, dict[str, str]] = {}
TRACKER_NAME = r"[a-z][a-z0-9-]*"
BAD_TRACKER_NAME = (
    "%s cannot be a tracker's name. A name uses lowercase letters, digits and hyphens, "
    "and starts with a letter."
)
SHIPPED_TRACKER_NAME = "%s is the name of an adapter built into dotdiw."
NOT_WRITTEN = "could not write %s into this repository's git config."
# What a module can do to this process that is its mistake and not a worker's:
# sys.exit() in a module must not end the command, or pass a check, in silence.
MODULE_MISTAKES = (Exception, SystemExit)
TRACKERS: dict[str, TrackerTable] = {}
LOAD_FAILED: dict[str, str] = {}  # name -> why a module did not load, one line
LOAD_TRIED: set[str] = set()  # files that gave no adapter, not run twice in one process
SETTLED: set[str] = set()  # adapters whose usage metrics this run has already seen to
RECORD_KINDS: dict[Any, dict[str, Any]] = {}  # a record type -> its fields' types, read once
# What a completed answer must hold for its callers to read, beyond its type.
# An adapter that printed the answer itself may have nothing more to give.
TRACKER_ANSWERS = {
    "operation.describe-tracker": ("info",),
    "operation.create-item": ("item",),
    "operation.add-need": ("edge",),
    "operation.pour-steps": ("rootId", "stepIds"),
    "operation.show-item": ("item",),
    "operation.list-items": ("items",),
    "operation.update-item": ("item",),
    "operation.ready-items": ("items",),
