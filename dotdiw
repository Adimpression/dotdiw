#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""dotdiw -- workflow discovery for a project.

Everything bd does, under one name, plus the part bd does not ship: when work
starts, the procedure that applies surfaces on its own.

Four capabilities have to work in a project. Beads covers management and
declaration, git covers sharing, and this covers discovery. It owns the moment
work starts -- `dotdiw create` -- and hands everything else to bd unchanged, so
no task ever requires typing `bd`. bd's own output names itself in compiled-in
hints, so its stream is rewritten on the way out.

Formulas live anywhere in the tree, next to whatever they are about. They are
found with `git ls-files`, which means an uncommitted formula is invisible --
the sharing convention made mechanical rather than advisory.

Silence the hints with DOTDIW_NO_HINTS=1.
"""
import glob
import json
import math
import os
import re
import shutil
import sqlite3
import subprocess
import sys

try:
    import tomllib
except ImportError:  # python < 3.11
    tomllib = None

PROG = "dotdiw"

# Its own, not the version of the tool it wraps. `--version` used to forward to
# bd, whose answer then had bd's name rewritten to this one -- so the tool
# reported another tool's version as its own.
VERSION = "0.2.0"

TOP_N = 3

# How much of a title a formula has to account for before it is worth showing:
# the share of the title's distinctive words that the formula actually holds.
# A fraction and not a score, because bm25's scale depends on how much text the
# project has. An absolute threshold tuned on a documented project silences
# every match in a project with one formula and one README, where bm25's idf is
# zero by construction -- see the measurements in IMPLEMENTATION.md. Set to keep
# Bracketed by measurement on both sides: at 0.10 a coincidence gets through,
# and at 0.20 a formula stops retrieving one of its own examples. A coincidence
# costs a glance, silence costs the mechanism. Ordering is bm25's, as it was.
COVERAGE = 0.15

# The same fraction, for one earlier title against another -- used only to seed
# a new formula's examples with titles the work has already been given here.
# Loose on purpose: a wrong seed in a file its author is already editing costs
# a deleted line, so recall is worth more than precision at this one job. It is
# not worth anything at a harder one: two bare titles agree over almost
# nothing, and matching them is not a way to notice a procedure being repeated.
# Measured: see IMPLEMENTATION.md.
SEED = 0.25

# A procedure someone carried out in the tracker instead of declaring: a parent
# with this many children and at least one dependency between them. Children
# with no order are a checklist; ordered children are a procedure.
HANDMADE_STEPS = 3

# What each part of a formula is worth: the name and the directory it sits in
# are deliberate words, a description is prose, example titles are the thing
# being matched against.
WEIGHTS = (2.0, 1.5, 1.0, 1.5)

# A description shorter than this is a restatement of the name, not a situation.
MIN_DESC_WORDS = 12
MIN_EXAMPLES = 3

# Function words only. Nothing with meaning belongs here: bm25 works out for
# itself that "write" and "version" are everyday words in this project, and a
# hand-written list of them only deletes signal -- "down" cost the outage
# formula its best word until it came off this list.
STOP = set("""a an the and or but for to of in on at by with from into about as is are was were be been being
this that these those it its you your we our they them he she his her i me my if then than so such not no nor
do does did done doing have has had having can could will would should may might must shall there here when
where who whom which what why how all any both each few more most other some only own same too very just
now""".split())

# The background corpus is the project's own tracked text, up to this many
# files of this size. Enough of it that everyday words are provably everyday;
# capped so that `create` stays faster than the bd call that follows it.
CORPUS_FILES = 300
CORPUS_BYTES = 100000
CORPUS_EXTS = frozenset("""
.md .txt .rst .adoc .org .tex .py .go .js .mjs .ts .tsx .jsx .rb .rs .java .kt .swift .m .cs .php .pl .lua
.c .h .cc .cpp .hpp .sh .bash .zsh .fish .yaml .yml .toml .json .cfg .ini .conf .env .sql .proto .graphql
.html .css .scss .vue .svelte .tf .dockerfile .mk .gradle .bzl
""".split()) | {""}

_BD_WORD = re.compile(r"\bbd\b")
_BD_WORD_B = re.compile(rb"\bbd\b")


# ---------------------------------------------------------------- bd, hidden

def find_bd():
    return shutil.which("bd") or shutil.which("beads")


def rewrite(s):
    """bd names itself in compiled-in hints. argv[0] does not change them."""
    return _BD_WORD.sub(PROG, s)


# What bd init writes for agents to read. Its name is compiled into these the
# same way it is into its output -- but an agent reads the file, so the stream
# rewrite never reaches it. bd writes them again on setup, doctor --fix and
# upgrades, so this re-runs rather than running once.
AGENT_FILES = (
    "AGENTS.md",
    "CLAUDE.md",
    ".claude/settings.json",
    ".codex/hooks.json",
    ".codex/config.toml",
    ".cursor/hooks.json",
    ".cursor/rules/beads.mdc",
)
AGENT_TREES = (os.path.join(".agents", "skills", "beads"),)

# bd writes those files and says nothing about where work starts, so the
# project's own declaration goes in here. Between markers, because bd writes
# them again on setup, doctor --fix and upgrades, and this has to survive that.
MARK_OPEN = "<!-- dotdiw: how work starts -->"
MARK_CLOSE = "<!-- /dotdiw -->"
CONVENTION_FILES = ("AGENTS.md", "CLAUDE.md")

# Function words only would not do here: this block is the one place the two
# conventions are stated to whoever shows up, so it names the command, the file
# suffix, and why a formula beats a runbook.
CONVENTIONS = """%(open)s
## How work starts in this project

Start every task and subtask with:

    %(p)s create "<what you are about to do>"

That is the convention, and it is also what lets the right procedure find you.
On `create`, the procedures this project holds are matched against your title
and the ones that apply are printed. Start by cutting a branch or editing a
file instead and nothing surfaces -- the discipline was skipped, not the
mechanism broken.

A procedure you repeat belongs in a formula, not a runbook: a TOML file named
`<something>.formula.toml`, kept next to whatever it is about, and committed.
Prose cannot be matched against a title or instantiated as steps; a formula is
both. Leave it where it belongs in the tree -- it does not need moving or
linking anywhere.

Write one the moment you notice you are repeating yourself, or that you just
did by hand what you will do again. `formula new` writes the file for you; you
fill in the description and the steps.

Then commit it. A formula you have not committed is one only you hold: it does
not appear in `formula list`, nothing matches it against a title, and `check`
says so. Committing it is the last step of writing it, not a separate decision
-- and this is the project asking you to, so it is not the kind of commit a
conservative git policy is about. Commit the formula file; leave the rest of
your changes as they are.

    %(p)s formula new "<what the procedure is for>"
    %(p)s formula new "..." --from <id>   steps from work already done
    %(p)s formula list     the procedures this project holds
    %(p)s mol pour <id>    instantiate one as tracked, ordered steps
    %(p)s check            whether every formula here can actually be found
    %(p)s learn            all of it, in full
%(close)s"""


def conventions_text():
    return CONVENTIONS % {"p": PROG, "open": MARK_OPEN, "close": MARK_CLOSE}


def write_conventions(root):
    """State the conventions in the files agents read. Returns what changed."""
    body = conventions_text()
    changed = permit_formula_commit(root)
    for rel in CONVENTION_FILES:
        path = os.path.join(root, rel)
        try:
            with open(path, encoding="utf-8") as fh:
                before = fh.read()
        except OSError:
            before = ""
        if MARK_OPEN in before and MARK_CLOSE in before:
            head, rest = before.split(MARK_OPEN, 1)
            after = head + body + rest.split(MARK_CLOSE, 1)[1]
        elif before.strip():
            after = before.rstrip() + "\n\n" + body + "\n"
        else:
            after = body + "\n"
        if after == before:
            continue
        try:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(after)
        except OSError:
            continue
        if rel not in changed:
            changed.append(rel)
    return changed


# bd's own instruction files carry a git policy -- "Do not run git commits,
# git pushes, or Dolt remote sync unless explicitly asked" -- and the project's
# declaration right below it asks for one commit. Eight of eleven agents wrote
# a formula and none committed it; saying in the declaration that this commit
# is part of writing the formula moved that to three of nine. The rest read
# bd's sentence as the authority on git, which it is. So the exception goes
# inside bd's own sentence, through the escape hatch bd already wrote into it.
BD_GIT_POLICY = ("Do not run git commits, git pushes, or Dolt remote sync "
                 "unless explicitly asked.")
FORMULA_EXCEPTION = (
    " Committing a `*.formula.toml` file is the one exception: the project asks"
    " for it under \"How work starts\" below, so it is already explicitly asked."
    " Commit that file and leave your other changes alone.")


def permit_formula_commit(root):
    """Let the project's own declaration satisfy bd's git policy.

    Without this the instruction files contradict each other, the stricter
    sentence wins, and the formula stays uncommitted -- which by this design's
    own rule means the project does not hold it.
    """
    changed = []
    for rel in CONVENTION_FILES:
        path = os.path.join(root, rel)
        try:
            with open(path, encoding="utf-8") as fh:
                before = fh.read()
        except OSError:
            continue
        if BD_GIT_POLICY not in before or FORMULA_EXCEPTION in before:
            continue
        try:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(before.replace(BD_GIT_POLICY,
                                        BD_GIT_POLICY + FORMULA_EXCEPTION))
        except OSError:
            continue
        changed.append(rel)
    return changed


# ------------------------------------------------- undoing what adoption did

# `init` hands this tool's name to `bd init`, and v0.1.0 passed on three things
# bd does to a repository without saying so. Two of them are destructive.
#
#   core.hooksPath -> <repo>/.beads/hooks
#       bd copies the repository's existing hooks into that directory and
#       appends its own block, so hooks that were already there keep running.
#       What does not keep running is anything added to .git/hooks afterwards:
#       git reads one hook directory, and from adoption onward that is bd's
#       snapshot. A hook the team adds next week is silently ignored. The value
#       is also an absolute path, so it is wrong in any other checkout.
#
#   a Dolt remote, in .beads/config.yaml and in the database's own state,
#       aimed at the repository's git remote. The issue database is pushed into
#       the repository and grows there, keeping its full history.
#
# Neither is anything this tool needs or ever used. Because v0.1.0 shipped them,
# the repair runs on every invocation instead of waiting to be asked for: a
# repository is unprotected for as long as the setting stands, and nobody who
# was never told about it will think to look.
HOOKS_KEY = "core.hooksPath"


def hooks_replaced(root):
    """bd's hook directory standing in for the repository's own, or ""."""
    got = git(["config", "--get", HOOKS_KEY], root).strip()
    if not got:
        return ""
    # realpath, not normpath: on macOS a checkout under /var or /tmp is
    # reached through a symlink, and `git rev-parse` hands back the resolved
    # path while the configured value keeps whichever form it was written in.
    # Comparing the two unresolved left the override in place and said nothing
    # -- the worst of both. Found by the test, not by hand.
    mine = os.path.realpath(os.path.join(root, ".beads", "hooks"))
    return got if os.path.realpath(os.path.join(root, got)) == mine else ""


def dolt_remotes(root):
    """(state file, remote names) for each local database carrying a remote."""
    out = []
    base = os.path.join(root, ".beads", "embeddeddolt")
    try:
        dbs = sorted(os.listdir(base))
    except OSError:
        return out
    for db in dbs:
        path = os.path.join(base, db, ".dolt", "repo_state.json")
        try:
            with open(path, encoding="utf-8") as fh:
                state = json.load(fh)
        except (OSError, ValueError):
            continue
        if state.get("remotes"):
            out.append((path, sorted(state["remotes"])))
    return out


def repair(root):
    """Undo it, and return a line for each thing undone."""
    done = []

    got = hooks_replaced(root)
    if got:
        git(["config", "--unset", HOOKS_KEY], root)
        if not hooks_replaced(root):
            done.append("%s is unset. It pointed at %s, a snapshot of this "
                        "repository's hooks taken when it was adopted, so any "
                        "hook added since was being skipped; .git/hooks is read "
                        "again." % (HOOKS_KEY, got))

    cfg = os.path.join(root, ".beads", "config.yaml")
    try:
        with open(cfg, encoding="utf-8") as fh:
            before = fh.read()
    except OSError:
        before = ""
    if before:
        # A top-level `sync:` key and the indented block under it.
        after = re.sub(r"(?m)^sync:\n(?:[ \t]+.*\n)*", "", before)
        if after != before:
            try:
                with open(cfg, "w", encoding="utf-8") as fh:
                    fh.write(after)
                done.append("the Dolt remote is out of .beads/config.yaml.")
            except OSError:
                pass

    for path, names in dolt_remotes(root):
        try:
            with open(path, encoding="utf-8") as fh:
                state = json.load(fh)
            state["remotes"] = {}
            with open(path, "w", encoding="utf-8") as fh:
                json.dump(state, fh, indent=2)
        except (OSError, ValueError):
            continue
        done.append("the Dolt remote %s is out of %s."
                    % (", ".join(names), os.path.relpath(path, root)))

    return done


def left_uncommitted(root, rels):
    """Those of `rels` that git tracks and that now differ from the index."""
    if not rels:
        return []
    out = git(["diff", "--name-only", "--"] + list(rels), root)
    return [r for r in out.split("\n") if r.strip()]


def announce_repair(root):
    """Say what was undone. Silence when there was nothing to undo."""
    done = repair(root)
    if not done:
        return
    out = sys.stderr
    out.write("\n%s undid what an earlier version of it did here:\n" % PROG)
    for line in done:
        out.write("    %s\n" % line)
    out.write("\n    Nothing was deleted and no history was rewritten. Hooks\n"
              "    that existed when this repository was adopted went on\n"
              "    running. Any hook added after that was skipped until now,\n"
              "    so commits made in between did not see it.\n\n")


def undeclared(root):
    """The instruction files that do not say where work starts."""
    out = []
    for rel in CONVENTION_FILES:
        try:
            with open(os.path.join(root, rel), encoding="utf-8") as fh:
                if MARK_OPEN in fh.read():
                    continue
        except OSError:
            pass
        out.append(rel)
    return out


def agent_files(root):
    for rel in AGENT_FILES:
        yield os.path.join(root, rel)
    for rel in AGENT_TREES:
        for dirpath, _, names in os.walk(os.path.join(root, rel)):
            for n in names:
                yield os.path.join(dirpath, n)


def rename_in_agent_files(root):
    """Returns the files whose instructions stopped naming bd."""
    changed = []
    for path in agent_files(root):
        try:
            with open(path, encoding="utf-8") as fh:
                before = fh.read()
        except (OSError, UnicodeDecodeError, ValueError):
            continue
        after = rewrite(before)
        if after == before:
            continue
        try:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(after)
        except OSError:
            continue
        changed.append(os.path.relpath(path, root))
    return changed


def _hold_partial(buf):
    """Split off a short alphanumeric tail that may be half of a split token."""
    i, n = len(buf), 0
    while i > 0 and chr(buf[i - 1]).isalnum() and n < 3:
        i -= 1
        n += 1
    return buf[:i], buf[i:]


def run_bd(args):
    bd = find_bd()
    if not bd:
        sys.stderr.write("%s needs beads: brew install beads\n" % PROG)
        return 127
    argv = [bd] + list(args)

    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        p = subprocess.run(argv, capture_output=True, text=True)
        sys.stdout.write(rewrite(p.stdout))
        sys.stdout.flush()
        sys.stderr.write(rewrite(p.stderr))
        sys.stderr.flush()
        return p.returncode

    # A pty, so interactive prompts still work while the stream is filtered.
    import pty
    carry = bytearray()

    def reader(fd):
        data = os.read(fd, 4096)
        if not data:
            out = _BD_WORD_B.sub(PROG.encode(), bytes(carry))
            del carry[:]
            return out
        carry.extend(data)
        head, tail = _hold_partial(bytes(carry))
        del carry[:]
        carry.extend(tail)
        return _BD_WORD_B.sub(PROG.encode(), head)

    return os.waitstatus_to_exitcode(pty.spawn(argv, reader))


def bd_quiet(args):
    """Run bd for its output only, nothing printed."""
    bd = find_bd()
    if not bd:
        return 127, ""
    p = subprocess.run([bd] + list(args), capture_output=True, text=True)
    return p.returncode, p.stdout


# ------------------------------------------------------------------ scoring

def toks(s):
    """The words of a query. FTS5's porter tokenizer does the stemming."""
    return list(dict.fromkeys(
        w for w in re.findall(r"[a-z0-9]+", s.lower())
        if len(w) >= 2 and w not in STOP))


def git(args, cwd=None):
    try:
        p = subprocess.run(["git"] + args, capture_output=True, text=True,
                           timeout=10, cwd=cwd)
        if p.returncode == 0:
            return p.stdout
    except (OSError, subprocess.SubprocessError):
        pass
    return ""


def repo_root():
    return git(["rev-parse", "--show-toplevel"]).strip() or os.getcwd()


def background(root):
    """The project's own text, so that common words score as common.

    These documents are indexed and never returned. Their only job is to tell
    bm25 that "write", "test" and "version" are everyday words in this
    project, which a corpus of four formulas cannot work out on its own. On
    four documents of prose "version" was distinctive enough to pull up the
    release formula for a Go toolchain bump; on twenty-two it is not.
    """
    out = []
    for rel in git(["ls-files", "-z"], root).split("\0"):
        if not rel or rel.endswith(".formula.toml") or rel.endswith(".formula.json"):
            continue
        if os.path.splitext(rel)[1].lower() not in CORPUS_EXTS:
            continue
        p = os.path.join(root, rel)
        try:
            if os.path.getsize(p) > CORPUS_BYTES:
                continue
            with open(p, errors="ignore") as fh:
                out.append(fh.read())
        except OSError:
            continue
        if len(out) >= CORPUS_FILES:
            break
    return out


def tracked_formulas(root):
    out = git(["ls-files", "-z", "--", "*.formula.toml", "*.formula.json"], root)
    return [p for p in out.split("\0") if p]


def untracked_formulas(root):
    out = git(["ls-files", "-z", "--others", "--exclude-standard", "--",
               "*.formula.toml", "*.formula.json"], root)
    return [p for p in out.split("\0") if p]


def load_formula(root, rel):
    path = os.path.join(root, rel)
    try:
        with open(path, "rb") as fh:
            if path.endswith(".toml"):
                if tomllib is None:
                    return None
                data = tomllib.load(fh)
            else:
                data = json.load(fh)
    except Exception:
        return None

    name = os.path.basename(path).split(".")[0]
    desc = str(data.get("description", ""))
    ex = data.get("examples") or data.get("keywords") or []
    if isinstance(ex, str):
        ex = [ex]
    ex = [str(e) for e in ex]
    # The directory is matchable text too: services/billing/ says "billing"
    # without the description having to repeat it.
    where = " ".join(re.split(r"[/\\._-]+", os.path.dirname(rel)))
    return {
        "name": name,
        "rel": rel,
        "id": str(data.get("formula") or name),
        "desc": desc,
        "examples": ex,
        "words": name.replace("-", " "),
        "where": where,
    }


def load_formulas(root):
    rels = tracked_formulas(root)
    if rels and tomllib is None:
        # Silently returning nothing here is the worst available answer: the
        # project is full of formulas and the tool says it holds none.
        sys.stderr.write(
            "%s needs Python 3.11 or newer to read formulas (tomllib), and this "
            "is %d.%d.\n  %d formula file%s in this repo cannot be parsed.\n"
            "  brew install %s installs its own interpreter; this one came from "
            "elsewhere.\n"
            % (PROG, sys.version_info[0], sys.version_info[1], len(rels),
               "" if len(rels) == 1 else "s", PROG))
        sys.exit(3)
    out = []
    for rel in rels:
        f = load_formula(root, rel)
        if f:
            out.append(f)
    return out


def no_fts5():
    """Retrieval is FTS5, and some SQLite builds are compiled without it."""
    sys.stderr.write(
        "%s needs SQLite built with FTS5, and this interpreter's is not.\n"
        "  brew install %s installs its own interpreter; this one came from "
        "elsewhere.\n" % (PROG, PROG))
    sys.exit(4)


class Index:
    """BM25 over the formulas, with the project's prose for word weight.

    SQLite's FTS5 does the retrieval: its porter stemmer reaches "failing"
    from "fail", and bm25() ranks on how distinctive a word is instead of on
    how many words happened to overlap.
    """

    COLUMNS = ("fname", "place", "body", "cases")

    def __init__(self, forms, bg, floor=COVERAGE):
        self.forms = forms
        self.nbg = len(bg)
        self.floor = floor
        self._spread_cache = {}
        self.db = sqlite3.connect(":memory:")
        try:
            self.db.execute(
                "CREATE VIRTUAL TABLE f USING fts5(%s, "
                "tokenize='porter unicode61')" % ", ".join(self.COLUMNS))
        except sqlite3.Error:
            no_fts5()
        rows = [(f["words"], f["where"], f["desc"], " ".join(f["examples"]))
                for f in forms]
        # Formulas take rowid 1..N, so everything after them is background.
        rows += [("", "", text, "") for text in bg]
        self.db.executemany(
            "INSERT INTO f VALUES (?, ?, ?, ?)", rows)
        self.sql = (
            "SELECT rowid, -bm25(f, %s) AS s FROM f "
            "WHERE f MATCH ? AND rowid <= ?"
            % ", ".join("%g" % w for w in WEIGHTS))

    def spread(self, word):
        """Which formulas hold this word, and how many background documents do.

        One query per word, so a title costs a handful however many formulas
        the project has.
        """
        if word not in self._spread_cache:
            n = len(self.forms)
            rows = [r[0] for r in self.db.execute(
                "SELECT rowid FROM f WHERE f MATCH ?", ('"%s"' % word,))]
            self._spread_cache[word] = (frozenset(r for r in rows if r <= n),
                                        sum(1 for r in rows if r > n))
        return self._spread_cache[word]

    def weight(self, word):
        """How distinctive a word is in this project.

        Smoothed so it stays positive. bm25's own idf is zero for a word in
        half the corpus, and in a project with one formula and one README that
        is every word there is.
        """
        held = self.spread(word)[1]
        return math.log((self.nbg - held + 0.5) / (held + 0.5) + 1.0)

    def search(self, text):
        words = toks(text)
        if not words or not self.forms:
            return []
        match = " OR ".join('"%s"' % w for w in words)
        try:
            rows = self.db.execute(self.sql, (match, len(self.forms))).fetchall()
        except sqlite3.Error:
            return []
        total = sum(self.weight(w) for w in words)
        if not total:
            return []
        ranked = []
        for rowid, score in rows:
            held = sum(self.weight(w) for w in words
                       if rowid in self.spread(w)[0])
            if held / total >= self.floor:
                ranked.append((score, self.forms[rowid - 1]))
        ranked.sort(key=lambda r: (-r[0], r[1]["name"]))
        return ranked

    def search_without_example(self, i, j, text):
        """Search as if formula i had never listed example j.

        A self-test that leaves the example in place proves nothing: the
        title is in the index, so of course it finds itself.
        """
        ex = self.forms[i]["examples"]
        before = " ".join(ex)
        kept = " ".join(e for k, e in enumerate(ex) if k != j)
        self.db.execute("UPDATE f SET cases = ? WHERE rowid = ?", (kept, i + 1))
        self._spread_cache.clear()
        try:
            return self.search(text)
        finally:
            self.db.execute("UPDATE f SET cases = ? WHERE rowid = ?",
                            (before, i + 1))
            self._spread_cache.clear()


class Titles:
    """The work this project has already named, matched the way formulas are.

    Word weights come from the formula index, whose background is the project's
    own prose -- so "menu" counts as distinctive here for the same reason it
    does there, and this table holds nothing but the titles.
    """

    def __init__(self, titles, idx):
        self.titles = titles
        self.idx = idx
        self.db = sqlite3.connect(":memory:")
        try:
            self.db.execute("CREATE VIRTUAL TABLE t USING fts5(body, "
                            "tokenize='porter unicode61')")
        except sqlite3.Error:
            no_fts5()
        self.db.executemany("INSERT INTO t VALUES (?)",
                            [(t,) for t in titles])
        self._held = {}

    def holders(self, word):
        if word not in self._held:
            self._held[word] = frozenset(
                r[0] for r in self.db.execute(
                    "SELECT rowid FROM t WHERE t MATCH ?", ('"%s"' % word,)))
        return self._held[word]

    def echoes(self, text):
        """Earlier titles that look like this one, for seeding examples."""
        words = toks(text)
        if not words or not self.titles:
            return []
        total = sum(self.idx.weight(w) for w in words)
        if not total:
            return []
        out = []
        for i, t in enumerate(self.titles):
            held = sum(self.idx.weight(w) for w in words
                       if (i + 1) in self.holders(w))
            if held / total >= SEED:
                out.append((held / total, t))
        out.sort(key=lambda r: (-r[0], r[1]))
        return out


def past_titles(root, drop=None, limit=300):
    """The top-level work this project has named before.

    Children of a poured molecule are left out: those titles came out of a
    formula, so counting them as evidence that a formula is wanted is
    circular. `drop` removes one copy of a title -- the one `create` just made.
    """
    code, out = bd_quiet(["list", "--all", "--json", "--brief",
                          "-n", str(limit)])
    if code != 0:
        return []
    try:
        rows = json.loads(out)
    except (ValueError, TypeError):
        return []
    titles = []
    for r in rows:
        if not isinstance(r, dict) or r.get("parent"):
            continue
        if r.get("issue_type") in ("molecule", "epic"):
            continue
        t = " ".join(str(r.get("title") or "").split())
        if t:
            titles.append(t)
    if drop:
        drop = " ".join(drop.split())
        if drop in titles:
            titles.remove(drop)
    return titles


