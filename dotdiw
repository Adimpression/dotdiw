# fmt: on

# A request or a response as it travels through a door: the door holds it to
# the operation's type at run time; the bodies and the adapters are typed by
# the record classes above.
Request: TypeAlias = dict[str, Any]
Response: TypeAlias = dict[str, Any]
Operation: TypeAlias = Callable[[Any], Any]
R = TypeVar("R", bound=Mapping[str, object])


def failed_as(shape: type[R], reason: str | None, summary: str, exit_code: int = 1) -> R:
    """A failed response in the shape the caller answers with: status, reason,
    exitCode and summary are fields of every response type. The reason is one
    every tracker response allows, or the operation's own."""
    return cast(
        R, {"status": "failed", "reason": reason, "exitCode": exit_code, "summary": summary}
    )


class DoorSpec(TypedDict):
    """One row of the door's table: the body that answers an operation and the
    fields of its request and response, the required ones named."""

    body: str
    request: tuple[str, ...]
    requestRequired: tuple[str, ...]
    response: tuple[str, ...]
    responseRequired: tuple[str, ...]


class TrackerDoorSpec(TypedDict):
    """One row of the tracker door's table: the fields of an interface
    operation's request and response, and the record types of both. An
    adapter answers it."""

    request: tuple[str, ...]
    requestRequired: tuple[str, ...]
    requestType: type[Any]
    response: tuple[str, ...]
    responseRequired: tuple[str, ...]
    responseType: type[Any]


class TrackerTable(TypedDict, total=False):
    """An adapter as registered: TRACKER in a loaded module, or one of the two
    tables below."""

    info: Required[TrackerInfo]
    operations: Required[dict[str, Operation]]
    extras: dict[str, Operation]
    store: Callable[[str], str | None]


PROG = "dotdiw"

# Its own, not the version of the tool it wraps. `--version` used to forward to
# bd, whose answer then had bd's name rewritten to this one -- so the tool
# reported another tool's version as its own.
VERSION = "4.0.0"

TOP_N = 3

# How much of a title a formula has to account for before it is worth showing:
# the share of the title's distinctive words that the formula actually holds.
# A fraction and not a score, because bm25's scale depends on how much text the
# project has. An absolute threshold tuned on a documented project silences
# every match in a project with one formula and one README, where bm25's idf is
# zero by construction -- see the measurements in measurements/README.md. Set to keep
# Bracketed by measurement on both sides: at 0.10 a coincidence gets through,
# and at 0.20 a formula stops retrieving one of its own examples. A coincidence
# costs a glance, silence costs the mechanism. Ordering is bm25's, as it was.
COVERAGE = 0.15

# The same fraction, for one earlier title against another -- used only to seed
# a new formula's examples with titles the work has already been given here.
# Loose on purpose: a wrong seed in a file its author is already editing costs
# a deleted line, so recall is worth more than precision at this one job. It is
# not worth anything at a harder one: two bare titles agree over almost
# nothing, and matching them is not a way to notice a procedure being repeated.
# Measured: see measurements/README.md.
SEED = 0.25

# A procedure someone carried out in the tracker instead of declaring: a parent
