def main():
    argv = sys.argv[1:]

    if not argv or argv[0] == "learn":
        sys.stdout.write(LEARN)
        return 0
    if argv[0] in ("--version", "-V", "version") and len(argv) == 1:
        bd = find_bd()
        _, bdv = bd_quiet(["--version"]) if bd else (1, "")
        print("%s %s" % (PROG, VERSION))
        if bdv.strip():
            print("  on %s" % " ".join(bdv.split()))
        return 0
    # Before anything else: a repository adopted by v0.1.0 is running with
    # its own hooks replaced, and it cannot be left that way while this
    # tool is in a position to put it back.
    announce_repair(repo_root())

    if argv[0] == "check":
        return cmd_check()

    if argv[0] == "init":
        # bd installs its hooks by pointing core.hooksPath at its own
        # directory, which replaces this repository's. Decline that: nothing
        # here needs bd's hooks, and the repository needs its own.
        argv = list(argv)
        if "--skip-hooks" not in argv:
            argv.insert(1, "--skip-hooks")
        code = run_bd(argv)
        root = repo_root()
        announce_repair(root)
        renamed = rename_in_agent_files(root)
        declared = write_conventions(root)
        if renamed:
            print("\n\u2713 Renamed bd to %s in %d agent instruction file%s:"
                  % (PROG, len(renamed), "" if len(renamed) == 1 else "s"))
            for rel in renamed:
                print("    %s" % rel)
        if declared:
            print("\n\u2713 Declared where work starts, in %s."
                  % " and ".join(declared))
            print("    Whoever shows up reads it there, human or agent.")

        # bd commits its own files during init, and the two steps above then
        # edit some of them. That left the repository dirty and the committed
        # copies stale -- naming bd, and carrying no declaration -- so a clone
        # at that commit got neither. Say so; committing is not this tool's
        # to do.
        dirty = left_uncommitted(root, set(renamed) | set(declared))
        if dirty:
            print("\n\u26a0 Edited after bd committed them, so they are "
                  "uncommitted here:")
            for rel in dirty:
                print("    %s" % rel)
            print("\n  The committed copies still name bd and do not say where"
                  " work starts.\n  To fix that:\n")
            print("    git add %s && git commit -m \"Declare where work "
                  "starts\"" % " ".join(dirty))
        return code

    root = repo_root()

    # These three questions are about the project. bd answers them about its
    # own two search paths, and in a project whose formulas sit next to what
    # they are about its answer is "No formulas found".
    if argv[0] == "formula" and len(argv) > 1 and argv[1] == "new":
        rest, at, frm, title, i = argv[2:], None, None, "", 0
        while i < len(rest):
            a = rest[i]
            if a.startswith("--at="):
                at = a[5:]
            elif a.startswith("--from="):
                frm = a[7:]
            elif a in ("--at", "--from") and i + 1 < len(rest):
                i += 1
                at, frm = (rest[i], frm) if a == "--at" else (at, rest[i])
            elif not a.startswith("-") and not title:
                title = a
            i += 1
        return cmd_formula_new(root, title, at, frm)

    if argv[0] == "formula" and len(argv) > 1:
        forms = load_formulas(root)
        plain = [a for a in argv[2:] if not a.startswith("-")]
        flags = [a for a in argv[2:] if a.startswith("-")]
        if argv[1] == "list" and not [g for g in flags if g != "--json"]:
            return cmd_formula_list(root, forms, "--json" in flags)
        if argv[1] == "show" and len(plain) == 1 and not flags:
            f = resolve(forms, plain[0])
            if f:
                return cmd_formula_show(root, f)

    # Pour from where the formula lives, instead of requiring it be moved there.
    if argv[0] == "mol" and len(argv) > 2 and argv[1] == "pour":
        f = resolve(load_formulas(root), argv[2])
        if f and ensure_cooked(root, f):
            argv = ["mol", "pour", f["id"]] + argv[3:]
        return run_bd(argv)

    # `cook <id>` means that formula's file, wherever in the tree it sits.
    if argv[0] == "cook" and len(argv) > 1 and not argv[1].startswith("-"):
        f = resolve(load_formulas(root), argv[1])
        if f and not os.path.exists(argv[1]):
            argv = ["cook", os.path.join(root, f["rel"])] + argv[2:]
        return run_bd(argv)

    # The conventions, checked where someone actually looks. Nobody in the
    # trial ran `check` or `learn`; they ran these two.
    if argv[0] in ("doctor", "lint"):
        code = run_bd(argv)
        forms = load_formulas(root)
        idx = Index(forms, background(root))
        probs = problems(root, forms, idx)
        if probs:
            print("\n%d %s convention problem%s:"
                  % (len(probs), PROG, "" if len(probs) == 1 else "s"),
                  file=sys.stderr)
            print_problems(probs, limit=5)
        note_handmade(root, idx)
        return code

    # A procedure kept as a memory is one nothing can match or instantiate.
    # Three agents in five reached for this instead of writing a formula.
    if argv[0] == "remember":
        code = run_bd(argv)
        if code == 0 and reads_procedural(" ".join(argv[1:])):
            print("\n\U0001f4dc That reads like a procedure. A formula can be "
                  "matched against a\n   title and poured into tracked steps; "
                  "a memory can do neither.", file=sys.stderr)
            print("   Write it as one:  %s formula new \"%s\""
                  % (PROG, clip(" ".join(argv[1:]), 60)), file=sys.stderr)
        return code

    if argv[0] != "create":
        return run_bd(argv)

    code = run_bd(argv)
    if code != 0:
        return code
    if os.environ.get("DOTDIW_NO_HINTS"):
        return 0
    if any(a in ("--json", "-q", "--quiet", "--silent") for a in argv):
        return 0

    again = rename_in_agent_files(root)
    write_conventions(root)
    if again:
        print("\n(%s renamed bd in %d agent instruction file%s that bd rewrote)"
              % (PROG, len(again), "" if len(again) == 1 else "s"), file=sys.stderr)
    forms = load_formulas(root)
    idx = Index(forms, background(root))
    if forms:
        suggest(argv, root, idx)
    note_handmade(root, idx)
    probs = problems(root, forms, idx)
    if probs:
        print("\n%d formula problem%s:" % (len(probs), "" if len(probs) == 1 else "s"),
              file=sys.stderr)
        print_problems(probs, limit=3)
    return 0


if __name__ == "__main__":
    sys.exit(main() or 0)
