def present(operation, request, response):
    """What the worker sees of a response, as its operation returns."""
    shown = SHOW.get(operation)
    if shown is not None:
        shown(request, response)


def extract_query(argv):
    """Title plus -d description, from a `create ...` argument list."""
    title, desc, skip = "", "", False
    for i, a in enumerate(argv):
        if skip:
            skip = False
            continue
        if a == "create":
            continue
        if a.startswith("--") and "=" in a:
            k, v = a.split("=", 1)
            if k in ("-d", "--description"):
                desc = v
            continue
        if a.startswith("-"):
            if a in VALUE_FLAGS:
                skip = True
                if a in ("-d", "--description") and i + 1 < len(argv):
                    desc = argv[i + 1]
            continue
        if not title:
            title = a
    return title, desc


def main():
    global PRESENTER
    PRESENTER = present
    argv = sys.argv[1:]
    root = repo_root()

    # Before any bd command, --version included: while metrics are on, bd
    # queues an event for every command it runs.
    invoke("operation.turn-metrics-off", {})

    if not argv or argv[0] == "learn":
        return invoke("operation.learn-the-conventions", {})["exitCode"]
    if argv[0] in ("--version", "-V", "version") and len(argv) == 1:
        _, bdv = bd_quiet(["--version"]) if find_bd() else (1, "")
        print("%s %s" % (PROG, VERSION))
        number = re.search(r"\d+(?:\.\d+)+", bdv)
        if number:
            print("  tracker %s" % number.group(0))
        return 0
    # Before anything else: what an earlier version left -- a hook override,
    # a remote, a tracker in the tree -- is put right, so that the command
    # typed next runs against a tracker under the home.
    invoke("operation.undo-earlier-adoption", {"root": root})

    # The tracker this checkout is keyed to, told to every bd that runs.
    ws = workspace(root)
    if adopted(ws):
        os.environ["BEADS_DIR"] = beads_dir(ws)
    else:
        ws = None

    if argv[0] == "check":
        return invoke("operation.describe-and-check", {"root": root, "mode": "check"})["exitCode"]

    if argv[0] == "init":
        return invoke("operation.adopt-a-repository", {"root": root, "arguments": argv})["exitCode"]

    # These questions are about the project. bd answers them about its own
    # two search paths, and in a project whose formulas sit next to what they
    # are about its answer is "No formulas found". They need no tracker.
    if argv[0] == "formula" and len(argv) > 1 and argv[1] == "new":
        rest, at, frm, title, i = argv[2:], None, None, "", 0
        while i < len(rest):
            a = rest[i]
            if a.startswith("--at="):
                at = a[5:]
            elif a.startswith("--from="):
                frm = a[7:]
            elif a in ("--at", "--from") and i + 1 < len(rest):
                i += 1
                at, frm = (rest[i], frm) if a == "--at" else (at, rest[i])
            elif not a.startswith("-") and not title:
                title = a
            i += 1
        return invoke("operation.write-formula",
                      {"root": root, "title": title, "directory": at,
                       "fromRef": frm})["exitCode"]

    if argv[0] == "formula" and len(argv) > 1:
        plain = [a for a in argv[2:] if not a.startswith("-")]
        flags = [a for a in argv[2:] if a.startswith("-")]
        if argv[1] == "list" and not [g for g in flags if g != "--json"]:
            return invoke("operation.list-formulas",
                          {"root": root, "json": "--json" in flags})["exitCode"]
        if argv[1] == "show" and len(plain) == 1 and not flags:
            shown = invoke("operation.show-formula", {"root": root, "ident": plain[0]})
            if shown["status"] != "blocked":
                return shown["exitCode"]

    if ws is None:
        # bd's own error would name a .beads directory that is not supposed
        # to exist; one sentence is better.
        sys.stderr.write("%s: this repository is not adopted. Run %s init once; it is "
                         "local and commits nothing.\n" % (PROG, PROG))
        return 1

    # Pour from where the formula lives, instead of requiring it be moved there.
    if argv[0] == "mol" and len(argv) > 2 and argv[1] == "pour":
        return invoke("operation.pour-procedure",
                      {"root": root, "ident": argv[2], "arguments": argv[3:]})["exitCode"]

    if argv[0] != "create":
        return invoke("operation.run-a-tracker-command",
                      {"root": root, "arguments": argv})["exitCode"]

    title, desc = extract_query(argv)
    quiet = bool(os.environ.get("DOTDIW_NO_HINTS")) or any(
        a in ("--json", "-q", "--quiet", "--silent") for a in argv)
    return invoke("operation.start-named-work",
                  {"root": root, "arguments": argv, "title": title,
                   "description": desc, "quiet": quiet})["exitCode"]


if __name__ == "__main__":
    sys.exit(main() or 0)
