            expect(
                only.get("closedIds") == [kept["stepIds"][0]]
                and ask("show-item", id=kept["rootId"])["item"].get("status") != "closed",
                "close-item leaves open a root it is given to keep open, though its last step "
                "closed: %s" % only.get("summary"),
            )
            expect(
                ask("close-item", id=kept["rootId"]).get("closedIds") == [kept["rootId"]],
