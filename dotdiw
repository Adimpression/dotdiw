# ============================================================ the command line
#
# The interface binding: parse the affordance, build the request, call the
# operation through the door, return its exit code, and show what came back.
# No product decision lives here. What runs before every command -- metrics
# off, an earlier adoption put right -- runs here because every affordance
# supports those two operations (binding.cli-every-run-*); resolving the
# workspace is how the interface knows a tracker was opened here; the adapter
# the worker named, --tracker or DOTDIW_TRACKER, rides on every request that
# reaches one; the version is the tool's identity and no operation, and the
# tracker's version under it is what the chosen adapter says of itself, asked
# through the tracker door.
#
# present() is what main() installs in the door: one renderer per operation
# that has something to show, run as that operation returns, so the order on
# the terminal is the order of the calls. The wording is the product's and
# test_dotdiw.py holds it; the facts come from the typed response and the
# request, never from anywhere else.


def show_teach(request: Request, response: Response) -> None:
    sys.stdout.write(response["text"])


def show_index(request: Request, response: Response) -> None:
    for line in response.get("providersLeftOut") or []:
        sys.stderr.write("%s: %s It is left out of this run.\n" % (PROG, line))
    if response["status"] == "failed" and response.get("fileCount"):
        n = response["fileCount"]
        sys.stderr.write(
            "%s needs Python 3.11 or newer to read formulas (tomllib), and this "
            "is %d.%d.\n  %d formula file%s in this repo cannot be parsed.\n"
            "  brew install %s installs its own interpreter; this one came from "
            "elsewhere.\n"
            % (PROG, sys.version_info[0], sys.version_info[1], n, "" if n == 1 else "s", PROG)
        )


def show_providers(request: Request, response: Response) -> None:
    if response["status"] != "completed":
        sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))
        for rel in response.get("clashing") or []:
            sys.stderr.write("  %s\n" % rel)
        return
    if request.get("action") != "list":
        print(response["summary"])
        return
    providers = response.get("providers") or []
    if not providers:
        print("No formula management provider is registered.")
    for p in providers:
        where = ("  " + p["location"]) if p.get("location") else ""
        what = ", ".join(p.get("answers") or [])
        if p.get("unavailable"):
            what = "unavailable: %s" % p["unavailable"]
        print("  %-12s %-12s %s%s" % (p["name"], p["module"], what, where))


def show_list(request: Request, response: Response) -> None:
    if response["status"] != "completed":
        return
    forms = response["formulas"]
    if request.get("json"):
        print(
            json.dumps(
                [
                    dict(
                        {
                            "formula": f["formulaRef"],
                            "name": f["name"],
                            "path": f["path"],
                            "description": f["description"],
                            "examples": f["examples"],
                        },
                        **({"verifyUsing": f["verifyUsing"]} if f.get("verifyUsing") else {}),
                        **({"provider": f["provider"]} if f.get("provider") else {}),
                    )
                    for f in forms
                ],
                indent=2,
            )
        )
    elif not forms:
        print("No formulas in this repo yet. %s learn says how to write one." % PROG)
    else:
        w = max(len(f["formulaRef"]) for f in forms)
        print("%d formula%s:" % (len(forms), "" if len(forms) == 1 else "s"))
        for f in sorted(forms, key=lambda g: g["name"]):
            d = " ".join(f["description"].split())
            if len(d) > 70 - w:
                d = d[: 69 - w] + "…"
            print("  %-*s  %s" % (w, f["formulaRef"], d))
            where = "from the %s provider" % f["provider"] if f.get("provider") else f["path"]
            print("  %-*s  %s" % (w, "", where))
        print("\nRun one: %s formula pour <id>" % PROG)


def show_show(request: Request, response: Response) -> None:
    if response["status"] == "completed":
        sys.stdout.write(response["text"])
    elif response["status"] == "failed" and response.get("path"):
        sys.stderr.write("%s: %s\n" % (response["path"], response["summary"]))
    elif response.get("reason") in ("ambiguous", "provider-formula-unserved", "provider-failed"):
        sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))


def show_match(request: Request, response: Response) -> None:
    top = response.get("surfaced") or []
    if not top or not request.get("surface", True):
        return
    w = max(len(f["name"]) for f in top)
    print("\n\U0001f4dc Formulas that may apply:", file=sys.stderr)
    for f in top:
        d = " ".join(f["description"].split())
        if len(d) > 74 - w:
            d = d[: 73 - w] + "…"
        print("  %-*s  %s" % (w, f["name"], d), file=sys.stderr)
        where = "from the %s provider" % f["provider"] if f.get("provider") else f["path"]
        print("  %-*s  %s" % (w, "", where), file=sys.stderr)
    # One command. It used to print `cook --persist && mol wisp create`,
    # whose wisp is ephemeral and never synced via git -- which is
    # management and sharing both given up. `formula pour` is the durable one.
    print(
        "  Run it: %s formula pour %s"
        % (PROG, shlex.quote(response.get("pourRef") or top[0]["formulaRef"])),
        file=sys.stderr,
    )


def show_notice(found: list[dict[str, Any]]) -> None:
    """The handmade notice, shown by the check that carries it."""
    if not found:
        return
    sys.stdout.flush()
    print(
        "\n\U0001f4dc %d procedure%s carried out here, never declared:"
        % (len(found), "" if len(found) == 1 else "s"),
        file=sys.stderr,
    )
    for p in found[:TOP_N]:
        print(
            "    %s  (%d ordered steps, built by hand)"
            % (p["title"] or p["workRef"], p["stepCount"]),
            file=sys.stderr,
        )
        print(
            "      %s formula new %s --from %s"
            % (PROG, shell_word(p["title"]), shlex.quote(p["workRef"])),
            file=sys.stderr,
        )
    if len(found) > TOP_N:
        print("    ... and %d more" % (len(found) - TOP_N), file=sys.stderr)


def show_check(request: Request, response: Response) -> None:
    if response["status"] == "failed":  # the index said why
        return
    probs, mode = response["problems"], request.get("mode") or "check"
    undeclared = response.get("undeclared") or []

    def show(limit: int | None) -> None:
        shown = probs if limit is None else probs[:limit]
        w = max(len(p["where"]) for p in shown)
        for p in shown:
            print("  %-*s  %s" % (w, p["where"], p["what"]), file=sys.stderr)
        rest = len(probs) - len(shown)
        if rest > 0:
            print("  ... and %d more. See them all: %s check" % (rest, PROG), file=sys.stderr)

    if mode == "quiet":
        # Under a create the notice comes before the problems: the thing the
        # worker can act on first, then the housekeeping.
        show_notice(undeclared)
        if probs:
            print(
                "\n%d formula problem%s:" % (len(probs), "" if len(probs) == 1 else "s"),
                file=sys.stderr,
            )
            show(3)
    elif mode == "doctor":
        if probs:
            print(
                "\n%d %s convention problem%s:"
                % (len(probs), PROG, "" if len(probs) == 1 else "s"),
                file=sys.stderr,
            )
            show(5)
        show_notice(undeclared)
    else:
        n = response["formulaCount"]
        if not n and not probs:
            print("No formulas yet. %s learn says how to write one." % PROG)
        elif not probs:
            print("✓ %d formula%s, all discoverable." % (n, "" if n == 1 else "s"))
        else:
            print("%d problem%s:" % (len(probs), "" if len(probs) == 1 else "s"), file=sys.stderr)
            show(None)
        show_notice(undeclared)


def show_nudge(request: Request, response: Response) -> None:
    if response["nudged"]:
        print(
            "\n\U0001f4dc That reads like a procedure. A formula can be "
            "matched against a\n   title and poured into tracked steps; "
            "a memory can do neither.",
            file=sys.stderr,
        )
        print("   Write it as one:  %s" % response["command"], file=sys.stderr)


def show_write(request: Request, response: Response) -> None:
    reason = response.get("reason")
    if reason == "no-title":
        sys.stderr.write('%s formula new "<what the procedure is for>"\n' % PROG)
    elif reason == "exists":
        sys.stderr.write("%s already exists\n" % response["path"])
    elif reason == "unwritable":
        sys.stderr.write("%s: %s\n" % (response["path"], response["summary"]))
    elif response["status"] != "completed":
        sys.stderr.write("%s: %s\n" % (PROG, response["summary"]))
    if response["status"] != "completed":
        return
    rel = response["path"]
    print("✓ Wrote %s" % rel)
    if response["seeded"] > 1:
        print("  Seeded %d example titles from work already named here." % response["seeded"])
    if response.get("stepsFrom"):
        print("  Steps taken from %s, in the order the work was done." % response["stepsFrom"])
    if "steps" not in response["left"]:
        print("\n  One thing left, and it is discoverable:")
        print("    the description   the situation, and when to reach for it")
    else:
        print("\n  Two things left, and it is discoverable:")
        print("    the description   the situation, and when to reach for it")
        print("    the steps         what you do, and which step needs which")
    print("\n  Then:  git add %s && git commit" % shlex.quote(rel))
    print("         %s check" % PROG)


