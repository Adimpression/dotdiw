.md .txt .rst .adoc .org .tex .py .go .js .mjs .ts .tsx .jsx .rb .rs .java .kt .swift .m .cs
.php .pl .lua .c .h .cc .cpp .hpp .sh .bash .zsh .fish .yaml .yml .toml .json .cfg .ini .conf
.env .sql .proto .graphql .html .css .scss .vue .svelte .tf .dockerfile .mk .gradle .bzl
""".split()
) | {""}

# bd's name, as a whole word. Two places hide it -- the stream rewrite in the
# beads adapter and the file rewrite in DeclareConventions -- and each applies
# this pattern itself, so there is no helper that both share.
_BD_WORD = re.compile(r"\bbd\b")
_BD_WORD_B = re.compile(rb"\bbd\b")

# What bd init writes for agents to read. Its name is compiled into these the
# same way it is into its output -- but an agent reads the file, so the stream
# rewrite never reaches it. bd writes them again on setup, doctor --fix and
# upgrades, so DeclareConventions re-runs rather than running once.
