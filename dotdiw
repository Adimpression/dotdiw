    """Where a provider module may be: the places a tracker is looked for,
    each with a directory of its own."""
    return package_dirs(PROVIDERS_DIR, PROVIDERS_SHARED)


def load_provider(module: str) -> tuple[dict[str, Any] | None, str]:
    """A provider module's PROVIDER table by the module's name, a shipped one
    first, then the first file of that name in provider_dirs; with why it is
    None: module-not-found, or not-a-provider for a file that raised on load,
    holds no table, whose table lacks describe, list or show, or whose info
    names another provider interface than this one."""
    if module in PROVIDER_MODULES:
        return PROVIDER_MODULES[module], ""
    if not re.fullmatch(PROVIDER_MODULE, module or ""):
        return None, "module-not-found"
    path = None
    for directory in provider_dirs():
        if os.path.isfile(os.path.join(directory, module + ".py")):
            path = os.path.join(directory, module + ".py")
            break
    if path is None:
        return None, "module-not-found"
    name = "dotdiw_provider_" + module.replace("-", "_")
    loader = module_loader(name, path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        return None, "not-a-provider"
    loaded = importlib.util.module_from_spec(spec)
    vars(loaded)["dotdiw_version"] = VERSION
    sys.modules[loader.name] = loaded
    try:
        loader.exec_module(loaded)
    except Exception:
        return None, "not-a-provider"
    table = getattr(loaded, "PROVIDER", None)
    if not isinstance(table, dict):
        return None, "not-a-provider"
    operations = table.get("operations")
    if not isinstance(operations, dict) or not all(
        callable(operations.get(k)) for k in ("describe", "list", "show")
    ):
        return None, "not-a-provider"
    info = table.setdefault("info", {})
    if not isinstance(info, dict) or info.get("interface") != PROVIDER_INTERFACE:
        return None, "not-a-provider"
    info["origin"], info["source"] = "loaded", path
    PROVIDER_MODULES[module] = table
    return table, ""


def read_registry() -> dict[str, Any]:
    """The registry under the home: the registered providers by name, and the
    names removed since, whose suffixes no formula answers to any more."""
    try:
        with open(os.path.expanduser(PROVIDER_REGISTRY), encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        data = {}
    if not isinstance(data, dict):
        data = {}
    providers = data.get("providers")
    removed = data.get("removed")
    return {
        "providers": {
            name: entry
            for name, entry in (providers if isinstance(providers, dict) else {}).items()
            if isinstance(entry, dict) and isinstance(entry.get("module"), str)
        },
        "removed": sorted(
            {n for n in (removed if isinstance(removed, list) else []) if isinstance(n, str)}
        ),
    }


def read_providers() -> dict[str, dict[str, Any]]:
    """The registered providers by name, from the registry under the home."""
    return dict(read_registry()["providers"])


def write_registry(registry: dict[str, Any]) -> None:
    """The registry under the home, written whole through a file beside it,
    and only under registry_lock."""
    path = os.path.expanduser(PROVIDER_REGISTRY)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w", encoding="utf-8") as fh:
        json.dump(
            {"providers": registry["providers"], "removed": sorted(registry["removed"])},
            fh,
            indent=2,
            sort_keys=True,
        )
        fh.write("\n")
    os.replace(path + ".tmp", path)


@contextlib.contextmanager
def registry_lock() -> Iterator[None]:
    """The registry held for one read, change and write: a second register or
    remove waits for the first, so that neither loses what the other wrote."""
    path = os.path.expanduser(PROVIDER_LOCK)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a", encoding="utf-8") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)


def suffix_owner(ident: str, registry: dict[str, Any]) -> str | None:
    """The registered or removed provider whose suffix the ident carries, or
    None: an id with a provider's suffix is that provider's alone."""
    return next(
        (
            n
            for n in sorted(set(registry["providers"]) | set(registry["removed"]))
            if len(ident) > len(n) + 1 and ident.endswith("-" + n)
        ),
        None,
    )


def shell_word(text: str) -> str:
    """Free text as one word of a command printed to be copied: in double
    quotes, as dotdiw has always printed it, unless something in it is read by
    a shell inside them -- then quoted so that nothing in it is."""
    if re.search(r'["$`\\!\n]', text):
        return shlex.quote(text)
    return '"%s"' % text


