# registry holds adapters by name; two ship inside this file, and one more
# loads from the home by name. A request names the adapter that answers it,
# else the workspace's config does, else the one adapter holding a store
# under the workspace does -- a workspace adopted before there was a choice
# -- else the shipped default, local.
TRACKER_KEY = "dotdiw.tracker"
DEFAULT_TRACKER = "local"
