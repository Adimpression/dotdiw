def own_flags(
    args: list[str], values: dict[str, str], switches: dict[str, str], positionals: int
) -> tuple[dict[str, Any], list[str], str | None]:
    """The fields a command's own flags fill, its positional words, and what
    it refused, said as a clause, if anything: a flag outside its own, a flag
    with no value after it -- another flag where its value belongs counts as
    none, and --name=value gives a value that starts with a dash -- or a word
    beyond the positionals it takes."""
    fields: dict[str, Any] = {}
    words: list[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        flag, eq, value = a.partition("=") if a.startswith("--") else (a, "", "")
        if flag in values:
            if not eq:
                if i + 1 >= len(args) or args[i + 1].startswith("-") and args[i + 1] != "-":
                    return fields, words, "%s needs a value" % a
                i += 1
                value = args[i]
            fields[values[flag]] = value
        elif a in switches:
            fields[switches[a]] = True
        elif a.startswith("-") and a != "-":
            return fields, words, "%s is not one of its flags" % a
        elif len(words) >= positionals:
            return fields, words, "%s is one word too many; quote words that go together" % a
        else:
            words.append(a)
        i += 1
    return fields, words, None


def extract_tracker(argv: list[str]) -> tuple[str | None, list[str], bool]:
    """The adapter the worker named: --tracker <name> or --tracker=<name>
    anywhere, taken out of the arguments, else DOTDIW_TRACKER, else None --
    the workspace's choice and the default are the door's to apply; and
    whether --tracker was given with no name, which nothing may run on."""
    name, rest, i, missing = None, [], 0, False
    while i < len(argv):
        a = argv[i]
        if a == "--tracker":
            given = argv[i + 1] if i + 1 < len(argv) else ""
            if not given or given.startswith("-"):
                missing = True
                i += 1
                continue
            name = given
            i += 2
            continue
        if a.startswith("--tracker="):
            name = a[len("--tracker=") :]
            missing = missing or not name
        else:
            rest.append(a)
        i += 1
    return name or os.environ.get("DOTDIW_TRACKER") or None, rest, missing


# ===================================================================== gRPC
#
# The second interface: POA's gRPC projection of operation-idl.json, served.
# Every operation with a body that is not internal-only is a method of one
# service; the tracker interface is not served. Its descriptor is built here
# from the door's types: a message per record type, its fields numbered in
# the order the IDL gives them, as POA numbers them, and a map, or a list of
# maps, held as JSON text, as POA's proto holds them; test_promise.py holds
# the two equal wherever POA has generated the proto. A method turns the
# message into the operation's request, asks the door, and turns the answer
# into the message. A write whose ETags no longer match is ABORTED, as
# AIP-154 has it; an ETag that is none of dotdiw's, or a required field
# missing, INVALID_ARGUMENT; a body's mistake INTERNAL; every other answer,
# failed or not, is the response, its status inside. grpcio and protobuf
# are imported here alone, so that the rest of dotdiw keeps to the standard
# library.

GRPC_PACKAGE = "workflow.discovery.dotdiw.v0"
GRPC_SERVICE = "DotdiwOperations"
GRPC_FILE = "workflow/discovery/dotdiw/v0/dotdiw.proto"
GRPC_ADDRESS = "127.0.0.1:50051"
GRPC_WORKERS = 16  # requests answered at once, each a request of its own (Scope)


def grpc_field(name: str) -> str:
    """A field's name in the proto, as POA writes it."""
    return re.sub(r"(?<!^)(?=[A-Z])", "_", name).lower()


def grpc_kind(kind: Any) -> Any:
    """A field's type as the IDL declares it, without None; get_type_hints
    has taken Required off already."""
    if get_origin(kind) in (Union, UnionType):
        return next(k for k in get_args(kind) if k is not type(None))
    return kind


def grpc_descriptor(pb: Any) -> Any:
    """POA's projection as a FileDescriptorProto, from the door's types: the
    request and response of each operation served, and every record they
    hold, and one method per operation served, named as the IDL names it."""
    field = pb.FieldDescriptorProto
    proto = pb.FileDescriptorProto(name=GRPC_FILE, package=GRPC_PACKAGE, syntax="proto3")
    made: set[str] = set()

    def scalar(f: Any, kind: Any) -> None:
        if is_typeddict(kind):
            record(kind)
            f.type, f.type_name = field.TYPE_MESSAGE, ".%s.%s" % (GRPC_PACKAGE, kind.__name__)
        elif kind is int:
            f.type = field.TYPE_INT64
        elif kind is bool:
            f.type = field.TYPE_BOOL
        else:  # text, a word of an enum, or a map or a record held as JSON text
            f.type = field.TYPE_STRING

    def record(kind: Any) -> None:
        if kind.__name__ in made:
            return
        made.add(kind.__name__)
        message = proto.message_type.add(name=kind.__name__)
        for number, (name, hint) in enumerate(get_type_hints(kind).items(), 1):
            hint = grpc_kind(hint)
            f = message.field.add(name=grpc_field(name), number=number, json_name=name)
            f.label = field.LABEL_REPEATED if get_origin(hint) is list else field.LABEL_OPTIONAL
            scalar(f, grpc_kind(get_args(hint)[0]) if get_origin(hint) is list else hint)

    service = proto.service.add(name=GRPC_SERVICE)
    for spec in DOOR.values():
        if spec["visibility"] == "internal-only":
            continue
        hints = get_type_hints(globals()[spec["body"]])
        record(hints["request"])
        record(hints["return"])
        service.method.add(
            name=spec["body"],
            input_type=".%s.%s" % (GRPC_PACKAGE, hints["request"].__name__),
            output_type=".%s.%s" % (GRPC_PACKAGE, hints["return"].__name__),
        )
    return proto


def grpc_request(message: Any, kind: Any, within: bool = False) -> dict[str, Any]:
    """A message as the record its type is: each field the client set, by
    the IDL's name for it. A field left at its default is not given, since
    proto3 cannot tell the two apart -- except, in a record within the
    request, a field the record requires: it cannot be left out, so its
    default is what was given, as an empty text is, which removes a claim's
    value."""
    hints = get_type_hints(kind)
    out: dict[str, Any] = {}
    for f, value in message.ListFields():
        hint = grpc_kind(hints[f.json_name])
        if get_origin(hint) is list:
            inner = grpc_kind(get_args(hint)[0])
            out[f.json_name] = [
                grpc_request(v, inner, True)
                if is_typeddict(inner)
                else json.loads(v)
                if get_origin(inner) is dict
                else v
                for v in value
            ]
        elif get_origin(hint) is dict:
            out[f.json_name] = json.loads(value)
        elif is_typeddict(hint):
            out[f.json_name] = grpc_request(value, hint, True)
        else:
            out[f.json_name] = value
    for name in sorted(kind.__required_keys__ - out.keys()) if within else []:
        hint = grpc_kind(hints[name])
        if not is_typeddict(hint):  # a record is given or not: proto3 tells
            out[name] = (
                []
                if get_origin(hint) is list
                else {}
                if get_origin(hint) is dict
                else hint()
                if hint in (int, bool)
                else ""
            )
    return out


def grpc_message(value: Mapping[str, Any], kind: Any, message: Any) -> Any:
    """A record as the message its type is, None left unset."""
    hints = get_type_hints(kind)
    for name, one in value.items():
        if one is None:
            continue
        hint, target = grpc_kind(hints[name]), grpc_field(name)
        if get_origin(hint) is list:
            inner = grpc_kind(get_args(hint)[0])
            for v in one:
                if is_typeddict(inner):
                    grpc_message(v, inner, getattr(message, target).add())
                elif get_origin(inner) is dict:
                    getattr(message, target).append(json.dumps(v, ensure_ascii=False))
                else:
                    getattr(message, target).append(v)
        elif get_origin(hint) is dict:
            setattr(message, target, json.dumps(one, ensure_ascii=False))
        elif is_typeddict(hint):
            grpc_message(one, hint, getattr(message, target))
        else:
            setattr(message, target, one)
    return message


def grpc_answer(grpc: Any, operation: str, kinds: Any, reply: Any) -> Callable[[Any, Any], Any]:
    """One method: the message as the operation's request, the door, and
    the answer as the message; the request never says a terminal is there,
    since none is, and it starts when the server begins to answer it."""
    spec = DOOR[operation]

    def answer(message: Any, context: Any) -> Any:
        request = grpc_request(message, kinds["request"])
        request.pop("terminal", None)
        missing = [k for k in spec["requestRequired"] if request.get(k) is None]
        if missing:
            context.abort(
                grpc.StatusCode.INVALID_ARGUMENT,
                "%s: %s is required." % (spec["body"], ", ".join(missing)),
            )
        with a_request() as scope:
            scope.started = datetime.datetime.now(datetime.UTC).strftime("%Y-%m-%dT%H:%M:%S.%fZ")
            try:
                response = invoke(operation, request)
            except Exception as e:  # a body's mistake, the door's DoorError among them
                context.abort(grpc.StatusCode.INTERNAL, "%s: %s" % (spec["body"], e))
                raise
        if response.get("reason") == "changed-since-read":
            context.abort(grpc.StatusCode.ABORTED, response["summary"])
        if response.get("reason") == "not-an-etag":
            context.abort(grpc.StatusCode.INVALID_ARGUMENT, response["summary"])
        return grpc_message(response, kinds["return"], reply())

    return answer


def serve(address: str) -> int:
    """Serve the operations over gRPC until interrupted, with no presenter,
    since nothing is shown, and a thread per request answered at once."""
    global PRESENTER
    # gRPC's fork handlers prepare a child to use gRPC; dotdiw's children run
    # git or bd at once and never do, so the handlers do nothing for them but
    # log a line for every fork made while a call is answered -- under beads,
    # every request -- which, on a stderr no one reads, stops the server.
    os.environ.setdefault("GRPC_ENABLE_FORK_SUPPORT", "false")
    try:
        grpc = importlib.import_module("grpc")
        pb = importlib.import_module("google.protobuf.descriptor_pb2")
        pools = importlib.import_module("google.protobuf.descriptor_pool")
        factory = importlib.import_module("google.protobuf.message_factory")
        futures = importlib.import_module("concurrent.futures")
    except ImportError as e:
        sys.stderr.write("%s serve: serving gRPC needs grpcio and protobuf: %s.\n" % (PROG, e))
        return 1
    PRESENTER = None
    pool = pools.DescriptorPool()
    pool.Add(grpc_descriptor(pb))

    def message_class(name: str) -> Any:
        found = pool.FindMessageTypeByName("%s.%s" % (GRPC_PACKAGE, name))
        return factory.GetMessageClass(found)

    methods = {}
    for operation, spec in DOOR.items():
        if spec["visibility"] == "internal-only":
            continue
        kinds = get_type_hints(globals()[spec["body"]])
        methods[spec["body"]] = grpc.unary_unary_rpc_method_handler(
            grpc_answer(grpc, operation, kinds, message_class(kinds["return"].__name__)),
            request_deserializer=message_class(kinds["request"].__name__).FromString,
            response_serializer=lambda m: m.SerializeToString(),
        )
    server = grpc.server(futures.ThreadPoolExecutor(max_workers=GRPC_WORKERS))
    server.add_generic_rpc_handlers(
        (grpc.method_handlers_generic_handler("%s.%s" % (GRPC_PACKAGE, GRPC_SERVICE), methods),)
    )
    try:
        port = server.add_insecure_port(address)
    except RuntimeError as e:
        sys.stderr.write("%s serve: cannot listen on %s: %s\n" % (PROG, address, e))
        return 1
    server.start()
    sys.stderr.write("%s: serving gRPC on %s:%d\n" % (PROG, address.rpartition(":")[0], port))
    sys.stderr.flush()
    try:
        server.wait_for_termination()
    except KeyboardInterrupt:
        server.stop(grace=1)
    return 0


def main() -> int:
    global PRESENTER
    PRESENTER = present
    tracker, argv, missing = extract_tracker(sys.argv[1:])
    if missing:
        sys.stderr.write("%s: --tracker needs a value, as --tracker <name>.\n" % PROG)
        return 2
    root = repo_root()

    # Before any tracker command, --version included: while the tracker's
    # metrics are on, it queues an event for every command it runs.
    invoke("operation.turn-metrics-off", {"root": root, "tracker": tracker})

    if not argv or argv[0] == "learn":
        return int(invoke("operation.learn-the-conventions", {})["exitCode"])
    helped = HELP.get(" ".join(argv[:2])) or HELP.get(argv[0])
    if helped and ("--help" in argv[1:] or "-h" in argv[1:]):
        print(helped[0] % PROG)
        print("\n%s" % helped[1])
        return 0
    if argv[0] in ("--version", "-V", "version") and len(argv) == 1:
        print("%s %s" % (PROG, VERSION))
        described = invoke_tracker("operation.describe-tracker", {"root": root, "tracker": tracker})
        info = described.get("info") or {}
        if described["status"] == "completed" and info.get("version"):
            print("  tracker %s %s" % (info.get("name"), info["version"]))
        return 0
    # The other interface: the operations over gRPC, until interrupted.
    if argv[0] == "serve":
        fields, _, refused = own_flags(argv[1:], {"--address": "address"}, {}, 0)
        if refused is not None:
            sys.stderr.write("%s: serve: %s. %s\n" % (PROG, refused, SERVE_USAGE % PROG))
            return 2
        return serve(fields.get("address") or GRPC_ADDRESS)
    # What an earlier version left -- a hook override, a tracker in the tree,
    # a workspace with no tracker chosen -- is init's to put right. Every
    # other command asks first and is refused, in one line, while it is left.
    if argv[0] != "init":
        left = invoke("operation.undo-earlier-adoption", {"root": root, "tracker": tracker})
        if left["exitCode"] != 0:
            return int(left["exitCode"])

    # The workspace this checkout is keyed to, when a tracker was opened in it.
    ws = workspace(root) if checkout_adopted(root) else None

    # The command line's binding of record-what-a-step-found: lines from the
    # arguments, or from standard input when there are none.
    if argv[0] == "claim":
        as_json = "--json" in argv[1:]
        words = [a for a in argv[1:] if a != "--json"]
        if not words or words[0].startswith("-"):
            sys.stderr.write("%s: claim: name a step. %s\n" % (PROG, CLAIM_USAGE % PROG))
            return 2
        lines = words[1:]
        if not lines and not sys.stdin.isatty():
            lines = sys.stdin.read().splitlines()
        # Each line splits at its first colon, the value trimmed; any other
        # line refuses the whole input.
        values: list[ClaimValue] = []
        bad: list[str] = []
        for line in lines:
            label, colon, text = line.partition(":")
            if colon and CLAIM_LABEL.match(label.strip()):
                values.append({"label": label.strip(), "text": text.strip()})
            elif line.strip():
                bad.append(line)
        if bad:
            sys.stderr.write(
                "%s: claim: not a label: value line, so nothing was recorded: %s\n"
                % (PROG, "; ".join(repr(b) for b in bad))
            )
            return 2
        return int(
            invoke(
                "operation.record-what-a-step-found",
                {
                    "root": root,
                    "tracker": tracker,
                    "id": words[0],
                    "values": values,
                    "json": as_json,
                },
            )["exitCode"]
        )

    if argv[0] == "check":
        return int(
            invoke(
                "operation.describe-and-check", {"root": root, "mode": "check", "tracker": tracker}
            )["exitCode"]
        )

    if argv[0] == "init":
        fields, _, refused = own_flags(argv[1:], {"-p": "prefix", "--prefix": "prefix"}, {}, 0)
        if refused is not None:
            sys.stderr.write("%s: init: %s. %s\n" % (PROG, refused, INIT_USAGE % PROG))
            return 2
        return int(
            invoke(
                "operation.adopt-a-repository",
                {"root": root, "prefix": fields.get("prefix"), "tracker": tracker},
            )["exitCode"]
        )

    # The tracker chosen, in the open: which adapters there are, which this
    # checkout uses, whether one keeps to the interface, and the move.
    if argv[0] == "tracker":
        action = argv[1] if len(argv) > 1 else ""
        names = [a for a in argv[2:] if not a.startswith("-")]
        if action == "new":
            rest, at, name, i = argv[2:], None, None, 0
            while i < len(rest):
                a = rest[i]
                if a.startswith("--at="):
                    at = a[5:]
                elif a == "--at":
                    i += 1
                    at = rest[i] if i < len(rest) else ""
                elif not a.startswith("-") and name is None:
                    name = a
                i += 1
            if name and at != "":
                return int(
                    invoke("operation.ship-a-tracker", {"name": name, "directory": at})["exitCode"]
                )
        if action == "migrate":
            # Each --deleted names an item the move made in the target and the
            # person running it deleted there: a run that finds none makes it
            # again. Each --source-gone names an item of the source the
            # person deleted there: a run that finds none leaves the move's
            # copy as made. --from-store and --to-store name the stores a
            # record that names none read from and wrote to: a run held to
            # them goes on.
            # An option it does not know, or one with no value, is refused
            # before anything is read: a move run on what it was not told
            # writes the target as asked of no one.
            words, i = argv[2:], 0
            deleted: list[str] = []
            gone: list[str] = []
            stores: dict[str, str] = {}
            names = []
            while i < len(words):
                option, eq, value = words[i].partition("=")
                field = {"--from-store": "fromStore", "--to-store": "toStore"}.get(option)
                told = {"--deleted": deleted, "--source-gone": gone}.get(option)
                if told is None and field is None:
                    if words[i].startswith("-") and words[i] != "-":
                        sys.stderr.write(
                            "%s: tracker migrate: %s is not one of its options. %s\n"
                            % (PROG, words[i], MIGRATE_USAGE % PROG)
                        )
                        return 2
                    names.append(words[i])
                    i += 1
                    continue
                if not eq:
                    if i + 1 >= len(words) or words[i + 1].startswith("-"):
                        value = ""
                    else:
                        i += 1
                        value = words[i]
                if not value:
                    sys.stderr.write(
                        "%s: tracker migrate: %s needs a value. %s\n"
                        % (PROG, option, MIGRATE_USAGE % PROG)
                    )
                    return 2
                if told is not None:
                    told.append(value)
                elif field:
                    stores[field] = value
                i += 1
            if len(names) != 2:
                sys.stderr.write(
                    "%s: tracker migrate takes the tracker it moves from and the one it "
                    "moves to. %s\n" % (PROG, MIGRATE_USAGE % PROG)
                )
                return 2
        elif action in ("list", "use", "check") and len(names) != len(argv[2:]):
            sys.stderr.write(
                "%s: tracker %s: %s is not one of its options. %s\n"
                % (
                    PROG,
                    action,
                    next(a for a in argv[2:] if a.startswith("-")),
                    TRACKER_USAGE % PROG,
                )
            )
            return 2
        if action == "migrate" and len(names) == 2:
            asked: Request = {"root": root, "fromTracker": names[0], "toTracker": names[1]}
            if deleted:
                asked["deletedIds"] = deleted
            if gone:
                asked["sourceGoneIds"] = gone
            asked.update(stores)
            return int(invoke("operation.move-a-workspace", asked)["exitCode"])
        if (
            action == "check"
            and len(names) == 1
            and (os.sep in names[0] or names[0].endswith(".py"))
        ):
            return int(
                invoke(
                    "operation.choose-a-tracker",
                    {
                        "root": root,
                        "action": action,
                        "name": os.path.splitext(os.path.basename(names[0]))[0],
                        "path": os.path.abspath(names[0]),
                    },
                )["exitCode"]
            )
        if action == "list" or (action in ("use", "check") and len(names) == 1):
            return int(
                invoke(
                    "operation.choose-a-tracker",
                    {"root": root, "action": action, "name": names[0] if names else None},
                )["exitCode"]
            )
        sys.stderr.write("%s\n" % (TRACKER_USAGE % PROG))
        return 2

    # These questions are about the project. bd answers them about its own
    # two search paths, and in a project whose formulas sit next to what they
    # are about its answer is "No formulas found". They need no tracker.
    if argv[0] == "formula" and len(argv) > 1 and argv[1] == "new":
        rest, at, frm, title, i = argv[2:], None, None, "", 0
        while i < len(rest):
            a = rest[i]
            if a.startswith("--at="):
                at = a[5:]
            elif a.startswith("--from="):
                frm = a[7:]
            elif a in ("--at", "--from"):
                i += 1
                value = rest[i] if i < len(rest) else ""
                at, frm = (value, frm) if a == "--at" else (at, value)
            elif not a.startswith("-") and not title:
                title = a
            i += 1
        if at == "" or frm == "":
            title = ""  # says how it is used, as no title does
        return int(
            invoke(
                "operation.write-formula",
                {"root": root, "title": title, "directory": at, "fromRef": frm, "tracker": tracker},
            )["exitCode"]
        )

    if argv[:2] == ["formula", "provider"]:
        given = argv[3:]
        at = None
        if "--at" in given:
            k = given.index("--at")
            at = given[k + 1] if k + 1 < len(given) else ""
            given = given[:k] + given[k + 2 :]
        action = argv[2] if len(argv) > 2 else ""
        if action == "register" and len(given) == 2:
            asked = {"action": "register", "name": given[0], "module": given[1], "location": at}
        elif action == "list" and not given and at is None:
            asked = {"action": "list"}
        elif action == "remove" and len(given) == 1 and at is None:
            asked = {"action": "remove", "name": given[0]}
        else:
            sys.stderr.write(
                "usage: %s formula provider register <name> <module> [--at <location>] "
                "| list | remove <name>\n" % PROG
            )
            return 2
        answered = invoke("operation.answer-through-a-formula-provider", {"root": root, **asked})
        return int(answered["exitCode"])

    if argv[0] == "formula" and len(argv) > 1:
        plain = [a for a in argv[2:] if not a.startswith("-")]
        flags = [a for a in argv[2:] if a.startswith("-")]
        if argv[1] == "list" and not [g for g in flags if g != "--json"]:
            listed = invoke("operation.list-formulas", {"root": root, "json": "--json" in flags})
            return int(listed["exitCode"])
        if argv[1] == "show" and len(plain) == 1 and not flags:
            shown = invoke("operation.show-formula", {"root": root, "ident": plain[0]})
            # Only an id that names no formula at all is the tracker's to answer.
            if shown["status"] != "blocked" or shown.get("reason") != "formula-not-found":
                return int(shown["exitCode"])

    if ws is None:
        # The tracker's own error would name a store that is not supposed to
        # exist; one sentence is better.
        sys.stderr.write(
            "%s: this repository is not adopted. Run %s init once; it is "
            "local and commits nothing.\n" % (PROG, PROG)
        )
        return 1

    # Pour from where the formula lives, instead of requiring it be moved there.
    # formula pour is what dotdiw teaches; mol pour is the older spelling of it.
    if argv[:2] == ["formula", "pour"] and (len(argv) < 3 or argv[2].startswith("-")):
        sys.stderr.write("%s formula pour <formula>\n" % PROG)
        return 2

    if len(argv) > 2 and argv[1] == "pour" and argv[0] in ("formula", "mol"):
        fields, _, refused = own_flags(argv[3:], {}, {"--json": "json"}, 0)
        if refused is not None:
            sys.stderr.write("%s: formula pour: %s. %s\n" % (PROG, refused, POUR_USAGE % PROG))
            return 2
        return int(
            invoke(
                "operation.pour-procedure",
                {
                    "root": root,
                    "ident": argv[2],
                    "json": bool(fields.get("json")),
                    "tracker": tracker,
                },
            )["exitCode"]
        )

    if argv[0] != "create":
        return int(
            invoke(
                "operation.run-a-tracker-command",
                {"root": root, "arguments": argv, "tracker": tracker, "terminal": True},
            )["exitCode"]
        )

    fields, words, refused = own_flags(argv[1:], CREATE_VALUES, CREATE_SWITCHES, 1)
    number = re.fullmatch(r"[Pp]?([0-4])", str(fields.get("priority", "2")))
    if refused is not None or not words or not number:
        said = refused or (
            "a title is needed" if not words else "the priority is 0 to 4, as 2 or P2"
        )
        sys.stderr.write("%s: create: %s. %s\n" % (PROG, said, CREATE_USAGE % PROG))
        return 2
    if "priority" in fields:
        fields["priority"] = int(number.group(1))
    json_out, quiet = bool(fields.pop("json", False)), bool(fields.pop("quiet", False))
    return int(
        invoke(
            "operation.start-named-work",
            dict(
                fields,
                root=root,
                title=words[0],
                json=json_out,
                quiet=quiet or json_out or bool(os.environ.get("DOTDIW_NO_HINTS")),
                tracker=tracker,
            ),
        )["exitCode"]
    )


if __name__ == "__main__":
    sys.exit(main() or 0)
