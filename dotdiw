def NameTheWork(request: NameTheWorkRequest) -> NameTheWorkResponse:
    """step.name-the-work: the work item, created under the title given.

    Through the tracker door, with the fields dotdiw's own flags filled: the
    title, the description, the priority and the parent. The id comes back
    in the record.
    """
    root = request["root"]
    made = invoke_tracker(
        "operation.create-item",
        {
            "root": root,
            "tracker": request.get("tracker"),
            "title": request["title"],
            "description": request.get("description"),
            "priority": request.get("priority"),
            "parent": request.get("parent"),
        },
    )
    code = made.get("exitCode", 0 if made["status"] == "completed" else 1)
    work = (made.get("item") or {}).get("id") if code == 0 else None
    return {
        "status": made["status"],
        "summary": "Named %s." % (work or "the work") if code == 0 else made["summary"],
        "workRef": work,
        "item": made.get("item") if code == 0 else None,
        "reason": made.get("reason"),
        "tracker": made.get("tracker"),
        "exitCode": code,
    }


def PourProcedure(request: PourProcedureRequest) -> PourProcedureResponse:
    """step.pour-procedure: a surfaced formula becomes tracked, ordered steps.

    The formula is read from where it actually lives, every time, and its
    steps handed to the tracker with their needs: the file is the formula,
    so a formula edited in place pours as it reads now, not as a copy the
    tracker happened to hold. Every adapter pours the steps it is given.
    """
    root = request["root"]
    r = invoke("operation.resolve-formula", {"root": root, "ident": request.get("ident")})
    found = r["status"] == "completed"
    # An id refused here never reaches the tracker: one that two formulas
    # share, or one with a provider's suffix that the provider does not serve,
    # whose copy the tracker may still hold.
    if not found and r.get("reason") in (
        "ambiguous",
        "provider-formula-unserved",
        "provider-failed",
    ):
        return {
            "status": r["status"],
            "summary": r["summary"],
            "formulaRef": None,
            "reason": r["reason"],
            "exitCode": 1,
        }
    # The formula poured is the one the lookup selected, as its reading parsed
    # it: its id, its title, its description, its means to prove and its
    # steps, one version whatever is written to its file meanwhile. Nothing
    # reads the file again, and nothing is written for it.
    body = r.get("formula") if found else None
    formula = (
        {
            "id": r["formulaRef"],
            "desc": body["description"],
            "steps": body["steps"],
            "verifyUsing": body["verifyUsing"],
        }
        if body
        else {}
    )
    ident = request.get("ident") or ""
    ref = formula.get("id")
    shared = shared_step_id(formula.get("steps") or [])
    if shared is not None:
        return {
            "status": "failed",
            "summary": "Two steps of %s share the id %s, so nothing was poured." % (ref, shared),
            "formulaRef": ref,
            "reason": "duplicate-step",
            "exitCode": 1,
        }
    poured = invoke_tracker(
        "operation.pour-steps",
        {
            "root": root,
            "tracker": request.get("tracker"),
            "formulaRef": ref or ident,
            "title": ref or ident,
            "steps": formula.get("steps") or [],
            "description": formula.get("desc") or None,
            "verifyUsing": list(formula.get("verifyUsing") or []),
        },
    )
    code = poured.get("exitCode", 0 if poured["status"] == "completed" else 1)
    return {
        "status": poured["status"],
        "summary": poured["summary"],
        "formulaRef": ref if found else None,
        "moleculeRef": poured.get("rootId") if found else None,
        "stepRefs": list(poured.get("stepIds") or []) if found else [],
        "verifyUsing": list(formula.get("verifyUsing") or []) if found and code == 0 else None,
        "reason": poured.get("reason"),
        "tracker": poured.get("tracker"),
        "exitCode": code,
    }


def StartNamedWork(request: StartNamedWorkRequest) -> StartNamedWorkResponse:
    """journey.start-named-work: name it, read what applies, and -- when asked -- pour."""
    root = request["root"]
    named = invoke(
        "operation.name-the-work",
        {
            "root": root,
            "title": request.get("title"),
            "description": request.get("description"),
            "tracker": request.get("tracker"),
            "priority": request.get("priority"),
            "parent": request.get("parent"),
            "json": request.get("json"),
        },
    )
    if named["exitCode"] != 0:
        return {
            "status": named["status"],
            "summary": named["summary"],
            "workRef": named.get("workRef"),
            "exitCode": named["exitCode"],
        }
    if request.get("quiet"):
        return {
            "status": "completed",
            "summary": named["summary"],
            "workRef": named["workRef"],
            "surfaced": [],
            "exitCode": 0,
        }

    invoke("operation.declare-conventions", {"root": root, "announce": "create"})
    built = invoke("operation.index-the-project", {"root": root, "background": True})
    if built["status"] != "completed":
        return {
            "status": "failed",
            "summary": built["summary"],
            "workRef": named["workRef"],
            "exitCode": built["exitCode"],
        }
    matched = invoke(
        "operation.match-formulas",
        {
            "root": root,
            "title": request.get("title"),
            "description": request.get("description"),
            "workRef": named["workRef"],
        },
    )
    invoke(
        "operation.describe-and-check",
        {"root": root, "mode": "quiet", "tracker": request.get("tracker")},
    )
    if request.get("formulaRef"):
        invoke(
            "operation.pour-procedure",
            {
                "root": root,
                "ident": request["formulaRef"],
                "workRef": named["workRef"],
                "tracker": request.get("tracker"),
            },
        )
    return {
        "status": "completed",
        "summary": named["summary"],
        "workRef": named["workRef"],
        "surfaced": matched["surfaced"],
        "exitCode": 0,
    }


