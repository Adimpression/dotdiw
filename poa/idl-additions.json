{
  "updates": [
    {
      "changeId": "change.bind-the-named-work-story",
      "changeType": "add-causal-event-structure-contract",
      "targetRefs": [
        "idl.dotdiw",
        "cesc.named-work-found-its-procedure"
      ],
      "summary": "Reference the contract that witnesses a named piece of work finding its procedure, bind the observed labels to the operations that emit them, and make any report or summary of discovery firing answer to it.",
      "reason": "A claim that discovery fired must be backed by a witness contract, not by an invocation log read by hand.",
      "compatibility": "additive",
      "createdAt": "2026-11-01T00:00:00+08:00",
      "approvalStatus": "draft"
    },
    {
      "changeId": "change.bind-dotdiw-to-its-algebra",
      "changeType": "bind-implementation-and-interfaces",
      "targetRefs": [
        "idl.dotdiw"
      ],
      "summary": "Replace the generated poa invoke bindings with dotdiw's real command line, bind every operation to one inline body in dotdiw through promise_bindings.py, declare beads and git as the products dotdiw calls and name the calls, correct the kinds the step-id heuristic got wrong, and give the request and response types the fields the bodies use.",
      "reason": "Until the bindings are real, POA checks the artifacts against each other and never against the program. These are the facts that let it check the program.",
      "compatibility": "additive",
      "createdAt": "2026-11-01T12:00:00+08:00",
      "approvalStatus": "draft"
    }
  ],
