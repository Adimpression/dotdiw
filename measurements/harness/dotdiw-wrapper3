#!/bin/sh
# Simulation instrumentation only. Logs the invocation when, and only when, it
# is made from inside the matrix, then runs the real thing by absolute path.
S=${DOTDIW_SIM_ROOT:-./sim-root}
case "$PWD" in
  "$S"/runs3/*|"$S"/runs4/*) printf '%s\t%s\t%s\n' "$(date +%H:%M:%S)" "$PWD" "$*" >> "$S/invocations3.log" ;;
esac
exec /opt/homebrew/Cellar/dotdiw/0.1.0/bin/dotdiw "$@"
